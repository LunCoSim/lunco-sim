#usda 1.0
(
    "\n    luncoSchema — the LunCoSim USD schema library.\n\n    This is the usdGenSchema *source*. It is the single authoritative definition\n    of every prim type and API schema LunCoSim adds to USD, and it is what makes\n    them legitimate rather than squatted: an unregistered typeName composes fine\n    but carries no schema, which means no declared variability, no fallbacks, no\n    validation, and no meaning to any other DCC.\n\n    CODELESS (`skipCodeGeneration = true`), exactly like Omniverse's PhysxSchema:\n    there is no generated C++/Python, only the registered definitions.\n    `scripts/gen_schema.py` turns this file into `generatedSchema.usda` and\n    derives the `Types` block in `plugInfo.json`; those are what the runtime\n    registers and parses. The generated files are NEVER edited by hand.\n\n    REGENERATE:\n        python3 scripts/gen_schema.py\n\n    TODO — GENERATE VOCABULARIES FROM THE ENGINE. Token vocabularies here are\n    still hand-copied from Rust (the `UserIntent` alias table in\n    `lunco_control_core::parse_user_intent` is the clearest case);\n    The generator keeps the two DERIVED FILES in sync, not the vocabularies.\n\n    NAMING. Every property lives under the `lunco:` namespace, sub-namespaced by\n    concern (`lunco:env:`, `lunco:terrain:`, `lunco:policy:`). Bare names are\n    forbidden — they collide with core schemas (a terrain layer's `size` collided\n    with `UsdGeomCube`'s real `double size`, which is precisely the bug this\n    library exists to prevent).\n\n    WHAT IS *NOT* HERE, BY DESIGN. A program's own parameters (a gain, a rest\n    altitude, a capacity) are not schema properties: they vary per program, so no\n    fixed schema can declare them. They are authored as that program's `inputs:`\n    ports — `float inputs:kv = 1.2` — the same namespace its wired ports use. A\n    parameter is simply an input with a constant instead of a connection. Only the\n    stable contracts the engine's projectors read by name belong in here.\n\n    A PROGRAM IS AN APPLIED CAPABILITY. Apply `LunCoProgramAPI` directly to the\n    physical prim when the program is intrinsic. For a separable behaviour, apply it\n    to an ordinary `Scope` child, so the program composes and can be removed without\n    changing the owner. The API carries the standard UsdShade-style implementation\n    properties and typed ports. Role is inferred from the source and public interface,\n    never declared separately.\n\n    EXTERNAL FILES ARE `asset`, ALWAYS. A path held in a `string` is inert: USD's\n    resolver cannot see it, and nothing that walks a layer for the files a scene\n    depends on — the reference closure, packaging, `usdzip` — will carry it. Four\n    component bindings in this project pointed at models that did not exist, one of\n    them a case-mismatch, and every one of them failed in silence.\n    "
    subLayers = [@usd/schema.usda@, @usdGeom/schema.usda@]
)

over "GLOBAL" (
    customData = {
    string libraryName = "luncoSchema"
    string libraryPath = "."
    bool skipCodeGeneration = true
    bool useLiteralIdentifier = true
}
)
{
}

class LunCoEnvironment "LunCoEnvironment" (
    inherits = </Typed>
    doc = "Scene-wide render settings that have no natural light-prim home —\n    exposure, bloom, ambient and earthshine. These apply to global/camera state\n    rather than to any one light, so they live on a dedicated singleton prim under\n    the stage's default prim instead of being smuggled onto a UsdLux light."
)
{
    float lunco:env:exposureEv100 (
        doc = "Optional authored camera exposure in EV100. When omitted, the\n        camera's authored exposure or the renderer's calibrated scene default\n        remains authoritative."
    )
    float lunco:env:bloomIntensity (
        doc = "Optional authored bloom intensity; 0 = off. When omitted, Graphics settings supply the renderer default."
    )
}

class "LunCoDomeAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "Scene-owned visibility intent for a standard UsdLux DomeLight. Renderer quality, including cubemap resolution, belongs to Graphics settings."
)
{
    bool lunco:dome:skybox = true (
        doc = "Whether a textured dome is visible as the camera sky; false keeps its image-based lighting but leaves the sky black."
    )
}

class "LunCoProceduralSkyAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "Marks an Xform as the scene's procedural camera background. Its appearance is authored by the bound UsdShade material; the background does not illuminate the scene."
)
{
}

class "LunCoPointerInteractionAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "Button-specific scene pointer behavior consumed by the shared interaction router."
)
{
    uniform token lunco:interaction:left = "block" (
        doc = "Primary-button behavior: block lower picks, pass through to lower geometry, or route to an authored context policy."
        allowedTokens = ["block", "pass_through", "context"]
    )
    uniform token lunco:interaction:right = "block" (
        doc = "Secondary-button behavior: block lower picks, pass through to lower geometry, or route to an authored context policy."
        allowedTokens = ["block", "pass_through", "context"]
    )
}

class "LunCoPhysicsInitializationAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "Selects an authored deterministic policy for admitting a USD rigid-body pose into physics."
)
{
    uniform token lunco:physics:initializationPolicy (
        doc = "Named selector passed to the declared physics.initialization Rhai policy. Apply this API and author a non-empty selector together; the policy receives stable USD identity and pose facts with the owning Twin lifecycle context."
    )
}

class LunCoPolicy "LunCoPolicy" (
    inherits = </Typed>
    doc = "A scripted authorization hook, expressed as a prim so that policy\n    distribution rides the normal USD/journal plane instead of a bespoke one: a\n    policy is authored, composed, journaled, undone and network-synced exactly\n    like any other scene edit."
)
{
    uniform string lunco:policy:seam = "" (
        doc = "The seam this policy governs (the extension point it hooks).\n        Uniform: a policy cannot change which seam it guards over time."
    )
    uniform string info:sourceCode = "" (
        doc = "The rhai source of the hook, authored INLINE. Editing it live\n        re-registers the hook. Inline source rides the USD journal plane — it is a\n        per-op edit that syncs and converges like any other doc op, so it is the form\n        for live/dynamic policy editing.\n\n        `uniform`, matching `LunCoProgramAPI`: implementation source is config-time\n        metadata, never time-sampled. Uniform constrains variability (no time\n        samples), not mutability — a live edit still lands as a default-value op.\n\n        `UsdShade`'s own property name, as on `LunCoProgramAPI`: a policy is a pluggable\n        implementation behind a named seam, which is the same shape of thing a shader\n        is. For a file-backed policy author `info:sourceAsset` instead; inline wins\n        when both are present."
    )
    uniform asset info:sourceAsset = @@ (
        doc = "File-backed alternative to `info:sourceCode`: an `@…rhai@` reference to\n        the hook's rhai source, loaded via the asset server (wasm-safe, hot-reloadable).\n\n        `asset`, not `string`. A script reference is a genuine asset: only an `asset` is\n        seen by USD's resolver and discoverable by the whole-twin **content plane**\n        (walked, CID-addressed, fail-closed verified), so the `.rhai` ships and every\n        peer resolves byte-identical source — the convergence a policy needs. Held as a\n        `string` the path would be inert. Inline `info:sourceCode` wins over this when\n        both are authored."
    )
    string lunco:policy:entry = "" (
        doc = "Entry-point function name within the source."
    )
    bool lunco:policy:deterministic = true (
        doc = "Whether the hook is pure. A non-deterministic policy cannot be\n        replayed from the journal, so it may not participate in rollback."
    )
}

class "LunCoTerrainAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "Marks a prim as a LunCoSim procedural/DEM terrain surface and carries\n    its build parameters.\n\n    This replaces an earlier `PhysxTerrainAPI`, which squatted NVIDIA's `Physx`\n    prefix for a schema NVIDIA does not define — an unregistered name pretending\n    to be a registered one."
)
{
    uniform token lunco:terrain:surfaceRole (
        doc = "Explicit local surface owner. \"flat-site\" projects an ENU-aligned UsdGeomPlane into the finite globe handoff footprint. The role is topology, not animation."
    )
    bool lunco:terrain:horizonShadows = false (
        doc = "Bake a horizon map so distant terrain self-shadows."
    )
    int lunco:terrain:horizonMapResolution = 0 (
        doc = "Terrain self-shadow heightfield bake resolution (side length; 0 = the runtime default of 512; positive values must be in [2, 4096])."
    )
    bool lunco:terrain:lodFrozen = false (
        doc = "Freeze CDLOD selection after first load — the cinematic-LOD hold:\n        the terrain keeps the tile set it first built instead of re-selecting per\n        camera move."
    )
}

class "LunCoTerrainLayerAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "One layer of a layered terrain — the composable unit the terrain\n    pipeline stacks (DEM ground, craters, rocks, hand edits). `lunco:layer` is the\n    discriminator; the `lunco:layer:*` properties are its parameters.\n\n    Every parameter is namespaced. They used to be authored bare (`x`, `z`,\n    `size`, `seed`), which is how a rock layer's `size` came to collide with\n    `UsdGeomCube`'s real `double size` property."
)
{
    uniform token lunco:layer = "" (
        doc = "Which layer kind this prim is: `dem`, `craters`, `rocks`,\n        `overzoom`, plus `rock` (one\n        hand-placed boulder) and `edit` (one brush edit). Uniform: a layer cannot\n        change kind over time."
        allowedTokens = ["", "dem", "craters", "rocks", "rock", "overzoom", "edit"]
    )
    asset lunco:layer:demSource = @@ (
        doc = "Path to the DEM source, resolved against the open document —\n        the `dem` (ground) layer.\n\n        `asset`, not `string`. A DEM source is a genuine asset reference: only an\n        `asset` is seen by USD's resolver and discoverable by anything that walks a\n        layer for the files a scene depends on — asset-sync's reference closure,\n        packaging, `usdzip`. Held as a `string` the DEM travelled nowhere."
    )
    float lunco:layer:windowM = 0.0 (
        doc = "Side length of the DEM patch, in metres; zero means the whole map."
    )
    int lunco:layer:targetRes = 0 (
        doc = "Target visual heightfield resolution per side; zero keeps native resolution."
    )
    int lunco:layer:colliderDepth (
        doc = "Physics-only collider-ring quadtree depth. Omitted uses the terrain physics default; authored values must be in the supported positive range. Independent of visual LOD."
    )
    int lunco:layer:colliderResolution (
        doc = "Physics-only collider-ring heightfield samples per tile side. Omitted uses the terrain physics default; authored values must be in the supported range. Independent of visual LOD."
    )
    bool lunco:layer:lodViz = true (
        doc = "Whether to build the visual CDLOD mesh."
    )
    bool lunco:layer:colliderRing = true (
        doc = "Build colliders only in a ring around the origin rather than\n        across the whole patch."
    )
    float lunco:layer:x = 0.0 (
        doc = "Terrain-local X (metres) — hand-placed instance layers."
    )
    float lunco:layer:z = 0.0 (
        doc = "Terrain-local Z (metres) — hand-placed instance layers."
    )
    float lunco:layer:size = 0.6000000238418579 (
        doc = "Instance radius, metres."
    )
    int64 lunco:layer:seed = 0 (
        doc = "Deterministic scatter/noise seed."
    )
    float lunco:layer:density = 0.0 (
        doc = "Scatter density, instances per hectare (10 000 square metres)."
    )
    float lunco:layer:sizeMin = 0.0 (
        doc = "Minimum scattered instance size, metres."
    )
    float lunco:layer:sizeMax = 0.0 (
        doc = "Maximum scattered instance size, metres."
    )
    float lunco:layer:sizeMode = 0.0 (
        doc = "Mode of the scattered size distribution."
    )
    bool lunco:layer:enabled = true (
        doc = "Whether this authored terrain layer contributes to the composed surface."
    )
    float lunco:layer:amplitude = 0.0 (
        doc = "Noise amplitude, metres."
    )
    float lunco:layer:depthRatio = 0.0 (
        doc = "Crater depth as a fraction of its radius."
    )
    float lunco:layer:rimRatio = 0.0 (
        doc = "Crater rim height as a fraction of its radius."
    )
    float lunco:layer:minFeature = 0.0 (
        doc = "Smallest generated feature, metres."
    )
    float lunco:layer:maxFeature = 0.0 (
        doc = "Largest generated feature, metres."
    )
    float lunco:layer:regionM = 0.0 (
        doc = "Optional scatter half-extent in metres; zero or omission covers the whole composed terrain."
    )
    float lunco:layer:reliefScale = 0.0 (
        doc = "Vertical relief scale factor."
    )
    float lunco:layer:dynamicFrac = 0.0 (
        doc = "Fraction of scattered instances that are dynamic rigid bodies."
    )
    asset lunco:layer:regionalDemSource = @@ (
        doc = "Registered regional elevation asset; its lunar frame and projection must match the local DEM."
    )
    double lunco:layer:regionalBlendM = 0.0 (
        doc = "Width in metres of the transition outside the local DEM footprint."
    )
    double lunco:layer:regionalHeightOffsetM = 0.0 (
        doc = "Vertical offset in metres applied to the regional DEM to align its datum with the local DEM."
    )
    uniform token lunco:layer:localFrame = "" (
        doc = "Explicit lunar frame for the local DEM when its GeoTIFF does not encode one."
    )
}

class "LunCoShadowAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "The near/far split of a cascaded shadow map, for a UsdLux light.\n\n    Everything UsdLux CAN say, it says: shadow enable/colour and the far bound\n    are `UsdLuxShadowAPI` (`inputs:shadow:enable`, `inputs:shadow:distance`),\n    and the loader reads those. What is left is the cascade split itself — a\n    rasterizer technique UsdLux has no concept of — so it takes a renderer\n    namespace the way `ri:` / `karma:` / `arnold:` do.\n\n    Cascade COUNT and the depth/normal biases are deliberately absent: they are\n    persisted renderer settings in the Graphics section, not scene content. An\n    authored value for them would describe this renderer rather than the light;\n    the Graphics settings provide the renderer-wide defaults."
)
{
    float lunco:shadow:firstCascadeFarBound (
        doc = "Far bound of the first (highest-resolution) cascade, metres. Omitted values use the persisted Graphics setting."
    )
}

class "LunCoLightAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "Engine-side falloff for a local UsdLux light.\n\n    UsdLux has no attenuation-cutoff concept: a `SphereLight`/`DiskLight` falls off\n    physically and forever, which is correct for a path tracer and unusable for a\n    real-time renderer that must bound each light's influence volume. So the cutoff\n    is ours, namespaced as such rather than invented into the `inputs:` namespace\n    UsdLux already owns.\n\n    Declaring it here is what lets an asset author it WITHOUT `custom`: a\n    non-`custom` attribute that no schema defines is exactly what `usdchecker`\n    flags. Several rover assets still carry the un-declared form — see\n    38-domains-as-packages.md."
)
{
    float lunco:light:range = 0.0 (
        doc = "Attenuation cutoff radius, metres. 0 = engine default."
    )
}

class "LunCoCatalogAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "Marks a `*.usda` as a **spawnable part** — something the editor offers\n    in its palette and drops into the scene.\n\n    Applied to the stage's `defaultPrim`, because the unit of spawning is the FILE:\n    the catalogue asks each asset whether it is a part, and spawning it mounts its\n    default prim.\n\n    The human-readable \"what is this thing\" blurb is the prim's `doc` metadata, which\n    every prim already carries and which usdview and every other DCC already display."
)
{
    uniform bool lunco:spawnable = false (
        doc = "Whether this asset is a spawnable part. Opt-in: a default that has to\n        be disclaimed everywhere is a default that leaks.\n\n        Uniform: an asset does not stop being a part partway through a shot."
    )
}

class "LunCoCelestialBodyAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "Declares a natural celestial body whose pose and rotation are evaluated from the selected scene epoch. Referencing the solar-system asset opts a scene into its Sun, Earth, and Moon prims; ordinary scenes remain unchanged. Spatial frames and scene projections derive from those authored prims."
)
{
    uniform int lunco:body = 0 (
        doc = "NAIF id of the body this prim represents: `10` Sun, `399` Earth,\n        `301` Moon.\n\n        The NAIF id is the join key to the ephemeris provider (VSOP2013/ELP), to\n        `lunco:anchor:body` on a geodetic site, and to `lunco:orbit:body` on a Kepler\n        orbit — the same vocabulary already used across the celestial schemas, so a\n        scene never has to name a body twice in two different spellings.\n\n        Uniform: a prim does not become a different planet partway through a shot.\n        `0` is not a body — it means \"unset\", and such a prim is ignored."
    )
    asset lunco:body:albedoMap = @@ (
        doc = "Surface map this body wears — an ordinary asset reference,\n        resolved by the same schemes as any other (`@lunco://textures/earth.png@`,\n        `@twin://myschool/textures/earth_1970.png@`).\n\n        Which map a body wears is scene content, so a Twin dresses its own Earth\n        without touching the engine's manifests. Unset is a complete state, not a\n        broken one: the body falls back to the imagery declared in\n        `assets/manifests/celestial.toml` (if that dataset is installed), and then\n        to its own colour — ocean blue, regolith grey.\n\n        For anything richer than an albedo map — a custom shader, extra inputs —\n        bind a `UsdShade` Material to this prim instead. That path already exists\n        and outranks this one, which in turn outranks the manifest default."
    )
}

class "LunCoLinkAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "Declares that a prim is a connectivity endpoint — a node in the generic\n    link graph (doc 49).\n\n    **There is no comms schema here, deliberately.** A node is a node: the kernel\n    computes the GEOMETRY between pairs (range, local elevation, body occlusion,\n    terrain relief, authored occluders) and publishes it. What that geometry MEANS —\n    whether it counts as a usable link, what relays where, what the budget is — is\n    authored policy over the `link.connected` hook and `scripting/prelude/links.rhai`,\n    not vocabulary in this file. An `Antenna` prim type or a `lunco:comms:margin`\n    attribute existed once and was deleted; author roles over this instead.\n\n    A node's placement is orthogonal and already spelled elsewhere: a ground station\n    adds `lunco:anchor:*` (geodetic), a relay adds `lunco:orbit:*` (Kepler), and a\n    rover-mounted antenna adds neither — it is a scene-local prim posed through the\n    site frame. A satellite needs no new concept.\n\n    A node's IDENTITY is its prim's GID, not anything here. `lunco:link:class` is a\n    shared role and is explicitly NOT an identifier: three DSN complexes all author\n    `class = \"earth\"` and remain three distinct nodes, grouped under one role."
)
{
    uniform bool lunco:linkNode = false (
        doc = "Marks this prim a link endpoint. The kernel pairs it with every\n        other node at the `LinkConfig` cadence and publishes a `LinkState`."
    )
    string lunco:link:class = "" (
        doc = "The node's authored ROLE — `\"relay\"`, `\"earth\"`, `\"rover\"`, `\"base\"`.\n\n        The exact, case-sensitive label is passed to verdict/routing policy and used\n        to GROUP nodes (`query(\"Links\").groups`), so a script can ask \"can this rover\n        reach any Earth station?\" without naming one. It is not a node identity and\n        repeated labels intentionally denote the same routing group.\n\n        Scalar USD/Modelica ports use `link_<class>_<quantity>`. The port adapter\n        preserves lowercase ASCII letters and digits and encodes every other Unicode\n        character as `_uXXXX_`; it does not lowercase or collapse distinct labels.\n        Thus `earth` stays `link_earth_range_m`, while `Earth` and `deep space` keep\n        distinct public port names."
    )
    double lunco:link:maxRangeM = 1000000000000.0 (
        doc = "Hard geometric range cutoff, metres. Beyond it the builtin verdict\n        reports the link down.\n\n        This is GEOMETRY, not a link budget: there is no power, frequency, antenna\n        gain or noise temperature anywhere in the core, and this value is not derived\n        from any. A real budget is authored policy over the published `range_m` (and\n        `light_time_s`), or a Modelica component — see doc 49 §8."
    )
    double lunco:link:minElevationDeg = -90.0 (
        doc = "Elevation mask, degrees above this node's local horizon. A peer below\n        it is refused. `5` is realistic for a DSN dish; the default `-90` masks\n        nothing. A node with no local horizon (a free orbit) always passes."
    )
}

class "LunCoWifiAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "Declares a short-range rover radio endpoint.\n\n    This graph is deliberately separate from `LunCoLinkAPI`: the generic link\n    kernel publishes geometry, while the Wi-Fi projection applies this endpoint\n    range and exposes its own `WifiLinks` snapshot. It does not alter the\n    authored direct-link policy for Earth stations, lunar bases, or relays."
)
{
    uniform bool lunco:wifiNode = false (
        doc = "Marks this prim as an endpoint in the separate Wi-Fi graph."
    )
    double lunco:wifi:maxRangeM = 5000.0 (
        doc = "Maximum symmetric radio range for this endpoint, in metres."
    )
}

class "LunCoOccluderAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "Declares that a prim's geometry BLOCKS sight-lines: any link whose segment\n    crosses its box is severed (doc 49).\n\n    Generic, like everything else here — it says nothing about radio. A sensor, radar\n    or sunlight domain composes over the same fact.\n\n    **Deliberately separate from `PhysicsCollisionAPI`.** Opacity is a MATERIAL\n    property, not a collision one: a radio-transparent handrail has a collider and\n    must not block, and a radio-opaque radome may have no collider at all. Deriving\n    one from the other is wrong in both directions, so a prim says both or either.\n\n    The consequence is that occlusion is OPT-IN: an untagged wall does not block. That\n    is intended — name the geometry that is opaque.\n\n    Apply it to the GEOMETRY prim that does the blocking (the child `Cube`), not its\n    parent `Xform`, so the box inherits that prim's pose, scale and extent.\n\n    **The occluding box carries no vocabulary of its own.** It is the prim's UsdGeom\n    `extent` — \"a three dimensional range measuring the geometric extent of the\n    authored gprim in its own local space\" — which core USD already defines and every\n    DCC already authors. A `lunco:occluder:halfExtentsM` was drafted here and deleted:\n    it would have been a second, private spelling of a standard attribute, free to\n    disagree with the geometry it claims to bound.\n\n    With no authored `extent`, the box falls back to the unit-cube convention (a `Cube`\n    of `size = 1` scaled by `S` ⇒ half-extents `S/2`), which is how `props/wall.usda`\n    and the sandbox slabs are written — so tagging an existing prop is one line and no\n    measurements, and re-scaling an instance moves its shadow with the geometry."
)
{
    uniform bool lunco:occluder = false (
        doc = "Marks this prim's geometry opaque to link sight-lines. The ONE fact\n        USD has no word for; the shape it refers to is the standard `extent`."
    )
}

class "LunCoTerrainEditAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "ONE hand edit to a terrain surface — a brush, a flatten, or a crater.\n    Applied to an edit prim (`lunco:layer = \"edit\"`), a child of the terrain; the\n    edits fold, in path order, into the terrain's composed height."
)
{
    uniform token lunco:edit:kind = "" (
        doc = "Which edit this is. Uniform: an edit does not change kind over time.\n        `brush` displaces by `lunco:edit:amount`; `flatten` blends toward it as a\n        target height; `crater` excavates to it as a depth."
        allowedTokens = ["", "brush", "flatten", "crater"]
    )
    double2 lunco:edit:center = (0.0, 0.0) (
        doc = "Centre in terrain-local XZ, metres."
    )
    double lunco:edit:radius = 0.0 (
        doc = "Radius of effect, metres."
    )
    double lunco:edit:amount = 0.0 (
        doc = "The kind's single scalar: brush amplitude, flatten target height, or\n        crater depth — all metres."
    )
}

class "LunCoProgramAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "ONE program capability applied to a prim — a Modelica plant, a Rhai\n    controller, or a Python model. Apply it directly to a physical\n    prim when the program is intrinsic. For separable behaviour, apply it to an\n    ordinary `Scope` child; the scope supplies namespace and composition identity\n    while this API supplies the program contract. No custom concrete prim type is\n    needed.\n\n    ROLE IS NEVER DECLARED, because it cannot be. The same `.py` is a plant on one prim\n    and a script on the next; a rhai program can integrate state as readily as it can\n    answer an event; one program can do both at once. What a program DOES is derived\n    from what it declares — a program with `inputs:`/`outputs:` ports is a node in the\n    port graph and is stepped; a program without them runs for its effects alone. Once\n    `info:implementationSource` selects `info:sourceAsset`, the engine that runs it\n    comes from that asset's extension, exactly as USD chooses a file format plugin by\n    `.usda` / `.usdc` / `.usdz`.\n\n    PARAMETERS ARE PORTS. A gain is `float inputs:kv = 1.2` — an input with a constant\n    instead of a connection. Wire it later and nothing about the program changes.\n\n    INTERFACES HAVE THREE KINDS. `inputs:` / `outputs:` are causal scalar signals and\n    travel through the runtime port registry. `connectors:` are acausal physical\n    interfaces: they are valid only for Modelica programs collected into one compiler\n    network, where generated `connect()` equations enforce conservation laws. A\n    connector is never a runtime scalar port. Discrete conditions project through\n    `LunCoEvent`, not either port kind.\n\n    Which placement to use is not a style question, it is whether the program is separable\n    from the thing. A vessel's flight-control system is its airframe: it is what the\n    stick talks to, its `inputs:` ARE the vessel's control surface, and a lander\n    without it is not a lander with no engine. A guidance law or supervisory script\n    is bolted on as a `Scope` child applying `LunCoProgramAPI` and arriving on its own\n    `references` arc: delete the prim and the policy is gone, while the physical\n    model remains intact."
)
{
    uniform token info:implementationSource (
        doc = "Which property carries this program: a name the runtime already\n        implements (`info:id`), an external file (`info:sourceAsset`), or text\n        authored in place (`info:sourceCode`).\n\n        The selected arm is authoritative: exactly one of these implementation\n        arms may be populated. A populated non-selected arm is an authoring\n        conflict, not a fallback.\n\n        These are `UsdShade`'s OWN property names, not a lunco spelling of them.\n        `UsdShadeShader` asks exactly this question of a shader and carries exactly\n        these three answers; a program is the same shape of thing — a pluggable\n        implementation behind typed `inputs:`/`outputs:` — so it uses the same\n        properties."
        allowedTokens = ["id", "sourceAsset", "sourceCode"]
    )
    uniform token info:id = "" (
        doc = "A program the runtime ALREADY implements, named rather than supplied\n        — `\"range_beam\"`, `\"skid\"`. Resolved against an open registry of Rust drivers,\n        exactly as `info:id = \"UsdPreviewSurface\"` names a shader every renderer is\n        expected to have rather than shipping its source.\n\n        This is the case `info:sourceAsset`'s extension rule cannot cover:\n        there is no source, so there is no extension to dispatch on. A built-in wins\n        over a script hook of the same name, and an id nothing implements is a\n        fail-safe no-op with a warning — never a hard error, because a scene authored\n        against a newer runtime must still open in an older one.\n\n        The registry is open: a crate registers a driver, USD SELECTS it. Adding a\n        visualization is registering a name, not editing a schema."
    )
    uniform asset info:sourceAsset = @@ (
        doc = "The program's file — `@models/Lander.mo@` or\n        `@scenarios/route_follow.rhai@`.\n\n        `asset`, never `string`. Only an `asset` is visible to USD's resolver and to\n        anything that walks a layer for the files a scene depends on — the reference\n        closure, packaging, `usdzip`. A path smuggled in a `string` names a file that\n        does not travel with the scene, and cannot even be checked for existence."
    )
    uniform string info:sourceCode = "" (
        doc = "The program's text, authored in place instead of in a file. This is\n        the live-authoring path: an edit to it is an ordinary attribute edit, so it\n        journals, undoes, and replicates like every other edit."
    )
    uniform token info:sourceAsset:subIdentifier = "" (
        doc = "WHICH definition inside the source, when the file holds more than one\n        — a `.mo` that declares several models, a `.rhai` with several entry points.\n        Empty means the file's single definition, and a file with exactly one needs\n        nothing here.\n\n        Named for `UsdShade`'s `info:sourceAsset:subIdentifier`, which exists for the\n        same reason: an MDL module can define several shaders, so the prim has to say\n        which of them it means. A file path alone is not an identity."
    )
    uniform bool lunco:program:realtimeSafe = false (
        doc = "Whether this program steps fast enough to be trusted with a FORCE:\n        only a realtime-safe program may drive a `force_*` / `torque_*` port on a body\n        the client PREDICTS.\n\n        A model that takes 40ms to step, wired into a predicted body, diverges from\n        the server every frame it is late — so driving physics is a promise the author\n        makes, not a property the engine can read off the source. `false` (the default,\n        and what an unauthored program gets) means the wiring pass refuses it a force\n        port and says why.\n\n        Programs that never touch physics — a supervisory script, a battery model —\n        leave this alone. It is not a quality rating."
    )
    uniform double lunco:program:communicationPeriod = 0.016666666666666666 (
        doc = "Simulation seconds between Modelica co-simulation communication\n        points. Inputs are sampled and outputs are published at each point; the\n        last output is held between points. This is a simulation-time period, not\n        a wall-clock sleep and not a render-frame rate. The default is one\n        master physics tick (1/60 second). Longer integer multiples of the\n        master tick explicitly select multirate, zero-order-held exchange."
    )
}

class "LunCoModelicaTopologyAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "Presentation metadata for a Modelica physical component inside a generated\n    topology. This is not a solver direction and it does not change Modelica equations:\n    acausal `flow` variables remain reversible. It tells a presentation policy which\n    side of a visual bus best explains an authored component's intended domain role.\n\n    `source` is a component that normally supplies the connected network, `storage` is\n    a component that can absorb or supply and is preferred as a visual hub, `load` is a\n    component that normally consumes the network, and `neutral` carries no directional\n    presentation preference. The value is deliberately separate from `LunCoProgramAPI`:\n    a program's execution role is derived from its declared ports, while this contract\n    is an optional domain-presentation fact for a Modelica component."
)
{
    uniform token lunco:modelica:topologyRole = "neutral" (
        allowedTokens = ["source", "storage", "load", "neutral"]
        doc = "Presentation role consumed by the selected Rhai Modelica synthesis\n        policy. It never becomes a causal Modelica equation or a runtime source/sink\n        assertion. Omit the API for a component with no useful side preference."
    )
}

class "LunCoEnvironmentProbeAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "Marks a transform as an explicit source of local environmental\n    signals. The prim's transform is the gravity and direction-probe origin.\n    Environment systems publish fixed f64 gravity outputs; direction outputs are\n    materialized from authored source-id connections and resolved for each probe.\n\n    A probe is a source, never a solver and never a consumer. Keeping it on a\n    distinct prim avoids the old consumer self-wire pattern, makes the provider\n    visible in the scene graph, and prevents ordinary wiring diagnostics from\n    mistaking environmental injection for algebraic feedback."
)
{
    double outputs:gravity_accel = 0.0 (
        doc = "Local gravitational acceleration magnitude, m/s2."
    )
    double outputs:gravity_x = 0.0 (
        doc = "Local gravitational acceleration X component, m/s2."
    )
    double outputs:gravity_y = 0.0 (
        doc = "Local gravitational acceleration Y component, m/s2."
    )
    double outputs:gravity_z = 0.0 (
        doc = "Local gravitational acceleration Z component, m/s2."
    )
    double outputs:sun_visibility (
        doc = "Fraction of authored probe sampling points with clear Sun-centre rays through admitted terrain and selected optical proxies, 0..1. Independent of panel incidence and direct-normal irradiance."
    )
    double outputs:sun_irradiance_w_m2 (
        doc = "Physical direct-normal solar irradiance, W/m2, before terrain or equipment occlusion and panel incidence. Missing source data publishes no sample."
    )
}

class "LunCoDirectionTargetAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "Assigns a stable identifier to a position-bearing target for environment\n    direction inputs. An EnvironmentProbe connected to `<id>_mount_x/y/z` computes the\n    direction from its own origin to this prim's composed position through BigSpace.\n    The id is lower-case ASCII with digits and underscores, and must identify exactly\n    one target in the active scene. Apply this API to non-celestial objects; a\n    `LunCoCelestialBodyAPI` target uses its stable `lunco:body` NAIF identity. This API\n    defines identity only; it does not cache a direction or provide coordinate\n    conversion."
)
{
    uniform token lunco:directionTarget:id = "" (
        doc = "Stable source id used as the stem of `<id>_mount_x/y/z` direction ports."
    )
}

class LunCoEvent "LunCoEvent" (
    inherits = </Typed>
    doc = "A connected discrete signal projected onto the engine's TelemetryEvent\n    bus. The physical condition belongs to the producing model; this prim only binds\n    that output to an engine event name. One prim per event."
)
{
    float inputs:trigger = 0.0 (
        doc = "A 0/1 discrete signal connected from the producing model output."
    )
    uniform token lunco:event:name = "" (
        doc = "The TelemetryEvent name emitted on the trigger's rising edge."
    )
    uniform token lunco:event:severity = "info" (
        allowedTokens = ["debug", "info", "warning", "error", "critical"]
        doc = "Telemetry severity."
    )
    uniform bool lunco:event:latched = false (
        doc = "When true, emit once on the first rising edge and do not re-arm until the scene reloads."
    )
    uniform double lunco:event:qualificationTime = 0.0 (
        doc = "Continuous time in seconds that the trigger must remain active before the event is emitted. A false sample resets qualification."
    )
}

class "LunCoAvatarAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "Marks the prim that represents the scene's local avatar role."
)
{
    uniform bool lunco:avatar = false (
        doc = "Whether this prim is the scene's local avatar role."
    )
}

class "LunCoCameraAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "Declares a standard UsdGeomCamera's LunCo runtime role and sole pose authority. Apply to every camera that participates in a LunCo scene."
)
{
    double3 lunco:cameraLookAt (
        doc = "Optional parent-local point this standard camera faces."
    )
    uniform token lunco:cameraRole = "viewport" (
        allowedTokens = ["viewport", "sensor"]
        doc = "viewport participates in the main workbench view; sensor is an instrument camera and never becomes a window-view candidate."
    )
    uniform token lunco:cameraPose = "authored" (
        allowedTokens = ["authored", "mounted"]
        doc = "The sole pose authority. authored keeps USD hierarchy/animation; mounted is a rigid grid-direct follower of this camera's authored parent."
    )
}

class "LunCoSuspensionAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "The rest length of a LunCo raycast suspension. Applied to a suspension\n    prim alongside `PhysxVehicleSuspensionAPI`, whose spring/damper attrs carry the\n    rest of the compliance (see `assets/components/mobility/suspensions/*.usda`).\n\n    LunCo extension: PhysX's `PhysxVehicleSuspensionAPI` has no `restLength` — it\n    models travel as `travelDistance` + `sprungMass` — but the raycast wheel\n    integrator needs a rest length to solve Hooke's law."
)
{
    float lunco:suspension:restLength (
        customData = {
    double max = 2.0
    double min = 0.0
    string unit = "m"
}
        doc = "Natural standoff of a raycast wheel below its mount, metres — the\n        distance at which the analytical spring exerts zero force. `float`, like the\n        `physxVehicleSuspension:*` attrs it sits beside (and like the\n        `travelDistance` it stands in for). Read by `resolve_suspension_params`\n        (lunco-usd-sim); required for raycast wheels (doc 53 §4), and declared with\n        no fallback so an unauthored rest length is an error, not a 0.7 m guess."
    )
}

class "LunCoJointDampingAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "Relative-velocity damping on an authored UsdPhysics joint.\n    OpenUSD defines joint topology, limits, and drives, but no passive bearing\n    damping shared across joint types. Avian provides that solver primitive as\n    JointDamping. This API exposes it without turning a passive ball fitting into\n    a motor or applying drag to either rigid body in the world frame."
)
{
    float lunco:jointDamping:linear = 0.0 (
        customData = {
    double min = 0.0
    string unit = "1/s"
}
        doc = "Rate at which relative linear velocity is dissipated by the joint. Zero leaves allowed translational motion undamped."
    )
    float lunco:jointDamping:angular = 0.0 (
        customData = {
    double min = 0.0
    string unit = "1/s"
}
        doc = "Rate at which relative angular velocity is dissipated by the joint. Zero leaves allowed rotation undamped."
    )
}

class "LunCoWheelAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "The per-wheel knobs LunCo's wheel integrator needs and PhysX does not\n    model. Applied to a vehicle wheel prim alongside\n    `PhysxVehicleWheelAttachmentAPI`; `PhysxVehicleWheelAPI` carries the wheel's\n    dimensions and spin dynamics. The reusable hub in\n    `assets/components/mobility/wheel.usda` authors the values, while the vehicle\n    instance owns the standard wheel/attachment API because it also owns the\n    selected suspension, tire, and attachment index.\n\n    NO FALLBACKS. Every property here is declared without a default and must be\n    authored — `wheel.usda` authors them all, so every wheel on every rover has\n    them by composition. They were previously `unwrap_or(...)` constants in the\n    Rust loader, which meant the authored asset was not the source of truth and an\n    unauthored knob was indistinguishable from a deliberate one."
)
{
    double3 lunco:wheel:headingAxis (
        doc = "Wheel-heading axis, wheel-local. `(0, 1, 0)` is a vertical yaw\n        axis (cars); a raked fork authors e.g. `(0, 0.91, 0.42)` for ~25°."
    )
}

class "LunCoTireAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "Evidence envelope for the tire's steady-state force curve. Physical\n    grip remains standard UsdPhysicsMaterialAPI authoring; this API carries only\n    the validation bound that neither UsdPhysics nor PhysxVehicleTireAPI represents."
)
{
    float lunco:tire:minValidatedSpeed = 0.0 (
        customData = {
    double max = 10.0
    double min = 0.0
    string unit = "m/s"
}
        doc = "Lowest longitudinal speed at which the authored steady-state\n        cornering-stiffness curve was validated. Below it, slip-angle evaluation\n        holds the denominator at this evidence boundary instead of extrapolating\n        the curve into its singular zero-speed regime. Zero explicitly means the\n        model is valid to rest."
    )
}

class "LunCoSuspensionVisualAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "Marks a prim as a moving part of a suspension strut's VISUAL, so the\n    mobility animation system can drive it from the live compression. Applied to the\n    piston/spring subcomponents of a suspension\n    (`assets/components/mobility/suspensions/standard.usda`). The `casing` role\n    identifies static housing that remains mounted to a rigid carrier when the\n    wheel itself is projected as a spinning rigid body.\n\n    LunCo extension: the PhysX vehicle schema is physics-only — it has no notion of\n    a strut's visual parts."
)
{
    uniform token lunco:suspensionVisual:role (
        doc = "Which moving part this prim is. `\"piston\"` ⇒ the prim is stamped\n        with a `SuspensionPiston` Bevy component (translates along the travel axis);\n        `\"spring\"` ⇒ a `SuspensionSpring` component (scales along the travel axis);\n        `casing` is carrier-mounted static geometry and receives no animation.\n        A `kind` token is NOT used for this — `kind` is USD's regulated model\n        taxonomy (component/assembly/subcomponent), and \"piston\"/\"spring\" are not\n        valid kinds. Read at load by `process_usd_sim_prim_read` (lunco-usd-sim).\n        No fallback and no `\"\"`: applying the API IS the claim to be a moving part,\n        so there is no such thing as a roleless one."
        allowedTokens = ["casing", "piston", "spring"]
    )
}

class "LunCoMassContributionAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "A physical child mass that a reduced realization folds into its owning rigid body while a full realization projects as its own body. The mass itself remains authored through standard PhysicsMassAPI properties."
)
{
}

class "LunCoControlBindingAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "ONE intent→port binding — a child prim of a vessel's `Controls`\n    scope, named for the [`UserIntent`] it binds (`forward`, `steer`, …). While\n    that intent is active it contributes `factor` per unit intent to the named\n    input port. Read by the control-binding loader (lunco-usd-bevy); shared\n    profiles live in `assets/components/control_profiles.usda` and arrive on\n    vessels by `subLayers` + `inherits`."
)
{
    uniform string lunco:port = "" (
        doc = "The vessel input port this intent drives (`\"throttle\"`,\n        `\"pitch\"`). Uniform: a binding does not retarget over time.\n\n        This is a string because vessel port names are an open authoring\n        vocabulary, not a closed USD token set. The runtime compares the\n        composed value with the vessel's declared port registry."
    )
    uniform double lunco:factor = 1.0 (
        doc = "Port contribution per unit intent — sign flips an axis, magnitude\n        is sensitivity."
    )
    uniform token lunco:cameraFollow = "" (
        doc = "Follow mode the camera adopts when this vessel is possessed —\n        authored on the `Controls` scope itself, not a binding child. The\n        canonical values are `heading`, `orbit`, and `chase`; empty means the\n        engine default. Values outside this closed set are rejected by the\n        reader. A new value must be added here and to the reader together."
        allowedTokens = ["", "heading", "orbit", "chase"]
    )
}

class "LunCoTriggerZoneAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "Applying this API marks a prim's geometry as an overlap-only static\n    sensor volume. The physics loader (lunco-usd-avian) gives it a static\n    collider and a `Sensor`, so it detects overlaps and blocks nothing. The\n    optional trigger-zone token labels named geofence events; it does not opt\n    the prim into sensor behavior."
)
{
    token lunco:triggerZone = "" (
        doc = "Optional name for this sensor's geofence events. When non-empty,\n        the physics runtime also emits `enter:<zone>` / `exit:<zone>` events.\n        Empty means generic sensor events only; applying LunCoTriggerZoneAPI is\n        what enables overlap sensing.\n\n        `token`: the name is an IDENTIFIER — it is compared in Rhai, never\n        presented as prose. Open vocabulary — a scene names its own zones — so\n        no `allowedTokens`."
    )
}

class "LunCoAssetAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "How a prim backed by an external binary asset (glTF payload) or a\n    built terrain projects into the engine.\n\n    The standard USD payload/reference remains the asset identity. The runtime\n    render projection reads that authored arc from the composed prim stack and\n    passes its canonical URI to the native glTF loader."
)
{
    string lunco:assetMode = "scene" (
        doc = "How the asset/prim realizes: `scene` (whole glTF scene) | `mesh`\n        (one named mesh primitive) — or, on a terrain root, `dem` | `layered`\n        (build a heightfield from the child layer prims instead)."
    )
    string lunco:assetLabel = "" (
        doc = "Sub-asset label inside the binary asset (`\"Mesh0/Primitive0\"`),\n        for `lunco:assetMode = \"mesh\"`. Empty = the loader's default label."
    )
    bool lunco:placeholder = false (
        doc = "This prim's primitive mesh is a stand-in that hides once the real\n        (glTF) visual finishes loading."
    )
}

class "LunCoBillboardAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "A floating text label over the prim. Opt-in: only a prim that\n    authors `lunco:billboard = true` gets one, so adding this schema can never\n    make an existing scene sprout labels."
)
{
    bool lunco:billboard = false (
        doc = "Whether this prim shows a billboard label."
    )
    string lunco:billboard:text = "{label}" (
        doc = "Label template; `{label}` expands to the prim's display name."
    )
    float lunco:billboard:offsetY = 3.0 (
        doc = "Label height above the prim origin, metres."
    )
    float lunco:billboard:fadeEnd = 1200.0 (
        doc = "Camera distance at which the label has fully faded out, metres."
    )
}

class "LunCoNetAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "Per-prim multiplayer replication overrides. Absent means the engine's\n    defaults — replicated, server-authoritative."
)
{
    bool lunco:net:replicate = true (
        doc = "`false` excludes this prim from network replication entirely."
    )
    string lunco:net:authority = "" (
        doc = "Authority override. The engine reads it for opacity markers\n        (a prim another peer owns is not client-predictable); empty = server."
    )
}

class "LunCoRaycastAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "A mounted single-ray Avian query. The runtime publishes only the\n    raw hit observation; Modelica or another authored consumer decides what that\n    observation means."
)
{
    double3 lunco:raycast:offset = (0.0, 0.0, 0.0) (
        doc = "Ray origin offset in the mounted prim's local frame, metres."
    )
    float lunco:raycast:maxDistance = 100.0 (
        doc = "Maximum distance passed to the Avian ray query, metres."
    )
    token lunco:raycast:axis = "-Y" (
        doc = "Body-local direction of the single Avian ray."
        allowedTokens = ["X", "-X", "Y", "-Y", "Z", "-Z"]
    )
}

class "LunCoTelemetryAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "ONE authored telemetry channel — a prim opting a port (or a reflected\n    component field) into the telemetry ring buffer. See\n    docs/architecture/telemetry-subsystem.md."
)
{
    bool lunco:telemetry = false (
        doc = "Whether this prim authors a telemetry channel."
    )
    string lunco:telemetry:name = "" (
        doc = "Channel display name. Empty = the source's own name."
    )
    string lunco:telemetry:port = "" (
        doc = "Source: a runtime port on this prim. Wins over `reflect`."
    )
    string lunco:telemetry:reflect = "" (
        doc = "Source: a reflected component field path, when no port is named."
    )
    string lunco:telemetry:unit = "" (
        doc = "Display unit string; empty = unitless."
    )
    string lunco:telemetry:description = "" (
        doc = "Human-facing explanation shown with the retained signal."
    )
    rel lunco:telemetry:target (
        doc = "Measured prim. Omitted means the declaration's own prim; exactly one target is allowed."
    )
    double lunco:telemetry:rateHz = 0.0 (
        doc = "Sampling rate, Hz. 0/unauthored = the engine's default cadence."
    )
    bool lunco:telemetry:enabled = true (
        doc = "Whether the channel records. An authored channel is a live one:\n        you turn it off by saying so, not by forgetting to say anything."
    )
    double lunco:telemetry:deadband = 0.0 (
        doc = "Change threshold below which a sample is not recorded. 0 = record all."
    )
    int64 lunco:telemetry:retention = 0 (
        doc = "Ring-buffer sample count to retain. 0/unauthored = engine default."
    )
}

class "LunCoAnchorAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "A geodetic anchor — pins the prim to a latitude/longitude/height on a\n    celestial body. On a scene's ROOT prim it is the scene's site frame\n    (`SiteAnchor`); on any other prim it is a ground station or surface asset.\n    A relay in space authors `lunco:orbit:*` instead; a rover-mounted antenna\n    authors neither. Also read by the terrain pipeline as the DEM georeference\n    (the body's radius folds into the surface oracle as curvature)."
)
{
    int lunco:anchor:body = 301 (
        doc = "NAIF id of the anchoring body — the same join key as `lunco:body`\n        and `lunco:orbit:body`. The default is the Moon."
    )
    double lunco:anchor:lat = 0.0 (
        doc = "Planetodetic latitude, degrees."
    )
    double lunco:anchor:lon = 0.0 (
        doc = "Planetodetic longitude, degrees east."
    )
    double lunco:anchor:height = 0.0 (
        doc = "Height above the reference surface, metres."
    )
}

class "LunCoEpochAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "Optional TDB epoch override for the selected scene. The scene-time startup policy reads it only after scene loading and projection settle; when absent or invalid, that policy selects current computer UTC converted to TDB."
)
{
    double lunco:time:epochJd (
        doc = "Optional absolute scene epoch in Julian days (TDB). A valid authored value overrides computer time; when omitted or invalid, the scene-time startup policy selects current computer UTC converted to TDB after scene loading and projection settle."
    )
}

class "LunCoOrbitAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "A Keplerian orbit — the prim's pose comes from these elements\n    propagated at the current epoch, not from an authored transform. Keyed on\n    `semiMajorAxisM`: a prim authoring no semi-major axis has no orbit."
)
{
    int lunco:orbit:body = 301 (
        doc = "NAIF id of the central body. The default is the Moon."
    )
    double lunco:orbit:semiMajorAxisM = 0.0 (
        doc = "Semi-major axis, metres. Unauthored/0 = no orbit."
    )
    double lunco:orbit:eccentricity = 0.0 (
        doc = "Eccentricity, 0..1."
    )
    double lunco:orbit:inclinationDeg = 0.0 (
        doc = "Inclination, degrees."
    )
    double lunco:orbit:raanDeg = 0.0 (
        doc = "Right ascension of the ascending node, degrees."
    )
    double lunco:orbit:argPeriapsisDeg = 0.0 (
        doc = "Argument of periapsis, degrees."
    )
    double lunco:orbit:meanAnomalyDeg = 0.0 (
        doc = "Mean anomaly at epoch, degrees."
    )
    double lunco:orbit:epochJd = 2451545.0 (
        doc = "Epoch of the elements, Julian date. The default is J2000."
    )
}

class "LunCoLibrationAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "Places the prim at a libration (Lagrange) point of a body PAIR.\n    Keyed on `primary`: an L-point is a property of the pair, so a prim naming\n    only one body is not half-placed, it is unplaced."
)
{
    int lunco:libration:primary = 0 (
        doc = "NAIF id of the primary body. 0 = unset — no placement."
    )
    int lunco:libration:secondary = 0 (
        doc = "NAIF id of the secondary body."
    )
    token lunco:libration:point = "L1" (
        doc = "Which libration point of the pair."
        allowedTokens = ["L1", "L2", "L3", "L4", "L5"]
    )
}

class "LunCoMountHostAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "A host body explicitly enumerates the socket prims it owns. The socket prims may live anywhere below the host; their paths are relationship data and no child or group name is special."
)
{
    rel lunco:mount:sockets (
        doc = "The socket prims advertised by this host. Every target must apply LunCoMountSocketAPI and be under the host body."
    )
}

class "LunCoMountSocketAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "ONE socket — a prim explicitly advertised by a host where a part can\n    attach. The socket prim's own transform IS the socket frame, composed\n    relative to the host's body root."
)
{
    uniform token lunco:mount:socket = "" (
        doc = "What plug kind this socket accepts (`\"wheel\"`, `\"arm\"`).\n        Non-empty IS what makes the child a socket."
    )
    uniform token lunco:mount:joint (
        doc = "Joint kind created on attach. `fixed` carries no axis; other\n        kinds read `lunco:mount:axis`. The value is required; no Rust-side\n        default is permitted."
        allowedTokens = ["fixed", "revolute", "prismatic"]
    )
    token lunco:mount:axis = "" (
        doc = "Joint axis for non-fixed joints, socket-local (`\"X\"`, `\"Y\"`, `\"Z\"`)."
        allowedTokens = ["", "X", "Y", "Z"]
    )
    rel lunco:mount:part (
        doc = "The part currently seated in this socket. A relationship, so\n        composition rebases it and a dangling target is visible to any tool that\n        walks the stage. Unauthored = an empty socket."
    )
    uniform asset lunco:mount:asset = @@ (
        doc = "The component asset an empty socket offers to reference in and\n        snap. `asset`, not `string` — it names a USD file, and only an `asset`\n        travels in the reference closure."
    )
}

class "LunCoMountAttachmentAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "The authored ownership edge for a component attachment. It records the exact generated joint prim so detach never derives a joint path from a component name."
)
{
    rel lunco:mount:attachmentJoint (
        doc = "The one joint prim generated for this attached component. The target must carry a UsdPhysics joint schema and relate body0 to the host and body1 to this component."
    )
}

class "LunCoMountPlugAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "The PART half of the socket/plug pair — applied to the part's root\n    prim (the asset's `defaultPrim`)."
)
{
    uniform token lunco:mount:plug = "" (
        doc = "What plug kind this part is (`\"wheel\"`, `\"arm\"`) — matched\n        against `lunco:mount:socket`."
    )
    rel lunco:mount:frame (
        doc = "The prim whose frame is the part's plug — the frame snapped onto\n        the socket, composed relative to the part's root. Unauthored = the part\n        advertises no plug and cannot snap."
    )
}

class "LunCoLatheAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "A procedural lathe (surface of revolution) — engine bells and dish\n    reflectors. `profile` picks the generator; each profile reads its own subset\n    of the dimensions. All dimensions in metres."
)
{
    uniform token lunco:lathe:profile = "" (
        doc = "Which profile of revolution. `bell` reads\n        throatRadius/exitRadius/length/contour; `paraboloid` reads\n        apexRadius/rimRadius/focalLength. Empty/unknown = no surface generated."
        allowedTokens = ["", "bell", "paraboloid"]
    )
    float lunco:lathe:throatRadius = 0.3499999940395355 (
        doc = "Bell: throat radius, metres."
    )
    float lunco:lathe:exitRadius = 1.350000023841858 (
        doc = "Bell: exit-plane radius, metres."
    )
    float lunco:lathe:length = 1.899999976158142 (
        doc = "Bell: throat-to-exit length, metres."
    )
    float lunco:lathe:contour = 0.550000011920929 (
        doc = "Bell: contour shape factor, 0..1."
    )
    float lunco:lathe:apexRadius = 0.019999999552965164 (
        doc = "Paraboloid: apex hole radius, metres."
    )
    float lunco:lathe:rimRadius = 0.5799999833106995 (
        doc = "Paraboloid: rim radius, metres."
    )
    float lunco:lathe:focalLength = 0.3499999940395355 (
        doc = "Paraboloid: focal length, metres."
    )
}

class "LunCoDerivedGeometryAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "Provenance for collision geometry derived from composed USD geometry.\n    Cube and Cylinder proxies exactly reproduce their sibling source dimensions\n    and transform stack; source drift rejects admission. NURBS mesh proxies carry\n    reproducible cook settings. The source relationship is authoritative. The geometry fingerprint covers the cooked\n    canonical vertices and topology and is checked against both source and proxy\n    at collider admission. The refinement delta is a deterministic sampled\n    convergence estimate, not a certified error bound."
)
{
    rel lunco:derived:source (
        doc = "The authoritative composed geometry source: a sibling Cube or Cylinder for an exact primitive proxy, or a NurbsPatch for a cooked mesh proxy."
    )
    uniform uint64 lunco:derived:geometryFingerprint = 0 (
        doc = "Stable fingerprint of the canonical cooked point and triangle arrays. A mismatch rejects the proxy as stale or modified."
    )
    uniform double lunco:derived:maxRefinementDeltaM = 0.0 (
        doc = "Positive maximum accepted sampled mesh change between consecutive refinement levels, in canonical metres; this is not a certified surface-error bound."
    )
    uniform double lunco:derived:refinementDeltaM = 0.0 (
        doc = "Measured symmetric vertex-to-triangle distance between the last two refinement levels, in canonical metres."
    )
    uniform int lunco:derived:nurbsUSubdivisions = 0 (
        doc = "U parameter subdivisions selected by the refinement-limited untrimmed surface cook."
    )
    uniform int lunco:derived:nurbsVSubdivisions = 0 (
        doc = "V parameter subdivisions selected by the refinement-limited untrimmed surface cook."
    )
    uniform int lunco:derived:trimCurveSamples = 0 (
        doc = "Samples per authored NURBS trim curve selected by the refinement-limited trimmed surface cook."
    )
    uniform int lunco:derived:trimGridSubdivisions = 0 (
        doc = "Parameter-grid subdivisions selected to triangulate the authored NURBS trim domain."
    )
}

class "LunCoCameraPathAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "A camera SHOT — applied to the `BasisCurves` prim the camera rides.\n    The curve is the track (core USD vocabulary, nothing of ours); these\n    properties bind a camera to it, pace it, and aim it."
)
{
    rel lunco:path:camera (
        doc = "The camera prim this path drives. Unauthored = a plain curve,\n        not a camera path."
    )
    rel lunco:path:lookAt (
        doc = "Whole-shot aim target — the simple form. For per-key aims author\n        the `lunco:path:aim:*` triple instead."
    )
    double lunco:path:duration = 60.0 (
        doc = "Shot duration, seconds."
    )
    token lunco:path:clock = "sim" (
        doc = "Where the shot's clock hangs: `sim` freezes with the sim on\n        pause (authored motion is scene content), `real` keeps running on the\n        wall clock."
        allowedTokens = ["sim", "real"]
    )
    double[] lunco:path:aim:times = [] (
        doc = "Aim key times, seconds along the shot. Parallel to `aim:modes`."
    )
    token[] lunco:path:aim:modes = [] (
        doc = "Aim mode per key — `tangent` (look along the track), `target`\n        (consume the next `aim:targets` entry), or `manual` (position only; the\n        camera's existing orientation remains authoritative)."
        allowedTokens = ["tangent", "target", "manual"]
    )
    double lunco:path:aim:blendDuration = 0.0 (
        doc = "Seconds before each aim key over which the previous and current\n        look directions are slerped. Zero preserves authored cuts."
    )
    rel lunco:path:aim:targets (
        doc = "Aim-target prims, in order, one per `target` entry in\n        `aim:modes`."
    )
}

class "LunCoCameraTrackAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "A camera CUT LIST: which camera is live over time. The value is a\n    held-interpolated token channel — at each key time the shot cuts to the named\n    camera; authoring `timeSamples` on it IS what makes the prim a track."
)
{
    token lunco:activeCamera = "" (
        doc = "Path/name of the live camera. Deliberately VARYING — the whole\n        point is its `timeSamples`."
    )
}

class "LunCoSolarAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "Opts the prim into the solar-pose query — its sun-relative geometry\n    (incidence, shadowing) is computed and published each tick. Generic celestial\n    fact, no power vocabulary: a solar-power model composes over it."
)
{
    bool lunco:solarTracked = false (
        doc = "Whether this prim's solar pose is tracked."
    )
}

class "LunCoMarkerAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "A screen-constant marker — geometry held at a fixed APPARENT size so\n    a thing that is physically correct but sub-pixel still reads on screen. The\n    canonical case is a ground station: a 70 m dish is 1/91,000 of Earth and\n    invisible from any camera that can see the globe, and inflating the model\n    would corrupt the aperture the link budget reads.\n\n    The geometry it applies to must be UNIT-sized — the engine owns\n    `Transform.scale` on this prim outright (\"unit prim + scale\")."
)
{
    float lunco:marker:angularSizeDeg = 0.15000000596046448 (
        doc = "Apparent DIAMETER in degrees, held constant with range. The\n        identifying property: a prim without one is not a marker.\n\n        SIZE IT AGAINST WHAT IT MARKS, not against the screen: Earth seen from\n        the Moon is 1.9° wide, so half a degree is a quarter of the planet."
    )
    float lunco:marker:showBeyondM = 200000.0 (
        doc = "Hide the marker closer than this (metres). Angular-constant\n        scaling never stops on its own, and a marker parked inside a facility\n        that is already fully modelled is clutter, not information."
    )
}

class "LunCoSurfaceAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "Engine-side surface blend override for an authored gprim's material —\n    what core USD's opacity primvars cannot say."
)
{
    bool lunco:surface:unlit = false (
        doc = "Render the bound surface without lighting, normals, or shadows."
    )
    bool lunco:surface:additive = false (
        doc = "Render this surface with ADDITIVE blending — a glow (engine\n        plume or other authored gprim) that brightens without occluding. Distinct from\n        `primvars:displayOpacity` blending, which still occludes."
    )
}

class "LunCoDomainSynthesisAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "Selects the domain synthesizer that owns a composed network root."
)
{
    uniform token lunco:synthesizer = "" (
        doc = "Registered synthesizer id for this network root."
    )
}

class "LunCoForceActuatorAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "A force actuator geometry and its structural command-output binding."
)
{
    float3 lunco:forceActuator:direction = (0.0, 0.0, 1.0) (
        doc = "Unit direction in the actuator prim frame."
    )
    double lunco:forceActuator:maxForce = 0.0 (
        doc = "Maximum force in newtons."
    )
    rel lunco:forceActuator:commandSource (
        doc = "The scalar output property that supplies this actuator's normalized command slot. This is a structural target for the geometry-derived allocator; the actuator's physical value still arrives through inputs:force_command."
    )
}

class "LunCoUiSchemaAPI" (
    inherits = </APISchemaBase>
    customData = {
    token apiSchemaType = "singleApply"
}
    doc = "Typed layout hints for the Lunica connection/schema projection."
)
{
    bool lunco:ui:schemaRoot = false (
        doc = "Whether this prim starts a projected connection-schema view."
    )
    bool lunco:ui:schemaNode = false (
        doc = "Whether this prim is shown as a projected schema node."
    )
    int lunco:ui:schemaColumn = 0 (
        doc = "Column in the projected schema layout."
    )
    int lunco:ui:schemaRow = 0 (
        doc = "Row in the projected schema layout."
    )
    string lunco:ui:schemaRole = "" (
        doc = "Short authored explanation of what enters and leaves this projected block."
    )
    string lunco:ui:surfaceId = "" (
        doc = "Stable runtime UI surface identity authored by the active scene or Twin."
    )
    string lunco:ui:visibilityMode = "possessed" (
        doc = "Input to the built-in runtime UI policy: possessed or always."
    )
}
