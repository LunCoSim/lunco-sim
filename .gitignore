# Godot-specific ignores
.agents/
target/

# Downloaded mission data
.cache/
extern/

# Downloaded and derived terrain products. Source URLs, hashes, and processing
# policy belong in Assets.toml; the potentially large payloads never do.
terrain/*/materials/
**/.bakekey

# Web bundle output (final shippable wasm + JS + HTML)
dist/

# Locally installed cargo binaries (e.g. wasm-bindgen-cli) used by build scripts.
# Kept outside target/ so `cargo clean` doesn't force a reinstall.
.cargo-bin/

# AI tool configs
external/

# IDE/Editor
.idea/
.vscode/
*.swp
*.swo
.claude/settings.local.json
node_modules/

.cargo/

# graphify generated outputs
graphify-out/

# Per-session runtime state written INTO a twin, and never content:
#   .lunco/runtime/ — the generated runtime overlay (live spawns + moved
#     transforms), written by `lunco_usd::runtime_persistence`
#
# The code predicate also covers `history/` (the edit journal, already
# replicated on its own plane). It is deliberately NOT ignored here: nothing
# under it is tracked today, and a bare `history/` pattern would swallow any
# directory of that name anywhere in the tree.
#
# `assets/` is itself an open twin, so an ordinary dev run writes personal
# session state inside the library we ship. A tracked overlay is layered over
# the authored scene on every install that receives it, which means testers
# report bugs against someone else's recorded mouse clicks. The same predicate
# lives in code as `lunco_usd::is_runtime_state` — keep the two in step.
.lunco/
.tmpdir/
*.png
*.glb
assets/icons/macos/luncosim.icns
assets/icons/windows/luncosim.ico
assets/icons/linux/
assets/icons/macos/png/
assets/icons/windows/png/
__pycache__/
