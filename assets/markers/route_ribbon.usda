#usda 1.0
(
    defaultPrim = "RouteRibbon"
    upAxis = "Y"
    metersPerUnit = 1
)

# A reusable standard USD curve surface for route visualisation. The route tool
# supplies points and topology; the USD renderer owns the fast BasisCurves
# projection. This asset contains no route or vessel semantics.
def Xform "RouteRibbon"
{
    def Scope "Looks"
    {
        def Material "RouteRibbon_Mat"
        {
            token outputs:surface.connect = </RouteRibbon/Looks/RouteRibbon_Mat/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                # A route ribbon is a signal/annotation, not a terrain surface.
                # Keep it visible on the lunar night side by using the standard
                # UsdPreviewSurface emissive channel rather than scene lighting.
                color3f inputs:diffuseColor = (0.0, 0.0, 0.0)
                color3f inputs:specularColor = (0.0, 0.0, 0.0)
                float inputs:useSpecularWorkflow = 1
                float inputs:roughness = 1.0
                color3f inputs:emissiveColor = (0.2, 1.4, 0.55)
                float inputs:opacity = 0.85
                token outputs:surface
            }
        }
    }

    def BasisCurves "Geometry"
    (
        prepend apiSchemas = ["MaterialBindingAPI", "LunCoSurfaceAPI"]
    )
    {
        token type = "linear"
        token wrap = "nonperiodic"
        double3 xformOp:translate = (0, 1.0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        int[] curveVertexCounts = [2]
        point3f[] points = [(0, 0, 0), (0, 0, 1)]
        float[] widths = [0.65]
        rel material:binding = </RouteRibbon/Looks/RouteRibbon_Mat>
        bool doubleSided = true
        color3f[] primvars:displayColor = [(0.20, 0.85, 1.0)]
        float[] primvars:displayOpacity = [0.85]
        bool lunco:surface:additive = true
        bool primvars:doNotCastShadows = true
    }
}
