#usda 1.0
(
    defaultPrim = "SolarTower"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "SolarTower" (
    kind = "component"
    documentation = "Vertical solar tower — mast + sun-tracking PV head on a revolute joint. Base power. Site it in the open with a clear horizon; keep it clear of the landing pad's plume."
    prepend apiSchemas = ["LunCoCatalogAPI"]
)
{
    uniform bool lunco:spawnable = true
    def Scope "Looks"
    {
        def Material "SolarPanel"
        {
            token outputs:surface
            token outputs:surface.connect = </SolarTower/Looks/SolarPanel/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                color3f inputs:cell_color = (0.05000000074505806, 0.05000000074505806, 0.3499999940395355)
                color3f inputs:bus_color = (0.8500000238418579, 0.8500000238418579, 0.8999999761581421)
                color3f inputs:frame_color = (0.3499999940395355, 0.3499999940395355, 0.3799999952316284)
                float inputs:cell_rows = 8.0
                float inputs:cell_cols = 12.0
                float inputs:cell_gap = 0.019999999552965164
                float inputs:bus_width = 0.004000000189989805
                float inputs:border = 0.03999999910593033
                token outputs:surface
                uniform asset info:wesl:sourceAsset = @lunco://shaders/solar_panel.wesl@
            }
        }
    }
    def Cube "Pad" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0.0, 0.1, 0.0)
        double3 xformOp:scale = (2.0, 0.2, 2.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.3199999928474426, 0.3100000023841858, 0.30000001192092896)]
        bool physics:collisionEnabled = true
    }
    def Cylinder "Mast" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Y"
        double radius = 0.18
        double height = 5.0
        double3 xformOp:translate = (0.0, 2.7, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5199999809265137)]
        float physics:mass = 200.0
        bool physics:rigidBodyEnabled = false
        bool physics:collisionEnabled = true
    }
    def Cylinder "YawHead" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Y"
        double radius = 0.4
        double height = 0.5
        double3 xformOp:translate = (0.0, 5.6, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.44999998807907104, 0.44999998807907104, 0.47999998927116394)]
        float physics:mass = 20.0
        float3 physics:diagonalInertia = (1.0, 1.0, 1.0)
        bool physics:collisionEnabled = true
        def Cube "Panel" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double size = 1.0
            double3 xformOp:translate = (0.0, 1.2, 0.0)
            double3 xformOp:scale = (4.0, 3.0, 0.06)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.05000000074505806, 0.05000000074505806, 0.3499999940395355)]
            rel material:binding = </SolarTower/Looks/SolarPanel>
        }
    }
    def PhysicsRevoluteJoint "YawJoint"
    {
        rel physics:body0 = </SolarTower/Mast>
        rel physics:body1 = </SolarTower/YawHead>
        uniform token physics:axis = "Y"
        point3f physics:localPos0 = (0.0, 2.9000000953674316, 0.0)
        point3f physics:localPos1 = (0.0, 0.0, 0.0)
    }
}
