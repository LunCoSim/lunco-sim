#usda 1.0
(
    defaultPrim = "CommsMast"
    upAxis = "Y"
    metersPerUnit = 1
)

# LunaNet Comms Mast — tall tower + shallow dish (flattened sphere) + feed.
# Wants a high ridge point for Earth line-of-sight.
#
# The connectivity endpoint is the antenna's `LinkAperture` at the dish feed, NOT
# this root: a mast exists to lift the antenna clear of terrain, and the dish itself
# must be the exact origin for both its link geometry and beam.
# Override `lunco:link:class` per instance if a scene has more than one role of
# mast; identity is the prim's GID either way, so two masts never collide.
def Xform "CommsMast" (
    kind = "component"
    doc = "LunaNet comms mast — tower, dish and feed horn. The base's link home; put it on the highest ground you have for Earth line-of-sight."
    prepend apiSchemas = ["LunCoCatalogAPI", "PhysicsRigidBodyAPI"]
)
{
    uniform bool lunco:spawnable = true

    # ── The mast is ONE static body, and that is what the antenna mounts to ──
    #
    # `rigidBodyEnabled = false` makes it `RigidBody::Static`: a tower does not
    # move. The footpad, tower and head colliders below fold into this body's
    # compound shape, which is what the USD physics spec says happens to a
    # collider under a rigid body — they used to be three separate standalone
    # static colliders that merely stood in the same place.
    #
    # Declaring it HERE, on the root, is load-bearing for the antenna. The dish
    # yaws against the nearest ANCESTOR body of wherever it is parented, and
    # `Antenna` is a child of this root — a sibling of the tower, not a
    # descendant of it. Without a body here the mechanism has nothing to mount
    # to. Reparenting the antenna under `Tower` would work equally well for
    # physics and would silently break every scene that reaches it by
    # `over "Antenna"` (`scenes/tests/comms_wall.usda` does exactly that).
    bool physics:rigidBodyEnabled = false

    def Cube "FootPad" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0, 0.15, 0)
        double3 xformOp:scale = (1.5, 0.3, 1.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.33, 0.32, 0.31)]
        bool physics:collisionEnabled = true
    }

    def Cylinder "Tower" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Y"
        double radius = 0.2
        double height = 10.0
        double3 xformOp:translate = (0, 5.0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.55, 0.55, 0.58)]
        bool physics:collisionEnabled = true
    }

    # The antenna's feed endpoint is scene-local (no anchor/orbit): the site frame
    # poses it, so it rides whatever ground the mast is placed on.
    #
    # It is also the DISH ITSELF: the catalogue antenna arrives by reference, so this
    # mast draws the same lathed paraboloid as the lander and the ground stations
    # instead of the flattened sphere that used to stand here. Its own `Mast` stalk is
    # hidden — the tower below is the mast — and the head is scaled to a 4 m aperture,
    # the size the sphere it replaces read as.
    #
    # No joint is authored here. The component owns both its hinges and mounts by
    # ancestry, and its nearest ancestor body is this file's root (see above).
    def "Antenna" (
        prepend references = @lunco://components/comms/antenna.usda@</CommsAntenna>
    )
    {
        double3 xformOp:translate = (0, 10.6, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        over "Mast"
        {
            token visibility = "invisible"
        }
        over "YawHead"
        {
            double3 xformOp:translate = (0, 0.3, 0.4)
            over "DishGimbal"
            {
                over "DishHead"
                {
                    double3 xformOp:scale = (3.4, 3.4, 3.4)
                    over "LinkAperture"
                    {
                        string lunco:link:class = "base"
                    }
                }
            }
        }
    }

    def Cube "Head"
    {
        double size = 0.6
        double3 xformOp:translate = (0, 10.0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.4, 0.4, 0.43)]
    }

    # (No `Dish`/`Feed` prims here. The dish is the `Antenna` prim above — the
    # catalogue's lathed paraboloid, referenced. A flattened `Sphere` used to stand
    # in for it, which meant the mast, the lander and the rovers each drew a
    # different shape and called it the same thing.)
}
