#usda 1.0
(
    defaultPrim = "Kalyazin"
    upAxis = "Y"
    metersPerUnit = 1
)

# Kalyazin (Калязин), Tver oblast — RT-64, a 64 m dish.
#
# Primarily a RADIO ASTRONOMY instrument (VLBI). It backs the deep-space network
# up rather than carrying the daily traffic, so it is NOT one of the operational
# command stations and scenes modelling the working Russian ground segment
# should reference `bear_lakes.usda` and `ussuriysk.usda` and stop there.
#
# It is in the catalogue anyway, because a station that exists is worth having
# authored once: it makes a good third endpoint when a lesson deliberately needs
# one station to be unavailable, and it is the right answer for a scene about
# VLBI or about the ground segment as a whole. Reference it when you can say why.
#
# See `structures/ground_stations/README.md` — the height here is approximate,
# and the 5° elevation mask is inherited rather than measured for this dish.
def Xform "Kalyazin" (
    prepend references = @lunco://components/comms/ground_station.usda@</GroundStation>
    kind = "component"
    doc = "Kalyazin, Tver oblast — RT-64, 64 m. Radio-astronomy dish used as a deep-space and VLBI backup, not an operational command station."
)
{
    custom string lunco:label = "Kalyazin · RT-64"

    double lunco:anchor:lat = 57.22
    double lunco:anchor:lon = 37.90
    double lunco:anchor:height = 130
    int lunco:anchor:body = 399

    # 64 m aperture = 1.16 · 55.17.
    over "Antenna"
    {
        over "YawHead"
        {
            over "DishGimbal"
            {
                over "DishHead"
                {
                    double3 xformOp:scale = (55.17, 55.17, 55.17)
                }
            }
        }
    }
}
