#usda 1.0
(
    defaultPrim = "SolarSystem"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "SolarSystem" (
    documentation = "Sun, Earth and Moon — the standard celestial set. Reference this from a scene that wants a sky."
    kind = "assembly"
)
{
    def Xform "Sun" (
        prepend apiSchemas = "LunCoCelestialBodyAPI"
        documentation = "The Sun. Origin of the solar frame and the scene's key light."
    )
    {
        uniform int lunco:body = 10
    }
    def Xform "Earth" (
        prepend apiSchemas = ["LunCoCelestialBodyAPI", "MaterialBindingAPI"]
        documentation = "Earth. Also the route root for deep-space comms (DSN ground stations anchor to it)."
    )
    {
        uniform int lunco:body = 399
        rel material:binding = </SolarSystem/Looks/Earth>
        def DistantLight "Earthshine" (
            prepend references = @lunco://lighting/earthshine.usda@</Earthshine>
        )
        {
        }
        def Xform "OrbitView" (
            prepend apiSchemas = "LunCoTrajectoryViewAPI"
            documentation = "Earth's heliocentric orbit. Hidden by default."
        )
        {
            string lunco:trajectory:name = "Earth Orbit View"
            int lunco:trajectory:trackedId = 399
            int lunco:trajectory:referenceId = 10
            color4f lunco:trajectory:color = (0.0, 0.800000011920929, 1.0, 1.0)
            bool lunco:trajectory:userVisible = false
            double lunco:trajectory:samplingDays = 400.0
            double lunco:trajectory:samplingStep = 0.5
            token lunco:trajectory:frame = "Inertial"
        }
    }
    def Xform "Moon" (
        prepend apiSchemas = ["LunCoCelestialBodyAPI", "MaterialBindingAPI"]
        documentation = "The Moon. Surface scenes anchor their site frame here (`int lunco:anchor:body = 301`)."
    )
    {
        uniform int lunco:body = 301
        rel material:binding = </SolarSystem/Looks/Moon>
        def Xform "OrbitView" (
            prepend apiSchemas = "LunCoTrajectoryViewAPI"
            documentation = "The Moon's orbit about Earth. Hidden by default."
        )
        {
            string lunco:trajectory:name = "Moon Orbit View"
            int lunco:trajectory:trackedId = 301
            int lunco:trajectory:referenceId = 399
            color4f lunco:trajectory:color = (1.0, 0.8999999761581421, 0.20000000298023224, 1.0)
            bool lunco:trajectory:userVisible = false
            double lunco:trajectory:samplingDays = 30.0
            double lunco:trajectory:samplingStep = 0.02
            token lunco:trajectory:frame = "Inertial"
        }
    }
    def Scope "Looks"
    {
        def Material "Earth"
        {
            token outputs:surface
            token outputs:surface.connect = </SolarSystem/Looks/Earth/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:wgsl:sourceAsset = @lunco://shaders/blueprint.wgsl@
                uniform asset info:wgsl:vertexAsset = @lunco://shaders/blueprint.wgsl@
                color3f inputs:surface_color = (0.12999999523162842, 0.3199999928474426, 0.6600000262260437)
                float inputs:roughness = 0.5
                color3f inputs:high_line_color = (0.0, 0.5, 1.0)
                color3f inputs:low_line_color = (0.0, 0.5, 1.0)
                float2 inputs:subdivisions = (36.0, 18.0)
                float2 inputs:fade_range = (0.20000000298023224, 0.6000000238418579)
                float inputs:line_width = 1.0
                float inputs:transition = 0.0
                token outputs:surface
            }
        }
        def Material "Moon"
        {
            token outputs:surface
            token outputs:surface.connect = </SolarSystem/Looks/Moon/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:wgsl:sourceAsset = @lunco://shaders/blueprint.wgsl@
                uniform asset info:wgsl:vertexAsset = @lunco://shaders/blueprint.wgsl@
                color3f inputs:surface_color = (0.5, 0.5, 0.5)
                float inputs:roughness = 0.8999999761581421
                color3f inputs:high_line_color = (0.6000000238418579, 0.6000000238418579, 0.6000000238418579)
                color3f inputs:low_line_color = (0.6000000238418579, 0.6000000238418579, 0.6000000238418579)
                float2 inputs:subdivisions = (24.0, 12.0)
                float2 inputs:fade_range = (0.20000000298023224, 0.6000000238418579)
                float inputs:line_width = 2.0
                float inputs:transition = 0.0
                token outputs:surface
            }
        }
    }
}
