#usda 1.0
(
    defaultPrim = "SolarSystem"
    upAxis = "Y"
    metersPerUnit = 1
)

# The standard celestial set — Sun, Earth, Moon (doc 19 §11e, doc 43).
#
# Celestial content is OPT-IN, per scene. Nothing celestial exists unless a scene
# declares it: no bodies, no globes, no orbit views, no ephemeris. A scene that wants
# a sky references this file:
#
#   def "SolarSystem" (
#       prepend references = @lunco://celestial/solar_system.usda@</SolarSystem>
#   ) { }
#
# and a scene that does not (the flat sandbox arena) simply says nothing and gets a
# black sky — which is the correct reading of "a test arena".
#
# This replaces `CelestialConfig.spawn_hierarchy`, a boolean in Rust that decided
# whether a solar system existed and was flipped as a side effect of a scene authoring
# a site anchor. A scene could not ASK for a Moon; it could only trip a switch — and
# any subsystem that forgot to read the switch leaked planets into scenes that never
# wanted them (Earth/Moon orbit views were being spawned into the sandbox).
#
# The transforms here are NOT authored: each body's pose is driven every frame from the
# ephemeris (VSOP2013/ELP) at the current epoch — which is itself a clock you can
# re-parent, rate-scale or seek (`SetClock`, doc 19 §11b). The `big_space` precision
# scaffolding (grids, reference frames, SOI, gravity, globe LOD) is built in Rust FROM
# these declarations: derived structure, not authored content.
def Xform "SolarSystem" (
    doc = "Sun, Earth and Moon — the standard celestial set. Reference this from a scene that wants a sky."
    kind = "assembly"
)
{
    def Xform "Sun" (
        prepend apiSchemas = ["LunCoCelestialBodyAPI"]
        doc = "The Sun. Origin of the solar frame and the scene's key light."
    )
    {
        uniform int lunco:body = 10
    }

    def Xform "Earth" (
        prepend apiSchemas = ["LunCoCelestialBodyAPI", "MaterialBindingAPI"]
        doc = "Earth. Also the route root for deep-space comms (DSN ground stations anchor to it)."
    )
    {
        uniform int lunco:body = 399
        rel material:binding = </SolarSystem/Looks/Earth>
        # Earthshine: the light Earth throws back onto whatever is looking at it.
        # It hangs UNDER the body it comes from, so the namespace states the
        # relationship and no attribute has to. Declaring Earth therefore brings
        # its illumination with it — a scene gets the fill by asking for the
        # body, not by knowing to spawn a second light.
        #
        # Intensity is 0 until the ephemeris resolves Earth's phase; see
        # `lunco://lighting/earthshine.usda`.
        def DistantLight "Earthshine" (
            prepend references = @lunco://lighting/earthshine.usda@</Earthshine>
        )
        {
        }

        # Earth's orbit around the Sun, as a drawn line. AUTHORED CONTENT, and
        # OFF unless a scene asks for it — see the `OrbitView` note under Moon.
        def Xform "OrbitView" (
            prepend apiSchemas = ["LunCoMissionTrajectoryAPI"]
            doc = "Earth's heliocentric orbit. Hidden by default."
        )
        {
            string lunco:trajectory:name = "Earth Orbit View"
            int    lunco:trajectory:trackedId = 399
            int    lunco:trajectory:referenceId = 10
            color4f lunco:trajectory:color = (0.0, 0.8, 1.0, 1.0)
            bool   lunco:trajectory:userVisible = false
            double lunco:trajectory:samplingDays = 400.0
            double lunco:trajectory:samplingStep = 0.5
            token  lunco:trajectory:frame = "Inertial"
        }
    }

    def Xform "Moon" (
        prepend apiSchemas = ["LunCoCelestialBodyAPI", "MaterialBindingAPI"]
        doc = "The Moon. Surface scenes anchor their site frame here (`int lunco:anchor:body = 301`)."
    )
    {
        uniform int lunco:body = 301
        rel material:binding = </SolarSystem/Looks/Moon>

        # These two orbit lines used to be spawned in RUST, unconditionally, for
        # any scene that declared a body. That made "this world has an Earth"
        # silently also mean "draw a 400-day ellipse through my sky" — with no
        # attribute anywhere a scene could set to decline. They are content, so
        # they are authored here, and `userVisible = false` is the default: a
        # scene (or the user, via the trajectory toggle) opts the line IN.
        #
        # An `over` in the referencing scene raises one without copying the file:
        #
        #   over "SolarSystem" { over "Moon" { over "OrbitView" {
        #       bool lunco:trajectory:userVisible = true } } }
        def Xform "OrbitView" (
            prepend apiSchemas = ["LunCoMissionTrajectoryAPI"]
            doc = "The Moon's orbit about Earth. Hidden by default."
        )
        {
            string lunco:trajectory:name = "Moon Orbit View"
            int    lunco:trajectory:trackedId = 301
            int    lunco:trajectory:referenceId = 399
            color4f lunco:trajectory:color = (1.0, 0.9, 0.2, 1.0)
            bool   lunco:trajectory:userVisible = false
            double lunco:trajectory:samplingDays = 30.0
            double lunco:trajectory:samplingStep = 0.02
            token  lunco:trajectory:frame = "Inertial"
        }
    }

    # Default globe looks are ordinary USD Shade content. Celestial Rust owns
    # the generated high-precision body and LOD topology, then carries these
    # authored looks onto the streamed tiles. A scene may override the binding
    # or its shader inputs using normal USD composition.
    def Scope "Looks"
    {
        def Material "Earth"
        {
            token outputs:surface.connect = </SolarSystem/Looks/Earth/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:wgsl:sourceAsset = @lunco://shaders/blueprint.wgsl@
                color3f inputs:surface_color = (0.13, 0.32, 0.66)
                float inputs:roughness = 0.5
                color3f inputs:high_line_color = (0.0, 0.5, 1.0)
                color3f inputs:low_line_color = (0.0, 0.5, 1.0)
                float2 inputs:subdivisions = (36.0, 18.0)
                float2 inputs:fade_range = (0.2, 0.6)
                float inputs:line_width = 1.0
                float inputs:transition = 0.0
                token outputs:surface
            }
        }

        def Material "Moon"
        {
            token outputs:surface.connect = </SolarSystem/Looks/Moon/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:wgsl:sourceAsset = @lunco://shaders/blueprint.wgsl@
                color3f inputs:surface_color = (0.5, 0.5, 0.5)
                float inputs:roughness = 0.9
                color3f inputs:high_line_color = (0.6, 0.6, 0.6)
                color3f inputs:low_line_color = (0.6, 0.6, 0.6)
                float2 inputs:subdivisions = (24.0, 12.0)
                float2 inputs:fade_range = (0.2, 0.6)
                float inputs:line_width = 2.0
                float inputs:transition = 0.0
                token outputs:surface
            }
        }
    }
}
