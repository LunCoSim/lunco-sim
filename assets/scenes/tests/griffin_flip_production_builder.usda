#usda 1.0
(
    defaultPrim = "GriffinFlipProductionBuilderTest"
    upAxis = "Y"
    metersPerUnit = 1
)

# The fixture is deliberately only an empty mission frame. The production
# lander and four-wheel rover are composed by the Rhai authoring plan so this
# test exercises the same reference/placement/joint path as an Editor build.
def Xform "GriffinFlipProductionBuilderTest" (
    kind = "assembly"
    prepend apiSchemas = ["LunCoCatalogAPI"]
)
{
    def DistantLight "TestLight"
    {
        float intensity = 1.0
    }

    def Xform "Mission"
    {
    }

    def Scope "Scenario"
    {
        custom string lunco:scenario = "griffin-flip-production-builder"
        def Scope "Test" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            asset info:sourceAsset = @lunco://scenarios/tests/griffin_flip_production_builder.rhai@
        }
    }
}
