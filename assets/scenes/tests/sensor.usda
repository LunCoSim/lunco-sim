#usda 1.0
(
    defaultPrim = "SandboxScene"
    upAxis = "Y"
    metersPerUnit = 1
)

# Verifies the native Avian-to-Modelica sensor boundary.
# A 100 kg box rests on the ground carrying an IMU conversion and a raw ray
# conversion. Collider contact remains a native Avian body fact.
#
# Read live:  ListPorts -> the Box entity exposes accel_*, range, contact,
#   contact_force alongside its rigid-body ports.
# Loaded by `target/debug/luncosim test --scene scenes/tests/sensor.usda`.

# Scene root: an `assembly` — a thing you OPEN, not a part you place.
def Xform "SandboxScene" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    kind = "assembly"
    doc = "A box resting on the ground carrying simple sensors: one that feels motion, one that measures distance to the ground, and one that feels touch. Checks that each reports sensible numbers."
    prepend apiSchemas = ["LunCoCatalogAPI"]
)
{
    uniform bool lunco:spawnable = false

    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0, -0.5, 0)
        double3 xformOp:scale = (200.0, 1.0, 200.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.4, 0.4, 0.45)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </SandboxScene/PhysicsMaterials/Friction_1_0>
    }

    def Xform "Avatar" (
        prepend apiSchemas = ["LunCoAvatarAPI"]
    )
    {
        uniform bool lunco:avatar = true
        uniform token lunco:cameraMode = "freeflight"
        double3 lunco:cameraLookAt = (0.0, 0.5, 0.0)
        double3 xformOp:translate = (0.0, 4.0, 9.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # Box resting on the ground (half-size 0.5 → centre at y=0.5).
    def Cube "Box" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0.0, 0.5, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.9, 0.7, 0.2)]
        float physics:mass = 100.0
        bool physics:collisionEnabled = true

        # The Modelica IMU conversion consumes only the body's raw Avian
        # kinematics and the local gravity source.
        def "IMU" (
            prepend references = @lunco://vessels/sensors/imu.usda@</Imu>
        )
        {
            float inputs:raw_velocity_x.connect = </SandboxScene/Box.outputs:velocity_x>
            float inputs:raw_velocity_y.connect = </SandboxScene/Box.outputs:velocity_y>
            float inputs:raw_velocity_z.connect = </SandboxScene/Box.outputs:velocity_z>
            float inputs:raw_angvel_x.connect = </SandboxScene/Box.outputs:angvel_x>
            float inputs:raw_angvel_y.connect = </SandboxScene/Box.outputs:angvel_y>
            float inputs:raw_angvel_z.connect = </SandboxScene/Box.outputs:angvel_z>
            float inputs:raw_quat_w.connect = </SandboxScene/Box.outputs:quat_w>
            float inputs:raw_quat_x.connect = </SandboxScene/Box.outputs:quat_x>
            float inputs:raw_quat_y.connect = </SandboxScene/Box.outputs:quat_y>
            float inputs:raw_quat_z.connect = </SandboxScene/Box.outputs:quat_z>
            float inputs:gravity_world_y.connect = </SandboxScene/Box/Environment.outputs:gravity_y>
        }

        # A downward raw Avian ray is mounted 0.3 m above the box centre. Its
        # Model child turns hit distance and validity into range outputs.
        def "Environment" (
            prepend references = @lunco://components/environment/probe.usda@</EnvironmentProbe>
        )
        {
        }
        def "Altimeter" (
            prepend references = @lunco://vessels/sensors/altimeter.usda@</Altimeter>
        )
        {
            double3 xformOp:translate = (0.0, 0.3, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            float lunco:raycast:maxDistance = 10.0
        }
    }

    # Second box, 50 kg, far from the first — to check the contact-force ratio
    # is a constant factor (mass-independent) vs penetration-dependent.
    def Cube "Box50" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (6.0, 0.5, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.2, 0.8, 0.9)]
        float physics:mass = 50.0
        bool physics:collisionEnabled = true
    }

    def Scope "Scenario"
    {
        custom string lunco:scenario = "sensors"

        def Scope "Test" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform asset info:sourceAsset = @lunco://scenarios/tests/sensor.rhai@
        }
    }
}
