#usda 1.0
(
    defaultPrim = "BatteryEmptyActuator"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "BatteryEmptyActuator" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    kind = "assembly"
    documentation = "An empty battery rover has no solved electrical authority for its actuators."
    prepend apiSchemas = ["LunCoCatalogAPI", "LunCoAnchorAPI", "LunCoEpochAPI"]
)
{
    uniform bool lunco:spawnable = false
    double lunco:anchor:lat = 26.13
    double lunco:anchor:lon = 3.63
    double lunco:anchor:height = 0.0
    int lunco:anchor:body = 301
    double lunco:time:epochJd = 2461395.5
    def Camera "Avatar" (
        prepend apiSchemas = ["LunCoCameraAPI", "LunCoAvatarAPI"]
    )
    {
        uniform bool lunco:avatar = true
        double3 xformOp:translate = (0.0, 6.0, 10.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def "Controls" (
            prepend references = @lunco://vessels/control_profiles.usda@</AvatarControls>
        )
        {
        }
    }
    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0.0, -0.5, 0.0)
        double3 xformOp:scale = (100.0, 1.0, 100.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.4000000059604645, 0.4000000059604645, 0.44999998807907104)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </BatteryEmptyActuator/PhysicsMaterials/Friction_1_0>
    }
    def Xform "Rover" (
        prepend references = @lunco://vessels/rovers/rocker_bogie.usda@</RockerBogie>
        variants = { string "generation" = "none"; string "power" = "battery" }
    )
    {
        double3 xformOp:translate = (0.0, 1.6, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "Battery"
        {
            float inputs:soc_init = 0.0
        }
    }
    def Scope "Scenario"
    {
        custom string lunco:scenario = "battery-empty-actuator"
        def Scope "Test" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/battery_empty_actuator.rhai@
        }
    }
    def Xform "SolarSystem" (
        prepend references = @lunco://celestial/solar_system.usda@</SolarSystem>
    )
    {
    }
}
