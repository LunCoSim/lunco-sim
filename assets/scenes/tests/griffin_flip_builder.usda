#usda 1.0
(
    defaultPrim = "GriffinFlipBuilderTest"
    upAxis = "Y"
    metersPerUnit = 1
)

# Rhai-owned construction fixture. It deliberately exposes the same semantic
# topology as the mission study assets: one lander body with two referenced-
# style ramp Xforms and a four-station FLIP layout.
def Xform "GriffinFlipBuilderTest" (
    kind = "assembly"
    prepend apiSchemas = ["LunCoCatalogAPI"]
)
{
    def DistantLight "TestLight"
    {
        float intensity = 1.0
    }

    def Xform "Lander" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 1200.0
        float3 physics:centerOfMass = (0.0, 0.0, 0.0)
        float3 physics:diagonalInertia = (900.0, 1000.0, 1100.0)

        def Xform "EgressRampPort"
        {
            double3 xformOp:translate = (2.3, 1.95, 0.0)
            double3 xformOp:rotateXYZ = (0.0, 0.0, -50.0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]

            def Cube "Surface" (
                prepend apiSchemas = "PhysicsCollisionAPI"
            )
            {
                double size = 1.0
                double3 xformOp:scale = (4.0, 0.16, 2.3)
                uniform token[] xformOpOrder = ["xformOp:scale"]
                bool physics:collisionEnabled = true
            }
            def Cube "EdgeRail" (
                prepend apiSchemas = "PhysicsCollisionAPI"
            )
            {
                double size = 1.0
                double3 xformOp:scale = (4.0, 0.25, 0.12)
                uniform token[] xformOpOrder = ["xformOp:scale"]
                bool physics:collisionEnabled = true
            }
            def Cube "EdgeRailInner" (
                prepend apiSchemas = "PhysicsCollisionAPI"
            )
            {
                double size = 1.0
                double3 xformOp:translate = (0.0, 0.2, -0.95)
                double3 xformOp:scale = (4.0, 0.25, 0.12)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                bool physics:collisionEnabled = true
            }
        }

        def Xform "EgressRampStarboard"
        {
            double3 xformOp:translate = (-2.3, 1.95, 0.0)
            double3 xformOp:rotateXYZ = (0.0, 0.0, 50.0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]

            def Cube "Surface" (
                prepend apiSchemas = "PhysicsCollisionAPI"
            )
            {
                double size = 1.0
                double3 xformOp:scale = (4.0, 0.16, 2.3)
                uniform token[] xformOpOrder = ["xformOp:scale"]
                bool physics:collisionEnabled = true
            }
            def Cube "EdgeRail" (
                prepend apiSchemas = "PhysicsCollisionAPI"
            )
            {
                double size = 1.0
                double3 xformOp:scale = (4.0, 0.25, 0.12)
                uniform token[] xformOpOrder = ["xformOp:scale"]
                bool physics:collisionEnabled = true
            }
            def Cube "EdgeRailInner" (
                prepend apiSchemas = "PhysicsCollisionAPI"
            )
            {
                double size = 1.0
                double3 xformOp:translate = (0.0, 0.2, 0.95)
                double3 xformOp:scale = (4.0, 0.25, 0.12)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                bool physics:collisionEnabled = true
            }
        }
    }

    def Xform "FLIP" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 450.0
        float3 physics:centerOfMass = (0.0, -0.05, 0.0)
        float3 physics:diagonalInertia = (240.0, 337.5, 145.5)

        def Xform "Suspension_FL"
        {
            double3 xformOp:translate = (0.0, 0.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            def Cylinder "Wheel_FL"
            {
                int physxVehicleWheelAttachment:index = 0
                float physxVehicleWheel:radius = 0.45
                float physxVehicleWheel:width = 0.28
            }
        }
        def Xform "Suspension_FR"
        {
            double3 xformOp:translate = (0.0, 0.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            def Cylinder "Wheel_FR"
            {
                int physxVehicleWheelAttachment:index = 1
                float physxVehicleWheel:radius = 0.45
                float physxVehicleWheel:width = 0.28
            }
        }
        def Xform "Suspension_RL"
        {
            double3 xformOp:translate = (0.0, 0.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            def Cylinder "Wheel_RL"
            {
                int physxVehicleWheelAttachment:index = 2
                float physxVehicleWheel:radius = 0.45
                float physxVehicleWheel:width = 0.28
            }
        }
        def Xform "Suspension_RR"
        {
            double3 xformOp:translate = (0.0, 0.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            def Cylinder "Wheel_RR"
            {
                int physxVehicleWheelAttachment:index = 3
                float physxVehicleWheel:radius = 0.45
                float physxVehicleWheel:width = 0.28
            }
        }
    }

    def PhysicsFixedJoint "FLIPPayloadAdapterJoint"
    {
        rel physics:body0 = </GriffinFlipBuilderTest/Lander>
        rel physics:body1 = </GriffinFlipBuilderTest/FLIP>
        point3f physics:localPos0 = (0.0, 1.94, 0.0)
        point3f physics:localPos1 = (0.0, -1.0, 0.0)
    }

    def Scope "Scenario"
    {
        custom string lunco:scenario = "griffin-flip-builder"
        def Scope "Test" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            asset info:sourceAsset = @lunco://scenarios/tests/griffin_flip_builder.rhai@
        }
    }
}
