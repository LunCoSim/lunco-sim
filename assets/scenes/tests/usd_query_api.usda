#usda 1.0
(
    defaultPrim = "UsdQueryApi"
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "UsdQueryApi"
{
    def DistantLight "TestLight" { float intensity = 1.0 }

    def Xform "Assembly" {}

    def Xform "Site" (
        prepend references = @lunco://scenes/fixtures/usd_query_api/site.usda@</Site>
    )
    {
        over "Route"
        {
            over "W0" {}
        }
    }

    def Scope "Scenario"
    {
        custom string lunco:scenario = "usd-query-api"

        def Scope "Test" (prepend apiSchemas = ["LunCoProgramAPI"])
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/usd_query_api.rhai@
        }
    }
}
