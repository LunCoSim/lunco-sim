#usda 1.0
(
    defaultPrim = "SunTrackerTest"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "SunTrackerTest" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    kind = "assembly"
    documentation = "A solar panel that turns to face the sun. A controller reads where the sun is and turns the panel to point at it; move the sun and watch the panel re-aim."
    prepend apiSchemas = "LunCoCatalogAPI"
)
{
    uniform bool lunco:spawnable = false
    def Scope "Looks"
    {
        def Material "SolarPanel"
        {
            token outputs:surface
            token outputs:surface.connect = </SunTrackerTest/Looks/SolarPanel/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:wgsl:sourceAsset = @lunco://shaders/solar_panel.wgsl@
                color3f inputs:cell_color = (0.05000000074505806, 0.05000000074505806, 0.3499999940395355)
                color3f inputs:bus_color = (0.8500000238418579, 0.8500000238418579, 0.8999999761581421)
                color3f inputs:frame_color = (0.3499999940395355, 0.3499999940395355, 0.3799999952316284)
                float inputs:cell_rows = 8.0
                float inputs:cell_cols = 12.0
                float inputs:cell_gap = 0.019999999552965164
                float inputs:bus_width = 0.004000000189989805
                float inputs:border = 0.03999999910593033
                token outputs:surface
            }
        }
    }
    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0.0, -0.5, 0.0)
        double3 xformOp:scale = (200.0, 1.0, 200.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.4000000059604645, 0.4000000059604645, 0.44999998807907104)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </SunTrackerTest/PhysicsMaterials/Friction_1_0>
    }
    def Camera "Avatar" (
        prepend apiSchemas = ["LunCoCameraAPI", "LunCoAvatarAPI"]
    )
    {
        uniform bool lunco:avatar = true
        double3 lunco:cameraLookAt = (0.0, 4.0, 0.0)
        double3 xformOp:translate = (10.0, 7.0, 12.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def "Controls" (
            prepend references = @lunco://vessels/control_profiles.usda@</AvatarControls>
        )
        {
        }
    }
    over "Sun"
    {
        double3 xformOp:rotateXYZ = (-35.0, 40.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
    def Xform "SolarTower"
    {
        double3 xformOp:translate = (0.0, 0.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Cylinder "Mast" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            uniform token axis = "Y"
            double radius = 0.18
            double height = 5.0
            double3 xformOp:translate = (0.0, 2.7, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(0.5, 0.5, 0.5199999809265137)]
            float physics:mass = 100.0
            bool physics:rigidBodyEnabled = false
            def Cube "Pad"
            {
                double size = 1.0
                double3 xformOp:translate = (0.0, -2.6, 0.0)
                double3 xformOp:scale = (2.0, 0.2, 2.0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                color3f[] primvars:displayColor = [(0.3199999928474426, 0.3100000023841858, 0.30000001192092896)]
                bool physics:collisionEnabled = false
            }
        }
        def Cylinder "YawHead" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            uniform token axis = "Y"
            double radius = 0.4
            double height = 0.5
            double3 xformOp:translate = (0.0, 5.3, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(0.44999998807907104, 0.44999998807907104, 0.47999998927116394)]
            float physics:mass = 50.0
            def Cube "Panel" (
                prepend apiSchemas = "MaterialBindingAPI"
            )
            {
                double size = 1.0
                double3 xformOp:translate = (0.0, 1.5, 0.0)
                double3 xformOp:scale = (4.0, 3.0, 0.06)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                color3f[] primvars:displayColor = [(0.05000000074505806, 0.05000000074505806, 0.3499999940395355)]
                bool physics:collisionEnabled = false
                rel material:binding = </SunTrackerTest/Looks/SolarPanel>
            }
        }
        def PhysicsRevoluteJoint "Hinge"
        {
            rel physics:body0 = </SunTrackerTest/SolarTower/Mast>
            rel physics:body1 = </SunTrackerTest/SolarTower/YawHead>
            uniform token physics:axis = "Y"
            point3f physics:localPos0 = (0.0, 2.5999999046325684, 0.0)
            point3f physics:localPos1 = (0.0, 0.0, 0.0)
            float inputs:angle
            float inputs:angle.connect = </SunTrackerTest/SolarTower/Controller.outputs:yaw>
        }
        def Xform "Environment" (
            prepend references = @lunco://components/environment/probe.usda@</EnvironmentProbe>
        )
        {
        }
        def Xform "Controller" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://models/LunCo/Pointing/SunTracker.mo@
            custom double inputs:target_mount_x
            double inputs:target_mount_x.connect = </SunTrackerTest/SolarTower/Environment.outputs:sun_mount_x>
            custom double inputs:target_mount_y
            double inputs:target_mount_y.connect = </SunTrackerTest/SolarTower/Environment.outputs:sun_mount_y>
            custom double inputs:target_mount_z
            double inputs:target_mount_z.connect = </SunTrackerTest/SolarTower/Environment.outputs:sun_mount_z>
        }
    }
    def Scope "Scenario"
    {
        custom string lunco:scenario = "sun-tracker"
        def Scope "Test" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/sun_tracker.rhai@
        }
    }
    def Xform "SpacecraftTarget" (
        prepend apiSchemas = "LunCoDirectionTargetAPI"
    )
    {
        uniform token lunco:directionTarget:id = "spacecraft_b"
        custom double3 xformOp:translate = (10.0, 0.0, 0.0)
        custom token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "SpacecraftController" (
        prepend apiSchemas = "LunCoProgramAPI"
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://models/LunCo/Pointing/SunTracker.mo@
        custom double inputs:target_mount_x
        double inputs:target_mount_x.connect = </SunTrackerTest/SolarTower/Environment.outputs:spacecraft_b_mount_x>
        custom double inputs:target_mount_y
        double inputs:target_mount_y.connect = </SunTrackerTest/SolarTower/Environment.outputs:spacecraft_b_mount_y>
        custom double inputs:target_mount_z
        double inputs:target_mount_z.connect = </SunTrackerTest/SolarTower/Environment.outputs:spacecraft_b_mount_z>
    }
}
