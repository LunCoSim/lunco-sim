#usda 1.0
(
    defaultPrim = "RoboticHandControls"
    upAxis = "Y"
    metersPerUnit = 1
)

# Production-path behavioural fixture for the authored robotic hand.
# USD supplies the mechanism, Modelica supplies the command shaping and joint
# targets, and the Rhai observer supplies only semantic command transitions.
def Xform "RoboticHandControls" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    kind = "assembly"
    doc = "Three-finger hand driven through Modelica and generic Rhai port commands."
    prepend apiSchemas = ["LunCoCatalogAPI"]
)
{
    uniform bool lunco:spawnable = false

    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0.0, -0.5, 0.0)
        double3 xformOp:scale = (80.0, 1.0, 80.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.4, 0.4, 0.45)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </RoboticHandControls/PhysicsMaterials/Friction_1_0>
    }

    over "Sun"
    {
        double3 xformOp:rotateXYZ = (-35.0, 40.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def Xform "Avatar" (
        prepend apiSchemas = ["LunCoAvatarAPI"]
    )
    {
        def "Controls" (
            prepend references = @lunco://vessels/control_profiles.usda@</AvatarControls>
        )
        {
        }
        uniform bool lunco:avatar = true
        uniform token lunco:cameraMode = "freeflight"
        double3 lunco:cameraLookAt = (0.0, 1.5, 0.0)
        double3 xformOp:translate = (0.0, 7.0, 12.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Camera "ControlsCam" (
        prepend apiSchemas = ["LunCoCameraAPI"]
    )
    {
        custom double3 lunco:cameraLookAt = (0.0, 1.5, 0.0)
        double3 xformOp:translate = (0.0, 7.0, 12.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float focalLength = 35.0
        float2 clippingRange = (0.1, 100000.0)
    }

    def Xform "Hand" (
        prepend references = @lunco://vessels/rigs/robotic_hand.usda@</RoboticHand>
    )
    {
        double3 xformOp:translate = (0.0, 3.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Scope "Scenario"
    {
        custom string lunco:scenario = "robotic-hand-controls"

        def Scope "ControlsTest" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/robotic_hand_controls.rhai@
        }
    }
}
