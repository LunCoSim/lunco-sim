#usda 1.0
(
    defaultPrim = "Engine"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "Engine"
{
    def Xform "Exhaust"
    {
        def Scope "Looks"
        {
            def Material "Flame_Mat"
            {
                custom token outputs:surface
                token outputs:surface.connect = </Engine/Exhaust/Looks/Flame_Mat/Surface.outputs:surface>
                def Shader "Surface"
                {
                    float inputs:throttle = 1.0
                    float inputs:flicker_scale = 7.0
                    asset info:wgsl:sourceAsset = @lunco://shaders/plume.wgsl@
                    color3f inputs:core_color = (1.0, 1.0, 1.0)
                    uniform token info:implementationSource = "sourceAsset"
                    float inputs:plume_length_fraction = 1.0
                    float inputs:steps = 64.0
                    float inputs:flicker = 0.0
                    color3f inputs:edge_color = (1.0, 1.0, 1.0)
                    token outputs:surface = ""
                    float inputs:fuel_color_r = 1.0
                    float inputs:fuel_color_g = 1.0
                    float inputs:fuel_color_b = 1.0
                    custom float inputs:bound_radius_m = 1.0
                    custom float inputs:profile_length_m = 4.0
                    custom float inputs:luminous_efficacy_lm_w = 200.0
                    custom float inputs:radius_m_0 = 1.0
                    custom float inputs:radius_m_1 = 1.0
                    custom float inputs:radius_m_2 = 1.0
                    custom float inputs:radius_m_3 = 1.0
                    custom float inputs:radius_m_4 = 1.0
                    custom float inputs:temperature_k_0 = 2000.0
                    custom float inputs:temperature_k_1 = 2000.0
                    custom float inputs:temperature_k_2 = 2000.0
                    custom float inputs:temperature_k_3 = 2000.0
                    custom float inputs:temperature_k_4 = 2000.0
                    custom float inputs:emission_w_m3_0 = 1000.0
                    custom float inputs:emission_w_m3_1 = 1000.0
                    custom float inputs:emission_w_m3_2 = 1000.0
                    custom float inputs:emission_w_m3_3 = 1000.0
                    custom float inputs:emission_w_m3_4 = 1000.0
                    custom float inputs:energy_fraction = 1.0
                    custom float inputs:radial_width = 1.0
                    custom float inputs:flow_phase_sin = 0.0
                    custom float inputs:flow_phase_cos = 1.0
                }
            }
        }
        def Cylinder "Flame" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            bool lunco:surface:additive = true
            bool physics:collisionEnabled = false
            float[] primvars:displayOpacity = [0.41999998688697815]
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
            double height = 1.0
            double radius = 1.0
            uniform token axis = "Y"
            double3 xformOp:scale = (1.0, 4.0, 1.0)
            bool primvars:doNotCastShadows = true
            uniform token purpose = "render"
            double3 xformOp:rotateXYZ = (180.0, 0.0, 0.0)
            uniform bool doubleSided = true
            double3 xformOp:translate = (0.0, -2.0, 0.0)
            custom rel material:binding = </Engine/Exhaust/Looks/Flame_Mat>
            custom float inputs:throttle = 1.0
            custom float inputs:plume_length_fraction = 1.0
            custom float inputs:flicker = 0.0
            custom float inputs:energy_fraction = 1.0
            custom float inputs:radial_width = 1.0
            custom float inputs:bound_radius_m = 1.0
            custom float inputs:profile_length_m = 4.0
            custom float inputs:luminous_efficacy_lm_w = 200.0
            custom float inputs:radius_m_0 = 1.0
            custom float inputs:temperature_k_0 = 2000.0
            custom float inputs:emission_w_m3_0 = 1000.0
            custom float inputs:radius_m_1 = 1.0
            custom float inputs:temperature_k_1 = 2000.0
            custom float inputs:emission_w_m3_1 = 1000.0
            custom float inputs:radius_m_2 = 1.0
            custom float inputs:temperature_k_2 = 2000.0
            custom float inputs:emission_w_m3_2 = 1000.0
            custom float inputs:radius_m_3 = 1.0
            custom float inputs:temperature_k_3 = 2000.0
            custom float inputs:emission_w_m3_3 = 1000.0
            custom float inputs:radius_m_4 = 1.0
            custom float inputs:temperature_k_4 = 2000.0
            custom float inputs:emission_w_m3_4 = 1000.0
        }
    }
    def Scope "Looks"
    {
        def Material "Nozzle_Mat"
        {
            custom token outputs:surface
            token outputs:surface.connect = </Engine/Looks/Nozzle_Mat/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                token outputs:surface = ""
                color3f inputs:diffuseColor = (0.1599999964237213, 0.17000000178813934, 0.18000000715255737)
                float inputs:metallic = 0.8500000238418579
                float inputs:roughness = 0.47999998927116394
            }
        }
    }
    def Camera "Camera" (
        prepend apiSchemas = ["LunCoCameraAPI"]
    )
    {
        custom double3 xformOp:translate = (0.0, -2.0, 8.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float focalLength = 35.0
        float2 clippingRange = (0.009999999776482582, 1000.0)
        token projection = "perspective"
        custom token lunco:cameraRole = "viewport"
    }
    def Material "Opaque"
    {
        token outputs:surface
        token outputs:surface.connect = </Engine/Opaque/Surface.outputs:surface>
        def Shader "Surface"
        {
            uniform token info:implementationSource = "sourceAsset"
            custom asset info:wgsl:sourceAsset = @lunco://shaders/tests/opaque_depth_probe.wgsl@
            custom color4f inputs:color = (0.0, 0.009999999776482582, 0.10000000149011612, 1.0)
            custom token outputs:surface = ""
        }
    }
    def Cube "Occluder"
    {
        double size = 2.0
        custom double3 xformOp:translate = (0.0, -2.0, 0.0)
        custom double3 xformOp:scale = (0.18, 1.5, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        custom rel material:binding = </Engine/Opaque>
    }
    def DistantLight "Sun"
    {
        float inputs:intensity = 1.0
    }
    def Scope "Director" (
        prepend apiSchemas = ["LunCoCameraTrackAPI"]
    )
    {
        token lunco:activeCamera
        token lunco:activeCamera.timeSamples = {
            0.0: "Camera",
        }
    }
    def Camera "OrthographicCamera" (
        prepend apiSchemas = ["LunCoCameraAPI"]
    )
    {
        custom double3 xformOp:translate = (0.0, -2.0, 8.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float2 clippingRange = (0.009999999776482582, 1000.0)
        token projection = "orthographic"
        float horizontalAperture = 60.0
        float verticalAperture = 33.75
        uniform token lunco:cameraRole = "viewport"
    }
    def Scope "Test" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://scenarios/tests/plume_depth_occlusion.rhai@
    }
}
