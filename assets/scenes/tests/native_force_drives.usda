#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "World" (
    prepend apiSchemas = "LunCoEpochAPI"
)
{
    double lunco:time:epochJd = 2451545.0
    def PhysicsScene "Physics"
    {
        float physics:gravityMagnitude = 0.0
    }
    def DistantLight "Sun"
    {
        float inputs:intensity = 1000.0
    }
    def Cube "FiniteHost" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI"]
    )
    {
        double size = 0.1
        double3 xformOp:translate = (0.0, 0.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 10.0
    }
    def Cube "FiniteBob" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI"]
    )
    {
        double size = 0.1
        double3 xformOp:translate = (0.0, 0.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 2.0
    }
    def PhysicsPrismaticJoint "Finite" (
        prepend apiSchemas = "PhysicsDriveAPI:linear"
    )
    {
        custom rel physics:body0 = </World/FiniteHost>
        custom rel physics:body1 = </World/FiniteBob>
        uniform token physics:axis = "X"
        bool physics:collisionEnabled = false
        float drive:linear:physics:targetPosition = 0.10000000149011612
        float drive:linear:physics:stiffness = 1000.0
        float drive:linear:physics:damping = 100.0
    }
    def Cube "ComputedHost" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI"]
    )
    {
        double size = 0.1
        double3 xformOp:translate = (0.0, 2.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 10.0
        bool physics:kinematicEnabled = true
    }
    def Cube "ComputedBob" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI"]
    )
    {
        double size = 0.1
        double3 xformOp:translate = (0.0, 2.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def PhysicsPrismaticJoint "Computed" (
        prepend apiSchemas = "PhysicsDriveAPI:linear"
    )
    {
        custom rel physics:body0 = </World/ComputedHost>
        custom rel physics:body1 = </World/ComputedBob>
        uniform token physics:axis = "X"
        bool physics:collisionEnabled = false
        float drive:linear:physics:targetPosition = 0.10000000149011612
        float drive:linear:physics:maxForce = inf
        float drive:linear:physics:stiffness = 1000.0
        float drive:linear:physics:damping = 100.0
    }
    def Cube "DampingHost" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI"]
    )
    {
        double size = 0.1
        double3 xformOp:translate = (0.0, 4.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 10.0
    }
    def Cube "DampingBob" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI"]
    )
    {
        double size = 0.1
        double3 xformOp:translate = (0.0, 4.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 2.0
        vector3f physics:velocity = (1.0, 0.0, 0.0)
    }
    def PhysicsPrismaticJoint "Damping" (
        prepend apiSchemas = "PhysicsDriveAPI:linear"
    )
    {
        custom rel physics:body0 = </World/DampingHost>
        custom rel physics:body1 = </World/DampingBob>
        uniform token physics:axis = "X"
        bool physics:collisionEnabled = false
        float drive:linear:physics:targetPosition = 0.0
        float drive:linear:physics:maxForce = 1000000000.0
        float drive:linear:physics:stiffness = 0.0
        float drive:linear:physics:damping = 100.0
    }
    def Cube "ZeroCapHost" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI"]
    )
    {
        double size = 0.1
        double3 xformOp:translate = (0.0, 6.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 10.0
    }
    def Cube "ZeroCapBob" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI"]
    )
    {
        double size = 0.1
        double3 xformOp:translate = (0.0, 6.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 2.0
    }
    def PhysicsPrismaticJoint "ZeroCap" (
        prepend apiSchemas = "PhysicsDriveAPI:linear"
    )
    {
        custom rel physics:body0 = </World/ZeroCapHost>
        custom rel physics:body1 = </World/ZeroCapBob>
