#usda 1.0
(
    defaultPrim = "SixIndependentParity"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "SixIndependentParity" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    kind = "assembly"
    doc = "One six-wheel independent-drive rover on flat ground, for authored controller motion acceptance. Raycast-only: this rover has no physical drivetrain variant."
    prepend apiSchemas = ["LunCoCatalogAPI"]
)
{
    uniform bool lunco:spawnable = false
    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0.0, -0.5, 0.0)
        double3 xformOp:scale = (500.0, 1.0, 500.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.4000000059604645, 0.4000000059604645, 0.44999998807907104)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </SixIndependentParity/PhysicsMaterials/Friction_1_0>
    }
    over "Sun"
    {
        double3 xformOp:rotateXYZ = (-35.0, 40.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
    def Camera "Avatar" (
        prepend apiSchemas = ["LunCoCameraAPI", "LunCoAvatarAPI"]
    )
    {
        uniform bool lunco:avatar = true
        double3 lunco:cameraLookAt = (0.0, 1.0, 100.0)
        double3 xformOp:translate = (0.0, 30.0, 175.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def "Controls" (
            prepend references = @lunco://vessels/control_profiles.usda@</AvatarControls>
        )
        {
        }
    }
    def Camera "MotionCam" (
        prepend apiSchemas = ["LunCoCameraAPI"]
    )
    {
        double3 lunco:cameraLookAt = (0.0, 1.0, 60.0)
        double3 xformOp:translate = (0.0, 60.0, 190.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float focalLength = 24.0
        float2 clippingRange = (0.10000000149011612, 100000.0)
    }
    def Xform "Rover" (
        prepend references = @lunco://vessels/rovers/six_wheel_independent.usda@</SixWheelIndependent>
    )
    {
        double3 xformOp:translate = (0.0, 1.1, 50.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "Chassis"
        {
            color3f[] primvars:displayColor = [(0.8500000238418579, 0.550000011920929, 0.15000000596046448)]
        }
    }
    def Scope "Scenario"
    {
        custom string lunco:scenario = "six-independent-motion"
        def Scope "MotionTest" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/six_independent_parity.rhai@
        }
    }
}
