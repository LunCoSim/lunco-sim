#usda 1.0
(
    defaultPrim = "AuthoredRuntimeContractsNegative"
    upAxis = "Y"
    metersPerUnit = 1
)

# Negative companion: the missing presentation and disabled collision are
# intentional authored defects. The scenario passes only when the production
# queries expose those omissions instead of inventing defaults.
def Xform "AuthoredRuntimeContractsNegative" (
    kind = "assembly"
    doc = "Negative fixture for missing camera/light and disabled collision."
)
{
    def Cube "UncollidableBody"
    {
        double size = 1.0
        double3 xformOp:translate = (0.0, 1.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool physics:collisionEnabled = false
    }

    def Scope "Scenario"
    {
        custom string lunco:scenario = "authored-runtime-contracts-negative"

        def Scope "Test" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/authored_runtime_contracts_negative.rhai@
        }
    }
}
