#usda 1.0
(
    defaultPrim = "NoiseContinuity"
    upAxis = "Y"
    metersPerUnit = 1.0
    documentation = "GPU value and analytic-gradient noise continuity across negative integer lattice boundaries; green panel is success."
)

def Xform "NoiseContinuity" (
    kind = "assembly"
)
{
    def Scope "Test" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://scenarios/tests/noise_continuity.rhai@
    }
    def Scope "Looks"
    {
        def Material "Noise"
        {
            token outputs:surface
            token outputs:surface.connect = </NoiseContinuity/Looks/Noise/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                custom asset info:wgsl:sourceAsset = @lunco://shaders/tests/noise_continuity.wgsl@
                custom token outputs:surface = ""
            }
        }
    }
    def Plane "Panel" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double width = 10.0
        double length = 10.0
        custom rel material:binding = </NoiseContinuity/Looks/Noise>
    }
    def Camera "Camera" (
        prepend apiSchemas = ["LunCoCameraAPI"]
    )
    {
        custom double3 xformOp:translate = (0.0, 0.0, 2.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        double3 lunco:cameraLookAt = (0.0, 0.0, 0.0)
        float focalLength = 18.0
    }
    def Scope "CameraTrack" (
        prepend apiSchemas = ["LunCoCameraTrackAPI"]
    )
    {
        token lunco:activeCamera
        token lunco:activeCamera.timeSamples = {
            0.0: "Camera",
        }
    }
}
