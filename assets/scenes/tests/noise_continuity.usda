#usda 1.0
(
    defaultPrim = "NoiseContinuity"
    upAxis = "Y"
    metersPerUnit = 1.0
    documentation = "GPU lattice continuity and per-octave value/gradient footprint filtering in 2D and 3D; green panel is success."
)

def Xform "NoiseContinuity" (
    kind = "assembly"
    prepend apiSchemas = ["LunCoEpochAPI"]
)
{
    double lunco:time:epochJd = 2461302.91528
    def Scope "Test" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://scenarios/tests/noise_continuity.rhai@
    }
    def Scope "Looks"
    {
        def Material "Noise"
        {
            token outputs:surface
            token outputs:surface.connect = </NoiseContinuity/Looks/Noise/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                custom token outputs:surface = ""
                custom asset info:wesl:sourceAsset = @lunco://shaders/tests/noise_continuity.wesl@
            }
        }
    }
    def Plane "Panel" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double width = 10.0
        double length = 10.0
        custom rel material:binding = </NoiseContinuity/Looks/Noise>
    }
    def Camera "Camera" (
        prepend apiSchemas = ["LunCoCameraAPI"]
    )
    {
        custom double3 xformOp:translate = (0.0, 0.0, 2.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        double3 lunco:cameraLookAt = (0.0, 0.0, 0.0)
        float focalLength = 18.0
    }
    def Scope "CameraTrack" (
        prepend apiSchemas = ["LunCoCameraTrackAPI"]
    )
    {
        token lunco:activeCamera
        token lunco:activeCamera.timeSamples = {
            0.0: "Camera",
        }
    }
    def DistantLight "Sun"
    {
        float inputs:intensity = 1.0
    }
}
