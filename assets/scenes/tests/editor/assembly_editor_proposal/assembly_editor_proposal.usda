#usda 1.0
(
    defaultPrim = "AssemblyEditorProposalTest"
    upAxis = "Y"
    metersPerUnit = 1
)

# Headless acceptance fixture for the Assembly Editor proposal lifecycle.
# The test scenario creates, reviews, commits, undoes, redoes, and conflicts a
# typed USD plan through the public command/query surface.
def Xform "AssemblyEditorProposalTest"
{
    def DistantLight "TestLight"
    {
        float intensity = 1.0
    }

    def Xform "Assembly"
    {
    }

    def Scope "Scenario"
    {
        custom string lunco:scenario = "assembly-editor-proposal"

        def Scope "Test" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/assembly_editor_proposal.rhai@
        }
    }
}
