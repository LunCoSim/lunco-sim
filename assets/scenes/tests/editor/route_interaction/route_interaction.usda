#usda 1.0
(
    defaultPrim = "RouteInteraction"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "RouteInteraction" (
    prepend references = @lunco://scenes/base/route_lifecycle_source.usda@</RouteLifecycleSource>
)
{
    def Scope "Scenario"
    {
        def Scope "Test" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/route_interaction.rhai@
        }
    }
    def Camera "Avatar" (
        prepend apiSchemas = ["LunCoCameraAPI", "LunCoAvatarAPI"]
    )
    {
        uniform bool lunco:avatar = true
        double3 lunco:cameraLookAt = (0.0, 1.0, 0.0)
        custom double3 xformOp:translate = (14.0, 8.0, 14.0)
        custom token[] xformOpOrder = ["xformOp:translate"]
        def "Controls" (
            prepend references = @lunco://vessels/control_profiles.usda@</AvatarControls>
        )
        {
        }
    }
}
