#usda 1.0
(
    defaultPrim = "SolarRoverTest"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "SolarRoverTest" (
    prepend references = @lunco://scenes/luncosim/solar_rover_demo.usda@</SolarRoverTest>
)
{
    over "SolarRover" (
        documentation = "Energy-cycle fixture starts facing its first route waypoint so the bounded load phase measures forward travel as well as electrical discharge."
    )
    {
        custom double3 xformOp:rotateXYZ = (0.0, -119.05460409907714, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        over "Battery"
        {
            float inputs:capacity = 0.10000000149011612
            float inputs:soc_init = 0.550000011920929
        }
        over "YawHead"
        {
            over "SolarPanel"
            {
                double parameters:area = 0.1
            }
        }
    }
    over "Route"
    {
        over "Program"
        {
            float inputs:enabled = 0.0
        }
    }
    over "Scenario"
    {
        custom string lunco:scenario = "solar-rover-energy-cycle"
        over "Mission" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/solar_rover_energy_cycle.rhai@
        }
    }
}
