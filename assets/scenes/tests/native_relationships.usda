#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "World"
{
    def Scope "RelationshipProbe"
    {
        custom double value = 2.0
        custom double outputs:speed = 1.0
        custom double inputs:drive
        double inputs:drive.connect = </World/RelationshipProbe.outputs:speed>
        custom rel links:empty = None
        custom rel links:child = </World/RelationshipProbe/Child>
        def Scope "Child"
        {
        }
    }
    def Scope "Test" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://scenarios/tests/native_relationships.rhai@
        uniform bool lunco:program:realtimeSafe = false
    }
}
