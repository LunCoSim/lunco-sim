#usda 1.0
(
    defaultPrim = "PrismaticSpringTest"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "PrismaticSpringTest" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    kind = "assembly"
    doc = "Raked prismatic springs under known loads — the landing-leg joint, isolated, in both regimes."
)
{
    uniform bool lunco:spawnable = false
    def Camera "Avatar" (
        prepend apiSchemas = ["LunCoCameraAPI", "LunCoAvatarAPI"]
    )
    {
        uniform bool lunco:avatar = true
        double3 lunco:cameraLookAt = (0.0, 9.0, 0.0)
        double3 xformOp:translate = (6.0, 10.0, 6.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def "Controls" (
            prepend references = @lunco://vessels/control_profiles.usda@</AvatarControls>
        )
        {
        }
    }
    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0.0, -0.5, 0.0)
        double3 xformOp:scale = (50.0, 1.0, 50.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.12999999523162842, 0.125, 0.11999999731779099)]
        bool physics:collisionEnabled = true
    }
    def Xform "AnchorExt" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        double3 xformOp:translate = (-3.0, 10.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool physics:kinematicEnabled = true
        def Cube "Shape" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1.0
            double3 xformOp:scale = (0.6, 0.3, 0.6)
            color3f[] primvars:displayColor = [(0.3499999940395355, 0.36000001430511475, 0.4000000059604645)]
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
    }
    def Sphere "BobExt" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
    )
    {
        double radius = 0.35
        double3 xformOp:translate = (-2.57738, 9.09369, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.8500000238418579, 0.550000011920929, 0.20000000298023224)]
        float physics:mass = 500.0
        bool physics:collisionEnabled = true
    }
    def PhysicsPrismaticJoint "StrutExt" (
        prepend apiSchemas = ["PhysicsDriveAPI:linear"]
    )
    {
        rel physics:body0 = </PrismaticSpringTest/AnchorExt>
        rel physics:body1 = </PrismaticSpringTest/BobExt>
        uniform token physics:axis = "Y"
        quatf physics:localRot0 = (-0.21644000709056854, 0.0, 0.0, 0.9762960076332092)
        quatf physics:localRot1 = (-0.21644000709056854, 0.0, 0.0, 0.9762960076332092)
        float physics:lowerLimit = -1.0
        float physics:upperLimit = 1.0
        uniform token drive:linear:physics:type = "force"
        float drive:linear:physics:stiffness = 4000.0
        float drive:linear:physics:damping = 2200.0
        float drive:linear:physics:targetPosition = 0.0
        float drive:linear:physics:maxForce = 20000.0
        point3f physics:localPos0 = (0.4226199984550476, -0.9063100218772888, 0.0)
    }
    def Xform "AnchorComp" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        double3 xformOp:translate = (3.0, 8.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool physics:kinematicEnabled = true
        def Cube "Shape" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1.0
            double3 xformOp:scale = (0.6, 0.3, 0.6)
            color3f[] primvars:displayColor = [(0.3499999940395355, 0.36000001430511475, 0.4000000059604645)]
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
    }
    def Sphere "BobComp" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
    )
    {
        double radius = 0.35
        double3 xformOp:translate = (3.42262, 8.90631, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.30000001192092896, 0.699999988079071, 0.8999999761581421)]
        float physics:mass = 500.0
        bool physics:collisionEnabled = true
    }
    def PhysicsPrismaticJoint "StrutComp" (
        prepend apiSchemas = ["PhysicsDriveAPI:linear"]
    )
    {
        rel physics:body0 = </PrismaticSpringTest/AnchorComp>
        rel physics:body1 = </PrismaticSpringTest/BobComp>
        uniform token physics:axis = "Y"
        quatf physics:localRot0 = (0.9762960076332092, 0.0, 0.0, -0.21644000709056854)
        quatf physics:localRot1 = (0.9762960076332092, 0.0, 0.0, -0.21644000709056854)
        float physics:lowerLimit = -1.0
        float physics:upperLimit = 1.0
        uniform token drive:linear:physics:type = "force"
        float drive:linear:physics:stiffness = 4000.0
        float drive:linear:physics:damping = 2200.0
        float drive:linear:physics:targetPosition = 0.0
        float drive:linear:physics:maxForce = 20000.0
        point3f physics:localPos0 = (0.4226199984550476, 0.9063100218772888, 0.0)
    }
    def Xform "AnchorLegLike" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        double3 xformOp:translate = (0.0, 10.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool physics:kinematicEnabled = true
        def Cube "Shape" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1.0
            double3 xformOp:scale = (0.6, 0.3, 0.6)
            color3f[] primvars:displayColor = [(0.3499999940395355, 0.36000001430511475, 0.4000000059604645)]
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
    }
    def Cube "BobLegLike" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0.42262, 9.09369, 0.0)
        double3 xformOp:rotateXYZ = (0.0, 0.0, 25.0)
        double3 xformOp:scale = (0.5, 0.5, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.6000000238418579, 0.8500000238418579, 0.4000000059604645)]
        float physics:mass = 500.0
        bool physics:collisionEnabled = true
    }
    def PhysicsPrismaticJoint "StrutLegLike" (
        prepend apiSchemas = ["PhysicsDriveAPI:linear"]
    )
    {
        rel physics:body0 = </PrismaticSpringTest/AnchorLegLike>
        rel physics:body1 = </PrismaticSpringTest/BobLegLike>
        uniform token physics:axis = "Y"
        quatf physics:localRot0 = (-0.21644000709056854, 0.0, 0.0, 0.9762960076332092)
        quatf physics:localRot1 = (0.0, 0.0, 0.0, 1.0)
        float physics:lowerLimit = -1.0
        float physics:upperLimit = 1.0
        uniform token drive:linear:physics:type = "force"
        float drive:linear:physics:stiffness = 4000.0
        float drive:linear:physics:damping = 2200.0
        float drive:linear:physics:targetPosition = 0.0
        float drive:linear:physics:maxForce = 20000.0
        point3f physics:localPos0 = (0.4226199984550476, -0.9063100218772888, 0.0)
    }
    def Scope "Scenario"
    {
        custom string lunco:scenario = "prismatic-spring"
        def Scope "Mission" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/prismatic_spring.rhai@
        }
    }
}
