#usda 1.0
(
    defaultPrim = "RhaiLintPolicy"
    metersPerUnit = 1
)

def Xform "RhaiLintPolicy"
{
    def Scope "Scenario"
    {
        def Scope "Test" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/rhai_lint_policy.rhai@
        }
    }
}
