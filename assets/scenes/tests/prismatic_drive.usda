#usda 1.0
(
    defaultPrim = "SandboxScene"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "SandboxScene" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    kind = "assembly"
    documentation = "A platform that slides up and down a vertical rail. Checks that a motorized slider can move to a chosen height and hold there against gravity."
    prepend apiSchemas = "LunCoCatalogAPI"
)
{
    uniform bool lunco:spawnable = false
    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0.0, -0.5, 0.0)
        double3 xformOp:scale = (200.0, 1.0, 200.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.4000000059604645, 0.4000000059604645, 0.44999998807907104)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </SandboxScene/PhysicsMaterials/Friction_1_0>
    }
    def Camera "Avatar" (
        prepend apiSchemas = ["LunCoCameraAPI", "LunCoAvatarAPI"]
    )
    {
        uniform bool lunco:avatar = true
        double3 lunco:cameraLookAt = (0.0, 5.0, 0.0)
        double3 xformOp:translate = (0.0, 6.0, 12.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def "Controls" (
            prepend references = @lunco://vessels/control_profiles.usda@</AvatarControls>
        )
        {
        }
    }
    def Cube "Base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        double size = 0.6
        double3 xformOp:translate = (0.0, 6.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(1.0, 0.20000000298023224, 0.20000000298023224)]
        float physics:mass = 1.0
        bool physics:kinematicEnabled = true
    }
    def Xform "Platform" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        double3 xformOp:translate = (0.0, 4.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 50.0
        def Cube "Shape" (
            prepend apiSchemas = "PhysicsCollisionAPI"
        )
        {
            double size = 0.5
            double3 xformOp:scale = (1.6, 0.3, 1.6)
            color3f[] primvars:displayColor = [(0.20000000298023224, 0.6000000238418579, 1.0)]
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
    }
    def PhysicsPrismaticJoint "Lift" (
        prepend apiSchemas = "PhysicsDriveAPI:linear"
    )
    {
        rel physics:body0 = </SandboxScene/Base>
        rel physics:body1 = </SandboxScene/Platform>
        uniform token physics:axis = "Y"
        point3f physics:localPos0 = (0.0, 0.0, 0.0)
        point3f physics:localPos1 = (0.0, 2.0, 0.0)
        float physics:lowerLimit = -3.0
        float physics:upperLimit = 0.5
        float drive:linear:physics:targetPosition = -1.5
        float drive:linear:physics:maxForce = 5000.0
        float drive:linear:physics:stiffness = 18000.0
        float drive:linear:physics:damping = 3800.0
    }
    def Scope "Scenario"
    {
        custom string lunco:scenario = "prismatic-drive"
        def Scope "Test" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/prismatic_drive.rhai@
        }
    }
}
