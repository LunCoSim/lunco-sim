#usda 1.0
(
    defaultPrim = "SelectionAiWorkflow"
    upAxis = "Y"
    metersPerUnit = 1
)
def Xform "SelectionAiWorkflow" (kind = "assembly")
{
    def DistantLight "Light" { float intensity = 1 }
    def Cube "Part" {
        double size = 0.5
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cube "Other" {
        double size = 0.5
        double3 xformOp:translate = (1, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Scope "Scenario" (prepend apiSchemas = ["LunCoProgramAPI"])
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://scenarios/tests/selection_ai_workflow.rhai@
    }
}
