#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1.0
    documentation = "Generic loaded-slider static-friction and blocked-rotation reproduction; 0.12 rad slope, mu=0.8, lunar gravity, standard substeps."
)

def Xform "World" (
    prepend apiSchemas = ["LunCoEpochAPI"]
)
{
    double lunco:time:epochJd = 2451545.0
    def PhysicsScene "Physics"
    {
        float physics:gravityMagnitude = 1.6200000047683716
        vector3f physics:gravityDirection = (0.0, -1.0, 0.0)
    }
    def DistantLight "Sun"
    {
        float inputs:intensity = 1000.0
    }
    def Material "Material" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.800000011920929
        float physics:staticFriction = 0.800000011920929
        float physics:restitution = 0.0
    }
    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1.0
        custom double3 xformOp:translate = (0.011971220728891938, -0.09928086358538663, 0.0)
        custom double3 xformOp:rotateXYZ = (0.0, 0.0, 6.875493541569878)
        custom double3 xformOp:scale = (30.0, 0.2, 30.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        custom rel material:binding:physics = </World/Material>
    }
    def Cube "Load" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        double size = 0.5
        custom double3 xformOp:translate = (-0.12629637868980992, 1.0474131108258289, 0.0)
        custom double3 xformOp:rotateXYZ = (0.0, 0.0, 6.875493541569878)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        float physics:mass = 4000.0
        float3 physics:diagonalInertia = (166.6666717529297, 166.6666717529297, 166.6666717529297)
        custom rel material:binding:physics = </World/Material>
        custom bool physics:collisionEnabled = false
    }
    def Cube "Foot" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
    )
    {
        double size = 1.0
        custom double3 xformOp:translate = (-0.006584171400890565, 0.05460447497196264, 0.0)
        custom double3 xformOp:rotateXYZ = (0.0, 0.0, 6.875493541569878)
        custom double3 xformOp:scale = (1.0, 0.1, 1.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        float physics:mass = 180.0
        float3 physics:diagonalInertia = (15.149999618530273, 30.0, 15.149999618530273)
        custom rel material:binding:physics = </World/Material>
    }
    def Cube "Control" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
    )
    {
        double size = 1.0
        custom double3 xformOp:translate = (3.9646503720145745, 0.5334533041276401, 0.0)
        custom double3 xformOp:rotateXYZ = (0.0, 0.0, 6.875493541569878)
        custom double3 xformOp:scale = (1.0, 0.1, 1.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        float physics:mass = 180.0
        float3 physics:diagonalInertia = (15.149999618530273, 30.0, 15.149999618530273)
        custom rel material:binding:physics = </World/Material>
    }
    def PhysicsPrismaticJoint "Slider" (
        prepend apiSchemas = ["PhysicsDriveAPI:linear"]
    )
    {
        rel physics:body0 = </World/Load>
        rel physics:body1 = </World/Foot>
        uniform token physics:axis = "Y"
        point3f physics:localPos0 = (0.0, -1.0, 0.0)
        point3f physics:localPos1 = (0.0, 0.0, 0.0)
        bool physics:collisionEnabled = false
        float physics:lowerLimit = -0.05000000074505806
        float physics:upperLimit = 0.019999999552965164
        float drive:linear:physics:targetPosition = 0.0
        float drive:linear:physics:targetVelocity = 0.0
        float drive:linear:physics:stiffness = 85000.0
        float drive:linear:physics:damping = 19000.0
        float drive:linear:physics:maxForce = 12000.0
        uniform token drive:linear:physics:type = "force"
    }
    def Scope "Scenario" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://scenarios/tests/loaded_slider_slope.rhai@
    }
}
