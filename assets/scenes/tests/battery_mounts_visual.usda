#usda 1.0
(
    defaultPrim = "BatteryMountsVisual"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "BatteryMountsVisual" (
    prepend references = @lunco://scenes/tests/battery_mounts.usda@</BatteryMountsTest>
    kind = "assembly"
)
{
    def Xform "Sky" (
        prepend references = @lunco://components/environment/starfield_sky.usda@</StarfieldSky>
    )
    {
    }
    over "Sun"
    {
        float inputs:intensity = 15000.0
    }
    def DomeLight "ReviewFill"
    {
        float inputs:intensity = 5000.0
        float inputs:exposure = 0.0
        color3f inputs:color = (0.550000011920929, 0.6000000238418579, 0.699999988079071)
    }
    def "Rucheyok" (
        active = false
    )
    {
        bool physics:rigidBodyEnabled = false
        over "Wheel_FL"
        {
            bool physics:rigidBodyEnabled = false
        }
        over "Wheel_FR"
        {
            bool physics:rigidBodyEnabled = false
        }
        over "Wheel_RL"
        {
            bool physics:rigidBodyEnabled = false
        }
        over "Wheel_RR"
        {
            bool physics:rigidBodyEnabled = false
        }
    }
    over "Skid"
    {
        bool physics:rigidBodyEnabled = false
        over "Suspension_FL"
        {
            over "Wheel_FL"
            {
                bool physics:rigidBodyEnabled = false
            }
        }
        over "Suspension_FR"
        {
            over "Wheel_FR"
            {
                bool physics:rigidBodyEnabled = false
            }
        }
        over "Suspension_RL"
        {
            over "Wheel_RL"
            {
                bool physics:rigidBodyEnabled = false
            }
        }
        over "Suspension_RR"
        {
            over "Wheel_RR"
            {
                bool physics:rigidBodyEnabled = false
            }
        }
    }
    over "SixWheel"
    {
        bool physics:rigidBodyEnabled = false
        over "Wheel_L0"
        {
            bool physics:rigidBodyEnabled = false
        }
        over "Wheel_L1"
        {
            bool physics:rigidBodyEnabled = false
        }
        over "Wheel_L2"
        {
            bool physics:rigidBodyEnabled = false
        }
        over "Wheel_R0"
        {
            bool physics:rigidBodyEnabled = false
        }
        over "Wheel_R1"
        {
            bool physics:rigidBodyEnabled = false
        }
        over "Wheel_R2"
        {
            bool physics:rigidBodyEnabled = false
        }
    }
    over "RockerBogie"
    {
        bool physics:rigidBodyEnabled = false
        over "RockerL"
        {
            bool physics:rigidBodyEnabled = false
            over "Wheel_FL"
            {
                bool physics:rigidBodyEnabled = false
            }
        }
        over "RockerR"
        {
            bool physics:rigidBodyEnabled = false
            over "Wheel_FR"
            {
                bool physics:rigidBodyEnabled = false
            }
        }
        over "BogieL"
        {
            bool physics:rigidBodyEnabled = false
            over "Wheel_ML"
            {
                bool physics:rigidBodyEnabled = false
            }
            over "Wheel_RL"
            {
                bool physics:rigidBodyEnabled = false
            }
        }
        over "BogieR"
        {
            bool physics:rigidBodyEnabled = false
            over "Wheel_MR"
            {
                bool physics:rigidBodyEnabled = false
            }
            over "Wheel_RR"
            {
                bool physics:rigidBodyEnabled = false
            }
        }
        over "HingeL"
        {
            bool physics:jointEnabled = false
        }
        over "HingeR"
        {
            bool physics:jointEnabled = false
        }
        over "BogieHingeL"
        {
            bool physics:jointEnabled = false
        }
        over "BogieHingeR"
        {
            bool physics:jointEnabled = false
        }
    }
    def Camera "VisualCamera" (
        prepend references = @lunco://components/cameras/visual_review_camera.usda@</VisualReviewCamera>
    )
    {
        double3 lunco:cameraLookAt = (-3.0, 0.9, 0.0)
        double3 xformOp:translate = (-3.0, 5.0, 18.0)
        float focalLength = 28.0
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Scope "CameraTrack" (
        prepend apiSchemas = ["LunCoCameraTrackAPI"]
    )
    {
        token lunco:activeCamera
        token lunco:activeCamera.timeSamples = {
            0.0: "VisualCamera",
        }
    }
    over "Scenario"
    {
        over "Test"
        {
            uniform asset info:sourceAsset = @lunco://scenarios/tests/battery_mounts_visual.rhai@
        }
    }
}
