#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "World" (
    prepend apiSchemas = ["LunCoEpochAPI"]
)
{
    double lunco:time:epochJd = 2461395.5
    def PhysicsScene "Physics"
    {
        float physics:gravityMagnitude = 0.0
    }
    def Cube "Enabled" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1.0
        custom double3 xformOp:translate = (0.0, 0.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cube "Disabled" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1.0
        custom double3 xformOp:translate = (-4.0, 0.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool physics:collisionEnabled = false
    }
    def Xform "DisabledUnsupportedGeometry" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        custom double3 xformOp:translate = (8.0, 0.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool physics:collisionEnabled = false
    }
    def Cube "DisabledTrigger" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTriggerZoneAPI"]
    )
    {
        double size = 1.0
        custom double3 xformOp:translate = (12.0, 0.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool physics:collisionEnabled = false
    }
    def Cube "EnabledTrigger" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTriggerZoneAPI"]
    )
    {
        double size = 1.0
        custom double3 xformOp:translate = (16.0, 0.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool physics:collisionEnabled = true
    }
    def Cube "Body" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
    )
    {
        bool physics:collisionEnabled = false
        bool physics:kinematicEnabled = true
        float physics:mass = 1.0
        custom double3 xformOp:translate = (4.0, 0.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Cube "Child" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 0.5
            custom double3 xformOp:translate = (0.0, -2.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
    def Sphere "ProbeDisabled" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
    )
    {
        double radius = 0.2
        float physics:mass = 1.0
        vector3f physics:velocity = (0.0, -1.0, 0.0)
        custom double3 xformOp:translate = (-4.0, 2.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "ProbeEnabled" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
    )
    {
        double radius = 0.2
        float physics:mass = 1.0
        vector3f physics:velocity = (0.0, -1.0, 0.0)
        custom double3 xformOp:translate = (0.0, 2.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Scope "Test" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://scenarios/tests/collision_enabled.rhai@
    }
    def DistantLight "TestLight"
    {
    }
}
