#usda 1.0
(
    defaultPrim = "SlopeTest"
    upAxis = "Y"
    metersPerUnit = 1
)

# Runs the actual B3 lesson and observes the real tilt + climb objectives.
def Xform "SlopeTest" (
    prepend references = @lunco://tutorials/basic/slope_test.usda@</SlopeTest>
)
{
    custom string lunco:scenario = "tutorial-slopes-tipover"

    # This lesson is a local lunar mobility exercise; it does not author a
    # celestial frame for Earth tracking. The shared rover's communications
    # mechanism is therefore explicitly scenery in this stage. Its links are
    # disabled as well as its controller so the stage contains no unattached
    # dynamic mechanism bodies and no request for an absent Earth direction.
    over "Rover"
    {
        over "Antenna"
        {
            over "YawHead"
            {
                bool physics:rigidBodyEnabled = false

                over "DishGimbal"
                {
                    bool physics:rigidBodyEnabled = false
                }
            }
            over "EarthTrackerController" (
                active = false
            )
            {
            }
            over "YawJoint" (
                active = false
            )
            {
            }
            over "ElevationJoint" (
                active = false
            )
            {
            }
        }
    }

    def Scope "Scenario" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://tutorials/basic/b3_slopes_tipover.rhai@
    }

    def Xform "TestHost"
    {
        def Scope "Test" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/tutorial_slopes_tipover.rhai@
        }
    }
}
