#usda 1.0
(
    defaultPrim = "RockerBogieHighSpeed"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "RockerBogieHighSpeed" (
    kind = "assembly"
    prepend apiSchemas = "LunCoEpochAPI"
)
{
    double lunco:anchor:lat = 26.13
    double lunco:anchor:lon = 3.63
    double lunco:anchor:height = 0.0
    int lunco:anchor:body = 301
    double lunco:time:epochJd = 2461395.5
    def Xform "SolarSystem" (
        prepend references = @lunco://celestial/solar_system.usda@</SolarSystem>
    )
    {
    }
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0.0, -1.0, 0.0)
        float physics:gravityMagnitude = 1.6200000047683716
    }
    def Scope "PhysicsMaterials"
    {
        def Material "Friction_1_0" (
            prepend apiSchemas = "PhysicsMaterialAPI"
        )
        {
            float physics:dynamicFriction = 1.0
            float physics:staticFriction = 1.0
        }
    }
    def Plane "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI", "MaterialBindingAPI"]
    )
    {
        token lunco:terrain:surfaceRole = "flat-site"
        double width = 1.0
        double length = 1.0
        token axis = "Y"
        double3 xformOp:translate = (0.0, 0.0, 0.0)
        double3 xformOp:scale = (200.0, 1.0, 200.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.4000000059604645, 0.4000000059604645, 0.44999998807907104)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </RockerBogieHighSpeed/PhysicsMaterials/Friction_1_0>
    }
    def Xform "Rover" (
        prepend references = @lunco://vessels/rovers/rocker_bogie.usda@</RockerBogie>
    )
    {
        double3 xformOp:translate = (0.0, 0.9, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "RockerL"
        {
            float physxRigidBody:angularDamping = 3.0
        }
        over "RockerR"
        {
            float physxRigidBody:angularDamping = 3.0
        }
        over "BogieL"
        {
            float physxRigidBody:angularDamping = 3.0
        }
        over "BogieR"
        {
            float physxRigidBody:angularDamping = 3.0
        }
    }
    def Scope "Scenario"
    {
        custom string lunco:scenario = "rocker-bogie-high-speed"
        def Scope "Test" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/rocker_bogie_high_speed.rhai@
        }
    }
}
