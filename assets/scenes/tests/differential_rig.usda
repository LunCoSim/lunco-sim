#usda 1.0
(
    defaultPrim = "DiffRigTest"
    upAxis = "Y"
    metersPerUnit = 1
)

# G5 isolated differential test — coupling ON. See differential_rig.usda.
#   sandbox --scene scenes/tests/differential_rig.usda
# Verify (ListPorts): HingeR.angle ≈ −HingeL.angle (rocker B mirrors A).

def Xform "DiffRigTest" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    kind = "assembly"
    doc = "A test stand for the balancing linkage a rover uses between its left and right sides. With it switched on, the two sides move as mirror images of each other."
    prepend apiSchemas = ["LunCoCatalogAPI"]
)
{

    uniform bool lunco:spawnable = false

    def Cube "Ground" (prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI"])
    {
        double size = 1.0
        double3 xformOp:translate = (0, -0.5, 0)
        double3 xformOp:scale = (200.0, 1.0, 200.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.4, 0.4, 0.45)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </DiffRigTest/PhysicsMaterials/Friction_1_0>
    }
    over "Sun"
    {
        double3 xformOp:rotateXYZ = (-35.0, 40.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
    def Xform "Avatar" (
        prepend apiSchemas = ["LunCoAvatarAPI"]
    )
    {
        uniform bool lunco:avatar = true
        uniform token lunco:cameraMode = "freeflight"
        double3 lunco:cameraLookAt = (0.0, 1.5, 0.0)
        double3 xformOp:translate = (6.0, 4.0, 7.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "Rig" (
        prepend references = @lunco://vessels/rovers/differential_rig.usda@</DiffRig>
    )
    {
        double3 xformOp:translate = (0, 1.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Scope "Scenario"
    {
        custom string lunco:scenario = "diff-rig"

        def Scope "DiffTest" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform asset info:sourceAsset = @lunco://scenarios/tests/differential_rig.rhai@

            # Which case this stage is. The scenario asserts mirroring or
            # independence on the strength of this, rather than inferring it from
            # the coupling it is meant to be testing.
            float lunco:param:coupled = 1.0
        }
    }
}
