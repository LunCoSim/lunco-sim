#usda 1.0
(
    defaultPrim = "ParametricSurfaceTest"
    upAxis = "Y"
    metersPerUnit = 1
)

# Asset-level acceptance for the shared parametric surface contract. The test
# references the two shipped NurbsPatch prims directly, so it does not load the
# surrounding vehicle assemblies or duplicate their authored parameters.
def Xform "ParametricSurfaceTest" (
    kind = "assembly"
)
{
    def "AntennaReflector" (
        prepend references = @lunco://components/comms/antenna.usda@</CommsAntenna/YawHead/DishGimbal/DishHead/Reflector>
    )
    {
    }

    def "LanderNozzle" (
        prepend references = @lunco://vessels/landers/descent_lander.usda@</DescentLander/Nozzle>
    )
    {
    }

    def Scope "Test" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://scenarios/tests/parametric_surface.rhai@
    }
}
