#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1.0
    documentation = "GPU native-light versus terrain horizon sign and zero-angle sky material gate."
)

def Xform "World" (
    prepend apiSchemas = ["LunCoEpochAPI"]
    kind = "assembly"
)
{
    double lunco:time:epochJd = 2461302.91528
    def Scope "Test" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://scenarios/tests/sun_material_precision.rhai@
    }
    def Scope "Looks"
    {
        def Material "Ground"
        {
            token outputs:surface
            token outputs:surface.connect = </World/Looks/Ground/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                custom asset info:wgsl:sourceAsset = @lunco://shaders/tests/sun_material_precision.wgsl@
                custom token outputs:surface = ""
            }
        }
        def Material "Sky"
        {
            token outputs:surface
            token outputs:surface.connect = </World/Looks/Sky/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                custom asset info:wgsl:sourceAsset = @lunco://shaders/tests/sun_radius_precision.wgsl@
                custom token outputs:surface = ""
            }
        }
    }
    def Xform "Sky" (
        prepend apiSchemas = ["LunCoProceduralSkyAPI", "MaterialBindingAPI"]
    )
    {
        custom rel material:binding = </World/Looks/Sky>
    }
    def DistantLight "Sun"
    {
        float inputs:intensity = 128000.0
        float inputs:angle = 0.0
        custom double3 xformOp:rotateXYZ = (-17.188733853924695, 28.64788975654116, 0.0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
    def Plane "Ground" (
        prepend apiSchemas = ["LunCoTerrainAPI", "MaterialBindingAPI"]
    )
    {
        uniform token axis = "Y"
        double width = 100.0
        double length = 100.0
        bool lunco:terrain:horizonShadows = true
        int lunco:terrain:horizonMapResolution = 8
        custom rel material:binding = </World/Looks/Ground>
    }
    def Camera "Camera" (
        prepend apiSchemas = ["LunCoCameraAPI"]
    )
    {
        custom double3 xformOp:translate = (0.0, 1.0, 5.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        double3 lunco:cameraLookAt = (0.0, 1.0, 0.0)
        float focalLength = 18.0
    }
    def Scope "CameraTrack" (
        prepend apiSchemas = ["LunCoCameraTrackAPI"]
    )
    {
        token lunco:activeCamera
        token lunco:activeCamera.timeSamples = {
            0.0: "Camera",
        }
    }
}
