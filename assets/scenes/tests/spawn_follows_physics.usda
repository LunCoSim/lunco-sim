#usda 1.0
(
    defaultPrim = "SpawnFollowsPhysics"
    upAxis = "Y"
    metersPerUnit = 1
)

# Production scene-test contract for runtime catalog spawning. The scenario
# spawns the shipped Modelica balloon, waits for its dynamic body to move under
# this authored gravity, and compares the public simulation pose with the
# reflected render translation.
def Xform "SpawnFollowsPhysics" (
    kind = "assembly"
    prepend apiSchemas = ["LunCoCatalogAPI"]
    doc = "Runtime catalog spawns must expose one moving physics/render pose."
)
{
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, -1, 0)
        float physics:gravityMagnitude = 9.81
    }

    def Scope "Scenario"
    {
        custom string lunco:scenario = "spawn-follows-physics"

        def Scope "Test" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/spawn_follows_physics.rhai@
        }
    }
}
