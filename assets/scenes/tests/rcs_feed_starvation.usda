#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "World"
{
    def Scope "Jet" (
        prepend apiSchemas = "LunCoProgramAPI"
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://models/LunCo/Propulsion/RCSJet.mo@
        float inputs:valve_opening = 1.0
        float inputs:f_nom_n = 111.2055435180664
        float inputs:plume_width_m = 0.03999999910593033
        float inputs:available_fuel_mass_kg = 1.0
        float inputs:available_oxidizer_mass_kg = 1.0
        float outputs:thrust_n = 0.0
        float outputs:mass_flow_kgs = 0.0
        float outputs:light_intensity = 0.0
        float outputs:activity = 0.0
        float outputs:visual_length_fraction = 0.0
        float outputs:envelope_radius_m = 0.0
        float outputs:envelope_length_m = 0.0
    }
    def Scope "Scenario" (
        prepend apiSchemas = "LunCoProgramAPI"
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://scenarios/tests/rcs_feed_starvation.rhai@
    }
}
