#usda 1.0
(
    defaultPrim = "LandingLegsTest"
    upAxis = "Y"
    metersPerUnit = 1
)

# The landing gear on its own: one airframe, four sprung legs, flat ground.
#
# No guidance, no rover, no mission — a lander dropped from 3 m so the legs take
# the vehicle's weight within the first two seconds and the run observes the full
# eight-second ring-down. What it pins down is the LEG MECHANISM: that the raked
# prismatic joints start satisfied, that the compound leg bodies stroke and settle
# instead of diverging, and that the hull ends the drop level and at ride height.
#
#   target/debug/luncosim test --scene assets/scenes/tests/landing_legs.usda

def Xform "LandingLegsTest" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    kind = "assembly"
    doc = "A lander dropped onto its legs from 3 m — the landing gear with nothing else attached."
)
{

    uniform bool lunco:spawnable = false

    # The reusable lander includes an Earth tracker; this drop test composes
    # the celestial source and lunar frame explicitly so the tracker receives
    # real no-magic Earth direction data while the gear is exercised.
    double lunco:anchor:lat = 26.13
    double lunco:anchor:lon = 3.63
    double lunco:anchor:height = 0.0
    int lunco:anchor:body = 301

    def "SolarSystem" (
        prepend references = @lunco://celestial/solar_system.usda@</SolarSystem>
    )
    {
    }

    def Plane "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI", "MaterialBindingAPI"]
    )
    {
        token lunco:terrain:surfaceRole = "flat-site"
        double width = 1.0
        double length = 1.0
        token axis = "Y"
        double3 xformOp:translate = (0, 0, 0)
        double3 xformOp:scale = (200.0, 1.0, 200.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.13, 0.125, 0.12)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </LandingLegsTest/PhysicsMaterials/Friction_1_0>
    }


    def Xform "Avatar" (
        prepend apiSchemas = ["LunCoAvatarAPI"]
    )
    {
        def "Controls" (
            prepend references = @lunco://vessels/control_profiles.usda@</AvatarControls>
        )
        {
        }
        uniform bool lunco:avatar = true
        uniform token lunco:cameraMode = "freeflight"
        double3 lunco:cameraLookAt = (0.0, 3.0, 0.0)
        double3 xformOp:translate = (14.0, 6.0, 14.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # The airframe arc ONLY — no guidance component. The pads sit at about
    # y = -5.3 in the vehicle frame, so a hull at y = 8.0 gives a 3 m drop.
    def "Lander" (
        prepend references = @lunco://vessels/landers/descent_lander.usda@</DescentLander>
    )
    {
        double3 xformOp:translate = (0, 8.0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        # Exercise the landing gear by itself. The reusable vehicle normally
        # stabilises attitude even with no mission guidance; that would fire
        # physical RCS jets after an asymmetric pad strike and turn this into a
        # coupled flight-control test. Zeroing the documented airframe gain here
        # leaves every actuator demand at zero without disabling or replacing
        # any physics component.
        float inputs:attitude_hold = 0.0

    }

    def Scope "Scenario"
    {
        custom string lunco:scenario = "landing-legs"

        def Scope "Mission" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/landing_legs.rhai@
        }
    }
}
