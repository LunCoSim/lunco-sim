#usda 1.0
(
    defaultPrim = "MultiRoverStress"
    upAxis = "Y"
    metersPerUnit = 1
    doc = "Negative control with three maintained rover assemblies; the supported stress matrix starts at four."
)

def Xform "MultiRoverStress" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    kind = "assembly"
    prepend apiSchemas = ["LunCoCatalogAPI"]
)
{
    custom int lunco:roverCount = 3
    uniform bool lunco:spawnable = false

    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0, -0.5, -10)
        double3 xformOp:scale = (10, 1, 35)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.24, 0.22, 0.19)]
        bool physics:collisionEnabled = true
    }

    def Xform "Rovers"
    {
        def Xform "Rover01" (prepend references = @lunco://vessels/rovers/variants/rover_stress.usda@</RoverStress>) { double3 xformOp:translate = (-5, 1.6, 0) }
        def Xform "Rover02" (prepend references = @lunco://vessels/rovers/variants/rover_stress.usda@</RoverStress>) { double3 xformOp:translate = (0, 1.6, 0) }
        def Xform "Rover03" (prepend references = @lunco://vessels/rovers/variants/rover_stress.usda@</RoverStress>) { double3 xformOp:translate = (5, 1.6, 0) }
    }

    def Scope "Scenario"
    {
        def Scope "Test" (prepend apiSchemas = ["LunCoProgramAPI"])
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/multi_rover_stress_negative.rhai@
        }
    }
}
