#usda 1.0
(
    defaultPrim = "AckermannParity"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "AckermannParity" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    kind = "assembly"
    doc = "A parked articulated rover on an eight-degree slope, with one native-material tire and three shared-tire contacts."
    prepend apiSchemas = ["LunCoCatalogAPI"]
)
{
    uniform bool lunco:spawnable = false
    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0.0, -0.5, 0.0)
        double3 xformOp:scale = (500.0, 1.0, 500.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.4000000059604645, 0.4000000059604645, 0.44999998807907104)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </AckermannParity/PhysicsMaterials/Friction_1_0>
        custom double3 xformOp:rotateXYZ = (0.0, 0.0, 8.0)
    }
    over "Sun"
    {
        double3 xformOp:rotateXYZ = (-35.0, 40.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
    def Camera "Avatar" (
        prepend apiSchemas = ["LunCoCameraAPI", "LunCoAvatarAPI"]
    )
    {
        uniform bool lunco:avatar = true
        double3 lunco:cameraLookAt = (0.0, 1.0, 100.0)
        double3 xformOp:translate = (0.0, 30.0, 175.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def "Controls" (
            prepend references = @lunco://vessels/control_profiles.usda@</AvatarControls>
        )
        {
        }
    }
    def Camera "ParityCam" (
        prepend apiSchemas = ["LunCoCameraAPI"]
    )
    {
        double3 lunco:cameraLookAt = (0.0, 1.0, 90.0)
        double3 xformOp:translate = (0.0, 45.0, 190.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float focalLength = 24.0
        float2 clippingRange = (0.10000000149011612, 100000.0)
    }
    def Xform "RoverRaycast" (
        prepend references = @lunco://vessels/rovers/ackermann_rover.usda@</AckermannRover>
        variants = { string "drivetrain" = "raycast" }
        active = false
    )
    {
        double3 xformOp:translate = (-25.0, 1.1, 50.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "Chassis"
        {
            color3f[] primvars:displayColor = [(0.8500000238418579, 0.3499999940395355, 0.15000000596046448)]
        }
    }
    def Xform "RoverPhysical" (
        prepend references = @lunco://vessels/rovers/ackermann_rover.usda@</AckermannRover>
        variants = { string "drivetrain" = "physical" }
    )
    {
        double3 xformOp:translate = (0.0, 1.1, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        custom double3 xformOp:rotateXYZ = (0.0, 0.0, 8.0)
        over "Chassis"
        {
            color3f[] primvars:displayColor = [(0.15000000596046448, 0.44999998807907104, 0.8500000238418579)]
        }
        over "Suspension_FL"
        {
            over "Wheel_FL"
            {
                custom rel material:binding:physics = </AckermannParity/PhysicsMaterials/Friction_1_0>
            }
        }
    }
    def Scope "Scenario"
    {
        custom string lunco:scenario = "mixed-tire-parking"
        def Scope "ParityTest" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/mixed_tire_parking.rhai@
        }
    }
}
