#usda 1.0
(
    defaultPrim = "RockerBogieTest"
    upAxis = "Y"
    metersPerUnit = 1
)

# G5 CONTROL scene — identical to `rocker_bogie.usda` but the differential
# is DISABLED by zeroing the differential gear joint's angular-drive stiffness
# with a local `over` on the Rover (a local opinion overrides the referenced value).
# With the coupling off, the step under the left-front corner should ROLL the chassis
# noticeably more than the coupled case — isolating the differential's leveling effect.

def Xform "RockerBogieTest" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    kind = "assembly"
    doc = "The rocker-bogie rover over a step, but with the body-leveling linkage switched off. The body tips more, showing what the linkage normally does."
    prepend apiSchemas = ["LunCoCatalogAPI"]
)
{

    uniform bool lunco:spawnable = false

    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0, -0.5, 0)
        double3 xformOp:scale = (200.0, 1.0, 200.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.4, 0.4, 0.45)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </RockerBogieTest/PhysicsMaterials/Friction_1_0>
    }

    def Cube "Step" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (-1.29, 0.0, 1.2)
        double3 xformOp:scale = (0.7, 0.5, 0.7)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.6, 0.5, 0.4)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </RockerBogieTest/PhysicsMaterials/Friction_1_0>
    }

    over "Sun"
    {
        double3 xformOp:rotateXYZ = (-35.0, 40.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def Xform "Avatar" (
        prepend apiSchemas = ["LunCoAvatarAPI"]
    )
    {
        def "Controls" (
            prepend references = @lunco://vessels/control_profiles.usda@</AvatarControls>
        )
        {
        }
        uniform bool lunco:avatar = true
        uniform token lunco:cameraMode = "freeflight"
        double3 lunco:cameraLookAt = (0.0, 1.6, 0.0)
        double3 xformOp:translate = (7.0, 5.0, 8.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "Rover" (
        prepend references = @lunco://vessels/rovers/rocker_bogie.usda@</RockerBogie>
    )
    {
        # This control is also a local mobility test.  Keep the shared antenna
        # as visual scenery so its mechanism cannot become an unrelated dynamic
        # body or request an Earth direction that this stage does not author.
        over "Antenna"
        {
            over "YawHead"
            {
                bool physics:rigidBodyEnabled = false

                over "DishGimbal"
                {
                    bool physics:rigidBodyEnabled = false
                }
            }
            over "EarthTrackerController" (
                active = false
            )
            {
            }
            over "YawJoint" (
                active = false
            )
            {
            }
            over "ElevationJoint" (
                active = false
            )
            {
            }
        }
        # Disable the differential: zero the authored gear engagement (a local
        # `over` opinion wins over the referenced asset's value).
        over "Differential"
        {
            float drive:angular:physics:stiffness = 0.0
        }
        double3 xformOp:translate = (0, 1.6, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Scope "Scenario"
    {
        custom string lunco:scenario = "rocker-bogie-nodiff"

        def Scope "Test" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/rocker_bogie.rhai@

            # Which case this stage is — asserted on, not inferred from the
            # differential this test exists to check.
            float lunco:param:coupled = 0.0
        }
    }
}
