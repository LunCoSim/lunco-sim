#usda 1.0
(
    defaultPrim = "SixWheelVisual"
    upAxis = "Y"
    metersPerUnit = 1
)

# Visual companion for the numeric six-wheel test. Reuse the production test
# scene and replace only its observer, so the camera, sky, rover, and authored
# assembly remain one source of truth while the render gate gets a stable take.
def Xform "SixWheelVisual" (
    prepend references = @lunco://scenes/tests/six_wheel.usda@</SixWheelTest>
    kind = "assembly"
)
{
    def Xform "Sky" (
        prepend references = @lunco://components/environment/starfield_sky.usda@</StarfieldSky>
    )
    {
    }

    over "Sun"
    {
        # Keep rover material detail and headlight beams readable in the
        # calibrated fixture without changing the production rover asset.
        float inputs:intensity = 15000.0
    }

    over "Avatar"
    {
        bool active = false
        uniform bool lunco:avatar = false
    }

    def Camera "VisualCamera" (
        prepend references = @lunco://components/cameras/visual_review_camera.usda@</VisualReviewCamera>
    )
    {
        double3 lunco:cameraLookAt = (0.0, 0.4, -1.0)
        double3 xformOp:translate = (5.0, 2.8, -9.0)
        float focalLength = 24.0
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Scope "CameraTrack" (
        prepend apiSchemas = ["LunCoCameraTrackAPI"]
    )
    {
        token lunco:activeCamera.timeSamples = {
            0: "VisualCamera",
        }
    }

    over "Scenario" {
        over "Test" {
            uniform asset info:sourceAsset = @lunco://scenarios/tests/six_wheel_visual.rhai@
        }
    }
}
