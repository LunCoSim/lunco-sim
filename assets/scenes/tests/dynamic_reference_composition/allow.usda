(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "World"
{
    def Scope "CompositionTest" (
        prepend apiSchemas = "LunCoProgramAPI"
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://scenarios/tests/dynamic_reference_composition.rhai@
