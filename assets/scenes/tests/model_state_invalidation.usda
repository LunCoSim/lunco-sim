#usda 1.0
(
    defaultPrim = "ModelStateInvalidationTest"
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "ModelStateInvalidationTest" (
    kind = "assembly"
    prepend apiSchemas = ["LunCoCatalogAPI"]
)
{
    def Scope "EditableOscillator" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://models/Oscillator.mo@
        float inputs:frequency = 0.5
        float inputs:amplitude = 0.5
        float outputs:signal
    }

    def Scope "UntouchedOscillator" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://models/Oscillator.mo@
        float inputs:frequency = 0.5
        float inputs:amplitude = 0.25
        float outputs:signal
    }

    def Scope "Scenario" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://scenarios/tests/model_state_invalidation.rhai@
    }
}
