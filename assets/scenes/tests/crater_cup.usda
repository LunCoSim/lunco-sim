#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "World" (
    prepend references = @lunco://scenes/luncosim/crater_cup.usda@</World>
)
{
    def Xform "Judge"
    {
        def Scope "Verification" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/crater_cup.rhai@
        }
        def Xform "DropBall" (
            prepend references = @lunco://props/ball_dynamic.usda@</BallDynamic>
        )
        {
            custom double3 xformOp:translate = (-20.75, 5.65, 1.485)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
    over "Scout"
    {
        custom double3 xformOp:translate = (-5.0, 1.05, 8.0)
    }
}
