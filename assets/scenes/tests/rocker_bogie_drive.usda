#usda 1.0
(
    defaultPrim = "RockerBogieDrive"
    upAxis = "Y"
    metersPerUnit = 1
)

# Physics-only drive fixture. It deliberately has no scenario: the API drive
# command is applied after the same composed rover has settled in both this
# scene and rocker_bogie_drive_nodiff.usda.
def Xform "RockerBogieDrive" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    kind = "assembly"
)
{
    def Scope "Scenario"
    {
        custom string lunco:scenario = "rocker-bogie-drive"

        def Scope "Drive" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/rocker_bogie_drive.rhai@
        }
    }

    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI", "MaterialBindingAPI"]
    )
    {
        token lunco:terrain:surfaceRole = "flat-site"
        double size = 1.0
        double3 xformOp:translate = (0, -0.5, 0)
        double3 xformOp:scale = (200.0, 1.0, 200.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.4, 0.4, 0.45)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </RockerBogieDrive/PhysicsMaterials/Friction_1_0>
    }

    def Cube "Step" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (-1.29, 0.0, 1.2)
        double3 xformOp:scale = (0.7, 0.5, 0.7)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.6, 0.5, 0.4)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </RockerBogieDrive/PhysicsMaterials/Friction_1_0>
    }

    # A stable observer for the graphics acceptance take. The camera is
    # authored at the fixture root so offscreen capture does not depend on a
    # nested rover camera arriving during streaming.
    def Camera "VisualCamera" (
        prepend references = @lunco://components/cameras/visual_review_camera.usda@</VisualReviewCamera>
    )
    {
        uniform bool lunco:avatar = true
        uniform token lunco:cameraMode = "freeflight"
        double3 lunco:cameraLookAt = (12.0, 0.0, 0.0)
        double3 xformOp:translate = (20.0, 22.0, 24.0)
        float focalLength = 22.0
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "Rover" (
        prepend references = @lunco://vessels/rovers/rocker_bogie.usda@</RockerBogie>
    )
    {
        double3 xformOp:translate = (0, 1.6, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
