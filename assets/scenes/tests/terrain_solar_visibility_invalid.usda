    prepend references = @lunco://scenes/tests/terrain_solar_visibility.usda@</TerrainSolarVisibility>
)
{
    over "Scenario"
    {
        def "Test"
        {
            uniform asset info:sourceAsset = @lunco://scenarios/tests/terrain_solar_visibility_invalid.rhai@
        }
    }
    over "Power"
    {
        over "Panel"
        {
            def "Environment"
            {
            }
        }
    }
}
