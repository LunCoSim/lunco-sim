#usda 1.0
(
    defaultPrim = "FlipRoverAssetBuilderTest"
    upAxis = "Y"
    metersPerUnit = 1
)

# TEST-ONLY. The asset is assembled into AssetFrame by the Rhai recipe; this
# fixture contains only the stable parent frame needed by typed plans.
def Xform "FlipRoverAssetBuilderTest" (
    kind = "assembly"
    prepend apiSchemas = ["LunCoCatalogAPI"]
)
{
    def DistantLight "TestLight"
    {
        float intensity = 1.0
    }

    def Xform "AssetFrame"
    {
    }

    def Scope "Scenario"
    {
        custom string lunco:scenario = "flip-rover-asset-builder"
        def Scope "Test" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            asset info:sourceAsset = @lunco://scenarios/tests/flip_rover_asset_builder.rhai@
        }
    }
}
