#usda 1.0
(
    defaultPrim = "WifiLinksTest"
    upAxis = "Y"
    metersPerUnit = 1
)

# Production/headless acceptance fixture for the separate rover radio graph.
# The scenario spawns two ordinary rover assets, then requires a Wi-Fi edge while
# the direct Earth-policy graph remains edge-free.
def Xform "WifiLinksTest" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    kind = "assembly"
    doc = "Wi-Fi acceptance: two spawned rover radios connect without creating a direct Links edge."
    prepend apiSchemas = ["LunCoCatalogAPI"]
)
{
    uniform bool lunco:spawnable = false

    # The spawned radios and route nodes use scene-local positions; this fixture
    # selects no celestial direction or ephemeris frame.


    def Plane "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI", "MaterialBindingAPI"]
    )
    {
        token lunco:terrain:surfaceRole = "flat-site"
        double width = 1.0
        double length = 1.0
        token axis = "Y"
        double3 xformOp:translate = (0, 0, 0)
        double3 xformOp:scale = (100.0, 1.0, 100.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </WifiLinksTest/PhysicsMaterials/Friction_1_0>
    }

    def Scope "Scenario"
    {
        custom string lunco:scenario = "wifi-links"

        def Scope "Test" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/wifi_links.rhai@
        }
    }
}
