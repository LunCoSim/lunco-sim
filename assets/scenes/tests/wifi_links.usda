#usda 1.0
(
    defaultPrim = "WifiLinksTest"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "WifiLinksTest" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    kind = "assembly"
    documentation = "Wi-Fi acceptance: two spawned rover radios at a lunar site share the authoritative solar frame and connect without creating a direct Links edge."
    prepend apiSchemas = ["LunCoCatalogAPI", "LunCoEpochAPI"]
)
{
    uniform bool lunco:spawnable = false
    custom double lunco:anchor:lat = 26.13
    custom double lunco:anchor:lon = 3.63
    custom double lunco:anchor:height = 0.0
    custom int lunco:anchor:body = 301
    double lunco:time:epochJd = 2461395.5
    def Plane "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI", "MaterialBindingAPI"]
    )
    {
        token lunco:terrain:surfaceRole = "flat-site"
        double width = 1.0
        double length = 1.0
        token axis = "Y"
        double3 xformOp:translate = (0.0, 0.0, 0.0)
        double3 xformOp:scale = (100.0, 1.0, 100.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </WifiLinksTest/PhysicsMaterials/Friction_1_0>
    }
    def Scope "Scenario"
    {
        custom string lunco:scenario = "wifi-links"
        def Scope "Test" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/wifi_links.rhai@
        }
    }
    def Xform "SolarSystem" (
        prepend references = @lunco://celestial/solar_system.usda@</SolarSystem>
    )
    {
    }
}
