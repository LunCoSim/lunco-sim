#usda 1.0
(
    defaultPrim = "EscapeContainmentTest"
    upAxis = "Y"
    metersPerUnit = 1
)

# Negative production fixture for the physics escape boundary.
#
# The dynamic body is authored outside the only static collider's footprint. A
# production luncosim session must keep running, raise the structured terminal
# fault, and hold physics without rewriting the body's pose. Keeping the body
# laterally outside the support avoids the authored-initial-pose penetration
# gate while still exercising the world-exit boundary.
def Xform "EscapeContainmentTest" (
    kind = "assembly"
    doc = "Negative fixture: a dynamic body begins outside the static world bounds."
)
{
    def Scope "Scenario"
    {
        custom string lunco:scenario = "escape-containment"

        def Scope "EscapeContainment" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/escape_containment.rhai@
        }
    }

    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0, -0.5, 0)
        double3 xformOp:scale = (200.0, 1.0, 200.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        bool physics:collisionEnabled = true
    }

    def Cube "Escapee" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (1510.0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 1.0
        bool physics:collisionEnabled = true
    }
}
