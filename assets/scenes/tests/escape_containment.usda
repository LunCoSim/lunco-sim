#usda 1.0
(
    defaultPrim = "EscapeContainmentTest"
    upAxis = "Y"
    metersPerUnit = 1
)

# Negative production fixture for the physics escape boundary.
#
# The dynamic body is authored far below the only static collider. A production
# luncosim session must keep running, raise the structured terminal fault, and
# hold physics without rewriting the body's pose.
def Xform "EscapeContainmentTest" (
    kind = "assembly"
    doc = "Negative fixture: a dynamic body begins outside the static world bounds."
)
{
    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0, -0.5, 0)
        double3 xformOp:scale = (200.0, 1.0, 200.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        bool physics:collisionEnabled = true
    }

    def Cube "Escapee" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0, -1510.0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 1.0
        bool physics:collisionEnabled = true
    }
}
