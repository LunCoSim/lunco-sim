#usda 1.0
(
    defaultPrim = "EscapeContainmentTest"
    upAxis = "Y"
    metersPerUnit = 1
)

# Production fixture for per-object physics escape containment.
#
# Escapee begins outside the only static collider's footprint. The default
# application Rhai policy must disable its physics object while ControlBody
# continues falling and settling under the same production solver.
def Xform "EscapeContainmentTest" (
    kind = "assembly"
    doc = "An escaped dynamic object pauses while the rest of physics continues."
)
{
    def Scope "Scenario"
    {
        custom string lunco:scenario = "escape-containment"

        def Scope "EscapeContainment" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/escape_containment.rhai@
        }
    }

    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0, -0.5, 0)
        double3 xformOp:scale = (200.0, 1.0, 200.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        bool physics:collisionEnabled = true
    }

    def Cube "Escapee" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (1510.0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 1.0
        bool physics:collisionEnabled = true
    }

    def Cube "ControlBody" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0, 10, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 1.0
        bool physics:collisionEnabled = true
    }
}
