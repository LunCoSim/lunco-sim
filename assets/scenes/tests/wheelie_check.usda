#usda 1.0
(
    defaultPrim = "WheelieCheck"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "WheelieCheck" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    kind = "assembly"
    documentation = "Full throttle from rest on flat ground. The suspension must stay put and all six wheels stay down — no bogie slam, no nose-up launch."
    prepend apiSchemas = ["LunCoCatalogAPI", "LunCoEpochAPI"]
)
{
    uniform bool lunco:spawnable = false
    double lunco:anchor:lat = 26.13
    double lunco:anchor:lon = 3.63
    double lunco:anchor:height = 0.0
    int lunco:anchor:body = 301
    double lunco:time:epochJd = 2461395.5
    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0.0, -0.5, 0.0)
        double3 xformOp:scale = (200.0, 1.0, 400.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.4000000059604645, 0.4000000059604645, 0.44999998807907104)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </WheelieCheck/PhysicsMaterials/Friction_1_0>
    }
    over "Sun"
    {
        double3 xformOp:rotateXYZ = (-35.0, 40.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
    def Camera "Avatar" (
        prepend apiSchemas = ["LunCoCameraAPI", "LunCoAvatarAPI"]
    )
    {
        uniform bool lunco:avatar = true
        double3 lunco:cameraLookAt = (0.0, 1.0, 0.0)
        double3 xformOp:translate = (8.0, 3.0, -6.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def "Controls" (
            prepend references = @lunco://vessels/control_profiles.usda@</AvatarControls>
        )
        {
        }
    }
    def Xform "Rover" (
        prepend references = @lunco://vessels/rovers/variants/rover_medium.usda@</RoverMedium>
    )
    {
        double3 xformOp:translate = (0.0, 1.6, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Scope "Scenario"
    {
        custom string lunco:scenario = "wheelie-check"
        def Scope "Test" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/wheelie_check.rhai@
        }
    }
    def Xform "SolarSystem" (
        prepend references = @lunco://celestial/solar_system.usda@</SolarSystem>
    )
    {
    }
}
