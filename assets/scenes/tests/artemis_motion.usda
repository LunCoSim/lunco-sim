#usda 1.0
(
    defaultPrim = "Artemis2Review"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "Artemis2Review" (
    prepend references = @lunco://scenes/celestial/artemis_2_review.usda@</Artemis2Review>
)
{
    def Scope "Scenario"
    {
        custom string lunco:scenario = "artemis-motion"
        def Scope "Test" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/artemis_motion.rhai@
            uniform bool lunco:program:realtimeSafe = false
        }
    }
}
