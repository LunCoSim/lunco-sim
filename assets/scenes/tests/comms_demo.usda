#usda 1.0
(
    defaultPrim = "CommsDemoScene"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "CommsDemoScene" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    documentation = "MoonDAO comms demo: Malapert Massif site with rover, base mast, lunar relay (ELFO) and the three DSN complexes on Earth — connectivity via the generic link kernel (lunco:linkNode; link.aos/link.los events)."
    prepend apiSchemas = ["LunCoCatalogAPI", "LunCoEpochAPI"]
    kind = "assembly"
)
{
    uniform bool lunco:spawnable = false
    double lunco:anchor:lat = -85.99
    double lunco:anchor:lon = 2.9
    double lunco:anchor:height = 0.3
    int lunco:anchor:body = 301
    double lunco:time:epochJd = 2461395.5
    def "SolarSystem" (
        prepend references = @lunco://celestial/solar_system.usda@</SolarSystem>
    )
    {
    }
    def Plane "Ground" (
        prepend apiSchemas = "LunCoTerrainAPI"
    )
    {
        token lunco:terrain:surfaceRole = "flat-site"
        double width = 1.0
        double length = 1.0
        token axis = "Y"
        double3 xformOp:translate = (0.0, 0.0, 0.0)
        double3 xformOp:scale = (400.0, 1.0, 400.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.41999998688697815, 0.4000000059604645, 0.3799999952316284)]
        bool physics:collisionEnabled = true
    }
    def LunCoEnvironment "Environment"
    {
        float lunco:env:exposureEv100 = 12.5
    }
    def Camera "Avatar" (
        prepend apiSchemas = ["LunCoCameraAPI", "LunCoAvatarAPI"]
    )
    {
        uniform bool lunco:avatar = true
        double3 xformOp:translate = (14.0, 6.0, 12.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        double3 lunco:cameraLookAt = (6.0, 1.4, 0.0)
        def "Controls" (
            prepend references = @lunco://vessels/control_profiles.usda@</AvatarControls>
        )
        {
        }
    }
    def Xform "Rover" (
        prepend references = @lunco://vessels/rovers/skid_rover.usda@</SkidRover>
    )
    {
        double3 xformOp:translate = (6.0, 1.4, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "Comms" (
            prepend references = @lunco://components/comms/radio.usda@</CommsRadio>
        )
        {
            over "YawHead"
            {
                over "DishGimbal"
                {
                    over "DishHead"
                    {
                        over "LinkAperture"
                        {
                            string lunco:link:class = "rover"
                            double lunco:link:minElevationDeg = -10.0
                            double lunco:link:maxRangeM = 100000000.0
                        }
                    }
                }
            }
        }
    }
    def Xform "BaseMast" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        prepend references = @lunco://components/comms/antenna.usda@</CommsAntenna>
    )
    {
        double3 xformOp:translate = (-8.0, 0.0, -4.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 200.0
        bool physics:kinematicEnabled = true
        over "Mast"
        {
            double height = 3.2
            double3 xformOp:translate = (0.0, 1.6, 0.0)
        }
        over "YawHead"
        {
            double3 xformOp:translate = (0.0, 3.2, 0.0)
            over "DishGimbal"
            {
                over "DishHead"
                {
                    double3 xformOp:scale = (4.0, 4.0, 4.0)
                    over "LinkAperture"
                    {
                        string lunco:link:class = "base"
                        double lunco:link:maxRangeM = 5000.0
                    }
                }
            }
        }
    }
    def Xform "RelaySat" (
        prepend references = @lunco://vessels/satellites/relay_sat.usda@</RelaySat>
    )
    {
        double lunco:orbit:epochJd = 2461395.5
    }
    def Xform "DSS_Madrid" (
        prepend references = @lunco://components/comms/ground_station.usda@</GroundStation>
    )
    {
        double lunco:anchor:lat = 40.4314
        double lunco:anchor:lon = -4.2481
        double lunco:anchor:height = 837.0
        int lunco:anchor:body = 399
    }
    def Xform "DSS_Goldstone" (
        prepend references = @lunco://components/comms/ground_station.usda@</GroundStation>
    )
    {
        double lunco:anchor:lat = 35.4267
        double lunco:anchor:lon = -116.89
        double lunco:anchor:height = 1001.0
        int lunco:anchor:body = 399
    }
    def Xform "DSS_Canberra" (
        prepend references = @lunco://components/comms/ground_station.usda@</GroundStation>
    )
    {
        double lunco:anchor:lat = -35.4014
        double lunco:anchor:lon = 148.9817
        double lunco:anchor:height = 688.0
        int lunco:anchor:body = 399
    }
    def Scope "Scenario"
    {
        custom string lunco:scenario = "comms-demo"
        def Scope "Test" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/comms_demo.rhai@
        }
    }
}
