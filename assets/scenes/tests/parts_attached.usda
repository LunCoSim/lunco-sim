#usda 1.0
(
    defaultPrim = "PartsAttached"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "PartsAttached" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    kind = "assembly"
    documentation = "Both Skid rover drivetrain variants are driven in a straight line; every descendant part must still be at its authored offset afterwards."
    prepend apiSchemas = ["LunCoCatalogAPI", "LunCoEpochAPI"]
)
{
    uniform bool lunco:spawnable = false
    double lunco:anchor:lat = 26.13
    double lunco:anchor:lon = 3.63
    double lunco:anchor:height = 0.0
    int lunco:anchor:body = 301
    double lunco:time:epochJd = 2461395.5
    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0.0, -0.5, 0.0)
        double3 xformOp:scale = (500.0, 1.0, 500.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.4000000059604645, 0.4000000059604645, 0.44999998807907104)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </PartsAttached/PhysicsMaterials/Friction_1_0>
    }
    over "Sun"
    {
        double3 xformOp:rotateXYZ = (-35.0, 40.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
    def Camera "Avatar" (
        prepend apiSchemas = ["LunCoCameraAPI", "LunCoAvatarAPI"]
    )
    {
        uniform bool lunco:avatar = true
        double3 lunco:cameraLookAt = (0.0, 1.0, 100.0)
        double3 xformOp:translate = (0.0, 30.0, 175.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def "Controls" (
            prepend references = @lunco://vessels/control_profiles.usda@</AvatarControls>
        )
        {
        }
    }
    def Camera "PartsCam" (
        prepend apiSchemas = "LunCoCameraAPI"
    )
    {
        double3 lunco:cameraLookAt = (0.0, 1.0, 90.0)
        double3 xformOp:translate = (0.0, 40.0, 200.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float focalLength = 24.0
        float2 clippingRange = (0.10000000149011612, 100000.0)
    }
    def Xform "SkidRaycast" (
        prepend references = @lunco://vessels/rovers/skid_rover.usda@</SkidRover>
        variants = { string "drivetrain" = "raycast" }
    )
    {
        double3 xformOp:translate = (-60.0, 1.0, 50.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "SkidPhysical" (
        prepend references = @lunco://vessels/rovers/skid_rover.usda@</SkidRover>
        variants = { string "drivetrain" = "physical" }
    )
    {
        double3 xformOp:translate = (-20.0, 1.0, 50.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Scope "Scenario"
    {
        custom string lunco:scenario = "parts-attached"
        def Scope "PartsTest" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/parts_attached.rhai@
        }
    }
    def "SolarSystem" (
        prepend references = @lunco://celestial/solar_system.usda@</SolarSystem>
    )
    {
    }
}
