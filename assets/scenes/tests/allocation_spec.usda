#usda 1.0
(
    defaultPrim = "AllocationSpec"
    upAxis = "Y"
    metersPerUnit = 1
)

# ── Drive-allocation spec rig ────────────────────────────────────────────────
#
# The scene `scenarios/tests/allocation_spec.rhai` runs against. It exists because the
# allocation spec needs THREE rovers off one asset, differing in exactly ONE
# authored opinion each: how their drive kernel is selected.
#
#   RoverSkid   — stock `vessels/rovers/skid_rover.usda`. Its
#                 `PhysxVehicleTankDifferentialAPI` derives `DriveMix::skid`, so
#                 `DriveMix.kernel == "skid"` and the name resolves in the
#                 `ControlKernelRegistry`. Every allocation assertion (named
#                 ports, forward/reverse mirror, counter-rotation, steer
#                 priority) is measured on this one.
#
#   RoverBogus  — the SAME asset with one attribute added: a `lunco:driveKernel`
#                 naming a kernel that does not exist, in the registry or as a
#                 rhai hook. It is the scenario-level form of the unit test's
#                 `reg.get("nope").is_none()`.
#
#   RoverLazy   — the SAME asset with an authored `DriveMix` scope, so it
#                 composes the LINEAR kernel instead of skid. It is the control
#                 for the steer-priority assertion: the "lazy arc" the skid
#                 kernel exists to beat. See its prim for the full argument.
#
# WHY THE BOGUS ROVER IS WORTH A WHOLE PRIM. A misspelled or unavailable
# scripted kernel must fail safe rather than silently falling back to skid. So
# this rig asserts the observable result, not merely the lookup: under full
# throttle, a rover with an unresolvable kernel does not move.
#
# The rovers are spread along X (-75, -25, +25) and drive along -Z, so their
# paths never meet. Geometry, ground, friction and spawn height are copied from
# `drivetrain_parity.usda` — a rig whose numbers are already known-good — so the
# only new variable in this scene is the kernel name.
#
#     target/debug/luncosim test --scene scenes/tests/allocation_spec.usda

def Xform "AllocationSpec" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    kind = "assembly"
    doc = "Three rovers off one asset differing only in how their drive kernel is selected — skid, unresolvable (fail-safe), and an authored linear mix (steer-priority control) — for the drive-allocation spec."
    prepend apiSchemas = ["LunCoCatalogAPI"]
)
{

    # A test rig, not a spawnable part.
    uniform bool lunco:spawnable = false

    # ONE friction material under BOTH rovers — the inherited `Friction_1_0`.
    # The bogus rover's assertion is "it did not move", which a different surface
    # under it would trivially satisfy for the wrong reason.

    # Flat, level, 500 x 500 m. Level matters here more than usual: on a slope an
    # un-actuated rover ROLLS, and "the fail-safe coasted" would be
    # indistinguishable from "gravity moved it".
    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0, -0.5, 0)
        double3 xformOp:scale = (500.0, 1.0, 500.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.4, 0.4, 0.45)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </AllocationSpec/PhysicsMaterials/Friction_1_0>
    }

    over "Sun"
    {
        double3 xformOp:rotateXYZ = (-35.0, 40.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def Xform "Avatar" (
        prepend apiSchemas = ["LunCoAvatarAPI"]
    )
    {
        uniform bool lunco:avatar = true
        uniform token lunco:cameraMode = "freeflight"
        double3 lunco:cameraLookAt = (0.0, 1.0, 100.0)
        double3 xformOp:translate = (0.0, 30.0, 175.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # Broadside: both rovers in frame for the whole run, so a human can SEE that
    # one of them drove off and the other sat still.
    def Camera "SpecCam" (
        prepend apiSchemas = ["LunCoCameraAPI"]
    )
    {
        custom double3 lunco:cameraLookAt = (0.0, 1.0, 90.0)
        double3 xformOp:translate = (0.0, 45.0, 190.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float focalLength = 24.0
        float2 clippingRange = (0.1, 100000.0)
    }

    # ── The measured rover ───────────────────────────────────────────────────
    # Stock skid rover. `drivetrain = "raycast"` is the asset's own fallback but
    # is written out explicitly: the spec measures wheel spin off
    # `WheelRaycast.spin_velocity`, so the realization is not an incidental
    # detail of this rig, it is a precondition of the measurement.
    def Xform "RoverSkid" (
        prepend references = @lunco://vessels/rovers/skid_rover.usda@</SkidRover>
        variants = {
            string drivetrain = "raycast"
        }
    )
    {
        double3 xformOp:translate = (-25.0, 1.0, 50.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        over "Chassis"
        {
            color3f[] primvars:displayColor = [(0.85, 0.35, 0.15)]
        }
    }

    # ── The fail-safe control ────────────────────────────────────────────────
    # Identical in every respect but one. `lunco:driveKernel` takes precedence
    # over the inherited `PhysxVehicleTankDifferentialAPI` in `derive_drive_mix`,
    # so this rover composes a `DriveMix { kernel: <this name>, ports: [],
    # entries: [] }`. `apply_drive_mix` then finds no built-in and no rhai hook,
    # warns ONCE, and writes no port.
    #
    # The name is deliberately grotesque. A plausible one ("skid2", "tank") is a
    # name somebody might one day register for real, which would turn this test
    # green by making its premise false.
    def Xform "RoverBogus" (
        prepend references = @lunco://vessels/rovers/skid_rover.usda@</SkidRover>
        prepend apiSchemas = ["LunCoDriveKernelAPI"]
        variants = {
            string drivetrain = "raycast"
        }
    )
    {
        string lunco:driveKernel = "no_such_kernel__failsafe_probe"

        double3 xformOp:translate = (25.0, 1.0, 50.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        over "Chassis"
        {
            color3f[] primvars:displayColor = [(0.15, 0.45, 0.85)]
        }
    }

    # ── The steer-priority CONTROL ───────────────────────────────────────────
    # The same asset with an authored `DriveMix` scope, which `derive_drive_mix`
    # checks BEFORE the inherited `PhysxVehicleTankDifferentialAPI` — so this
    # rover composes `DriveMix::linear` with the two entries below instead of
    # `DriveMix::skid`, on the same chassis, wheels, mass and surface.
    #
    # WHY: `skid_mix_norm` claims two properties a plain linear mix lacks —
    # steer-priority (`drive = forward * (1 - 0.5*|steer|)`, so the inner side can
    # counter-rotate) and PROPORTIONAL saturation (both sides scale by the larger
    # magnitude, preserving the commanded L/R ratio). Its own comment says that
    # without them "the outer side saturates and steering becomes a lazy arc".
    # This mix IS that lazy arc, stated as data:
    #
    #     throttle +1, steer +1  ->  left  = 1 + 1 =  2  -> clamped to  1.0
    #                                right = 1 - 1 =  0  ->             0.0
    #
    # one side driven, the other merely stopped. Skid under the same command
    # gives (1.0, -0.333): the inner bank drives BACKWARD.
    #
    # This exists because the spec's yaw-authority assertion was a bare constant
    # calibrated against a since-replaced tyre model, so it measured the tyres as
    # much as the allocation. Yaw swept by the steer-priority mix RELATIVE to the
    # lazy mix on an otherwise identical rover is a claim about allocation alone,
    # and it survives the next physics change.
    def Xform "RoverLazy" (
        prepend references = @lunco://vessels/rovers/skid_rover.usda@</SkidRover>
        variants = {
            string drivetrain = "raycast"
        }
    )
    {
        # Far enough out that the arc it sweeps under full throttle never reaches
        # RoverSkid's lane — this control is only honest if the two rovers never
        # touch each other.
        double3 xformOp:translate = (-75.0, 1.0, 50.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        # Child prim NAME is the port name; the factors are the linear
        # projection `throttle*forward + steer*steer + brake*brake`, clamped
        # per-port to +-1 (`linear_kernel`).
        def Scope "DriveMix"
        {
            def Scope "drive_left" (
                prepend apiSchemas = ["LunCoDriveMixTermAPI"]
            )
            {
                double lunco:factor:throttle = 1.0
                double lunco:factor:steer = 1.0
            }
            def Scope "drive_right" (
                prepend apiSchemas = ["LunCoDriveMixTermAPI"]
            )
            {
                double lunco:factor:throttle = 1.0
                double lunco:factor:steer = -1.0
            }
        }

        over "Chassis"
        {
            color3f[] primvars:displayColor = [(0.85, 0.8, 0.2)]
        }
    }

    # ── The test itself ──────────────────────────────────────────────────────
    # A non-physical prim owning the harness and reaching every rover by path,
    # rather than hanging off one of them: the rovers must differ in exactly
    # one opinion each, and hosting the program on one of them is a second.
    def Scope "Scenario"
    {
        custom string lunco:scenario = "allocation-spec"

        def Scope "AllocationSpec" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform asset info:sourceAsset = @lunco://scenarios/tests/allocation_spec.rhai@
        }
    }
}
