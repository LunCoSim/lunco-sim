#usda 1.0
(
    defaultPrim = "RockerBogieTest"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "RockerBogieTest" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    kind = "assembly"
    documentation = "The rocker-bogie rover (the kind Mars rovers use) driving over a small step. The linkage should keep the body level as one side lifts."
    prepend apiSchemas = ["LunCoCatalogAPI", "LunCoEpochAPI"]
)
{
    uniform bool lunco:spawnable = false
    double lunco:anchor:lat = 26.13
    double lunco:anchor:lon = 3.63
    double lunco:anchor:height = 0.0
    int lunco:anchor:body = 301
    double lunco:time:epochJd = 2461395.5
    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0.0, -0.5, 0.0)
        double3 xformOp:scale = (200.0, 1.0, 200.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.4000000059604645, 0.4000000059604645, 0.44999998807907104)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </RockerBogieTest/PhysicsMaterials/Friction_1_0>
    }
    def Cube "Step" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (-1.29, 0.0, 1.2)
        double3 xformOp:scale = (0.7, 0.5, 0.7)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.6000000238418579, 0.5, 0.4000000059604645)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </RockerBogieTest/PhysicsMaterials/Friction_1_0>
    }
    over "Sun"
    {
        double3 xformOp:rotateXYZ = (-35.0, 40.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
    def Camera "Avatar" (
        prepend apiSchemas = ["LunCoCameraAPI", "LunCoAvatarAPI"]
    )
    {
        uniform bool lunco:avatar = true
        double3 lunco:cameraLookAt = (0.0, 1.6, 0.0)
        double3 xformOp:translate = (7.0, 5.0, 8.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def "Controls" (
            prepend references = @lunco://vessels/control_profiles.usda@</AvatarControls>
        )
        {
        }
    }
    def Xform "Rover" (
        prepend references = @lunco://vessels/rovers/rocker_bogie.usda@</RockerBogie>
    )
    {
        double3 xformOp:translate = (0.0, 1.6, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "Antenna"
        {
            over "YawHead"
            {
                bool physics:rigidBodyEnabled = false
                over "DishGimbal"
                {
                    bool physics:rigidBodyEnabled = false
                }
            }
            over "EarthTrackerController" (
                active = false
            )
            {
            }
            over "YawJoint" (
                active = false
            )
            {
            }
            over "ElevationJoint" (
                active = false
            )
            {
            }
        }
    }
    def Scope "Scenario"
    {
        custom string lunco:scenario = "rocker-bogie"
        def Scope "Test" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/rocker_bogie.rhai@
            float lunco:param:coupled = 1.0
        }
    }
    def "SolarSystem" (
        prepend references = @lunco://celestial/solar_system.usda@</SolarSystem>
    )
    {
    }
}
