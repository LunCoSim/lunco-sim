#usda 1.0
(
    defaultPrim = "PhysicalRoverControls"
    upAxis = "Y"
    metersPerUnit = 1
)

# ── Physical rover command-transition matrix ────────────────────────────────
#
# This is a behavioural fixture for the two physical drivetrain realizations.
# It deliberately uses the real rover assets and their composed Modelica
# networks. The scenario supplies only high-level Rhai commands; it does not
# recreate steering allocation or tire math.
#
# The matrix is ordered so a failure identifies the contract that broke:
# settle/contact -> forward -> steer right -> steer left -> reverse -> brake.
# Both rovers share one authored flat surface, but have separate lanes so a
# turn cannot create a collision that hides a drivetrain result.

def Xform "PhysicalRoverControls" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    kind = "assembly"
    doc = "Physical skid and Ackermann rovers under the authored command-transition matrix."
    prepend apiSchemas = ["LunCoCatalogAPI"]
)
{
    uniform bool lunco:spawnable = false

    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0, -0.5, 0)
        double3 xformOp:scale = (500.0, 1.0, 500.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.4, 0.4, 0.45)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </PhysicalRoverControls/PhysicsMaterials/Friction_1_0>
    }

    over "Sun"
    {
        double3 xformOp:rotateXYZ = (-35.0, 40.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def Xform "Avatar" (
        prepend apiSchemas = ["LunCoAvatarAPI"]
    )
    {
        def "Controls" (
            prepend references = @lunco://vessels/control_profiles.usda@</AvatarControls>
        )
        {
        }
        uniform bool lunco:avatar = true
        uniform token lunco:cameraMode = "freeflight"
        double3 lunco:cameraLookAt = (0.0, 1.0, 40.0)
        double3 xformOp:translate = (0.0, 35.0, 145.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Camera "ControlsCam" (
        prepend apiSchemas = ["LunCoCameraAPI"]
    )
    {
        custom double3 lunco:cameraLookAt = (0.0, 1.0, 40.0)
        double3 xformOp:translate = (0.0, 42.0, 150.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float focalLength = 24.0
        float2 clippingRange = (0.1, 100000.0)
    }

    def Xform "SkidPhysical" (
        prepend references = @lunco://vessels/rovers/skid_rover.usda@</SkidRover>
        variants = {
            string drivetrain = "physical"
        }
    )
    {
        double3 xformOp:translate = (-12.0, 1.0, 60.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "Chassis"
        {
            color3f[] primvars:displayColor = [(0.15, 0.30, 0.80)]
        }
    }

    def Xform "AckermannPhysical" (
        prepend references = @lunco://vessels/rovers/ackermann_rover.usda@</AckermannRover>
        variants = {
            string drivetrain = "physical"
        }
    )
    {
        double3 xformOp:translate = (12.0, 1.0, 60.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "Chassis"
        {
            color3f[] primvars:displayColor = [(0.90, 0.45, 0.05)]
        }
    }

    def Scope "Scenario"
    {
        custom string lunco:scenario = "physical-rover-controls"

        def Scope "ControlsTest" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/physical_rover_controls.rhai@
        }
    }
}
