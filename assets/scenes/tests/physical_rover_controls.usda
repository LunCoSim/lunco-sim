#usda 1.0
(
    defaultPrim = "PhysicalRoverControls"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "PhysicalRoverControls" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    kind = "assembly"
    documentation = "Physical skid and Ackermann rover control matrix with explicit lunar-site and SolarSystem facts for their Earth-tracking probes."
    prepend apiSchemas = ["LunCoCatalogAPI", "LunCoEpochAPI"]
)
{
    uniform bool lunco:spawnable = false
    double lunco:anchor:lat = 26.13
    double lunco:anchor:lon = 3.63
    double lunco:anchor:height = 0.0
    int lunco:anchor:body = 301
    double lunco:time:epochJd = 2461395.5
    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0.0, -0.5, 0.0)
        double3 xformOp:scale = (500.0, 1.0, 500.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.4000000059604645, 0.4000000059604645, 0.44999998807907104)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </PhysicalRoverControls/PhysicsMaterials/Friction_1_0>
    }
    over "Sun"
    {
        double3 xformOp:rotateXYZ = (-35.0, 40.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
    def Camera "Avatar" (
        prepend apiSchemas = ["LunCoCameraAPI", "LunCoAvatarAPI"]
    )
    {
        uniform bool lunco:avatar = true
        double3 lunco:cameraLookAt = (0.0, 1.0, 40.0)
        double3 xformOp:translate = (0.0, 35.0, 145.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def "Controls" (
            prepend references = @lunco://vessels/control_profiles.usda@</AvatarControls>
        )
        {
        }
    }
    def Camera "ControlsCam" (
        prepend apiSchemas = "LunCoCameraAPI"
    )
    {
        double3 lunco:cameraLookAt = (0.0, 1.0, 40.0)
        double3 xformOp:translate = (0.0, 42.0, 150.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float focalLength = 24.0
        float2 clippingRange = (0.10000000149011612, 100000.0)
    }
    def Xform "SkidPhysical" (
        prepend references = @lunco://vessels/rovers/skid_rover.usda@</SkidRover>
        variants = { string "drivetrain" = "physical" }
    )
    {
        double3 xformOp:translate = (-12.0, 1.0, 60.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "Chassis"
        {
            color3f[] primvars:displayColor = [(0.15000000596046448, 0.30000001192092896, 0.800000011920929)]
        }
    }
    def Xform "AckermannPhysical" (
        prepend references = @lunco://vessels/rovers/ackermann_rover.usda@</AckermannRover>
        variants = { string "drivetrain" = "physical" }
    )
    {
        double3 xformOp:translate = (12.0, 1.0, 60.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "Chassis"
        {
            color3f[] primvars:displayColor = [(0.8999999761581421, 0.44999998807907104, 0.05000000074505806)]
        }
    }
    def Scope "Scenario"
    {
        custom string lunco:scenario = "physical-rover-controls"
        def Scope "ControlsTest" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/physical_rover_controls.rhai@
        }
    }
    def "SolarSystem" (
        references = @lunco://celestial/solar_system.usda@
    )
    {
    }
}
