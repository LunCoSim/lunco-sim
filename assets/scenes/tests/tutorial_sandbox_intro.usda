#usda 1.0
(
    defaultPrim = "TutorialSandboxIntro"
    metersPerUnit = 1
)

# This is a headless contract for the authored Sandbox onboarding policy. It
# attaches the shipped lesson script itself, then a separate Rhai observer
# drives only the public event names a learner can produce.
def Xform "TutorialSandboxIntro"
{
    def DistantLight "Sun" (
        prepend references = @lunco://lighting/sun.usda@</Sun>
    )
    {
    }

    def Scope "Scenario" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://tutorials/sandbox/sandbox_intro.rhai@
    }

    def Xform "TestHost"
    {
        def Scope "Test" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/tutorial_sandbox_intro.rhai@
        }
    }
}
