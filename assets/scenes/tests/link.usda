#usda 1.0
(
    defaultPrim = "LinkTest"
    metersPerUnit = 1.0
    documentation = "Connectivity-kernel smoke scene: every PLACEMENT kind the kernel can pose a link node from — geodetic (Earth + Moon surface), Kepler (lunar orbit), and libration (Earth-Moon L1/L2/L4). No terrain, globe or rovers, so it exercises pose -> pairwise -> verdict -> LinkState on its own."
)

def Xform "LinkTest" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    kind = "assembly"
    documentation = "Connectivity-kernel smoke scene: one link node per placement kind — Earth-surface geodetic, Moon-surface geodetic, lunar Kepler orbit, and Earth-Moon L1/L2/L4 libration points."
    prepend apiSchemas = ["LunCoCatalogAPI", "LunCoEpochAPI"]
)
{
    bool lunco:spawnable = false
    double lunco:time:epochJd = 2461395.5
    def Xform "Relay" (
        prepend apiSchemas = "LunCoLinkAPI"
    )
    {
        bool lunco:linkNode = true
        string lunco:link:class = "relay"
        int lunco:orbit:body = 301
        double lunco:orbit:semiMajorAxisM = 6540000.0
        double lunco:orbit:eccentricity = 0.0
        double lunco:orbit:inclinationDeg = 0.0
        double lunco:orbit:meanAnomalyDeg = 0.0
    }
    def Xform "DSS_Goldstone" (
        prepend apiSchemas = "LunCoLinkAPI"
    )
    {
        bool lunco:linkNode = true
        string lunco:link:class = "earth"
        double lunco:link:minElevationDeg = 5.0
        double lunco:anchor:lat = 35.4267
        double lunco:anchor:lon = -116.89
        double lunco:anchor:height = 1001.0
        int lunco:anchor:body = 399
    }
    def Xform "DSS_Canberra" (
        prepend apiSchemas = "LunCoLinkAPI"
    )
    {
        bool lunco:linkNode = true
        string lunco:link:class = "earth"
        double lunco:link:minElevationDeg = 5.0
        double lunco:anchor:lat = -35.4014
        double lunco:anchor:lon = 148.9817
        double lunco:anchor:height = 688.0
        int lunco:anchor:body = 399
    }
    def Xform "DSS_Madrid" (
        prepend apiSchemas = "LunCoLinkAPI"
    )
    {
        bool lunco:linkNode = true
        string lunco:link:class = "earth"
        double lunco:link:minElevationDeg = 5.0
        double lunco:anchor:lat = 40.4314
        double lunco:anchor:lon = -4.2481
        double lunco:anchor:height = 837.0
        int lunco:anchor:body = 399
    }
    def Xform "MalapertBase" (
        prepend apiSchemas = "LunCoLinkAPI"
    )
    {
        bool lunco:linkNode = true
        string lunco:link:class = "base"
        double lunco:link:minElevationDeg = 0.0
        double lunco:anchor:lat = -85.43
        double lunco:anchor:lon = -0.94
        int lunco:anchor:body = 301
    }
    def Xform "L1_Relay" (
        prepend apiSchemas = "LunCoLinkAPI"
    )
    {
        bool lunco:linkNode = true
        string lunco:link:class = "relay"
        int lunco:libration:primary = 399
        int lunco:libration:secondary = 301
        token lunco:libration:point = "L1"
    }
    def Xform "L2_Relay" (
        prepend apiSchemas = "LunCoLinkAPI"
    )
    {
        bool lunco:linkNode = true
        string lunco:link:class = "relay"
        int lunco:libration:primary = 399
        int lunco:libration:secondary = 301
        token lunco:libration:point = "L2"
    }
    def Xform "L4_Camp" (
        prepend apiSchemas = "LunCoLinkAPI"
    )
    {
        bool lunco:linkNode = true
        string lunco:link:class = "relay"
        int lunco:libration:primary = 399
        int lunco:libration:secondary = 301
        token lunco:libration:point = "L4"
    }
    def Xform "ShortRangeSat" (
        prepend apiSchemas = "LunCoLinkAPI"
    )
    {
        bool lunco:linkNode = true
        string lunco:link:class = "shortrange"
        double lunco:link:maxRangeM = 1000000.0
        int lunco:orbit:body = 301
        double lunco:orbit:semiMajorAxisM = 6540000.0
        double lunco:orbit:eccentricity = 0.0
        double lunco:orbit:inclinationDeg = 90.0
        double lunco:orbit:meanAnomalyDeg = 180.0
    }
    def Xform "ShortRangeCompanion" (
        prepend apiSchemas = "LunCoLinkAPI"
    )
    {
        bool lunco:linkNode = true
        string lunco:link:class = "relay"
        int lunco:orbit:body = 301
        double lunco:orbit:semiMajorAxisM = 6540000.0
        double lunco:orbit:eccentricity = 0.0
        double lunco:orbit:inclinationDeg = 90.0
        double lunco:orbit:meanAnomalyDeg = 184.0
    }
    def Scope "Scenario"
    {
        custom string lunco:scenario = "link"
        def Scope "Test" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/link.rhai@
        }
    }
}
