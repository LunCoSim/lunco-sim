#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "World" (
    prepend references = @lunco://scenes/luncosim/crater_cup.usda@</World>
)
{
    def Xform "RangeJudge"
    {
        def Scope "Verification" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/crater_relay.rhai@
        }
    }
}
