#usda 1.0
(
    defaultPrim = "BatteryMountsNegative"
    upAxis = "Y"
    metersPerUnit = 1
)

# Negative composition fixture: an explicit host override lifts the pack out
# of the chassis and into the solar-panel envelope. The authored test must
# reject this composed result; the production rover asset is not modified.

def Xform "BatteryMountsNegative" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    kind = "assembly"
)
{
    uniform bool lunco:spawnable = false

    def Xform "SixWheel" (
        prepend references = @lunco://vessels/rovers/six_wheel_rover.usda@</SixWheelRover>
        variants = {
            string power = "battery"
            string generation = "solar"
        }
    )
    {
        double3 xformOp:translate = (0.0, 1.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        over "Battery"
        {
            double3 xformOp:translate = (0.0, 0.4, 0.0)
        }
    }

    def Scope "Scenario"
    {
        custom string lunco:scenario = "battery-mounts-negative"

        def Scope "Test" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/battery_mounts_negative.rhai@
        }
    }
}
