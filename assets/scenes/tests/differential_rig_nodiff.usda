#usda 1.0
(
    defaultPrim = "DiffRigTest"
    upAxis = "Y"
    metersPerUnit = 1
)

# G5 isolated differential test — coupling OFF (control). Local stiffness=0
# opinion disables the coupling. RockerR should stay at ≈0 (no mirror).

def Xform "DiffRigTest" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    kind = "assembly"
    doc = "The same balancing-linkage test as the differential rig, but with the linkage switched off. Shows what the linkage does by showing what changes when it is gone."
    prepend apiSchemas = ["LunCoCatalogAPI"]
)
{

    uniform bool lunco:spawnable = false

    def Cube "Ground" (prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI", "MaterialBindingAPI"])
    {
        double size = 1.0
        double3 xformOp:translate = (0, -0.5, 0)
        double3 xformOp:scale = (200.0, 1.0, 200.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.4, 0.4, 0.45)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </DiffRigTest/PhysicsMaterials/Friction_1_0>
    }
    over "Sun"
    {
        double3 xformOp:rotateXYZ = (-35.0, 40.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
    def Xform "Avatar" (
        prepend apiSchemas = ["LunCoAvatarAPI"]
    )
    {
        def "Controls" (
            prepend references = @lunco://vessels/control_profiles.usda@</AvatarControls>
        )
        {
        }
        uniform bool lunco:avatar = true
        uniform token lunco:cameraMode = "freeflight"
        double3 lunco:cameraLookAt = (0.0, 1.5, 0.0)
        double3 xformOp:translate = (6.0, 4.0, 7.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "Rig" (
        prepend references = @lunco://vessels/rovers/differential_rig.usda@</DiffRig>
    )
    {
        # Disable the differential: zero the gear joint's angular drive (local `over`).
        over "Differential"
        {
            float drive:angular:physics:stiffness = 0.0
            float drive:angular:physics:damping = 0.0
        }
        double3 xformOp:translate = (0, 1.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Scope "Scenario"
    {
        custom string lunco:scenario = "diff-rig-nodiff"

        def Scope "DiffTest" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/differential_rig.rhai@

            # Which case this stage is. The scenario asserts mirroring or
            # independence on the strength of this, rather than inferring it from
            # the coupling it is meant to be testing.
            float lunco:param:coupled = 0.0
        }
    }
}
