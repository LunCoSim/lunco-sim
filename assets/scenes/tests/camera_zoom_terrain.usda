#usda 1.0
(
    defaultPrim = "CameraZoomTerrain"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "CameraZoomTerrain" (
    prepend references = @lunco://scenes/tests/camera_flat_terrain.usda@</CameraFlatTerrain>
)
{
    over "Terrain"
    {
        def Xform "Crater" (
            prepend apiSchemas = ["LunCoTerrainLayerAPI", "LunCoTerrainEditAPI"]
        )
        {
            uniform token lunco:layer = "edit"
            uniform token lunco:edit:kind = "crater"
            double2 lunco:edit:center = (0.0, 0.0)
            double lunco:edit:radius = 4.0
            double lunco:edit:amount = 1.0
        }
    }
    over "Avatar"
    {
        custom double3 xformOp:translate = (0.0, -918.0, 1.0)
        double3 lunco:cameraLookAt = (0.0, -1918.0, 0.0)
        float focalLength = 18.0
    }
    over "SupportBody"
    {
        custom double3 xformOp:translate = (120.0, -1917.4, 120.0)
    }
}
