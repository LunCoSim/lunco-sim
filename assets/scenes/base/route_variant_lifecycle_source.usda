#usda 1.0
(
    defaultPrim = "RouteVariantLifecycleSource"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "RouteVariantLifecycleSource" (
    kind = "assembly"
    prepend variantSets = "site"
    variants = { string "site" = "other" }
)
{
    variantSet "site" = {
        "apollo15" {
            def Xform "Subject"
            {
                double3 xformOp:translate = (0.0, 1.5, 0.0)
                uniform token[] xformOpOrder = ["xformOp:translate"]
                rel programs = </RouteVariantLifecycleSource/Route/Program>
            }
            def Scope "Route"
            {
                def Scope "Program" (
                    prepend apiSchemas = ["LunCoProgramAPI"]
                )
                {
                    uniform token info:implementationSource = "sourceAsset"
                    uniform asset info:sourceAsset = @lunco://scenarios/tests/route_runtime_anchor.rhai@
                    float inputs:enabled = 0.0
                    rel inputs:subject = </RouteVariantLifecycleSource/Subject>
                }
                def Xform "P0" (
                    prepend references = @lunco://markers/route_point.usda@</RoutePoint>
                )
                {
                    double3 xformOp:translate = (0.0, 1.0, -8.0)
                    uniform token[] xformOpOrder = ["xformOp:translate"]
                    over "Trigger"
                    {
                        token lunco:triggerZone = "variant_route_P0"
                    }
                }
                def Xform "P1" (
                    prepend references = @lunco://markers/route_point.usda@</RoutePoint>
                )
                {
                    double3 xformOp:translate = (10.0, 1.0, -16.0)
                    uniform token[] xformOpOrder = ["xformOp:translate"]
                    over "Trigger"
                    {
                        token lunco:triggerZone = "variant_route_P1"
                    }
                }
                def Xform "P2" (
                    prepend references = @lunco://markers/route_point.usda@</RoutePoint>
                )
                {
                    double3 xformOp:translate = (20.0, 1.0, -24.0)
                    uniform token[] xformOpOrder = ["xformOp:translate"]
                    over "Trigger"
                    {
                        token lunco:triggerZone = "variant_route_P2"
                    }
                }
            }
        }
        "other" {
            def Xform "Subject"
            {
            }
            def Scope "Route"
            {
            }
        }
    }
    def DistantLight "TestLight"
    {
        float intensity = 1.0
    }
    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0.0, -0.5, 0.0)
        double3 xformOp:scale = (100.0, 1.0, 100.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        bool physics:collisionEnabled = true
    }
    def Scope "Scenario"
    {
        def Scope "Test" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/tests/route_variant_lifecycle.rhai@
        }
    }
}
