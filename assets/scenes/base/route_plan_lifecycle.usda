#usda 1.0
(
    defaultPrim = "Route"
    upAxis = "Y"
    metersPerUnit = 1
)

# Reusable route-plan asset. The scene supplies the composed subject at the
# absolute path below; the route itself owns topology and executable policy.
def Scope "Route"
{
    def Scope "Program" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://scenarios/route_follow.rhai@
        float inputs:enabled = 0.0
    }

    def Xform "P0" (
        prepend references = @lunco://markers/route_point.usda@</RoutePoint>
    )
    {
        double3 xformOp:translate = (0.0, 1.0, -8.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "Trigger" { token lunco:triggerZone = "route_P0" }
    }
    def Xform "P1" (
        prepend references = @lunco://markers/route_point.usda@</RoutePoint>
    )
    {
        double3 xformOp:translate = (0.0, 1.0, -16.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "Trigger" { token lunco:triggerZone = "route_P1" }
    }
    def Xform "P2" (
        prepend references = @lunco://markers/route_point.usda@</RoutePoint>
    )
    {
        double3 xformOp:translate = (0.0, 1.0, -24.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "Trigger" { token lunco:triggerZone = "route_P2" }
    }
}
