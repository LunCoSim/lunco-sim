        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def "GreenBalloon" (
        prepend references = @lunco://vessels/balloons/python_balloon.usda@</PythonBalloon>
    )
    {
        double3 xformOp:translate = (-10.0, 5.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Scope "Oscillator" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://models/Oscillator.mo@
        float outputs:signal
    }
    def Scope "Amplifier" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://models/Amplifier.py@
        uniform bool lunco:program:realtimeSafe = true
        float outputs:scaled
        float inputs:signal
        float inputs:signal.connect = </SandboxScene/Oscillator.outputs:signal>
    }
    def Sphere "CosimTarget" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        double radius = 0.5
        color3f[] primvars:displayColor = [(0.8999999761581421, 0.699999988079071, 0.20000000298023224)]
        rel material:binding = </SandboxScene/Looks/Checker_Yellow>
        double3 xformOp:translate = (-30.0, 5.0, 10.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool physics:rigidBodyEnabled = true
        bool physics:collisionEnabled = true
        float physics:mass = 1.0
        float inputs:force_y
        float inputs:force_y.connect = </SandboxScene/Amplifier.outputs:scaled>
    }
    def Cube "JointTestA" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (-5.0, 6.0, 5.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(1.0, 0.20000000298023224, 0.20000000298023224)]
        float physics:mass = 5.0
        bool physics:kinematicEnabled = true
        string lunco:net:authority = "opaque"
    }
    def Cube "JointTestB" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (-2.0, 6.0, 5.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(1.0, 0.6000000238418579, 0.10000000149011612)]
        float physics:mass = 5.0
        string lunco:net:authority = "opaque"
    }
    def PhysicsFixedJoint "JointTestLink"
    {
        rel physics:body0 = </SandboxScene/JointTestA>
        rel physics:body1 = </SandboxScene/JointTestB>
        point3f physics:localPos0 = (1.5, 0.0, 0.0)
        point3f physics:localPos1 = (-1.5, 0.0, 0.0)
    }
    def Cube "Base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "LunCoMountHostAPI"]
    )
    {
        rel lunco:mount:sockets = [</SandboxScene/Base/Interfaces/arm>, </SandboxScene/Base/Interfaces/probe>]
        double size = 1.0
        double3 xformOp:translate = (5.0, 6.0, 5.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.20000000298023224, 0.5, 1.0)]
        float physics:mass = 5.0
        bool physics:kinematicEnabled = true
        string lunco:net:authority = "opaque"
        def Xform "Interfaces"
        {
            def Xform "arm" (
                kind = "subcomponent"
                prepend apiSchemas = ["LunCoMountSocketAPI"]
            )
            {
                uniform token lunco:mount:socket = "arm"
                uniform token lunco:mount:joint = "fixed"
                rel lunco:mount:part = </SandboxScene/Base/Arm>
                double3 xformOp:translate = (0.0, 2.5, 0.0)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
            def Xform "probe" (
                kind = "subcomponent"
                prepend apiSchemas = ["LunCoMountSocketAPI"]
            )
            {
                uniform token lunco:mount:socket = "probe"
                uniform token lunco:mount:joint = "fixed"
                uniform asset lunco:mount:asset = @lunco://components/mounting/demo_probe.usda@
                double3 xformOp:translate = (0.0, -2.5, 0.0)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
        }
        def Cube "Arm" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "LunCoMountPlugAPI", "LunCoMountAttachmentAPI"]
        )
        {
            double size = 1.0
            double3 xformOp:translate = (2.0, 0.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(1.0, 0.800000011920929, 0.10000000149011612)]
            float physics:mass = 2.0
            string lunco:net:authority = "opaque"
            uniform token lunco:mount:plug = "arm"
            rel lunco:mount:frame = </SandboxScene/Base/Arm/Interfaces/hub>
            rel lunco:mount:attachmentJoint = </SandboxScene/Base/constraint_arm>
            def Xform "Interfaces"
            {
                def Xform "hub" (
                    kind = "subcomponent"
                )
                {
                    double3 xformOp:translate = (0.0, 0.0, 0.0)
                    uniform token[] xformOpOrder = ["xformOp:translate"]
                }
            }
        }
        def PhysicsFixedJoint "constraint_arm"
        {
            rel physics:body0 = </SandboxScene/Base>
            rel physics:body1 = </SandboxScene/Base/Arm>
            point3f physics:localPos0 = (2.0, 0.0, 0.0)
            point3f physics:localPos1 = (0.0, 0.0, 0.0)
        }
    }
