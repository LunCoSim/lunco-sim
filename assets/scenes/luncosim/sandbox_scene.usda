#usda 1.0
(
    defaultPrim = "SandboxScene"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "SandboxScene" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    documentation = "The main sandbox: a large flat ground with ramps and rovers. The everyday space for driving rovers around obstacles."
    prepend apiSchemas = ["LunCoCatalogAPI", "LunCoEpochAPI"]
    kind = "assembly"
)
{
    uniform bool lunco:spawnable = false
    double lunco:anchor:lat = 26.13
    double lunco:anchor:lon = 3.63
    double lunco:anchor:height = 0.3
    int lunco:anchor:body = 301
    double lunco:time:epochJd = 2461395.5
    def "SolarSystem" (
        prepend references = @lunco://celestial/solar_system.usda@</SolarSystem>
    )
    {
    }
    def Xform "Sky" (
        prepend apiSchemas = ["LunCoProceduralSkyAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </SandboxScene/Looks/Starfield>
    }
    def Scope "Looks"
    {
        def Material "Blueprint_Ground"
        {
            token outputs:surface
            token outputs:surface.connect = </SandboxScene/Looks/Blueprint_Ground/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                color3f inputs:surface_color = (0.15000000596046448, 0.15000000596046448, 0.18000000715255737)
                color3f inputs:high_line_color = (0.20000000298023224, 0.20000000298023224, 0.23000000417232513)
                color3f inputs:low_line_color = (0.20000000298023224, 0.20000000298023224, 0.23000000417232513)
                float inputs:transition = 0.8500000238418579
                float inputs:roughness = 0.8999999761581421
                float inputs:major_grid_spacing = 1.0
                float inputs:minor_grid_spacing = 0.5
                float inputs:major_line_width = 1.0
                float inputs:minor_line_width = 0.5
                float inputs:minor_line_fade = 0.15000000596046448
                token outputs:surface
                uniform asset info:wesl:sourceAsset = @lunco://shaders/blueprint.wesl@
            }
        }
        def Material "Starfield"
        {
            token outputs:surface
            token outputs:surface.connect = </SandboxScene/Looks/Starfield/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                token outputs:surface
                uniform asset info:wesl:sourceAsset = @lunco://shaders/starfield.wesl@
            }
        }
        def Material "Blueprint_Ramp"
        {
            token outputs:surface
            token outputs:surface.connect = </SandboxScene/Looks/Blueprint_Ramp/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                color3f inputs:surface_color = (0.25, 0.2199999988079071, 0.18000000715255737)
                color3f inputs:high_line_color = (0.30000001192092896, 0.27000001072883606, 0.23000000417232513)
                color3f inputs:low_line_color = (0.30000001192092896, 0.27000001072883606, 0.23000000417232513)
                float inputs:transition = 0.8500000238418579
                float inputs:roughness = 0.8999999761581421
                float inputs:major_grid_spacing = 1.0
                float inputs:minor_grid_spacing = 0.5
                float inputs:major_line_width = 1.0
                float inputs:minor_line_width = 0.5
                float inputs:minor_line_fade = 0.15000000596046448
                token outputs:surface
                uniform asset info:wesl:sourceAsset = @lunco://shaders/blueprint.wesl@
            }
        }
        def Material "Blueprint_Ramp_Green"
        {
            token outputs:surface
            token outputs:surface.connect = </SandboxScene/Looks/Blueprint_Ramp_Green/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                color3f inputs:surface_color = (0.25, 0.5199999809265137, 0.18000000715255737)
                color3f inputs:high_line_color = (0.30000001192092896, 0.5699999928474426, 0.23000000417232513)
                color3f inputs:low_line_color = (0.30000001192092896, 0.5699999928474426, 0.23000000417232513)
                float inputs:transition = 0.8500000238418579
                float inputs:roughness = 0.8999999761581421
                float inputs:major_grid_spacing = 1.0
                float inputs:minor_grid_spacing = 0.5
                float inputs:major_line_width = 1.0
                float inputs:minor_line_width = 0.5
                float inputs:minor_line_fade = 0.15000000596046448
                token outputs:surface
                uniform asset info:wesl:sourceAsset = @lunco://shaders/blueprint.wesl@
            }
        }
        def Material "Checker_Yellow"
        {
            token outputs:surface
            token outputs:surface.connect = </SandboxScene/Looks/Checker_Yellow/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                color3f inputs:cell_a = (0.8999999761581421, 0.699999988079071, 0.20000000298023224)
                color3f inputs:cell_b = (0.11999999731779099, 0.11999999731779099, 0.14000000059604645)
                float inputs:wedge_count = 8.0 (
                    customData = {
    double max = 24.0
    double min = 2.0
    string unit = "cells"
}
                )
                float inputs:band_count = 6.0 (
                    customData = {
    double max = 16.0
    double min = 2.0
    string unit = "cells"
}
                )
                token outputs:surface
                uniform asset info:wesl:sourceAsset = @lunco://shaders/balloon.wesl@
            }
        }
    }
    def Plane "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI", "MaterialBindingAPI"]
    )
    {
        token lunco:terrain:surfaceRole = "flat-site"
        double width = 1.0
        double length = 1.0
        token axis = "Y"
        double3 xformOp:translate = (0.0, 0.0, 0.0)
        double3 xformOp:scale = (4000.0, 1.0, 4000.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </SandboxScene/Looks/Blueprint_Ground>
        bool physics:collisionEnabled = true
        rel material:binding:physics = </SandboxScene/PhysicsMaterials/Friction_1_0>
    }
    def Cube "Ramp" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (25.0, 7.91, 0.0)
        double3 xformOp:rotateXYZ = (0.0, 0.0, 17.1887)
        double3 xformOp:scale = (60.0, 2.0, 80.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        rel material:binding = </SandboxScene/Looks/Blueprint_Ramp>
        color3f[] primvars:displayColor = [(0.25, 0.2199999988079071, 0.18000000715255737)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </SandboxScene/PhysicsMaterials/Friction_1_0>
    }
    def Cube "Ramp1" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (25.0, 7.91, 80.0)
        double3 xformOp:rotateXYZ = (0.0, 0.0, 17.1887)
        double3 xformOp:scale = (60.0, 2.0, 80.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        rel material:binding = </SandboxScene/Looks/Blueprint_Ramp_Green>
        color3f[] primvars:displayColor = [(0.25, 0.2199999988079071, 0.18000000715255737)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </SandboxScene/PhysicsMaterials/Friction_1_0>
    }
    def Camera "Avatar" (
        prepend apiSchemas = ["LunCoCameraAPI", "LunCoAvatarAPI"]
        prepend references = @lunco://components/cameras/lunar_surface_camera.usda@</LunarSurfaceCamera>
    )
    {
        float exposure:time = 0.00390625
        uniform bool lunco:avatar = true
        double3 lunco:cameraLookAt = (0.0, 5.0, 0.0)
        double3 xformOp:translate = (-30.0, 15.0, -20.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def "Controls" (
            prepend references = @lunco://vessels/control_profiles.usda@</AvatarControls>
        )
        {
        }
    }
    def Scope "CameraTrack" (
        prepend apiSchemas = ["LunCoCameraTrackAPI"]
    )
    {
        token lunco:activeCamera
        token lunco:activeCamera.timeSamples = {
            0.0: "Avatar",
        }
    }
    def Camera "WideShot" (
        prepend apiSchemas = ["LunCoCameraAPI"]
    )
    {
        double3 lunco:cameraLookAt = (0.0, 5.0, 0.0)
        double3 xformOp:translate = (-45.0, 25.0, -35.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float focalLength = 24.0
        float2 clippingRange = (0.10000000149011612, 100000.0)
    }
    def Xform "Skid_Raycast_1" (
        prepend references = @lunco://vessels/rovers/skid_rover.usda@</SkidRover>
    )
    {
        double3 xformOp:translate = (15.0, 5.0, -10.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "Chassis"
        {
            color3f[] primvars:displayColor = [(0.8500000238418579, 0.15000000596046448, 0.11999999731779099)]
        }
        def Camera "ChaseCam" (
            prepend apiSchemas = ["LunCoCameraAPI"]
        )
        {
            uniform token lunco:cameraPose = "mounted"
            double3 lunco:cameraLookAt = (0.0, 0.4, -12.0)
            double3 xformOp:translate = (0.0, 0.9, -1.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            float focalLength = 28.0
            float2 clippingRange = (0.10000000149011612, 100000.0)
        }
    }
    def Xform "Skid_Raycast_2" (
        prepend references = @lunco://vessels/rovers/skid_rover.usda@</SkidRover>
    )
    {
        double3 xformOp:translate = (15.0, 5.0, 10.0)
