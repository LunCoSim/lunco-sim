    def Xform "Skid_Battery_Thermal_1" (
        prepend references = @lunco://vessels/rovers/skid_rover.usda@</SkidRover>
        variants = { string "power" = "battery"; string "thermal" = "basic" }
    )
    {
        double3 xformOp:translate = (-15.0, 1.0, 0.0)
        double3 xformOp:rotateXYZ = (0.0, -90.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        over "Chassis"
        {
            color3f[] primvars:displayColor = [(0.75, 0.25, 0.75)]
        }
        def Camera "ChaseCam" (
            prepend apiSchemas = ["LunCoCameraAPI"]
        )
        {
            uniform token lunco:cameraPose = "mounted"
            double3 lunco:cameraLookAt = (0.0, 0.4, -12.0)
            double3 xformOp:translate = (0.0, 0.9, -1.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            float focalLength = 28.0
            float2 clippingRange = (0.10000000149011612, 100000.0)
        }
    }
    def "RedBalloon" (
        prepend references = @lunco://vessels/balloons/modelica_balloon.usda@</ModelicaBalloon>
    )
