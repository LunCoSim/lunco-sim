    def Xform "BatteryBank" (
        doc = "Four 250 kWh battery cabinets on the 800 V refinery bus. Surplus PV charges storage and extraction peaks draw it down."
    )
    {
        custom double3 xformOp:translate = (-45.0, 0.0, -9.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Xform "Callsign" (
            prepend apiSchemas = ["LunCoBillboardAPI"]
        )
        {
            custom double3 xformOp:translate = (0.0, 3.15, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            bool lunco:billboard = true
            string lunco:billboard:text = "{label}"
            float lunco:billboard:offsetY = 0.0
            float lunco:billboard:fadeEnd = 110.0
            custom string ui:displayName = "BESS · 800 V"
