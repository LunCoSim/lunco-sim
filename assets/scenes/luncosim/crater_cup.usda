    def Xform "Scout" (
        prepend references = @lunco://vessels/rovers/skid_rover.usda@</SkidRover>
        doc = "Explore the base, steer the mast camera or push a sample through the gate."
        variants = { string "drivetrain" = "physical" }
    )
    {
        custom double3 xformOp:translate = (-5.0, 1.05, 8.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        custom double outputs:position_x = 0.0
        custom double outputs:position_z = 0.0
        custom double outputs:speed = 0.0
        custom double inputs:elevation = 0.0
        custom double inputs:azimuth = 0.0
        rel collection:components:includes = [</World/Scout/Drivetrain>, </World/Scout/PowerSource>, </World/Scout/MastDrive>, </World/Scout/Motor_FL>, </World/Scout/TorqueSource_FL>, </World/Scout/Gearbox_FL>, </World/Scout/Shaft_FL>, </World/Scout/Motor_FR>, </World/Scout/TorqueSource_FR>, </World/Scout/Gearbox_FR>, </World/Scout/Shaft_FR>, </World/Scout/Motor_RL>, </World/Scout/TorqueSource_RL>, </World/Scout/Gearbox_RL>, </World/Scout/Shaft_RL>, </World/Scout/Motor_RR>, </World/Scout/TorqueSource_RR>, </World/Scout/Gearbox_RR>, </World/Scout/Shaft_RR>]
        custom double outputs:mast_pitch
        double outputs:mast_pitch.connect = </World/Scout/MastDrive.outputs:pitch>
        custom double outputs:mast_yaw
        double outputs:mast_yaw.connect = </World/Scout/MastDrive.outputs:yaw>
