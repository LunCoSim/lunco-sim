#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "World" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    doc = "A six-wheel hauler collects regolith from a gravity feeder and tips its load into the factory receiving bin. Authored visual haul cycle, 25 seconds."
)
{
    over "Sun"
    {
        double3 xformOp:rotateXYZ = (-42.0, -23.0, 0.0)
    }
    def Material "Regolith" (
        prepend references = @lunco://structures/landing_pad.usda@</LandingPad/Looks/BlastRegolith>
    )
    {
        over "Shader"
        {
            color3f inputs:colorA = (0.28999999165534973, 0.27000001072883606, 0.25999999046325684)
        }
    }
    def Xform "NightSky" (
        prepend references = @lunco://components/environment/starfield_sky.usda@</StarfieldSky>
    )
    {
    }
    def Mesh "CraterRim" (
        prepend references = @lunco://scenes/luncosim/crater_cup.usda@</World/CraterRim>
    )
    {
        custom rel material:binding = </World/Regolith>
    }
    def Plane "Ground" (
        prepend references = @lunco://scenes/luncosim/crater_cup.usda@</World/Ground>
    )
    {
        custom rel material:binding = </World/Regolith>
        custom rel material:binding:physics = </World/PhysicsMaterials/Friction_1_0>
    }
    def Xform "Works" (
        prepend references = @lunco://scenes/luncosim/crater_cup.usda@</World/Works>
    )
    {
        custom double3 xformOp:translate = (9.0, 0.0, -5.2)
        custom double3 xformOp:rotateXYZ = (0.0, 0.0, 0.0)
        over "PackingLine"
        {
            custom double inputs:received_kg = 0.0 (
                doc = "This visual haul demonstration has keyframed loads rather than a mass-transfer source. The packing line processes its own initial hopper charge with no external feed."
            )
            double inputs:received_kg.connect = None
            over "Callsign" (
                active = false
            )
            {
            }
        }
    }
