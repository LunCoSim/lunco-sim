#usda 1.0
(
    defaultPrim = "SolarRoverTest"
    upAxis = "Y"
    metersPerUnit = 1.0
    timeCodesPerSecond = 1.0
)

def Xform "SolarRoverTest" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    kind = "assembly"
    documentation = "Solar-powered rover co-simulation scene. The rover drives Waypoints, drains its battery, then stops to track the sun and charge."
    prepend apiSchemas = ["LunCoCatalogAPI", "LunCoEpochAPI"]
)
{
    uniform bool lunco:spawnable = false
    double lunco:anchor:lat = 26.13
    double lunco:anchor:lon = 3.63
    double lunco:anchor:height = 0.3
    int lunco:anchor:body = 301
    double lunco:time:epochJd = 2461395.5
    def "SolarSystem" (
        prepend references = @lunco://celestial/solar_system.usda@</SolarSystem>
    )
    {
    }
    def Plane "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI", "MaterialBindingAPI"]
    )
    {
        token lunco:terrain:surfaceRole = "flat-site"
        double width = 1.0
        double length = 1.0
        token axis = "Y"
        double3 xformOp:translate = (0.0, 0.0, 0.0)
        double3 xformOp:scale = (200.0, 1.0, 200.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.3199999928474426, 0.3100000023841858, 0.33000001311302185)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </SolarRoverTest/PhysicsMaterials/Friction_1_0>
    }
    def Camera "Avatar" (
        prepend apiSchemas = ["LunCoCameraAPI", "LunCoAvatarAPI"]
    )
    {
        uniform bool lunco:avatar = true
        double3 lunco:cameraLookAt = (0.0, 1.0, 0.0)
        double3 xformOp:translate = (15.0, 8.0, 15.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def "Controls" (
            prepend references = @lunco://vessels/control_profiles.usda@</AvatarControls>
        )
        {
        }
    }
    over "Sun"
    {
        double3 xformOp:rotateXYZ = (-30.0, 40.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        float inputs:shadow:distance = 3000.0
    }
    def Camera "WideTrack" (
        prepend apiSchemas = "LunCoCameraAPI"
    )
    {
        double3 lunco:cameraLookAt = (0.0, 0.5, 0.0)
        double3 xformOp:translate = (25.0, 15.0, 25.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float focalLength = 28.0
        float2 clippingRange = (0.10000000149011612, 200000.0)
    }
    def Scope "CameraTrack" (
        prepend apiSchemas = "LunCoCameraTrackAPI"
    )
    {
        token lunco:activeCamera
        token lunco:activeCamera.timeSamples = {
            0.0: "WideTrack",
            5.0: "RoverCam",
        }
    }
    def Xform "SolarRover" (
        prepend references = @lunco://vessels/rovers/skid_rover.usda@</SkidRover>
        variants = { string "power" = "battery" }
    )
    {
        double3 xformOp:translate = (0.0, 0.5, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel collection:components:includes
        prepend rel collection:components:includes = </SolarRoverTest/SolarRover/YawHead/SolarPanel>
        float outputs:solar_power
        float outputs:solar_power.connect = </SolarRoverTest/SolarRover/YawHead/SolarPanel.outputs:power_out>
        float outputs:solar_available_power
        float outputs:solar_available_power.connect = </SolarRoverTest/SolarRover/YawHead/SolarPanel.outputs:available_power_w>
        float outputs:solar_incidence
        float outputs:solar_incidence.connect = </SolarRoverTest/SolarRover/YawHead/SolarPanel.outputs:cos_incidence>
        custom double inputs:target_mount_x
        double inputs:target_mount_x.connect = </SolarRoverTest/SolarRover/YawHead/SolarPanel/Environment.outputs:sun_mount_x>
        custom double inputs:target_mount_y
        double inputs:target_mount_y.connect = </SolarRoverTest/SolarRover/YawHead/SolarPanel/Environment.outputs:sun_mount_y>
        custom double inputs:target_mount_z
        double inputs:target_mount_z.connect = </SolarRoverTest/SolarRover/YawHead/SolarPanel/Environment.outputs:sun_mount_z>
        def Cylinder "Mast"
        {
            uniform token axis = "Y"
            double radius = 0.05
            double height = 0.7
            double3 xformOp:translate = (0.0, 0.45, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(0.5, 0.5, 0.5199999809265137)]
            bool physics:collisionEnabled = false
        }
        def Cylinder "YawHead" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            uniform token axis = "Y"
            double radius = 0.1
            double height = 0.15
            double3 xformOp:translate = (0.0, 0.85, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(0.4000000059604645, 0.4000000059604645, 0.41999998688697815)]
            float physics:mass = 2.0
            bool physics:collisionEnabled = false
            def Xform "SolarPanel" (
                prepend references = @lunco://components/power/solar_panel.usda@</SolarPanel>
            )
            {
                double3 xformOp:translate = (0.0, 0.4, 0.0)
                double3 xformOp:scale = (0.3, 0.2, 0.25)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                custom token connectors:p
                token connectors:p.connect = </SolarRoverTest/SolarRover/Battery.connectors:p>
                custom double inputs:target_mount_x
                double inputs:target_mount_x.connect = </SolarRoverTest/SolarRover.inputs:target_mount_x>
                custom double inputs:target_mount_y
                double inputs:target_mount_y.connect = </SolarRoverTest/SolarRover.inputs:target_mount_y>
                custom double inputs:target_mount_z
                double inputs:target_mount_z.connect = </SolarRoverTest/SolarRover.inputs:target_mount_z>
                def Xform "Environment" (
                    prepend references = @lunco://components/environment/probe.usda@</EnvironmentProbe>
                )
                {
                }
            }
        }
        def PhysicsRevoluteJoint "Hinge"
        {
            rel physics:body0 = </SolarRoverTest/SolarRover>
            rel physics:body1 = </SolarRoverTest/SolarRover/YawHead>
            uniform token physics:axis = "Y"
            point3f physics:localPos0 = (0.0, 0.8500000238418579, 0.0)
            point3f physics:localPos1 = (0.0, 0.0, 0.0)
            float inputs:angle
            float inputs:angle.connect = </SolarRoverTest/SolarRover/SunTrackerController.outputs:yaw>
        }
        def Xform "TrackingEnvironment" (
            prepend references = @lunco://components/environment/probe.usda@</EnvironmentProbe>
        )
        {
        }
        def Xform "SunTrackerController" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://models/LunCo/Pointing/SunTracker.mo@
            custom double inputs:target_mount_x
            double inputs:target_mount_x.connect = </SolarRoverTest/SolarRover/TrackingEnvironment.outputs:sun_mount_x>
            custom double inputs:target_mount_y
            double inputs:target_mount_y.connect = </SolarRoverTest/SolarRover/TrackingEnvironment.outputs:sun_mount_y>
            custom double inputs:target_mount_z
            double inputs:target_mount_z.connect = </SolarRoverTest/SolarRover/TrackingEnvironment.outputs:sun_mount_z>
        }
        def Camera "RoverCam" (
            prepend apiSchemas = "LunCoCameraAPI"
        )
        {
            uniform token lunco:cameraPose = "mounted"
            double3 lunco:cameraLookAt = (0.0, 0.6, -9.0)
            double3 xformOp:translate = (0.0, 2.5, 6.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            float focalLength = 26.0
            float2 clippingRange = (0.10000000149011612, 200000.0)
        }
        def Camera "SideCam" (
            prepend apiSchemas = "LunCoCameraAPI"
        )
        {
            uniform token lunco:cameraPose = "mounted"
            double3 lunco:cameraLookAt = (0.0, 1.25, 0.0)
            double3 xformOp:translate = (-3.5, 2.2, 3.5)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            float focalLength = 32.0
            float2 clippingRange = (0.10000000149011612, 200000.0)
        }
    }
    def Scope "Route"
    {
        def Scope "Program" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/route_follow.rhai@
            float inputs:enabled = 1.0
            rel inputs:subject = </SolarRoverTest/SolarRover>
        }
        def Xform "P0" (
            prepend references = @lunco://markers/route_point.usda@</RoutePoint>
        )
        {
            double3 xformOp:translate = (18.0, 0.0, 10.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            over "Trigger"
            {
                token lunco:triggerZone = "route_P0"
            }
        }
        def Xform "P1" (
            prepend references = @lunco://markers/route_point.usda@</RoutePoint>
        )
        {
            double3 xformOp:translate = (-15.0, 0.0, 20.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            over "Trigger"
            {
                token lunco:triggerZone = "route_P1"
            }
        }
        def Xform "P2" (
            prepend references = @lunco://markers/route_point.usda@</RoutePoint>
        )
        {
            double3 xformOp:translate = (8.0, 0.0, -18.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            over "Trigger"
            {
                token lunco:triggerZone = "route_P2"
            }
        }
    }
    def Scope "Scenario"
    {
        custom string lunco:scenario = "solar-rover-ops"
        def Scope "Mission" (
            prepend apiSchemas = "LunCoProgramAPI"
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://scenarios/solar_rover_cinematic.rhai@
        }
    }
}
