#usda 1.0
(
    defaultPrim = "SolarRoverTest"
    upAxis = "Y"
    metersPerUnit = 1
    timeCodesPerSecond = 1
)

# ── Cinematic demo: solar rover co-simulation scenario ────────────────────────
#
# Composes a custom scene with:
#   1. A SkidRover base referenced from assets/vessels
#   2. A reusable rotating solar panel mounted on the rover
#   3. A SunTracker.mo Modelica controller to yaw the panel to the sun
#   4. A generated electrical Modelica model assembled from the panel, battery and motors
#   5. An autopilot Rhai script directing the navigation
#   6. A cinematic director script executing the cuts and solar-tracking showcase
#
# Run locally with:
#   cargo run -p lunco-luncosim --bin luncosim -- --scene scenes/luncosim/solar_rover_demo.usda

def Xform "SolarRoverTest" (
    prepend references = @lunco://scenes/base/lunar_surface.usda@</LunarSurface>
    kind = "assembly"
    doc = "Solar-powered rover co-simulation scene. The rover drives Waypoints, drains its battery, then stops to track the sun and charge."
    prepend apiSchemas = ["LunCoCatalogAPI", "LunCoEpochAPI"]
)
{

    uniform bool lunco:spawnable = false

    # A solar-tracking scene needs an authored local celestial frame and a
    # reproducible epoch. Without these two inputs the environment provider has
    # no finite Earth/Sun direction, so the tracker correctly stays at its
    # authored pose and the electrical panel receives no sunlight.
    double lunco:anchor:lat = 26.13
    double lunco:anchor:lon = 3.63
    double lunco:anchor:height = 0.3
    int lunco:anchor:body = 301
    double lunco:time:epochJd = 2461395.5

    def "SolarSystem" (
        prepend references = @lunco://celestial/solar_system.usda@</SolarSystem>
    )
    {
    }

    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0, -0.5, 0)
        double3 xformOp:scale = (200.0, 1.0, 200.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.32, 0.31, 0.33)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </SolarRoverTest/PhysicsMaterials/Friction_1_0>
    }

    # Standard starting avatar location (unused in active cinematic camera mode)
    def Xform "Avatar" (
        prepend apiSchemas = ["LunCoAvatarAPI"]
    )
    {
        uniform bool lunco:avatar = true
        uniform token lunco:cameraMode = "freeflight"
        double3 lunco:cameraLookAt = (0.0, 1.0, 0.0)
        double3 xformOp:translate = (15.0, 8.0, 15.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # ── Sun Orbit Modelica Model (continuous solar orbit) ──
    def Xform "SunOrbit" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform asset info:sourceAsset = @lunco://models/LunCo/Pointing/SunOrbit.mo@
    }

    # The Sun - connected to SunOrbit modelica output via USD wire
    over "Sun"
    {
        double3 xformOp:rotateXYZ = (-30.0, 40.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        float inputs:shadow:distance = 3000.0

        # USD connection: SunOrbit Modelica output -> Sun light input
        float inputs:sun_azimuth.connect = </SolarRoverTest/SunOrbit.outputs:sun_azimuth>
    }

    # Static camera: Wide establishing shot looking at the starting region
    def Camera "WideTrack" (
        prepend apiSchemas = ["LunCoCameraAPI"]
    )
    {
        custom double3 lunco:cameraLookAt = (0, 0.5, 0)
        double3 xformOp:translate = (25.0, 15.0, 25.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float focalLength = 28.0
        float2 clippingRange = (0.1, 200000.0)
    }

    # Fixed-time presentation cuts are authored as scene data. The director
    # script retains only event-dependent cuts (battery warning/resume and the
    # mission-complete shot), so one camera-selection mechanism owns each beat.
    def Scope "CameraTrack" (
        prepend apiSchemas = ["LunCoCameraTrackAPI"]
    )
    {
        token lunco:activeCamera.timeSamples = {
            0: "WideTrack",
            5: "RoverCam",
        }
    }

    # ── The Solar Powered Rover ──────────────────────────────────────────────
    def Xform "SolarRover" (
        prepend references = @lunco://vessels/rovers/skid_rover.usda@</SkidRover>
        variants = {
            string power = "battery"
        }
    )
    {
        double3 xformOp:translate = (0.0, 0.5, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        # ── Mast: Static part of the panel mount attached to the chassis ──
        def Cylinder "Mast"
        {
            uniform token axis = "Y"
            double radius = 0.05
            double height = 0.7
            # Lifted to sit on top of the chassis.
            double3 xformOp:translate = (0, 0.45, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(0.5, 0.5, 0.52)]
            bool physics:collisionEnabled = false
        }

        # ── YawHead: Rotating part of the solar tracker ──
        # Dynamic body to let physics solve rotation under the motor torque.
        def Cylinder "YawHead" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            uniform token axis = "Y"
            double radius = 0.1
            double height = 0.15
            double3 xformOp:translate = (0, 0.85, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(0.4, 0.4, 0.42)]
            float physics:mass = 2.0

            # The complete reusable panel: visual, collision, mass, and its
            # independent electrical source facet. The assembly below decides
            # whether that pin is wired to the battery bus.
            # ONE spec per prim, per layer. The bus connection below used to be a
            # sibling `over "YawHead" { over "SolarPanel" { … } }` further down
            # this file, and the `over` won: the composed panel kept `connectors:p`
            # and lost EVERYTHING this `def` brings — the reference, the children,
            # `LunCoProgramAPI`, `info:sourceAsset`. `read_network` skips a member
            # with no program API, so the runtime blamed the collection instead
            # (`SolarPanel is outside collection Electrical`) and this demo has
            # been shipping with a dead electrical island. See
            # `sibling_over_does_not_erase_a_def_in_the_same_layer`.
            def Xform "SolarPanel" (
                prepend references = @lunco://components/power/solar_panel.usda@</SolarPanel>
            )
            {
                double3 xformOp:translate = (0, 0.4, 0)
                double3 xformOp:scale = (0.3, 0.2, 0.25)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                custom token connectors:p.connect = </SolarRoverTest/SolarRover/Battery.connectors:p>
                # Environment is a runtime provider, not a Modelica component.
                # Cross the generated-island boundary through Electrical's typed
                # inputs, then feed the panel from that boundary.
                float inputs:sun_mount_x.connect = </SolarRoverTest/SolarRover/Electrical.inputs:sun_mount_x>
                float inputs:sun_mount_y.connect = </SolarRoverTest/SolarRover/Electrical.inputs:sun_mount_y>
                float inputs:sun_mount_z.connect = </SolarRoverTest/SolarRover/Electrical.inputs:sun_mount_z>

                def Xform "Environment" (
                    prepend references = @lunco://components/environment/probe.usda@</EnvironmentProbe>
                )
                {
                }
            }
        }

        # ── Hinge joint allowing solar panel to rotate on top of rover ──
        def PhysicsRevoluteJoint "Hinge"
        {
            rel physics:body0 = </SolarRoverTest/SolarRover>
            rel physics:body1 = </SolarRoverTest/SolarRover/YawHead>
            uniform token physics:axis = "Y"
            point3f physics:localPos0 = (0, 0.85, 0)
            point3f physics:localPos1 = (0, 0, 0)

            # Declare the joint's command input, then wire it to the tracker.
            # `angle` is the shared revolute-joint port: its input side drives
            # the angular motor while its output side reports measured twist.
            float inputs:angle
            float inputs:angle.connect = </SolarRoverTest/SolarRover/SunTrackerController.outputs:yaw>
        }

        def Xform "TrackingEnvironment" (
            prepend references = @lunco://components/environment/probe.usda@</EnvironmentProbe>
        )
        {
        }

        # ── Sun Tracker Controller (Modelica) ──
        def Xform "SunTrackerController" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform asset info:sourceAsset = @lunco://models/LunCo/Pointing/SunTracker.mo@
            float inputs:sun_mount_x.connect = </SolarRoverTest/SolarRover/TrackingEnvironment.outputs:sun_mount_x>
            float inputs:sun_mount_y.connect = </SolarRoverTest/SolarRover/TrackingEnvironment.outputs:sun_mount_y>
            float inputs:sun_mount_z.connect = </SolarRoverTest/SolarRover/TrackingEnvironment.outputs:sun_mount_z>
        }

        # ── Electrical domain (runtime-generated Modelica) ───────────────
        # The inherited battery variant contributes Battery, motors and this
        # Scope. This scene contributes the panel and maps its environment probe
        # through typed network boundary inputs. The probe is a runtime provider,
        # not a generated Modelica member. No hand-written rover-level `.mo`
        # duplicates topology.
        over "Electrical"
        {
            float inputs:sun_mount_x.connect = </SolarRoverTest/SolarRover/YawHead/SolarPanel/Environment.outputs:sun_mount_x>
            float inputs:sun_mount_y.connect = </SolarRoverTest/SolarRover/YawHead/SolarPanel/Environment.outputs:sun_mount_y>
            float inputs:sun_mount_z.connect = </SolarRoverTest/SolarRover/YawHead/SolarPanel/Environment.outputs:sun_mount_z>
            float outputs:solar_power.connect = </SolarRoverTest/SolarRover/YawHead/SolarPanel.outputs:power_out>
            float outputs:solar_incidence.connect = </SolarRoverTest/SolarRover/YawHead/SolarPanel.outputs:cos_incidence>
            prepend rel collection:components:includes = [</SolarRoverTest/SolarRover/YawHead/SolarPanel>]
        }

        # ── Autopilot Script (Rhai) ──
        # Reuses the scene-agnostic rover_autopilot which discovers waypoints
        # via parent(me) and yields to the player on any key press.
        def Scope "Autopilot" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform asset info:sourceAsset = @lunco://behaviors/solar_rover_patrol.btxml@
        }

        # ── Chase camera riding behind the rover ──
        def Camera "RoverCam" (
            prepend apiSchemas = ["LunCoCameraAPI"]
        )
        {
            uniform token lunco:cameraPose = "mounted"
            custom double3 lunco:cameraLookAt = (0, 0.6, -9)
            double3 xformOp:translate = (0, 2.5, 6)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            float focalLength = 26.0
            float2 clippingRange = (0.1, 200000.0)
        }

        # ── Close-up camera pointing at the solar panel ──
        def Camera "SideCam" (
            prepend apiSchemas = ["LunCoCameraAPI"]
        )
        {
            uniform token lunco:cameraPose = "mounted"
            custom double3 lunco:cameraLookAt = (0, 1.25, 0)
            double3 xformOp:translate = (-3.5, 2.2, 3.5)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            float focalLength = 32.0
            float2 clippingRange = (0.1, 200000.0)
        }
    }

    # ── Waypoint course ──
    def Xform "RoverTarget1" (
        prepend references = @lunco://vessels/markers/waypoint.usda@</WaypointMarker>
    )
    {
        double3 xformOp:translate = (18.0, 0.0, 10.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "RoverTarget2" (
        prepend references = @lunco://vessels/markers/waypoint.usda@</WaypointMarker>
    )
    {
        double3 xformOp:translate = (-15.0, 0.0, 20.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "RoverTarget3" (
        prepend references = @lunco://vessels/markers/waypoint.usda@</WaypointMarker>
    )
    {
        double3 xformOp:translate = (8.0, 0.0, -18.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # ── Scenario director ──
    def Scope "Scenario"
    {
        custom string lunco:scenario = "solar-rover-ops"

        def Scope "Mission" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform asset info:sourceAsset = @lunco://scenarios/solar_rover_cinematic.rhai@
        }
    }
}
