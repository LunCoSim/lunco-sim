#usda 1.0
(
    defaultPrim = "Artemis2Review"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "Artemis2Review" (
    prepend apiSchemas = "LunCoEpochAPI"
)
{
    double lunco:time:epochJd = 2461132.5824799724
    def DistantLight "Sun" (
        prepend references = @lunco://lighting/sun.usda@</Sun>
    )
    {
    }
    def "SolarSystem" (
        prepend references = @lunco://celestial/solar_system.usda@</SolarSystem>
    )
    {
    }
    def "Artemis2" (
        prepend references = @lunco://missions/artemis_2_mission.usda@</Artemis2Mission>
    )
    {
    }
}
