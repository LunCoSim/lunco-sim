within LunCo;
package GNC "Guidance, Navigation, and Control (GNC) algorithm library for landers, rockets, and autonomous entry-descent-landing (EDL)."
  annotation(
    Documentation(info="<html>
<p>Reusable GNC algorithm models: powered descent, gravity turn, and the
three-axis <code>PositionPID3D</code> assembly built from reusable
<code>PIDAxis</code> blocks.</p>
</html>")
  );
end GNC;
