within LunCo;
package Manipulation "Modelica equations for authored robotic mechanisms"
  annotation(Documentation(info="<html>
<p>Reusable actuator and kinematic math for manipulators. USD owns links,
joints, limits, collision and visual geometry; Rhai owns sequencing and
acceptance; this package owns only the continuous-time command shaping and
joint setpoints.</p>
</html>"));
end Manipulation;
