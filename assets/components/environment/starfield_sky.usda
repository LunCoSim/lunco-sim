#usda 1.0
(
    defaultPrim = "StarfieldSky"
    upAxis = "Y"
    metersPerUnit = 1
)

# Reusable lunar night sky. The starfield shader owns the sky appearance; this
# component owns only the standard USD sphere/material binding and the additive
# presentation contract that lets terrain in front of it remain visible.
def Xform "StarfieldSky" (
    doc = "Reusable additive lunar starfield sky dome."
    kind = "component"
    prepend apiSchemas = ["LunCoCatalogAPI"]
)
{
    def Sphere "Dome" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        # The shader re-anchors the vertices at the active camera's far depth,
        # so this is only a culling volume. Keep it inside the renderer's
        # practical scene range; an enormous sphere can be rejected by the
        # camera frustum before the custom vertex stage gets to move it.
        double radius = 1000000.0
        uniform bool doubleSided = true
        bool primvars:doNotCastShadows = true
        bool lunco:surface:additive = true
        rel material:binding = </StarfieldSky/Looks/Starfield>
    }

    def Scope "Looks"
    {
        def Material "Starfield"
        {
            token outputs:surface.connect = </StarfieldSky/Looks/Starfield/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:wgsl:sourceAsset = @lunco://shaders/starfield.wgsl@
                uniform asset info:wgsl:vertexAsset = @lunco://shaders/starfield.wgsl@
                color3f inputs:core_color = (1.0, 0.86, 0.62)
                color3f inputs:arm_color = (0.84, 0.90, 1.0)
                float inputs:star_density = 46.0
                float inputs:limit_magnitude = 6.5
                float inputs:magnitude_slope = 0.6
                float inputs:color_spread = 0.55
                # A tutorial capture is normally 640x360. The physical
                # defaults are sub-pixel at that projection, so this reusable
                # presentation profile gives the star points enough integrated
                # flux to survive the display transform without turning the
                # galaxy into a flat white backdrop.
                float inputs:brightness = 0.12
                float inputs:band_intensity = 0.14
                float inputs:point_size = 2.50
                float inputs:glow = 0.12
                float inputs:seed = 37.0
                float inputs:core_boost = 3.0
                float inputs:band_width = 5.0
                float inputs:dust_strength = 2.6
                float inputs:dust_scale = 11.0
                float inputs:pole_tilt = 62.0
                float inputs:pole_azimuth = 20.0
                float inputs:center_roll = 120.0
                token outputs:surface
            }
        }
    }
}
