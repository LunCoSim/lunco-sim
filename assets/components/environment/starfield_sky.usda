#usda 1.0
(
    defaultPrim = "StarfieldSky"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "StarfieldSky" (
    documentation = "Reusable opaque lunar procedural camera background."
    kind = "component"
    prepend apiSchemas = ["LunCoCatalogAPI", "LunCoProceduralSkyAPI", "MaterialBindingAPI"]
)
{
    rel material:binding = </StarfieldSky/Looks/Starfield>
    def Scope "Looks"
    {
        def Material "Starfield"
        {
            token outputs:surface
            token outputs:surface.connect = </StarfieldSky/Looks/Starfield/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                token outputs:surface
                uniform asset info:wesl:sourceAsset = @lunco://shaders/starfield.wesl@
            }
        }
    }
}
