#usda 1.0
(
    defaultPrim = "StarfieldSky"
    upAxis = "Y"
    metersPerUnit = 1
)

# Reusable lunar night sky. The starfield shader owns the sky appearance; this
# component owns the standard USD material binding and the opaque background
# presentation contract that lets terrain in front of it remain visible.
def Xform "StarfieldSky" (
    doc = "Reusable opaque lunar procedural camera background."
    kind = "component"
    prepend apiSchemas = ["LunCoCatalogAPI", "MaterialBindingAPI"]
)
{
    # The sky is a camera background, not a finite enclosing gprim. This
    # explicit owner marker selects the renderer's fullscreen procedural path;
    # there is no radius, culling AABB, or mesh to couple to the camera range.
    bool lunco:surface:skybox = true
    rel material:binding = </StarfieldSky/Looks/Starfield>

    def Scope "Looks"
    {
        def Material "Starfield"
        {
            token outputs:surface.connect = </StarfieldSky/Looks/Starfield/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:wgsl:sourceAsset = @lunco://shaders/starfield.wgsl@
                # The WGSL defaults are the single sky presentation contract.
                # Hosts do not replace them with a resolution-dependent profile.
                token outputs:surface
            }
        }
    }
}
