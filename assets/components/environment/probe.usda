#usda 1.0
(
    defaultPrim = "EnvironmentProbe"
    upAxis = "Y"
    metersPerUnit = 1
)

# Explicit source of local environment signals.
#
# The probe's transform defines the mount frame. LunCoSim publishes gravity and
# requested target directions onto schema-declared outputs; consumers select
# those facts with ordinary USD connections. The probe has no solver and no policy.
def Xform "EnvironmentProbe" (
    doc = "Mount-frame source for local gravity and requested target directions."
    kind = "component"
    prepend apiSchemas = ["LunCoEnvironmentProbeAPI"]
)
{
}
