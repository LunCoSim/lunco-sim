#usda 1.0
(
    defaultPrim = "CommsRadio"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "CommsRadio" (
    prepend references = @lunco://components/comms/antenna.usda@</CommsAntenna>
    kind = "component"
)
{
    over "YawHead"
    {
        over "DishGimbal"
        {
            over "DishHead"
            {
                over "LinkAperture" (
                    prepend apiSchemas = ["LunCoProgramAPI"]
                    documentation = "LunCo.Comms.CommsLink owns the Friis/noise/capacity budget and finite telemetry queue. Hardware configuration is fixed Modelica parameter data; geometry, offered traffic and available carrier power are live inputs."
                )
                {
                    uniform token info:implementationSource = "sourceAsset"
                    uniform asset info:sourceAsset = @lunco://models/LunCo/Comms/CommsLink.mo@
                    float inputs:gain_tx_db = 3.0
                    float inputs:gain_rx_db = 30.0
                    float inputs:freq_hz = 2200000000.0
                    float inputs:bandwidth_hz = 2000000.0
                    float inputs:noise_temp_k = 150.0
                    float inputs:line_loss_db = 2.0
                    float inputs:rate_efficiency = 0.6000000238418579
                    float inputs:snr_required_db = 3.0
                    float inputs:data_in_bps = 500000.0
                    float inputs:buffer_capacity_bits = 80000000.0
                    float outputs:rate_bps (
                        documentation = "Available link capacity in bits/s; delivered_rate_bps is actual transmitted traffic."
                    )
                    float outputs:snr_db
                    float outputs:margin_db
                    float outputs:buffer_bits
                    float outputs:buffer_frac
                    float outputs:lost_bits
                    float outputs:up
                    float outputs:tx_active
                    float inputs:link_range_m
                    float inputs:link_range_m.connect = </CommsRadio/YawHead/DishGimbal/DishHead/LinkAperture.outputs:link_relay_range_m>
                    float inputs:link_connected
                    float inputs:link_connected.connect = </CommsRadio/YawHead/DishGimbal/DishHead/LinkAperture.outputs:link_relay_connected>
                    custom double inputs:tx_power_w = 10.0 (
                        documentation = "Available on-state carrier power in W. Powered assemblies connect Transmitter.available_rf_power_w; duty-averaged RF output is not a link-acquisition budget."
                    )
                    custom double outputs:delivered_rate_bps = 0.0
                    custom double outputs:accepted_rate_bps = 0.0
                    custom double outputs:dropped_rate_bps = 0.0
                    custom double outputs:snr_valid = 0.0 (
                        documentation = "1 when positive carrier power makes snr_db and margin_db valid; their off-state zero values are invalid placeholders."
                    )
                }
            }
        }
    }
}
