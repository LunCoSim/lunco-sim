#usda 1.0
(
    defaultPrim = "GroundStation"
    upAxis = "Y"
    metersPerUnit = 1
)

# Deep-space ground station (doc 43) — alidade pedestal + the catalogue dish,
# pinned to a geodetic point on a body via `lunco:anchor:*`.
#
# This is the GENERIC host. It is not a place: it has no name, no coordinates and
# no aperture size worth quoting. Real facilities live one level up as thin
# instances that reference this prim and override exactly those things —
# `structures/ground_stations/*.usda`. Author a scene against THOSE, not this:
#
#     def "BearLakes" ( prepend references = @lunco://structures/ground_stations/bear_lakes.usda@ ) {}
#
# ── One dish, one spelling ────────────────────────────────────────────────────
#
# The reflector is `components/comms/antenna.usda` — the same lathed paraboloid
# the lander, the comms mast and the rovers draw. It used to be a FLATTENED
# SPHERE authored inline here, which is precisely the duplication `antenna.usda`
# was extracted to end (its own header already claimed "the lander, the base
# mast, the rovers and the Earth stations all reference this prim now"; this file
# is what makes that true).
#
# SIZE is the one knob: `DishHead`'s uniform scale. Aperture = 1.16 · s metres,
# so a 70 m dish is s = 60.34 and a 64 m dish is s = 55.17. Scaling the head
# keeps the feed horn at the focus; scaling the reflector alone does not.
#
# ── The dish does NOT slew, on purpose ────────────────────────────────────────
#
# `antenna.usda` is an articulated mechanism: two rigid links, an elevation
# hinge, and a Modelica `EarthTracker` that converts a direction into joint
# angles. All three are DEACTIVATED here.
#
#   - The tracker points at EARTH. These dishes are ON Earth and would need to
#     point at the Moon — the same controller with a different target, which is
#     real work and not free.
#   - A station is scenery for a link the kernel computes from GEOMETRY. The
#     verdict does not read the dish's pose, so a slewing reflector changes
#     nothing a student or a script can observe from 384,000 km away.
#   - Six stations × (2 rigid bodies + 1 Modelica solver) is a real per-frame
#     cost for a prop nobody can see move.
#
# `active = false` removes a prim from the composed stage entirely (the
# projection walks active/defined/non-abstract prims only), so the joint and the
# controller cost nothing rather than running and being ignored. The two link
# bodies additionally carry `physics:rigidBodyEnabled = false`: without their
# joints they would otherwise be FREE dynamic bodies, and a dish in free fall is
# a worse bug than a dish that does not track.
#
# The antenna component owns BOTH its hinges, so both are deactivated here — the
# yaw joint alongside the elevation joint and the controller. Nothing about the
# mount is authored in this file: the component resolves its own mount by
# ancestry, which is why a station opts OUT explicitly rather than opting in by
# writing a joint.
#
# To make a station track after all: drop the three `active = false` overrides,
# make `Pedestal` a body it can yaw against (a `PhysicsCollisionAPI` is enough —
# a standalone collider is static geometry) and parent `Antenna` under it, then
# give the tracker a lunar target.
def Xform "GroundStation" (
    prepend apiSchemas = ["LunCoCatalogAPI"]
    kind = "component"
    doc = "Deep-space ground station — alidade pedestal and a 70 m-class dish, anchored to a geodetic point on a body. Reference a named station from structures/ground_stations/ rather than this generic host."
)
{
    uniform bool lunco:spawnable = true

    # Geodetic pin. The comms layer places the station on the (rotating) body
    # from the ephemeris — this prim's scene transform is IGNORED, so a station
    # is positioned by these four numbers and nothing else. Body 399 is Earth.
    # Every value here is a placeholder: the named instances override all four.
    double lunco:anchor:lat = 0
    double lunco:anchor:lon = 0
    double lunco:anchor:height = 0
    int lunco:anchor:body = 399

    # ── Screen label ──────────────────────────────────────────────────────────
    #
    # `{label}` resolves to `ui:displayName` (authored per station — the STANDARD
    # USD human name) and falls back to the prim's leaf name, so a station that
    # forgets its label still reads as something rather than blank. It used to say
    # `lunco:label`; that attribute was retired in favour of the core-USD spelling,
    # and the overlay went on passing nothing at all, so every station on screen
    # read "BearLakes" until the two ends were reconnected.
    #
    # `fadeEnd` is the interesting number. A 70 m dish on a true-scale Earth
    # (6371 km radius) is ~1/91,000 of the body — sub-pixel from any camera that
    # can see the whole globe, so the LABEL is the only thing that marks the site
    # at that range. 50,000 km covers every sane globe-view camera distance
    # (Earth auto-focus sits near 3× radius ≈ 19,000 km) while staying well under
    # the 384,400 km lunar distance, so six Earth stations do NOT stack their
    # labels onto the Earth disc in the lunar sky, where they would be unreadable
    # clutter rather than information. Raise it per instance if a scene wants
    # exactly that.
    custom bool lunco:billboard = true
    custom string lunco:billboard:text = "{label}\n{lat:.4}, {lon:.4}"
    custom float lunco:billboard:offsetY = 45.0
    custom float lunco:billboard:fadeEnd = 50000000.0

    # ── The marker pin: what makes the station VISIBLE at globe range ────────
    #
    # The dish above is physically correct and therefore invisible from anywhere
    # you can see Earth: 70 m on a 6371 km body is 1/91,000 of the disc. This
    # prim is the fix, and it is the fix the README asked for — a screen-constant
    # shape, so a station reads as a MARK and not only as a line of text.
    #
    # `LunCoMarkerAPI` holds the apparent diameter at 0.12°. SIZE THIS AGAINST
    # THE EARTH DISC, NOT THE SCREEN: Earth from the Moon is 1.9° wide, so half a
    # degree — a modest-looking number — is a quarter of the planet. 0.12° is ~6%
    # of the disc: a dot you can point at, on a globe that still reads as a globe,
    # and ~5 px in the ~19,000 km Earth auto-focus view. The sphere is UNIT-sized
    # because the engine owns the scale outright — do not author a radius here, it
    # will be overwritten every frame.
    #
    # It hides inside 200 km, where the real facility takes over: an angular
    # marker never stops scaling down, and a 0.4 m ball hovering over the
    # pedestal at walking distance is clutter parked on top of a model that is
    # already telling the truth.
    #
    # NOT a `lunco:link:*` participant and NOT an occluder: the link kernel reads
    # the aperture's geometry, and a 3 km marker sphere in the sight-line would
    # sever the very link it is drawn to advertise.
    def Sphere "Marker" (
        prepend apiSchemas = ["LunCoMarkerAPI", "MaterialBindingAPI"]
    )
    {
        double radius = 1
        float lunco:marker:angularSizeDeg = 0.12
        float lunco:marker:showBeyondM = 200000
        # EMISSIVE-ONLY, the same way `link_beam.usda` states it and for the same
        # reason: a marker is a SIGNAL, not a lit surface. Lit, it renders pure
        # black on the night half of Earth — precisely the half where a station is
        # doing the work of tracking a lunar night — and blows out to a white dot
        # in direct sun, indistinguishable from a star.
        rel material:binding = </GroundStation/Looks/MarkerLook>
        bool primvars:doNotCastShadows = true
        bool physics:collisionEnabled = false
        double3 xformOp:translate = (0, 60.0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Scope "Looks"
    {
        def Material "MarkerLook"
        {
            token outputs:surface.connect = </GroundStation/Looks/MarkerLook/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.0, 0.0, 0.0)
                # Cyan, and deliberately UNDER 1.0. An emissive above 1 does not
                # read as "brighter cyan", it reads as WHITE: the tonemapper
                # desaturates the highlight and the marker comes out an anonymous
                # white dot, indistinguishable from a star (measured: 0.35/1.6/2.0
                # rendered as 253,253,252). Staying inside the display range is
                # what keeps the mark a COLOUR rather than a blowout. Retint here —
                # it applies to every station at once.
                color3f inputs:emissiveColor = (0.10, 0.62, 0.90)
                float inputs:opacity = 0.9
                token outputs:surface
            }
        }
    }

    # The alidade — the rotating structure a big dish actually stands on. Sized
    # for the 70 m class (~26 m to the elevation axis; DSS-14's is ~24 m). A 64 m
    # station reuses it: the 9% it is out by is invisible next to a 35 m rim.
    # No collider, deliberately: nothing in a lunar scene can touch a structure on
    # Earth, and the original station had none. `comms_mast` gives its tower one
    # because a revolute joint attaches to it; this dish does not slew, so there
    # is no joint and a collider would be pure cost.
    def Cylinder "Pedestal"
    {
        uniform token axis = "Y"
        double radius = 9.0
        double height = 26.0
        double3 xformOp:translate = (0, 13.0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.80, 0.80, 0.82)]
    }

    def "Antenna" (
        prepend references = @lunco://components/comms/antenna.usda@</CommsAntenna>
    )
    {
        double3 xformOp:translate = (0, 26.0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        # The pedestal below IS the mast. The component's own 0.8 m stalk would
        # otherwise draw a second, tiny one buried inside it.
        over "Mast"
        {
            token visibility = "invisible"
        }

        over "YawHead"
        {
            # Static structure, not a link in an articulation: see the header.
            bool physics:rigidBodyEnabled = false

            over "DishGimbal"
            {
                bool physics:rigidBodyEnabled = false

                over "DishHead"
                {
                    # 70 m aperture (1.16 · 60.34). Named stations override this
                    # single line; nothing else about a station's size is
                    # authored anywhere.
                    double3 xformOp:scale = (60.34, 60.34, 60.34)

                    over "LinkAperture"
                    {
                        # The connectivity endpoint is the FEED, not this root —
                        # the same rule the comms mast follows, so link geometry,
                        # RF state and the drawn beam share one origin.
                        # `class = "earth"` marks it a route root; a 5° elevation
                        # mask is realistic for a big dish with terrain and
                        # atmosphere at the horizon.
                        string lunco:link:class = "earth"
                        double lunco:link:minElevationDeg = 5
                    }
                }
            }
        }

        # Pointing is off — the mechanism is scenery. See the header for why, and
        # for what to change to turn it back on.
        over "EarthTrackerController" (
            active = false
        )
        {
        }

        over "YawJoint" (
            active = false
        )
        {
        }

        over "ElevationJoint" (
            active = false
        )
        {
        }
    }
}
