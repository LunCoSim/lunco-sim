#usda 1.0
(
    defaultPrim = "Chassis"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Cube "Chassis" (
    kind = "subcomponent"
    prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
)
{
    double size = 1.0
    double3 xformOp:scale = (2.0, 0.3, 3.5)
    uniform token[] xformOpOrder = ["xformOp:scale"]
    color3f[] primvars:displayColor = [(0.25, 0.25999999046325684, 0.2800000011920929)]
    rel material:binding = </Chassis/HullLook>
    def Material "HullLook"
    {
        token outputs:surface
        token outputs:surface.connect = </Chassis/HullLook/Shader.outputs:surface>
        def Shader "Shader"
        {
            uniform token info:implementationSource = "sourceAsset"
            color3f inputs:accent_color = (0.8500000238418579, 0.44999998807907104, 0.10000000149011612)
            float inputs:panel_scale = 2.0
            float inputs:wear = 0.07999999821186066
            float inputs:dust_amount = 0.15000000596046448
            token outputs:surface
            uniform asset info:wesl:sourceAsset = @lunco://shaders/rover_hull.wesl@
        }
    }
}
