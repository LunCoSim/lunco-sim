#usda 1.0
(
    defaultPrim = "Suspension"
    upAxis = "Y"
    metersPerUnit = 1.0
)

over "Suspension" (
    prepend apiSchemas = ["PhysxVehicleSuspensionAPI", "LunCoSuspensionAPI"]
    kind = "component"
)
{
    float lunco:suspension:restLength = 0.0
    float physxVehicleSuspension:springStrength = 15000.0
    float physxVehicleSuspension:springDamperRate = 5000.0
    float physxVehicleSuspension:travelDistance = 0.0
    def Cylinder "SuspensionCasing" (
        documentation = "Visual mounting bracket of the rigid wheel mount. Nothing moves; plain geometry only."
    )
    {
        uniform token axis = "Y"
        double radius = 0.04
        double height = 0.2
        double3 xformOp:translate = (0.0, 0.1, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.20000000298023224, 0.20000000298023224, 0.20000000298023224)]
        bool physics:collisionEnabled = false
    }
}
