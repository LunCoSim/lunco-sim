#usda 1.0
(
    defaultPrim = "Suspension"
    upAxis = "Y"
    metersPerUnit = 1.0
)

over "Suspension" (
    prepend apiSchemas = ["PhysxVehicleSuspensionAPI", "LunCoSuspensionAPI"]
    kind = "component"
)
{
    float lunco:suspension:restLength = 0.699999988079071
    float physxVehicleSuspension:springStrength = 15000.0
    float physxVehicleSuspension:springDamperRate = 3000.0
    float physxVehicleSuspension:travelDistance = 0.699999988079071
    def Cylinder "SuspensionCasing" (
        prepend apiSchemas = ["LunCoSuspensionVisualAPI"]
        documentation = "Visual housing (outer cylinder) of the suspension strut. Stays fixed to the chassis mount point."
    )
    {
        uniform token lunco:suspensionVisual:role = "casing"
        uniform token axis = "Y"
        double radius = 0.04
        double height = 0.2
        double3 xformOp:translate = (0.0, 0.2, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.20000000298023224, 0.20000000298023224, 0.20000000298023224)]
        bool physics:collisionEnabled = false
    }
    def Cylinder "SuspensionPiston" (
        prepend apiSchemas = ["LunCoSuspensionVisualAPI"]
        documentation = "Visual piston (inner cylinder) of the suspension strut. Translates dynamically to follow the wheel's vertical displacement."
    )
    {
        uniform token lunco:suspensionVisual:role = "piston"
        uniform token axis = "Y"
        double radius = 0.025
        double height = 0.2
        double3 xformOp:translate = (0.0, 0.1, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.3499999940395355, 0.3499999940395355, 0.3700000047683716)]
        bool physics:collisionEnabled = false
    }
    def Cylinder "SuspensionSpring" (
        prepend apiSchemas = ["LunCoSuspensionVisualAPI"]
        documentation = "Visual spring coil of the suspension strut. Compresses and stretches dynamically based on suspension travel."
    )
    {
        uniform token lunco:suspensionVisual:role = "spring"
        uniform token axis = "Y"
        double radius = 0.06
        double height = 0.3
        double3 xformOp:translate = (0.0, 0.15, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.800000011920929, 0.20000000298023224, 0.20000000298023224)]
        bool physics:collisionEnabled = false
    }
}
