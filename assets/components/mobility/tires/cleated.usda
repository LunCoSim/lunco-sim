#usda 1.0
(
    defaultPrim = "Tire"
    upAxis = "Y"
    metersPerUnit = 1
)

# A CLEATED regolith tire — deep aggressive cleats that bite loose soil. The grippiest
# rubber in the shed: μ=1.3 ⇒ a slip limit of atan(1.3) = 52.4°, past anything the
# surveyed site can present, so a rover on these climbs any line it can reach.
#
# It is a `regolith` tire with better bite and nothing else changed: this `over`
# references `regolith.usda`</Tire> and overrides ONE number. The tread, the shader, the
# contact stiffness and the `LunCoTireAPI`/`PhysxVehicleTireAPI` application all arrive
# through that arc. A tire that differs by a coefficient should say so in a line, not by
# restating a tread it did not change.

over "Tire" (
    prepend references = @lunco://components/mobility/tires/regolith.usda@</Tire>
    kind = "component"
)
{
    double lunco:tire:frictionCoefficient = 1.8
    # The solver's coefficient tracks it — see the block in `regolith.usda` for why a
    # tyre carries two friction numbers and for the relation that sets this one:
    # `solver = 2·(μ / 0.55) − 1`. The flat 1.125·μ this replaces delivered an
    # effective ~0.83 against an authored 1.8 — the EASY tier gripped worse than
    # the default regolith tyre on a physical drivetrain, which is backwards.
    # 5.55 is an extrapolation of a relation measured at μ = 0.8; of the five
    # tyres this is the one to re-sweep on `drivetrain_parity` first.
    float physics:dynamicFriction = 5.55
    float physics:staticFriction = 5.55

    # The look states the grip: fewer, deeper cleats at full relief.
    over "TireLook"
    {
        over "Shader"
        {
            float inputs:tread_lugs = 14.0
            float inputs:lug_depth = 1.0
            float inputs:dust_amount = 0.5
        }
    }
}
