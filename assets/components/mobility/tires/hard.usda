#usda 1.0
(
    defaultPrim = "Tire"
    upAxis = "Y"
    metersPerUnit = 1.0
)

over "Tire" (
    prepend apiSchemas = ["PhysxVehicleTireAPI", "PhysicsMaterialAPI", "LunCoTireAPI", "MaterialBindingAPI"]
    kind = "component"
)
{
    float physxVehicleTire:longitudinalStiffness = 14000.0
    float physics:dynamicFriction = 1.100000023841858
    float physics:staticFriction = 1.100000023841858
    float2 physxVehicleTire:lateralStiffnessGraph = (1.0, 5600.0)
    float physxVehicleTire:restLoad = 400.0
    float lunco:tire:minValidatedSpeed = 0.0
    rel material:binding = </Tire/TireLook>
    color3f[] primvars:displayColor = [(0.2199999988079071, 0.2199999988079071, 0.23999999463558197)]
    def Material "TireLook"
    {
        token outputs:surface
        token outputs:surface.connect = </Tire/TireLook/Shader.outputs:surface>
        def Shader "Shader"
        {
            uniform token info:implementationSource = "sourceAsset"
            color3f inputs:rim_color = (0.11999999731779099, 0.12999999523162842, 0.14000000059604645)
            color3f inputs:tire_color = (0.05000000074505806, 0.05000000074505806, 0.05999999865889549)
            float inputs:spoke_count = 6.0
            float inputs:tread_lugs = 48.0
            float inputs:lug_depth = 0.30000001192092896
            float inputs:wear = 0.05000000074505806
            token outputs:surface
            uniform asset info:wesl:sourceAsset = @lunco://shaders/wheel.wesl@
        }
    }
}
