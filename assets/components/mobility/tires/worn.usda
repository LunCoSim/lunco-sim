#usda 1.0
(
    defaultPrim = "Tire"
    upAxis = "Y"
    metersPerUnit = 1
)

# A WORN regolith tire — cleats rounded off by a few hundred klicks. μ=1.0 ⇒ a slip
# limit of atan(1.0) = 45.0°: clears the steepest surveyed line (39.9° NNW) with
# margin, so a rover on these climbs any route in the site. The rover still goes
# where you plan; what makes it stop is torque, not grip — see the tier files.
#
# The value is load-bearing, not flavour. The regolith tyre re-grip (2026-07-18
# drivetrain rebalance) lifted it from μ=0.5 (26.6°) to 1.0; the "worn = barely
# climbs" story is now told by the TIER'S MOTOR (85 N·m at the axle), not by the
# rubber. See the twin's SURVEY.md ladder table, which is canonical for the site.
#
# A `regolith` tire with less bite and nothing else changed — see `cleated.usda` for
# why this file is three lines long.

over "Tire" (
    prepend references = @lunco://components/mobility/tires/regolith.usda@</Tire>
    kind = "component"
)
{
    float physics:dynamicFriction = 1.0
    float physics:staticFriction = 1.0

    # The look states the grip: rounded and flattened lugs after a hundred
    # klicks of wear.
    over "TireLook"
    {
        over "Shader"
        {
            float inputs:lug_depth = 0.4
            float inputs:wear = 0.7
        }
    }
}
