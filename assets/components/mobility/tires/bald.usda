#usda 1.0
(
    defaultPrim = "Tire"
    upAxis = "Y"
    metersPerUnit = 1
)

# A BALD regolith tire — the cleats are gone. μ=0.8 ⇒ a slip limit of atan(0.8) = 38.7°,
# which clears the steepest SECTOR of the surveyed site (31.1° N) with margin; only the
# single steepest line (39.9° NNW) is close. Grip is therefore NOT what punishes this
# tier — its weak motor (68 N·m at the axle, ~1.5× its cone) is. Every metre is still a
# traction decision: at that torque, any wheel that goes light stays light. That is the point.
#
# A `regolith` tire with almost no bite and nothing else changed — see `cleated.usda`
# for why this file is three lines long.

over "Tire" (
    prepend references = @lunco://components/mobility/tires/regolith.usda@</Tire>
    kind = "component"
)
{
    double lunco:tire:frictionCoefficient = 0.8
    # The solver's coefficient tracks it — see the block in `regolith.usda` for why a
    # tyre carries two friction numbers and for the relation that sets this one:
    # `solver = 2·(μ / 0.55) − 1`. It was 0.9 (a flat 1.125·μ), which is not that
    # relation: through avian's Average-with-ground and its ~55% delivery under
    # sliding, 0.9 lands an effective ~0.52 against an authored 0.8 — a physical
    # drivetrain on this tyre had a third less grip than the analytic model it is
    # supposed to match, so it span its wheels where its raycast twin drove.
    float physics:dynamicFriction = 1.91
    float physics:staticFriction = 1.91

    # The look states the grip: tread gone — a smooth, dusty drum.
    over "TireLook"
    {
        over "Shader"
        {
            float inputs:lug_depth = 0.05
            float inputs:wear = 0.95
            float inputs:dust_amount = 0.55
        }
    }
}
