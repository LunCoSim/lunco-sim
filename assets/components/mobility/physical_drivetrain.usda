#usda 1.0
(
    defaultPrim = "Drivetrain"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "Drivetrain" (
    kind = "component"
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    doc = "Joint-based drivetrain overlay. Vehicle physical variants author chassis-to-carrier joint frames at their mount positions. Coincident carrier-to-wheel frames use the standard zero position and identity rotation defaults."
)
{
    def PhysicsPrismaticJoint "Suspension_FL_Slider" (
        prepend apiSchemas = ["PhysicsDriveAPI:linear"]
    )
    {
        rel physics:body0 = </Drivetrain>
        rel physics:body1 = </Drivetrain/Suspension_FL>
        uniform token physics:axis = "Y"
        float physics:lowerLimit = -0.699999988079071
        float physics:upperLimit = 0.3499999940395355
        uniform token drive:linear:physics:type = "force"
        float drive:linear:physics:targetPosition = 0.0
        float drive:linear:physics:targetVelocity = 0.0
        float drive:linear:physics:stiffness = 15000.0
        float drive:linear:physics:damping = 3000.0
        float drive:linear:physics:maxForce = 12000.0
    }
    def PhysicsPrismaticJoint "Suspension_FR_Slider" (
        prepend apiSchemas = ["PhysicsDriveAPI:linear"]
    )
    {
        rel physics:body0 = </Drivetrain>
        rel physics:body1 = </Drivetrain/Suspension_FR>
        uniform token physics:axis = "Y"
        float physics:lowerLimit = -0.699999988079071
        float physics:upperLimit = 0.3499999940395355
        uniform token drive:linear:physics:type = "force"
        float drive:linear:physics:targetPosition = 0.0
        float drive:linear:physics:targetVelocity = 0.0
        float drive:linear:physics:stiffness = 15000.0
        float drive:linear:physics:damping = 3000.0
        float drive:linear:physics:maxForce = 12000.0
    }
    def PhysicsPrismaticJoint "Suspension_RL_Slider" (
        prepend apiSchemas = ["PhysicsDriveAPI:linear"]
    )
    {
        rel physics:body0 = </Drivetrain>
        rel physics:body1 = </Drivetrain/Suspension_RL>
        uniform token physics:axis = "Y"
        float physics:lowerLimit = -0.699999988079071
        float physics:upperLimit = 0.3499999940395355
        uniform token drive:linear:physics:type = "force"
        float drive:linear:physics:targetPosition = 0.0
        float drive:linear:physics:targetVelocity = 0.0
        float drive:linear:physics:stiffness = 15000.0
        float drive:linear:physics:damping = 3000.0
        float drive:linear:physics:maxForce = 12000.0
    }
    def PhysicsPrismaticJoint "Suspension_RR_Slider" (
        prepend apiSchemas = ["PhysicsDriveAPI:linear"]
    )
    {
        rel physics:body0 = </Drivetrain>
        rel physics:body1 = </Drivetrain/Suspension_RR>
        uniform token physics:axis = "Y"
        float physics:lowerLimit = -0.699999988079071
        float physics:upperLimit = 0.3499999940395355
        uniform token drive:linear:physics:type = "force"
        float drive:linear:physics:targetPosition = 0.0
        float drive:linear:physics:targetVelocity = 0.0
        float drive:linear:physics:stiffness = 15000.0
        float drive:linear:physics:damping = 3000.0
        float drive:linear:physics:maxForce = 12000.0
    }
    def PhysicsRevoluteJoint "Wheel_FL_Hinge"
    {
        rel physics:body0 = </Drivetrain/Suspension_FL>
        rel physics:body1 = </Drivetrain/Suspension_FL/Wheel_FL>
        uniform token physics:axis = "X"
    }
    def PhysicsRevoluteJoint "Wheel_FR_Hinge"
    {
        rel physics:body0 = </Drivetrain/Suspension_FR>
        rel physics:body1 = </Drivetrain/Suspension_FR/Wheel_FR>
        uniform token physics:axis = "X"
    }
    def PhysicsRevoluteJoint "Wheel_RL_Hinge"
    {
        rel physics:body0 = </Drivetrain/Suspension_RL>
        rel physics:body1 = </Drivetrain/Suspension_RL/Wheel_RL>
        uniform token physics:axis = "X"
    }
    def PhysicsRevoluteJoint "Wheel_RR_Hinge"
    {
        rel physics:body0 = </Drivetrain/Suspension_RR>
        rel physics:body1 = </Drivetrain/Suspension_RR/Wheel_RR>
        uniform token physics:axis = "X"
    }
}
