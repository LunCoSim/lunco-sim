#usda 1.0
(
    defaultPrim = "Motor"
    upAxis = "Y"
    metersPerUnit = 1
)

# A reusable two-domain motor. The electrical pin and measured mechanical speed
# are authored Modelica inputs; the containing USD network connects its solved
# torque output to a generic mechanical torque boundary and then to the load.
def Xform "Motor" (
    doc = "Reusable DC motor with electrical and mechanical Modelica boundaries."
    kind = "component"
    prepend apiSchemas = [
        "LunCoCatalogAPI",
        "PhysicsMassAPI",
        "LunCoProgramAPI",
        "LunCoModelicaTopologyAPI",
    ]
)
{
    uniform token lunco:modelica:topologyRole = "load"
    uniform bool lunco:spawnable = true
    uniform token info:implementationSource = "sourceAsset"
    uniform asset info:sourceAsset = @lunco://models/LunCo/Electrical/DCMotor.mo@

    # Housing mass is a physical part mass, not a standalone rigid body.
    float physics:mass = 8.0 (
        customData = {
            double min = 0.5
            double max = 200
            string unit = "kg"
        }
    )

    # Modelica parameter boundary. The names match DCMotor.mo exactly; the
    # generated network reads these authored inputs and no Rust reader mirrors
    # them.
    float inputs:stall_torque = 1.5
    float inputs:no_load_speed = 4800.0
    float inputs:rated_power = 500.0
    float inputs:v_rated = 28.0
    float inputs:demand = 0.0
    float inputs:speed

    custom token connectors:p
    float outputs:shaft_torque
    float outputs:shaft_speed
    float outputs:heat
    float outputs:electrical_power
    float outputs:terminal_voltage_v
    float outputs:terminal_current_a
    float outputs:mechanical_power_w

    def Cylinder "Body"
    {
        double radius = 0.09
        double height = 0.14
        color3f[] primvars:displayColor = [(0.4, 0.4, 0.4)]
    }
}
