#usda 1.0
(
    defaultPrim = "Gearbox"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "Gearbox" (
    documentation = "Reusable mechanical reduction with authored ratio, efficiency, and output rating."
    kind = "component"
    prepend apiSchemas = ["LunCoCatalogAPI", "PhysicsMassAPI", "LunCoProgramAPI"]
)
{
    uniform bool lunco:spawnable = true
    uniform token info:implementationSource = "sourceAsset"
    uniform asset info:sourceAsset = @lunco://models/LunCo/Mechanics/GearRatio.mo@
    float physics:mass = 4.0 (
        customData = {
    double max = 200.0
    double min = 0.2
    string unit = "kg"
}
    )
    float inputs:ratio = 200.0
    float inputs:eta = 0.8500000238418579
    float inputs:max_output_torque = 400.0
    float outputs:speed_a
    custom token connectors:flange_a
    custom token connectors:flange_b
    custom double outputs:power_a_w = 0.0
    custom double outputs:power_b_w = 0.0
    custom double outputs:heat = 0.0
}
