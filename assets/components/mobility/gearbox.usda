#usda 1.0
(
    defaultPrim = "Gearbox"
    upAxis = "Y"
    metersPerUnit = 1
)

# A reusable ideal reduction with loss and an authored output torque rating.
# Both flanges remain in the same Modelica mechanical network as the motor and
# the Avian shaft boundary, so speed and reaction torque are solved together.
def Xform "Gearbox" (
    doc = "Reusable mechanical reduction with authored ratio, efficiency, and output rating."
    kind = "component"
    prepend apiSchemas = ["LunCoCatalogAPI", "PhysicsMassAPI", "LunCoProgramAPI"]
)
{
    uniform bool lunco:spawnable = true
    uniform token info:implementationSource = "sourceAsset"
    uniform asset info:sourceAsset = @lunco://models/LunCo/Mechanics/GearRatio.mo@

    float physics:mass = 4.0 (
        customData = {
            double min = 0.2
            double max = 200
            string unit = "kg"
        }
    )

    float inputs:ratio = 200.0
    float inputs:eta = 0.85
    float inputs:max_output_torque = 400.0

    custom token connectors:flange_a
    custom token connectors:flange_b
}
