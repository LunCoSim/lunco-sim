#usda 1.0
(
    defaultPrim = "Wheel"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Cylinder "Wheel" (
    documentation = "Reusable motorized rover wheel hub with authored radius, traction, braking, and spin parameters."
    kind = "component"
    prepend apiSchemas = ["LunCoCatalogAPI", "LunCoWheelAPI"]
    prepend variantSets = "tire"
    variants = { string "tire" = "regolith" }
)
{
    uniform token axis = "X"
    double radius = 0.4
    double height = 0.3
    double3 xformOp:translate = (0.0, 0.0, 0.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    float physxVehicleWheel:mass = 25.0 (
        customData = {
    double max = 500.0
    double min = 1.0
    string unit = "kg"
}
    )
    float physxVehicleWheel:radius = 0.4000000059604645
    float physxVehicleWheel:width = 0.30000001192092896
    float physxVehicleWheel:moi = 2.0
    float physxVehicleWheel:dampingRate = 0.44999998807907104
    float physxVehicleWheel:maxBrakeTorque = 1500.0
    double3 lunco:wheel:headingAxis = (0.0, 1.0, 0.0)
    float inputs:drive
    float inputs:heading
    float outputs:shaft_speed
    custom double outputs:bearing_heat = 0.0
    custom double outputs:brake_heat = 0.0
    custom double outputs:tire_heat = 0.0
    custom double outputs:contact = 0.0
    variantSet "tire" = {
        "regolith" (
            prepend references = @lunco://components/mobility/tires/regolith.usda@</Tire>
        ) {
        }
        "hard" (
            prepend references = @lunco://components/mobility/tires/hard.usda@</Tire>
        ) {
        }
        "cleated" (
            prepend references = @lunco://components/mobility/tires/cleated.usda@</Tire>
        ) {
        }
        "worn" (
            prepend references = @lunco://components/mobility/tires/worn.usda@</Tire>
        ) {
        }
        "bald" (
            prepend references = @lunco://components/mobility/tires/bald.usda@</Tire>
        ) {
        }
    }
}
