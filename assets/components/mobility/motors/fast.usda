#usda 1.0
(
    defaultPrim = "MotorClass"
    upAxis = "Y"
    metersPerUnit = 1
)

# FAST winding — half the turns of `standard`, on the same frame.
#
# Twice the no-load speed for half the stall torque: 0.125 x 28 800 is the same
# ~900 W of peak mechanical power. Use it when a vehicle needs road speed more
# than gradeability — the axle ceiling doubles to 24 rad/s (9.6 m/s of rim speed
# through the 1200:1 reduction) while axle torque halves.
#
# ⚠ Torque is what climbs a crater wall. On the six-wheel rocker-bogie this drops
# axle stall to ~128 N.m against a ~46 N.m per-wheel traction limit, which is
# still ample on the flat but noticeably worse on a slope. See `standard.usda`
# for the winding rules these numbers obey.

def Xform "MotorClass" (
    prepend apiSchemas = ["LunCoMotorAPI"]
    kind = "component"
)
{
    float lunco:motor:stallTorque = 0.125
    float lunco:motor:noLoadSpeed = 28800.0
    float lunco:motor:continuousTorque = 0.075
    # FRAME property — same rotor iron as `standard`, so unchanged.
    float lunco:motor:rotorInertia = 0.00012
    float lunco:motor:ratedVoltage = 28.0
}
