#usda 1.0
(
    defaultPrim = "MotorClass"
    upAxis = "Y"
    metersPerUnit = 1
)

# TORQUE winding — twice the turns of `standard`, on the same frame.
#
# Half the no-load speed for twice the stall torque: 0.5 x 7 200, the same ~900 W.
# The climbing winding. Axle stall reaches ~510 N.m through the 1200:1 reduction
# while the axle ceiling drops to 6 rad/s (2.4 m/s of rim speed).
#
# Well past the ~46 N.m per-wheel traction limit of the rocker-bogie, so on that
# vehicle the extra torque is only reachable on high-grip ground or against a
# slope — which is exactly when it is wanted. See `standard.usda` for the rules.

def Xform "MotorClass" (
    prepend apiSchemas = ["LunCoMotorAPI"]
    kind = "component"
)
{
    float lunco:motor:stallTorque = 0.5
    float lunco:motor:noLoadSpeed = 7200.0
    float lunco:motor:continuousTorque = 0.3
    # FRAME property — same rotor iron as `standard`, so unchanged.
    float lunco:motor:rotorInertia = 0.00012
    float lunco:motor:ratedVoltage = 28.0
}
