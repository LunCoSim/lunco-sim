#usda 1.0
(
    defaultPrim = "MotorClass"
    upAxis = "Y"
    metersPerUnit = 1
)

# LUNOKHOD — the authentic machine, and a SMALLER FRAME than the other classes.
#
# Sized so the 200:1 reduction lands the axle at 1.39 rad/s: 0.56 m/s of rim
# speed on a 0.4 m wheel, which is Lunokhod's real ~2 km/h.
#
# This is the one class with a smaller motor frame. Its complete tire-and-
# drivetrain assembly inertia is authored on the composed wheel, so this winding
# changes only the motor's electrical nameplate values.
#
# ⚠ AUTHENTIC AND, FOR TEACHING, UNUSABLE. This was tried on the school scenario
# and rejected: it turns a 2.7 km round trip into a multi-hour wait. It is kept
# because a fidelity comparison is worth having, not because anything drives it.

def Xform "MotorClass" (
    prepend apiSchemas = ["LunCoProgramAPI"]
    kind = "component"
)
{
    float inputs:stall_torque = 1.44
    float inputs:no_load_speed = 277.83
    # Assembly inertia is authored on the composed wheel, not duplicated here.
}
