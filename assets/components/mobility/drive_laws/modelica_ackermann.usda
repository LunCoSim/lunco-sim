#usda 1.0
(
    defaultPrim = "DriveLaw"
    upAxis = "Y"
    metersPerUnit = 1
)

# Modelica DRIVE LAW for an ACKERMANN rover — the `driveLaw = "modelica"`
# variant references this into the rover ROOT, exactly as `modelica_skid.usda`
# does for the skid rovers: a variant CHOOSES a component, it never restates
# one. Everything below composes onto the rover; `</DriveLaw.…>` paths
# translate to the HOST rover root through the reference arc.
#
# What it does: replaces the instant built-in Ackermann linear kernel with a
# physical command→torque law — `models/LunCo/Mobility/RoverAckermannDrivetrain.mo` integrates
# ONE first-order motor lag on the shared axle (Ackermann steers with the front
# knuckles, not a torque differential). Native USD connections project its
# normalized outputs onto `drive_left`/`drive_right`/`steering`.
# `steering` is a model passthrough: the built-in kernel this
# law displaces writes all three ports, so the law must feed all three.
# USD wires + Modelica physics; no numerical Rhai bridge.
#
# NOT `lunco:spawnable` — an overlay for a rover that already has FSW ports.
# ── The law FORWARDS the vessel's outputs — see `modelica_skid.usda` ─────────
#
# `drive_left`/`drive_right`/`steering` are OUTPUTS of the rover root. A drive
# law replaces their PRODUCER, so the connections below are output-to-output
# forwards, not `inputs:` writes. The runtime materialises the forwards onto the
# vessel's actuator ports; see the production-backed note in `modelica_skid.usda`.
def Xform "DriveLaw" (
    kind = "component"
)
{
    # Contribute the law's Modelica member to the host rover's composed
    # component collection; collection membership is the generated-network
    # ownership contract.
    prepend rel collection:components:includes = [</DriveLaw/Drivetrain>]

    # The command surface is projected on the host rover root by the OBC's
    # authored Controls profile. Declare the same causal boundary here so the
    # generated network can receive those live InputPorts values.
    float inputs:throttle = 0.0
    float inputs:steer = 0.0

    # These connected outputs are the authoritative allocation. Their presence
    # prevents derivation of a second, imperative DriveMix on the vessel.
    float outputs:drive_left.connect = </DriveLaw/Drivetrain.outputs:drive_left>
    float outputs:drive_right.connect = </DriveLaw/Drivetrain.outputs:drive_right>
    float outputs:steering.connect = </DriveLaw/Drivetrain.outputs:steering>

    # The physics: shared-axle first-order motor lag + steering passthrough,
    # solver-clocked. In a CHILD prim because the rover root already binds the
    # OBC's model and `info:sourceAsset` is single-valued.
    def Scope "Drivetrain" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://models/LunCo/Mobility/RoverAckermannDrivetrain.mo@
        float outputs:drive_left
        float outputs:drive_right
        float outputs:steering
        # `</DriveLaw.…>` = the host rover root after arc translation: the
        # model reads the same FSW command ports the built-in kernels read.
        float inputs:throttle.connect = </DriveLaw.inputs:throttle>
        float inputs:steer.connect = </DriveLaw.inputs:steer>
    }
}
