#usda 1.0
(
    defaultPrim = "DriveLaw"
    upAxis = "Y"
    metersPerUnit = 1
)

# Modelica drive law for an Ackermann rover. The rover root references this
# component so its composed model publishes generic drive and joint-heading
# values through the authored port graph.
#
# What it does: `RoverAckermannDrivetrain.mo` integrates one first-order motor
# state on the shared axle and computes final left/right front-knuckle headings
# from the authored wheelbase and track. USD wires + Modelica physics; no
# numerical Rhai bridge.
#
# NOT `lunco:spawnable` — an overlay for a rover that already has FSW ports.
# ── The law FORWARDS the vessel's outputs — see `modelica_skid.usda` ─────────
#
# The root drive and heading values are outputs. This component is their
# producer, so the connections below are output-to-output forwards.
def Xform "DriveLaw" (
    kind = "component"
)
{
    # Contribute the law's Modelica member to the host rover's composed
    # component collection; collection membership is the generated-network
    # ownership contract.
    prepend rel collection:components:includes = [</DriveLaw/Drivetrain>]

    # The command surface is projected on the host rover root by the OBC's
    # authored Controls profile. Declare the same causal boundary here so the
    # generated network can receive those live InputPorts values.
    float inputs:throttle = 0.0
    float inputs:steer = 0.0

    # These connected outputs are the authored source for the vessel's generic
    # wheel and steering-joint ports.
    float outputs:drive_left.connect = </DriveLaw/Drivetrain.outputs:drive_left>
    float outputs:drive_right.connect = </DriveLaw/Drivetrain.outputs:drive_right>
    float outputs:heading_fl.connect = </DriveLaw/Drivetrain.outputs:heading_fl>
    float outputs:heading_fr.connect = </DriveLaw/Drivetrain.outputs:heading_fr>

    # The physics: shared-axle first-order motor lag + heading geometry,
    # solver-clocked. In a child prim because the rover root already binds the
    # OBC's model and `info:sourceAsset` is single-valued.
    def Scope "Drivetrain" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://models/LunCo/Mobility/RoverAckermannDrivetrain.mo@
        float outputs:drive_left
        float outputs:drive_right
        float outputs:heading_fl
        float outputs:heading_fr
        # The translated reference reads the host rover's command ports.
        float inputs:throttle.connect = </DriveLaw.inputs:throttle>
        float inputs:steer.connect = </DriveLaw.inputs:steer>
    }
}
