#usda 1.0
(
    defaultPrim = "DriveLaw"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "DriveLaw" (
    kind = "component"
)
{
    rel collection:components:includes
    prepend rel collection:components:includes = </DriveLaw/Drivetrain>
    float inputs:throttle = 0.0
    float inputs:steer = 0.0
    float inputs:program_active = 0.0
    float inputs:autopilot_enable = 0.0
    float inputs:autopilot_target_x = 0.0
    float inputs:autopilot_target_z = 0.0
    float inputs:autopilot_speed = 0.0
    float inputs:autopilot_radius = 2.0
    float inputs:autopilot_turn_only = 0.0
    float inputs:autopilot_position_x
    float inputs:autopilot_position_x.connect = </DriveLaw.outputs:position_x>
    float inputs:autopilot_position_z
    float inputs:autopilot_position_z.connect = </DriveLaw.outputs:position_z>
    float inputs:autopilot_yaw
    float inputs:autopilot_yaw.connect = </DriveLaw.outputs:yaw>
    float inputs:autopilot_yaw_rate
    float inputs:autopilot_yaw_rate.connect = </DriveLaw.outputs:angvel_y>
    float inputs:piloted
    float inputs:piloted.connect = </DriveLaw.outputs:piloted>
    float outputs:drive_left
    float outputs:drive_left.connect = </DriveLaw/Drivetrain.outputs:drive_left>
    float outputs:drive_right
    float outputs:drive_right.connect = </DriveLaw/Drivetrain.outputs:drive_right>
    float outputs:guidance_throttle
    float outputs:guidance_throttle.connect = </DriveLaw/Drivetrain.outputs:guidance_throttle>
    float outputs:guidance_steer
    float outputs:guidance_steer.connect = </DriveLaw/Drivetrain.outputs:guidance_steer>
    float outputs:guidance_heading_error
    float outputs:guidance_heading_error.connect = </DriveLaw/Drivetrain.outputs:guidance_heading_error>
    custom double outputs:guidance_travel_throttle = 0.0
    double outputs:guidance_travel_throttle.connect = </DriveLaw/Drivetrain.outputs:guidance_travel_throttle>
    custom double inputs:autopilot_velocity_x
    double inputs:autopilot_velocity_x.connect = </DriveLaw.outputs:velocity_x>
    custom double inputs:autopilot_velocity_z
    double inputs:autopilot_velocity_z.connect = </DriveLaw.outputs:velocity_z>
    def Scope "Drivetrain" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://models/LunCo/Mobility/RoverDrivetrain.mo@
        float outputs:drive_left
        float outputs:drive_right
        float outputs:guidance_throttle
        float outputs:guidance_steer
        float outputs:guidance_heading_error
        float inputs:throttle
        float inputs:throttle.connect = </DriveLaw.inputs:throttle>
        float inputs:steer
        float inputs:steer.connect = </DriveLaw.inputs:steer>
        float inputs:program_active
        float inputs:program_active.connect = </DriveLaw.inputs:program_active>
        float inputs:autopilot_enable
        float inputs:autopilot_enable.connect = </DriveLaw.inputs:autopilot_enable>
        float inputs:autopilot_target_x
        float inputs:autopilot_target_x.connect = </DriveLaw.inputs:autopilot_target_x>
        float inputs:autopilot_target_z
        float inputs:autopilot_target_z.connect = </DriveLaw.inputs:autopilot_target_z>
        float inputs:autopilot_speed
        float inputs:autopilot_speed.connect = </DriveLaw.inputs:autopilot_speed>
        float inputs:autopilot_radius
        float inputs:autopilot_radius.connect = </DriveLaw.inputs:autopilot_radius>
        float inputs:autopilot_turn_only
        float inputs:autopilot_turn_only.connect = </DriveLaw.inputs:autopilot_turn_only>
        float inputs:autopilot_position_x
        float inputs:autopilot_position_x.connect = </DriveLaw.inputs:autopilot_position_x>
        float inputs:autopilot_position_z
        float inputs:autopilot_position_z.connect = </DriveLaw.inputs:autopilot_position_z>
        float inputs:autopilot_yaw
        float inputs:autopilot_yaw.connect = </DriveLaw.inputs:autopilot_yaw>
        float inputs:autopilot_yaw_rate
        float inputs:autopilot_yaw_rate.connect = </DriveLaw.inputs:autopilot_yaw_rate>
        float inputs:piloted
        float inputs:piloted.connect = </DriveLaw.inputs:piloted>
        custom double outputs:guidance_travel_throttle = 0.0
        custom double inputs:autopilot_velocity_x
        double inputs:autopilot_velocity_x.connect = </DriveLaw.inputs:autopilot_velocity_x>
        custom double inputs:autopilot_velocity_z
        double inputs:autopilot_velocity_z.connect = </DriveLaw.inputs:autopilot_velocity_z>
    }
}
