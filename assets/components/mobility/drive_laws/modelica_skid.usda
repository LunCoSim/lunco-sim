#usda 1.0
(
    defaultPrim = "DriveLaw"
    upAxis = "Y"
    metersPerUnit = 1
)

# Modelica drive law for a skid rover. The rover root references this component
# so the composed model publishes wheel demands consumed by generic wheel
# ports. Everything below composes onto the host rover through the reference arc.
#
# What it does: `RoverDrivetrain.mo` integrates a first-order motor state per
# side on the solver clock. Native USD connections publish its outputs onto the
# rover's generic wheel ports; no tick script participates.
#
# NOT `lunco:spawnable` — an overlay for a rover that already has FSW ports.
# ── The law FORWARDS the vessel's output; it does not write an input ─────────
#
# `drive_left` on a rover root is an output consumed by wheel drive inputs. The
# drive law is its producer, so this is an output-to-output forward.
#
#     float outputs:drive_left.connect = </DriveLaw/Drivetrain.outputs:drive_left>
#
# ── Why the model stays in a child prim ──────────────────────────────────────
#
# Not for tidiness — the rover root is already taken. It references
# `components/avionics/obc.usda`, so it ALREADY carries `LunCoProgramAPI` and an
# `info:sourceAsset`. That attribute is single-valued and the OBC's arc is
# stronger, so a second `info:sourceAsset` here would be silently overridden and
# the drive law would never bind at all. One prim, one model.
#
# The generated network materialises these forwards onto the vessel's generic
# wheel ports.
def Xform "DriveLaw" (
    kind = "component"
)
{
    # Extend the host rover's composed Modelica member collection. The rover
    # owns the collection and the overlay contributes its one program member;
    # without this authored membership the drive law is visible in USD but is
    # not part of the generated network.
    prepend rel collection:components:includes = [</DriveLaw/Drivetrain>]

    # The command surface is projected on the host rover root by the OBC's
    # authored Controls profile. Declare the same causal boundary here so the
    # generated network can receive those live InputPorts values.
    float inputs:throttle = 0.0
    float inputs:steer = 0.0

    # These connected outputs are the authored source for the vessel's wheel
    # demand ports.
    float outputs:drive_left.connect = </DriveLaw/Drivetrain.outputs:drive_left>
    float outputs:drive_right.connect = </DriveLaw/Drivetrain.outputs:drive_right>

    # The physics: per-side first-order motor lag, solver-clocked.
    def Scope "Drivetrain" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://models/LunCo/Mobility/RoverDrivetrain.mo@
        float outputs:drive_left
        float outputs:drive_right
        # The translated reference reads the host rover's command ports.
        float inputs:throttle.connect = </DriveLaw.inputs:throttle>
        float inputs:steer.connect = </DriveLaw.inputs:steer>
    }
}
