#usda 1.0
(
    defaultPrim = "DriveLaw"
    upAxis = "Y"
    metersPerUnit = 1
)

# Modelica DRIVE LAW for the SIX-INDEPENDENT rover — the `driveLaw = "modelica"`
# variant references this into the rover ROOT, exactly as `modelica_skid.usda`
# does for the skid rovers: a variant CHOOSES a component, it never restates
# one. Everything below composes onto the rover; `</DriveLaw.…>` paths
# translate to the HOST rover root through the reference arc.
#
# What it does: replaces the authored `DriveMix` scope (the instant six-channel
# skid mix) with a physical command→torque law. The physics is per-SIDE (one
# motor controller per bank, two states, not six) and identical to the skid
# law's; `RoverSixIndependentDrivetrain.mo` differs from `RoverDrivetrain.mo`
# only in publishing the six per-wheel names this vehicle declares
# (`drive_w0..w2` = left bank, `drive_w3..w5` = right bank).
#
# NOT `lunco:spawnable` — an overlay for a rover that already has FSW ports.
# ── The law FORWARDS the vessel's outputs — see `modelica_skid.usda` ─────────
#
# `drive_w0..drive_w5` are OUTPUTS of the rover root — the commands each wheel
# consumes. A drive law replaces their PRODUCER, so these are output-to-output
# forwards, and the per-side fan-out is exactly that: wiring, not physics, which
# is why one `RoverDrivetrain` still serves. The runtime materialises these
# forwards onto the six authored actuator ports.
def Xform "DriveLaw" (
    kind = "component"
)
{
    # Contribute the law's Modelica member to the host rover's composed
    # component collection; collection membership is the generated-network
    # ownership contract.
    prepend rel collection:components:includes = [</DriveLaw/Drivetrain>]

    # The command surface is projected on the host rover root by the OBC's
    # authored Controls profile. Declare the same causal boundary here so the
    # generated network can receive those live InputPorts values.
    float inputs:throttle = 0.0
    float inputs:steer = 0.0

    # These connected outputs are the authoritative allocation. Their presence
    # prevents derivation of a second, imperative DriveMix on the vessel.
    float outputs:drive_w0.connect = </DriveLaw/Drivetrain.outputs:drive_left>
    float outputs:drive_w1.connect = </DriveLaw/Drivetrain.outputs:drive_left>
    float outputs:drive_w2.connect = </DriveLaw/Drivetrain.outputs:drive_left>
    float outputs:drive_w3.connect = </DriveLaw/Drivetrain.outputs:drive_right>
    float outputs:drive_w4.connect = </DriveLaw/Drivetrain.outputs:drive_right>
    float outputs:drive_w5.connect = </DriveLaw/Drivetrain.outputs:drive_right>

    # The physics: per-side first-order motor lag, solver-clocked. In a CHILD
    # prim because the rover root already binds the OBC's model and
    # `info:sourceAsset` is single-valued.
    def Scope "Drivetrain" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://models/LunCo/Mobility/RoverDrivetrain.mo@
        float outputs:drive_left
        float outputs:drive_right
        # `</DriveLaw.…>` = the host rover root after arc translation: the
        # model reads the same FSW command ports the built-in kernels read.
        float inputs:throttle.connect = </DriveLaw.inputs:throttle>
        float inputs:steer.connect = </DriveLaw.inputs:steer>
    }
}
