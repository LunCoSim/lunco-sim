#usda 1.0
(
    defaultPrim = "LunarSurfaceCamera"
    metersPerUnit = 1
)

# Shared `UsdGeomCamera` grade for interactive lunar surface scenes.
#
# This is a standard USD camera component, not a process preference: the
# physical Sun stays calibrated and every composed consumer receives the same
# display exposure. A deliberate campaign take can override these standard
# camera attributes on its local Camera prim.
def Camera "LunarSurfaceCamera" (
    prepend apiSchemas = ["LunCoCameraAPI"]
)
{
    # This component is referenced only by interactive avatar cameras. The
    # binding remains authored data, so changing the avatar command vocabulary
    # does not require a Rust change.
    def "Controls" (
        prepend references = @lunco://vessels/control_profiles.usda@</AvatarControls>
    )
    {
    }

    # Match the sandbox free-flight camera's former ~45° vertical view. USD's
    # 50 mm default is a narrow photographic lens, not a navigation camera.
    float focalLength = 18

    # EV100 = log2(fStop² / time) at ISO 100. f/16 for 3.90625 ms is EV16,
    # paired with the calibrated 128 klx lunar sun.
    float exposure:fStop = 16
    float exposure:iso = 100
    float exposure:responsivity = 1
    float exposure:time = 0.00390625
}
