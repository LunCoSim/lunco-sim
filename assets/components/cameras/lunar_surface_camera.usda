#usda 1.0
(
    defaultPrim = "LunarSurfaceCamera"
    metersPerUnit = 1.0
)

def Camera "LunarSurfaceCamera" (
    prepend apiSchemas = ["LunCoCameraAPI"]
)
{
    float focalLength = 18.0
    float exposure:fStop = 16.0
    float exposure:iso = 100.0
    float exposure:responsivity = 1.0
    float exposure:time = 0.00390625
    float2 clippingRange = (0.009999999776482582, 1000000.0)
    def "Controls" (
        prepend references = @lunco://vessels/control_profiles.usda@</AvatarControls>
    )
    {
    }
}
