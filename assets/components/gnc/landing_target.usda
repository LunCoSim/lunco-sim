#usda 1.0
(
    defaultPrim = "LandingTarget"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "LandingTarget" (
    doc = "Kinematic touchdown-reference target. Its authored footprint and material feed a disposable terrain-surface annotation independently of navigation height."
    prepend references = @lunco://vessels/markers/landing_location.usda@</LandingLocationMarker>
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "LunCoCatalogAPI", "LunCoPointerInteractionAPI"]
    kind = "component"
)
{
    uniform bool lunco:spawnable = true
    uniform token lunco:interaction:left = "pass_through"
    uniform token lunco:interaction:right = "context"
    bool physics:rigidBodyEnabled = true
    bool physics:kinematicEnabled = true
    float physics:mass = 1.0
    string lunco:net:authority = "opaque"
    over "Dome"
    {
        token visibility = "invisible"
    }
    def Scope "Presentation" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://scenarios/landing_target_presentation.rhai@
        uniform bool lunco:program:realtimeSafe = false
    }
    def Xform "SurfaceMark" (
        references = @lunco://markers/route_ribbon.usda@
    )
    {
        over "Geometry"
        {
            rel material:binding = </LandingTarget/Looks/Dome_Mat>
        }
    }
}
