#usda 1.0
(
    defaultPrim = "PositionPIDGuidance"
    upAxis = "Y"
    metersPerUnit = 1
)

# Reusable 3D position-PID guidance component.  It composes onto any rigid-body
# lander: the body publishes position/velocity, this program computes a thrust
# vector, and the airframe consumes normalized throttle/pitch/roll/yaw commands.
# The mission scene supplies the target connection; the component itself defaults
# to the origin so it remains useful without a scene-specific script.
def Xform "PositionPIDGuidance" (
    prepend apiSchemas = ["LunCoUiSchemaAPI"]
)
{
    # This is the authored GNC boundary shown in the Lunica schema view.  The
    # canvas reads the typed property; it does not infer importance from names
    # or paths.
    bool lunco:ui:schemaNode = false
    # The component publishes four command outputs below. The vessel/mission
    # that consumes this reusable guidance component owns these input wires;
    # keeping them out of the reference prevents a weaker authored connection
    # from surviving when a scene deliberately selects a different command
    # source (for example a fixed RCS demonstration demand).
    def Scope "GNC" (
        prepend apiSchemas = ["LunCoProgramAPI", "LunCoUiSchemaAPI"]
        doc = "Three-axis position PID navigation and thrust-vector guidance."
    )
    {
        bool lunco:ui:schemaNode = true
        string ui:displayName = "Guidance computer"
        int lunco:ui:schemaColumn = 0
        int lunco:ui:schemaRow = 0
        uniform asset info:sourceAsset = @lunco://models/LunCo/GNC/PositionPID3D.mo@
        uniform bool lunco:program:realtimeSafe = true

        # These are the public flight-computer inputs. The component does not
        # guess where a mounted sensor lives: the vehicle or mission layer
        # authors every USD connection to its own IMU and raw-ray conversion.
        float inputs:altimeter_range = 0.0
        float inputs:altimeter_range_rate = 0.0
        float inputs:altimeter_valid = 0.0
        float inputs:imu_coordinate_accel_local_x = 0.0
        float inputs:imu_coordinate_accel_local_y = 0.0
        float inputs:imu_coordinate_accel_local_z = 0.0
        float inputs:imu_attitude_quat_w = 1.0
        float inputs:imu_attitude_quat_x = 0.0
        float inputs:imu_attitude_quat_y = 0.0
        float inputs:imu_attitude_quat_z = 0.0
        float inputs:vehicle_mass = 2000.0
        float inputs:piloted = 0.0
        float inputs:touchdown = 0.0
        float inputs:landing_contact = 0.0

        # Mission-initialized navigation state. These are authored once at the
        # start of an experiment; after initialization the estimator moves from
        # IMU measurements and never reads the body's pose on each tick.
        float inputs:initial_pos_x = 0.0
        float inputs:initial_pos_y = 0.0
        float inputs:initial_pos_z = 0.0
        float inputs:initial_vel_x = 0.0
        float inputs:initial_vel_y = 0.0
        float inputs:initial_vel_z = 0.0
        float inputs:altimeter_mount_offset = 3.3 (
            customData = { double min = 0.0 double max = 10.0 string unit = "m" }
        )
        float inputs:vertical_velocity_correction_gain = 2.0 (
            customData = { double min = 0.0 double max = 20.0 string unit = "1/s" }
        )

        # Target position and velocity are mission inputs. A scene may connect
        # them to a kinematic target body's live position outputs, or leave the
        # authored origin/zero defaults for a fixed landing site. Target velocity
        # remains zero for a manually moved kinematic point.
        float inputs:target_x = 0.0
        float inputs:target_y = 5.0
        float inputs:target_z = 0.0
        float inputs:target_vel_x = 0.0
        float inputs:target_vel_y = 0.0
        float inputs:target_vel_z = 0.0

        # Shared with the airframe's Lander command contract. The mission wires
        # this input from the vessel's live `inputs:command_tilt_limit_rad` so
        # guidance and physical actuation cannot silently use different limits.
        float inputs:command_tilt_limit_rad = 0.35 (
            customData = { double min = 0.000001 double max = 1.570796 string unit = "rad" }
        )

        # PID gains are live inputs, with Inspector ranges authored at the
        # consumer boundary.  Changing them does not rebuild or replace the
        # Modelica component.
        float inputs:kp_x = 0.08 (
            customData = { double min = 0.0 double max = 1.0 string unit = "1/s2" }
        )
        float inputs:ki_x = 0.003 (
            customData = { double min = 0.0 double max = 0.1 string unit = "1/s3" }
        )
        float inputs:kd_x = 0.75 (
            customData = { double min = 0.0 double max = 5.0 string unit = "1/s" }
        )
        float inputs:kp_y = 0.18 (
            customData = { double min = 0.0 double max = 1.0 string unit = "1/s2" }
        )
        # Vertical descent is derivative-dominated: an integral term accumulates
        # the deliberate long coast above the landing site and delays braking.
        # Keep it exposed for experiments, but ship the stable default at zero.
        float inputs:ki_y = 0.0 (
            customData = { double min = 0.0 double max = 0.1 string unit = "1/s3" }
        )
        float inputs:kd_y = 2.0 (
            customData = { double min = 0.0 double max = 5.0 string unit = "1/s" }
        )
        float inputs:kp_z = 0.08 (
            customData = { double min = 0.0 double max = 1.0 string unit = "1/s2" }
        )
        float inputs:ki_z = 0.003 (
            customData = { double min = 0.0 double max = 0.1 string unit = "1/s3" }
        )
        float inputs:kd_z = 0.75 (
            customData = { double min = 0.0 double max = 5.0 string unit = "1/s" }
        )
        float inputs:position_integral_limit = 12.0 (
            customData = { double min = 0.0 double max = 100.0 string unit = "state" }
        )
        float inputs:anti_windup_gain = 1.0 (
            customData = { double min = 0.0 double max = 20.0 string unit = "1/s" }
        )
        float inputs:max_lateral_accel = 4.0 (
            customData = { double min = 0.1 double max = 20.0 string unit = "m/s2" }
        )
        float inputs:max_vertical_accel = 8.0 (
            customData = { double min = 0.1 double max = 30.0 string unit = "m/s2" }
        )
        float inputs:descent_speed_limit_mps = 4.0 (
            customData = { double min = 0.0 double max = 20.0 string unit = "m/s" }
        )
        float inputs:descent_braking_accel_mps2 = 3.0 (
            customData = { double min = 0.0 double max = 30.0 string unit = "m/s2" }
        )
        float inputs:g = 1.62 (
            customData = { double min = 0.0 double max = 20.0 string unit = "m/s2" }
        )
        float inputs:max_thrust = 60000.0 (
            customData = { double min = 1.0 double max = 1000000.0 string unit = "N" }
        )
        float inputs:minimum_positive_mass_kg = 0.000001 (
            customData = { double min = 0.000001 double max = 100.0 string unit = "kg" }
        )
        float inputs:minimum_vertical_accel_mps2 = 0.000001 (
            customData = { double min = 0.000001 double max = 1.0 string unit = "m/s2" }
        )
        float inputs:minimum_thrust_accel_mps2 = 0.000001 (
            customData = { double min = 0.000001 double max = 1.0 string unit = "m/s2" }
        )
        float inputs:engage = 1.0 (
            customData = { double min = 0.0 double max = 1.0 string unit = "bool" }
        )
    }
}
