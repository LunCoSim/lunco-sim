#usda 1.0
(
    defaultPrim = "Battery"
    upAxis = "Y"
    metersPerUnit = 1
)

# A physical battery pack — mass, collision, and visible case.
#
# Its electrical behaviour belongs to the vessel's ONE synthesized electrical
# domain model. The domain compiler instantiates `LunCo.Electrical.Battery`
# together with every load and source, then emits the `connect()` equations so
# Kirchhoff balance is solved inside one DAE.
def Xform "Battery" (
    doc = "Reusable battery pack with mass, collision, electrical state, capacity, and state-of-charge telemetry."
    kind = "component"
    prepend apiSchemas = ["LunCoCatalogAPI", "PhysicsMassAPI", "LunCoProgramAPI"]
)
{
    uniform bool lunco:spawnable = true
    uniform token info:implementationSource = "sourceAsset"
    uniform asset info:sourceAsset = @lunco://models/LunCo/Electrical/Battery.mo@

    # Model parameters consumed when an enclosing CollectionAPI:components
    # includes this part in a runtime-projected network.
    # The rover EPS is a 28 V bus; this must agree with the motor nameplate
    # voltage and the PDU contract instead of forcing the motor drive to run
    # below its authored operating point.
    float inputs:voltage_nom = 28.0
    float inputs:capacity = 83.33
    # Pack-level equivalent series resistance. 50 mOhm made the authored
    # eight-motor full-load current drive the Thevenin source through zero
    # volts, which is not a valid DC bus operating point. 10 mOhm is the
    # explicit high-current pack value used by this 83 Ah rover battery.
    float inputs:R_internal = 0.01
    float inputs:soc_init = 1.0
    float outputs:soc_out
    float outputs:capacity_ah
    float outputs:charge_remaining_ah
    float outputs:terminal_voltage_v
    float outputs:terminal_current_a
    float outputs:net_power_w
    float outputs:charge_power_w
    float outputs:discharge_power_w
    float outputs:charge_current_a
    float outputs:discharge_current_a
    custom token connectors:p

    # --- Telemetry ---
    # State of charge as a RETAINED channel. Authored on the component so every
    # vessel that references a battery can plot its charge without touching the
    # vessel file — the same rule the motor follows.
    #
    # The enclosing generated electrical domain admits the authored output ports
    # below and presents them back on this physical Battery prim. Solver-only
    # connector values and wrapper aliases are not operator telemetry.
    double3 xformOp:translate = (0, 0, 0)
    double3 xformOp:scale = (2.0, 0.5, 3.0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]

    # A mounted pack is part of its parent's body. A detachable pack must gain
    # a rigid body and joint together at the mount, never a free nested body.
    float physics:mass = 50.0

    def Cube "Body" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1.0
        color3f[] primvars:displayColor = [(0.8, 0.2, 0.2)]
        bool physics:collisionEnabled = true
    }
}
