#usda 1.0
(
    defaultPrim = "RoboticHand"
    upAxis = "Y"
    metersPerUnit = 1
)

# A small three-finger manipulation rig. The file owns the mechanism: link
# frames, collision shapes, revolute joints, joint limits, and the named
# controller connections. Modelica owns only command shaping and angle math;
# Rhai owns the open/grasp sequence and acceptance observations.
def Xform "RoboticHand" (
    kind = "assembly"
    doc = "Three-finger articulated hand with authored joint limits and a kinematic grasp target."
    prepend apiSchemas = ["LunCoCatalogAPI"]
)
{
    uniform bool lunco:spawnable = false

    # The palm is the fixed reference for this standalone rig. The fingers are
    # dynamic bodies, so contact with the target remains Avian-owned.
    def Xform "Palm" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 4.0
        bool physics:kinematicEnabled = true

        def Cube "Shell" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1.0
            double3 xformOp:scale = (3.0, 0.7, 1.2)
            uniform token[] xformOpOrder = ["xformOp:scale"]
            color3f[] primvars:displayColor = [(0.18, 0.22, 0.28)]
        }
    }

    def Xform "Finger_Left" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.55
        double3 xformOp:translate = (-0.9, -0.4, -0.55)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Link" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1.0
            double3 xformOp:translate = (0.0, -0.6, 0.0)
            double3 xformOp:scale = (0.3, 1.2, 0.3)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.20, 0.48, 0.82)]
        }
    }

    def Xform "Finger_Center" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.55
        double3 xformOp:translate = (0.0, -0.4, -0.95)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Link" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1.0
            double3 xformOp:translate = (0.0, -0.6, 0.0)
            double3 xformOp:scale = (0.3, 1.2, 0.3)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.27, 0.62, 0.86)]
        }
    }

    def Xform "Finger_Right" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.55
        double3 xformOp:translate = (0.9, -0.4, -0.55)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Link" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1.0
            double3 xformOp:translate = (0.0, -0.6, 0.0)
            double3 xformOp:scale = (0.3, 1.2, 0.3)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.20, 0.48, 0.82)]
        }
    }

    # A kinematic object gives the closing fingers a deterministic, load-bearing
    # surface to touch. It is not part of the hand's joint graph.
    def Cube "GripTarget" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
    )
    {
        float physics:mass = 0.25
        bool physics:kinematicEnabled = true
        double3 xformOp:translate = (0.0, -1.35, -0.55)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        double size = 0.3
        color3f[] primvars:displayColor = [(0.92, 0.62, 0.16)]
    }

    # The joint frames coincide with the finger body origins. A direct joint
    # pair is filtered by the generic Avian joint admission path; the fingers
    # remain free to contact the authored target and one another.
    def PhysicsRevoluteJoint "Finger_Left_Hinge"
    {
        rel physics:body0 = </RoboticHand/Palm>
        rel physics:body1 = </RoboticHand/Finger_Left>
        uniform token physics:axis = "Z"
        float physics:lowerLimit = -10.0
        float physics:upperLimit = 55.0
        float inputs:angle.connect = </RoboticHand/Controller.outputs:left_angle>
    }

    def PhysicsRevoluteJoint "Finger_Center_Hinge"
    {
        rel physics:body0 = </RoboticHand/Palm>
        rel physics:body1 = </RoboticHand/Finger_Center>
        uniform token physics:axis = "Z"
        float physics:lowerLimit = -10.0
        float physics:upperLimit = 20.0
        float inputs:angle.connect = </RoboticHand/Controller.outputs:center_angle>
    }

    def PhysicsRevoluteJoint "Finger_Right_Hinge"
    {
        rel physics:body0 = </RoboticHand/Palm>
        rel physics:body1 = </RoboticHand/Finger_Right>
        uniform token physics:axis = "Z"
        float physics:lowerLimit = -55.0
        float physics:upperLimit = 10.0
        float inputs:angle.connect = </RoboticHand/Controller.outputs:right_angle>
    }

    def Xform "Controller" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://models/LunCo/Manipulation/RoboticHandController.mo@
        float inputs:open_command
        float inputs:grasp_command
        float outputs:closure
        float outputs:left_angle
        float outputs:center_angle
        float outputs:right_angle
    }
}
