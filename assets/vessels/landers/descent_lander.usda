        prepend references = @lunco://vessels/control_profiles.usda@</LanderControls>
    )
    {
    }
    def Cylinder "Hull" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        uniform token axis = "Y"
        double radius = 2.5
        double height = 3.0
        color3f[] primvars:displayColor = [(0.7799999713897705, 0.6200000047683716, 0.27000001072883606)]
        rel material:binding = </DescentLander/Looks/MliFoil_Mat>
        bool physics:collisionEnabled = true
    }
    def "Altimeter" (
        prepend references = @lunco://vessels/sensors/altimeter.usda@</Altimeter>
    )
    {
        double3 xformOp:translate = (0.0, -3.3, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "Model"
        {
            float inputs:attitude_quat_w
            float inputs:attitude_quat_w.connect = </DescentLander/IMU.outputs:attitude_quat_w>
            float inputs:attitude_quat_x
            float inputs:attitude_quat_x.connect = </DescentLander/IMU.outputs:attitude_quat_x>
            float inputs:attitude_quat_y
            float inputs:attitude_quat_y.connect = </DescentLander/IMU.outputs:attitude_quat_y>
            float inputs:attitude_quat_z
            float inputs:attitude_quat_z.connect = </DescentLander/IMU.outputs:attitude_quat_z>
            float inputs:angular_velocity_local_x
            float inputs:angular_velocity_local_x.connect = </DescentLander/IMU.outputs:gyro_x>
            float inputs:angular_velocity_local_y
            float inputs:angular_velocity_local_y.connect = </DescentLander/IMU.outputs:gyro_y>
            float inputs:angular_velocity_local_z
            float inputs:angular_velocity_local_z.connect = </DescentLander/IMU.outputs:gyro_z>
        }
    }
    def "IMU" (
        prepend references = @lunco://vessels/sensors/imu.usda@</Imu>
    )
    {
        double3 xformOp:translate = (0.0, 0.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:raw_acceleration_x
        float inputs:raw_acceleration_x.connect = </DescentLander.outputs:acceleration_x>
        float inputs:raw_acceleration_y
        float inputs:raw_acceleration_y.connect = </DescentLander.outputs:acceleration_y>
        float inputs:raw_acceleration_z
        float inputs:raw_acceleration_z.connect = </DescentLander.outputs:acceleration_z>
        float inputs:raw_sample_valid
        float inputs:raw_sample_valid.connect = </DescentLander.outputs:acceleration_valid>
        float inputs:raw_angvel_x
        float inputs:raw_angvel_x.connect = </DescentLander.outputs:angvel_x>
        float inputs:raw_angvel_y
        float inputs:raw_angvel_y.connect = </DescentLander.outputs:angvel_y>
        float inputs:raw_angvel_z
        float inputs:raw_angvel_z.connect = </DescentLander.outputs:angvel_z>
        float inputs:raw_quat_w
        float inputs:raw_quat_w.connect = </DescentLander.outputs:quat_w>
        float inputs:raw_quat_x
        float inputs:raw_quat_x.connect = </DescentLander.outputs:quat_x>
        float inputs:raw_quat_y
        float inputs:raw_quat_y.connect = </DescentLander.outputs:quat_y>
        float inputs:raw_quat_z
        float inputs:raw_quat_z.connect = </DescentLander.outputs:quat_z>
        float inputs:gravity_world_x
        float inputs:gravity_world_x.connect = </DescentLander/Environment.outputs:gravity_x>
        float inputs:gravity_world_y
