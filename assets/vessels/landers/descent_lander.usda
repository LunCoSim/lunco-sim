        {
            uniform token axis = "Y"
            double radius = 0.34
            double height = 0.16
            double3 xformOp:translate = (0, -7.2, 0)
            double3 xformOp:rotateXYZ = (-20, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
            color3f[] primvars:displayColor = [(0.45, 0.45, 0.48)]
            rel material:binding:physics = </DescentLander/PhysicsMaterials/LandingPadSlide>
            bool physics:collisionEnabled = true
        }

    }

    # ── Landing-gear suspension ──
    #
    # THE SUSPENSION IS HERE, and only here. This API is a passive, compression-only
    # law owned by the generic physics backend. Unlike a bilateral drive, it never
    # pulls the leg back out of the sleeve after contact. The prismatic joint still
    # supplies the geometric constraint and locks the leg's rotation.
    #
    # No `der()` restates this law in Modelica and no script animates it: a second
    # spelling of one spring would put two writers on one fact, and which one wins
    # would become a function of load order.
    #
    # Tuning, per leg (a quarter of the 2000 kg vehicle, so m_eff = 500 kg):
    #   k = 4000 N/m   → static settle = m_eff*g/k = 500*1.62/4000 = 0.20 m
    #   c = 3600 N·s/m → zeta ≈ 1.27: the leg visibly contracts and settles
    #                    without a long post-landing bounce.
    # SIGN, and it is the physically natural one: a suspension reaction is POSITIVE
    # when the spring is COMPRESSED. Compression therefore reads as NEGATIVE
    # displacement along the hull→foot axis, the direction the strut EXTENDS.
    # Stroke runs -0.8 m (fully compressed) to 0 (fully extended, the rest pose
    # the geometry is authored in), well inside the 3.2 m piston sleeve, so the
    # strut never bottoms out visually. Everything downstream — the `force` port,
    # the glow — then reads positive under load with no sign fixups anywhere.
    #
    # FRAMES: a UsdPhysics joint is TWO frames — `physics:localPos0`/`localRot0` on
    # body0 and `localPos1`/`localRot1` on body1 — and `physics:axis` names a
    # cardinal axis OF THOSE FRAMES. Here +Y is the leg axis after the authored
    # frame rake. The X pair uses a half-turn about Z because its visible legs
    # rake in the X/Y plane; the Z pair uses the corresponding half-turn about X
    # because its visible legs rake in the Z/Y plane. Keeping those bases aligned
    # with the authored leg frames is what makes the slider axis a real geometric
    # constraint instead of an unrelated force direction. A prismatic joint locks
    # all three rotational DOF on the leg; the foot is a child collider in that
    # same rigid body.
    #
    # ANCHORS are deliberately unauthored. The loader derives them from the
    # transform hierarchy, which puts displacement at exactly 0 in the authored
    # rest pose — so the strut's `force` is exactly 0 until something compresses
    # it, and the glow cannot fire before touchdown. Typing the anchors by hand
    # would be restating the geometry a second time, giving it a second place to
    # drift from the airframe.
    #
    # Each leg is a prismatic body: it cannot rotate independently of the hull.
    # The foot is a child collider on that same body, so it has no independent
    # rotational DOF; the only suspension travel is the prismatic stroke above.
    #
    # The spring's force and the strut/pad contact force remain separate facts.
    # The former drives the load glow; the latter feeds touchdown guidance from
    # the collider that actually meets the terrain.

    def PhysicsPrismaticJoint "LegPX_Spring" (
        prepend apiSchemas = ["LunCoPrismaticSuspensionAPI"]
    )
    {
        rel physics:body0 = </DescentLander>
        rel physics:body1 = </DescentLander/LegPX>
        uniform token physics:axis = "Y"
        quatf physics:localRot0 = (-0.173648, 0, 0, 0.984808)
        # The leg body is authored with its strut along local -Y.  This
        # half-turn makes the joint's +Y slider axis coincide with that
        # physical hull-to-pad direction while the prismatic constraint still
        # locks all three rotational DOF.
        # The leg body is authored along local -Y. A half-turn about Z makes
        # the joint frame's +Y axis follow that physical hull-to-pad direction
        # instead of asking the constraint to pull the X leg through the hull.
        quatf physics:localRot1 = (0, 0, 0, 1)
        float physics:lowerLimit = -0.8
        float physics:upperLimit = 0.0
        float lunco:prismaticSuspension:restPosition = 0.0
        float lunco:prismaticSuspension:stiffness = 4000.0
        float lunco:prismaticSuspension:damping = 3600.0
        float lunco:prismaticSuspension:maxForce = 30000.0
    }
    def PhysicsPrismaticJoint "LegNX_Spring" (
        prepend apiSchemas = ["LunCoPrismaticSuspensionAPI"]
    )
    {
        rel physics:body0 = </DescentLander>
        rel physics:body1 = </DescentLander/LegNX>
        uniform token physics:axis = "Y"
        quatf physics:localRot0 = (0.173648, 0, 0, 0.984808)
        # Same body-side half-turn as the +X leg; the sign of localRot0 carries
        # the mirrored rake, not a different rotational freedom.
        # Mirror of the +X frame: the body-side half-turn keeps the slider on
        # the authored local -Y strut axis while the mirrored rake is carried
        # by localRot0.
        quatf physics:localRot1 = (0, 0, 0, 1)
        float physics:lowerLimit = -0.8
        float physics:upperLimit = 0.0
        float lunco:prismaticSuspension:restPosition = 0.0
        float lunco:prismaticSuspension:stiffness = 4000.0
        float lunco:prismaticSuspension:damping = 3600.0
        float lunco:prismaticSuspension:maxForce = 30000.0
    }
    def PhysicsPrismaticJoint "LegPZ_Spring" (
        prepend apiSchemas = ["LunCoPrismaticSuspensionAPI"]
    )
    {
        rel physics:body0 = </DescentLander>
        rel physics:body1 = </DescentLander/LegPZ>
        uniform token physics:axis = "Y"
        # Z-leg frame: body0 rake Rx(-20 deg) followed by the body1 half-turn Rx(180 deg).
        quatf physics:localRot0 = (0.173648, 0.984808, 0, 0)
        quatf physics:localRot1 = (0, 1, 0, 0)
        float physics:lowerLimit = -0.8
        float physics:upperLimit = 0.0
        float lunco:prismaticSuspension:restPosition = 0.0
        float lunco:prismaticSuspension:stiffness = 4000.0
        float lunco:prismaticSuspension:damping = 3600.0
        float lunco:prismaticSuspension:maxForce = 30000.0
    }
    def PhysicsPrismaticJoint "LegNZ_Spring" (
        prepend apiSchemas = ["LunCoPrismaticSuspensionAPI"]
    )
    {
        rel physics:body0 = </DescentLander>
        rel physics:body1 = </DescentLander/LegNZ>
        uniform token physics:axis = "Y"
        # Z-leg frame: body0 rake Rx(+20 deg) followed by the body1 half-turn Rx(180 deg).
        quatf physics:localRot0 = (-0.173648, 0.984808, 0, 0)
        quatf physics:localRot1 = (0, 1, 0, 0)
        float physics:lowerLimit = -0.8
        float physics:upperLimit = 0.0
        float lunco:prismaticSuspension:restPosition = 0.0
        float lunco:prismaticSuspension:stiffness = 4000.0
        float lunco:prismaticSuspension:damping = 3600.0
        float lunco:prismaticSuspension:maxForce = 30000.0
    }

}
