#usda 1.0
(
    defaultPrim = "DescentLander"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "DescentLander" (
    documentation = "A powered-descent lander. Possess it to take the stick: Space thrusts, WASD tilts, Q/E turns. It has no guidance of its own — a scene composes that on."
    kind = "assembly"
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI", "LunCoCatalogAPI", "LunCoProgramAPI", "LunCoUiSchemaAPI", "MaterialBindingAPI"]
    prepend references = @lunco://components/avionics/obc_lander.usda@</LanderOBC>
)
{
    string lunco:ui:surfaceId = "vehicle-control-left"
    string lunco:ui:visibilityMode = "possessed"
    rel material:binding:physics = </DescentLander/PhysicsMaterials/LandingPadSlide>
    bool lunco:ui:schemaNode = false
    string lunco:ui:schemaRole = "Tracks attitude · applies commands"
    uniform bool lunco:spawnable = true
    bool physics:rigidBodyEnabled = true
    float physics:mass = 4000.0
    float3 physics:diagonalInertia = (5905.0, 6250.0, 5905.0)
    float3 physics:centerOfMass = (0.0, 0.0, 0.0)
    float physxRigidBody:linearDamping = 0.0
    uniform token info:implementationSource = "sourceAsset"
    uniform asset info:sourceAsset = @lunco://models/Lander.mo@
    uniform bool lunco:program:realtimeSafe = true
    float inputs:spool_tau = 0.3499999940395355
    float inputs:authority_filter_tau_s = 0.019999999552965164
    float inputs:minimum_time_constant_s = 0.0000009999999974752427
    float inputs:authority_initial = 0.6000000238418579
    float inputs:command_lower_bound = 0.0
    float inputs:command_upper_bound = 1.0
    float inputs:landing_engine_cutoff = 0.0
    float inputs:ang_authority = 0.6000000238418579
    float inputs:command_tilt_limit_rad = 0.3499999940395355
    float inputs:attitude_hold = 1.0
    float inputs:hold_kp = 4.0 (
        customData = {
    double max = 12.0
    double min = 0.0
    string unit = "rad/s2"
}
    )
    float inputs:hold_kd = 6.0 (
        customData = {
    double max = 12.0
    double min = 0.0
    string unit = "rad/s"
}
    )
    float inputs:hold_torque_limit_nm = 6000.0
    float inputs:mass
    float inputs:mass.connect = </DescentLander/MainPropulsion.outputs:vehicle_mass_kg>
    float inputs:com_x
    float inputs:com_x.connect = </DescentLander/MainPropulsion.outputs:vehicle_com_x_m>
    float inputs:com_y
    float inputs:com_y.connect = </DescentLander/MainPropulsion.outputs:vehicle_com_y_m>
    float inputs:com_z
    float inputs:com_z.connect = </DescentLander/MainPropulsion.outputs:vehicle_com_z_m>
    float inputs:controller_inertia_xx
    float inputs:controller_inertia_xx.connect = </DescentLander/MainPropulsion.outputs:vehicle_inertia_xx_kg_m2>
    float inputs:controller_inertia_yy
    float inputs:controller_inertia_yy.connect = </DescentLander/MainPropulsion.outputs:vehicle_inertia_yy_kg_m2>
    float inputs:controller_inertia_zz
    float inputs:controller_inertia_zz.connect = </DescentLander/MainPropulsion.outputs:vehicle_inertia_zz_kg_m2>
    float inputs:piloted
    float inputs:piloted.connect = </DescentLander.outputs:piloted>
    float inputs:gyro_x
    float inputs:gyro_x.connect = </DescentLander/IMU.outputs:gyro_x>
    float inputs:gyro_y
    float inputs:gyro_y.connect = </DescentLander/IMU.outputs:gyro_y>
    float inputs:gyro_z
    float inputs:gyro_z.connect = </DescentLander/IMU.outputs:gyro_z>
    float inputs:attitude_error_x
    float inputs:attitude_error_x.connect = </DescentLander/AttitudeReference.outputs:error_x>
    float inputs:attitude_error_y
    float inputs:attitude_error_y.connect = </DescentLander/AttitudeReference.outputs:error_y>
    float inputs:attitude_error_z
    float inputs:attitude_error_z.connect = </DescentLander/AttitudeReference.outputs:error_z>
    float inputs:upright_axis_y
    float inputs:upright_axis_y.connect = </DescentLander/AttitudeReference.outputs:estimated_up_y>
    float inputs:leg_force_px
    float inputs:leg_force_px.connect = </DescentLander/LegPX.outputs:contact_force>
    float inputs:leg_force_nx
    float inputs:leg_force_nx.connect = </DescentLander/LegNX.outputs:contact_force>
    float inputs:leg_force_pz
    float inputs:leg_force_pz.connect = </DescentLander/LegPZ.outputs:contact_force>
    float inputs:leg_force_nz
    float inputs:leg_force_nz.connect = </DescentLander/LegNZ.outputs:contact_force>
    float inputs:leg_contact_px
    float inputs:leg_contact_px.connect = </DescentLander/LegPX.outputs:contact>
    float inputs:leg_contact_nx
    float inputs:leg_contact_nx.connect = </DescentLander/LegNX.outputs:contact>
    float inputs:leg_contact_pz
    float inputs:leg_contact_pz.connect = </DescentLander/LegPZ.outputs:contact>
    float inputs:leg_contact_nz
    float inputs:leg_contact_nz.connect = </DescentLander/LegNZ.outputs:contact>
    float inputs:leg_displacement_px
    float inputs:leg_displacement_px.connect = </DescentLander/LegPX_Spring.outputs:displacement>
    float inputs:leg_displacement_nx
    float inputs:leg_displacement_nx.connect = </DescentLander/LegNX_Spring.outputs:displacement>
    float inputs:leg_displacement_pz
    float inputs:leg_displacement_pz.connect = </DescentLander/LegPZ_Spring.outputs:displacement>
    float inputs:leg_displacement_nz
    float inputs:leg_displacement_nz.connect = </DescentLander/LegNZ_Spring.outputs:displacement>
    float inputs:leg_velocity_px
    float inputs:leg_velocity_px.connect = </DescentLander/LegPX_Spring.outputs:velocity>
    float inputs:leg_velocity_nx
    float inputs:leg_velocity_nx.connect = </DescentLander/LegNX_Spring.outputs:velocity>
    float inputs:leg_velocity_pz
    float inputs:leg_velocity_pz.connect = </DescentLander/LegPZ_Spring.outputs:velocity>
    float inputs:leg_velocity_nz
    float inputs:leg_velocity_nz.connect = </DescentLander/LegNZ_Spring.outputs:velocity>
    float inputs:navigation_velocity_x
    float inputs:navigation_velocity_x.connect = </DescentLander.outputs:velocity_x>
    float inputs:navigation_velocity_y
    float inputs:navigation_velocity_y.connect = </DescentLander.outputs:velocity_y>
    float inputs:navigation_velocity_z
    float inputs:navigation_velocity_z.connect = </DescentLander.outputs:velocity_z>
    def Scope "PhysicsMaterials"
    {
        def Material "LandingPadSlide" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4000000059604645
            float physics:staticFriction = 0.5
            float physics:restitution = 0.0
            token physxMaterial:frictionCombineMode = "min"
        }
    }
    def Scope "MainPropulsion" (
        prepend apiSchemas = ["CollectionAPI:components", "LunCoUiSchemaAPI"]
    )
    {
        bool lunco:ui:schemaNode = true
        string ui:displayName = "Main engine"
        int lunco:ui:schemaColumn = 2
        int lunco:ui:schemaRow = 1
        string lunco:ui:schemaRole = "Throttle in · downward braking"
        uniform token collection:components:expansionRule = "explicitOnly"
        rel collection:components:includes
        prepend rel collection:components:includes = [</DescentLander/MainPropulsion/FuelTank>, </DescentLander/MainPropulsion/OxidizerTank>, </DescentLander/MainPropulsion/FuelPump>, </DescentLander/MainPropulsion/OxidizerPump>, </DescentLander/MainPropulsion/MainChamber>, </DescentLander/MainPropulsion/PropellantStatus>]
        float inputs:valve_opening
        float inputs:valve_opening.connect = </DescentLander.outputs:throttle>
        float inputs:rcs_fuel_mass_flow_kgs
        float inputs:rcs_fuel_mass_flow_kgs.connect = </DescentLander/AttitudePropulsion.outputs:fuel_mass_flow_kgs>
        float inputs:rcs_oxidizer_mass_flow_kgs
        float inputs:rcs_oxidizer_mass_flow_kgs.connect = </DescentLander/AttitudePropulsion.outputs:oxidizer_mass_flow_kgs>
        float outputs:thrust_n
        float outputs:thrust_n.connect = </DescentLander/MainPropulsion/MainChamber.outputs:thrust_n>
        float outputs:exhaust_velocity_mps
        float outputs:exhaust_velocity_mps.connect = </DescentLander/MainPropulsion/MainChamber.outputs:exhaust_velocity_mps>
        float outputs:design_exhaust_velocity_mps
        float outputs:design_exhaust_velocity_mps.connect = </DescentLander/MainPropulsion/MainChamber.outputs:design_exhaust_velocity_mps>
        float outputs:maximum_thrust_n
        float outputs:maximum_thrust_n.connect = </DescentLander/MainPropulsion/MainChamber.outputs:maximum_thrust_n>
        float outputs:engine_activity
        float outputs:engine_activity.connect = </DescentLander/MainPropulsion/MainChamber.outputs:activity>
        float outputs:propellant_flow
        float outputs:propellant_flow.connect = </DescentLander/MainPropulsion/MainChamber.outputs:propellant_flow>
        float outputs:chamber_pressure_pa
        float outputs:chamber_pressure_pa.connect = </DescentLander/MainPropulsion/MainChamber.outputs:chamber_pressure_pa>
        float outputs:propellant_mass
        float outputs:propellant_mass.connect = </DescentLander/MainPropulsion/PropellantStatus.outputs:propellant_mass_kg>
        float outputs:propellant_fraction
        float outputs:propellant_fraction.connect = </DescentLander/MainPropulsion/PropellantStatus.outputs:propellant_fraction>
        float outputs:propellant_used
        float outputs:propellant_used.connect = </DescentLander/MainPropulsion/PropellantStatus.outputs:propellant_used_kg>
        float outputs:low_fuel
        float outputs:low_fuel.connect = </DescentLander/MainPropulsion/PropellantStatus.outputs:low_fuel>
        float outputs:depleted
        float outputs:depleted.connect = </DescentLander/MainPropulsion/PropellantStatus.outputs:depleted>
        float outputs:vehicle_mass_kg
        float outputs:vehicle_mass_kg.connect = </DescentLander/MainPropulsion/PropellantStatus.outputs:vehicle_mass_kg>
        float outputs:vehicle_inertia_xx_kg_m2
        float outputs:vehicle_inertia_xx_kg_m2.connect = </DescentLander/MainPropulsion/PropellantStatus.outputs:vehicle_inertia_xx_kg_m2>
        float outputs:vehicle_inertia_yy_kg_m2
        float outputs:vehicle_inertia_yy_kg_m2.connect = </DescentLander/MainPropulsion/PropellantStatus.outputs:vehicle_inertia_yy_kg_m2>
        float outputs:vehicle_inertia_zz_kg_m2
        float outputs:vehicle_inertia_zz_kg_m2.connect = </DescentLander/MainPropulsion/PropellantStatus.outputs:vehicle_inertia_zz_kg_m2>
        float outputs:vehicle_com_x_m
        float outputs:vehicle_com_x_m.connect = </DescentLander/MainPropulsion/PropellantStatus.outputs:vehicle_com_x_m>
        float outputs:vehicle_com_y_m
        float outputs:vehicle_com_y_m.connect = </DescentLander/MainPropulsion/PropellantStatus.outputs:vehicle_com_y_m>
        float outputs:vehicle_com_z_m
        float outputs:vehicle_com_z_m.connect = </DescentLander/MainPropulsion/PropellantStatus.outputs:vehicle_com_z_m>
        def Scope "FuelRemainingTelemetry" (
            prepend apiSchemas = ["LunCoTelemetryAPI"]
        )
        {
            bool lunco:telemetry = true
            string ui:displayName = "FUEL LEFT"
            token lunco:telemetry:port = "propellant_mass"
            token lunco:telemetry:name = "lander.fuel_remaining"
            token lunco:telemetry:unit = "kg"
            string lunco:telemetry:description = "Remaining fuel and oxidizer mass from the lander's PropellantStatus model."
            rel lunco:telemetry:target = </DescentLander/MainPropulsion>
        }
        def Scope "MainThrustTelemetry" (
            prepend apiSchemas = ["LunCoTelemetryAPI"]
        )
        {
            bool lunco:telemetry = true
            string ui:displayName = "THRUST"
            token lunco:telemetry:port = "thrust_n"
            token lunco:telemetry:name = "lander.main_thrust"
            token lunco:telemetry:unit = "N"
            string lunco:telemetry:description = "Delivered main-engine thrust from the lander's Modelica propulsion model."
            rel lunco:telemetry:target = </DescentLander/MainPropulsion>
        }
        def Scope "FuelTank" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://models/LunCo/Propulsion/PropellantTank.mo@
            uniform bool lunco:program:realtimeSafe = true
            float inputs:initial_mass_kg = 1000.0
            float inputs:nominal_pressure_pa = 2500000.0
            float inputs:pressure_headroom_pa = 500000.0
            float inputs:low_fuel_mass_kg = 100.0
            float inputs:depleted_mass_kg = 0.5
            float inputs:minimum_mass_kg = 0.0000009999999974752427
            float inputs:event_transition_width_kg = 0.009999999776482582
            float outputs:mass_kg
            float outputs:pressure_pa
            float outputs:mass_out_flow_kgs
            float outputs:low_fuel
            float outputs:depleted
            float inputs:auxiliary_mass_flow_kgs
            float inputs:auxiliary_mass_flow_kgs.connect = </DescentLander/MainPropulsion.inputs:rcs_fuel_mass_flow_kgs>
            custom token connectors:outlet
            token connectors:outlet.connect = </DescentLander/MainPropulsion/FuelPump.connectors:inlet>
        }
        def Scope "OxidizerTank" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://models/LunCo/Propulsion/PropellantTank.mo@
            uniform bool lunco:program:realtimeSafe = true
            float inputs:initial_mass_kg = 1000.0
            float inputs:nominal_pressure_pa = 2500000.0
            float inputs:pressure_headroom_pa = 500000.0
            float inputs:low_fuel_mass_kg = 100.0
            float inputs:depleted_mass_kg = 0.5
            float inputs:minimum_mass_kg = 0.0000009999999974752427
            float inputs:event_transition_width_kg = 0.009999999776482582
            float outputs:mass_kg
            float outputs:pressure_pa
            float outputs:mass_out_flow_kgs
            float outputs:low_fuel
            float outputs:depleted
            float inputs:auxiliary_mass_flow_kgs
            float inputs:auxiliary_mass_flow_kgs.connect = </DescentLander/MainPropulsion.inputs:rcs_oxidizer_mass_flow_kgs>
            custom token connectors:outlet
            token connectors:outlet.connect = </DescentLander/MainPropulsion/OxidizerPump.connectors:inlet>
        }
        def Scope "FuelPump" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://models/LunCo/Propulsion/Turbopump.mo@
            uniform bool lunco:program:realtimeSafe = true
            float inputs:maximum_flow_kgs = 8.0
            float inputs:nominal_tank_pressure_pa = 2500000.0
            float inputs:discharge_pressure_pa = 8000000.0
            float inputs:spool_tau = 0.07999999821186066
            float inputs:pump_efficiency = 0.7200000286102295
            float inputs:speed_rpm_max = 30000.0
            float inputs:propellant_density_kg_m3 = 810.0
            float inputs:minimum_pressure_pa = 1.0
            float inputs:minimum_efficiency = 0.0000009999999974752427
            float inputs:minimum_time_constant_s = 0.0000009999999974752427
            float inputs:minimum_available_mass_kg = 0.0000009999999974752427
            float inputs:availability_transition_mass_kg = 0.009999999776482582
            float outputs:mass_flow_kgs
            float outputs:outlet_pressure_pa
            float outputs:speed_fraction
            float outputs:speed_rpm
            float outputs:activity
            float outputs:shaft_power_w
            float inputs:available_mass_kg
            float inputs:available_mass_kg.connect = </DescentLander/MainPropulsion/FuelTank.outputs:mass_kg>
            float inputs:valve_opening
            float inputs:valve_opening.connect = </DescentLander/MainPropulsion.inputs:valve_opening>
            custom token connectors:inlet
            token connectors:inlet.connect = </DescentLander/MainPropulsion/FuelTank.connectors:outlet>
            custom token connectors:outlet
            token connectors:outlet.connect = </DescentLander/MainPropulsion/MainChamber.connectors:fuel_in>
        }
        def Scope "OxidizerPump" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://models/LunCo/Propulsion/Turbopump.mo@
            uniform bool lunco:program:realtimeSafe = true
            float inputs:maximum_flow_kgs = 21.0
            float inputs:nominal_tank_pressure_pa = 2500000.0
            float inputs:discharge_pressure_pa = 8000000.0
            float inputs:spool_tau = 0.07999999821186066
            float inputs:pump_efficiency = 0.7200000286102295
            float inputs:speed_rpm_max = 30000.0
            float inputs:propellant_density_kg_m3 = 1140.0
            float inputs:minimum_pressure_pa = 1.0
            float inputs:minimum_efficiency = 0.0000009999999974752427
            float inputs:minimum_time_constant_s = 0.0000009999999974752427
            float inputs:minimum_available_mass_kg = 0.0000009999999974752427
            float inputs:availability_transition_mass_kg = 0.009999999776482582
            float outputs:mass_flow_kgs
            float outputs:outlet_pressure_pa
            float outputs:speed_fraction
            float outputs:speed_rpm
            float outputs:activity
            float outputs:shaft_power_w
            float inputs:available_mass_kg
            float inputs:available_mass_kg.connect = </DescentLander/MainPropulsion/OxidizerTank.outputs:mass_kg>
            float inputs:valve_opening
            float inputs:valve_opening.connect = </DescentLander/MainPropulsion.inputs:valve_opening>
            custom token connectors:inlet
            token connectors:inlet.connect = </DescentLander/MainPropulsion/OxidizerTank.connectors:outlet>
            custom token connectors:outlet
            token connectors:outlet.connect = </DescentLander/MainPropulsion/MainChamber.connectors:oxidizer_in>
        }
        def Scope "MainChamber" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://models/LunCo/Propulsion/CombustionChamber.mo@
            uniform bool lunco:program:realtimeSafe = true
            float inputs:oxidizer_to_fuel_ratio = 2.5999999046325684
            float inputs:characteristic_velocity_mps = 1550.0
            float inputs:throat_area_m2 = 0.0044999998062849045
            float inputs:effective_exhaust_velocity_mps = 2940.0
            float inputs:combustion_efficiency = 0.9599999785423279
            float inputs:nominal_flow_kgs = 31.75
            float inputs:chamber_temperature_full_k = 3300.0
            float inputs:minimum_flow_kgs = 0.0000009999999974752427
            float inputs:minimum_throat_area_m2 = 0.0000000009999999717180685
            float inputs:fuel_energy_j_kg = 40000000.0
            custom token connectors:fuel_in
            custom token connectors:oxidizer_in
            float outputs:fuel_flow_kgs
            float outputs:oxidizer_flow_kgs
            float outputs:propellant_flow
            float outputs:mixture_ratio
            float outputs:mixture_ratio_error
            float outputs:mixture_efficiency
            float outputs:chamber_pressure_pa
            float outputs:ideal_chamber_pressure_pa
            float outputs:chamber_temperature_k
            float outputs:thrust_n
            float outputs:exhaust_velocity_mps
            float outputs:design_exhaust_velocity_mps
            float outputs:maximum_thrust_n
            float outputs:activity
            float outputs:heat_release_w
        }
        def Scope "PropellantStatus" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://models/LunCo/Propulsion/PropellantStatus.mo@
            uniform bool lunco:program:realtimeSafe = true
            float inputs:low_fuel_mass_kg = 200.0
            float inputs:depleted_mass_kg = 1.0
            float inputs:initial_propellant_mass_kg = 2000.0
            float inputs:minimum_mass_kg = 0.0000009999999974752427
            float inputs:event_transition_width_kg = 0.009999999776482582
            float inputs:dry_mass_kg = 2000.0
            float inputs:dry_inertia_xx_kg_m2 = 4625.0
            float inputs:dry_inertia_yy_kg_m2 = 6250.0
            float inputs:dry_inertia_zz_kg_m2 = 4625.0
            float inputs:fuel_position_y_m = 0.800000011920929
            float inputs:oxidizer_position_y_m = -0.800000011920929
            float outputs:propellant_mass_kg
            float outputs:propellant_used_kg
            float outputs:propellant_fraction
            float outputs:low_fuel
            float outputs:depleted
            float outputs:vehicle_mass_kg
            float outputs:vehicle_inertia_xx_kg_m2
            float outputs:vehicle_inertia_yy_kg_m2
            float outputs:vehicle_inertia_zz_kg_m2
            float outputs:vehicle_com_x_m
            float outputs:vehicle_com_y_m
            float outputs:vehicle_com_z_m
            float inputs:fuel_mass_kg
            float inputs:fuel_mass_kg.connect = </DescentLander/MainPropulsion/FuelTank.outputs:mass_kg>
            float inputs:oxidizer_mass_kg
            float inputs:oxidizer_mass_kg.connect = </DescentLander/MainPropulsion/OxidizerTank.outputs:mass_kg>
        }
    }
    def Scope "AttitudeActuation" (
        prepend apiSchemas = ["CollectionAPI:components", "LunCoUiSchemaAPI"]
    )
    {
        bool lunco:ui:schemaNode = true
        string ui:displayName = "RCS allocator"
        int lunco:ui:schemaColumn = 2
        int lunco:ui:schemaRow = 0
        string lunco:ui:schemaRole = "Torque request · valve pulses"
        float outputs:pitch_pos_a_valve
        float outputs:pitch_pos_b_valve
        float outputs:pitch_neg_a_valve
        float outputs:pitch_neg_b_valve
        float outputs:roll_pos_a_valve
        float outputs:roll_pos_b_valve
        float outputs:roll_neg_a_valve
        float outputs:roll_neg_b_valve
        float outputs:yaw_pos_a_valve
        float outputs:yaw_pos_b_valve
        float outputs:yaw_neg_a_valve
        float outputs:yaw_neg_b_valve
        uniform token collection:components:expansionRule = "explicitOnly"
        rel collection:components:includes
        prepend rel collection:components:includes = [</DescentLander/RcsPitchPos>, </DescentLander/RcsPitchNeg>, </DescentLander/RcsRollPos>, </DescentLander/RcsRollNeg>, </DescentLander/RcsYawPos>, </DescentLander/RcsYawNeg>, </DescentLander/RcsPitchPosB>, </DescentLander/RcsPitchNegB>, </DescentLander/RcsRollPosB>, </DescentLander/RcsRollNegB>, </DescentLander/RcsYawPosB>, </DescentLander/RcsYawNegB>]
        float inputs:desired_torque_x
        float inputs:desired_torque_x.connect = </DescentLander.outputs:torque_x>
        float inputs:desired_torque_y
        float inputs:desired_torque_y.connect = </DescentLander.outputs:torque_y>
        float inputs:desired_torque_z
        float inputs:desired_torque_z.connect = </DescentLander.outputs:torque_z>
    }
    def Scope "AttitudePropulsion" (
        prepend apiSchemas = ["CollectionAPI:components", "LunCoUiSchemaAPI"]
    )
    {
        bool lunco:ui:schemaNode = true
        string ui:displayName = "RCS jets"
        int lunco:ui:schemaColumn = 3
        int lunco:ui:schemaRow = 0
        string lunco:ui:schemaRole = "Valve pulses · turning force"
        uniform token collection:components:expansionRule = "explicitOnly"
        rel collection:components:includes
        prepend rel collection:components:includes = [</DescentLander/AttitudePropulsion/RcsPitchPosModel>, </DescentLander/AttitudePropulsion/RcsPitchPosBModel>, </DescentLander/AttitudePropulsion/RcsPitchNegModel>, </DescentLander/AttitudePropulsion/RcsPitchNegBModel>, </DescentLander/AttitudePropulsion/RcsRollPosModel>, </DescentLander/AttitudePropulsion/RcsRollPosBModel>, </DescentLander/AttitudePropulsion/RcsRollNegModel>, </DescentLander/AttitudePropulsion/RcsRollNegBModel>, </DescentLander/AttitudePropulsion/RcsYawPosModel>, </DescentLander/AttitudePropulsion/RcsYawPosBModel>, </DescentLander/AttitudePropulsion/RcsYawNegModel>, </DescentLander/AttitudePropulsion/RcsYawNegBModel>, </DescentLander/AttitudePropulsion/RcsFlowAggregator>]
        float inputs:pitch_pos_a_valve
        float inputs:pitch_pos_a_valve.connect = </DescentLander/AttitudeActuation.outputs:pitch_pos_a_valve>
        float inputs:pitch_pos_b_valve
        float inputs:pitch_pos_b_valve.connect = </DescentLander/AttitudeActuation.outputs:pitch_pos_b_valve>
        float inputs:pitch_neg_a_valve
