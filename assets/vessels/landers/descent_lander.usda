#usda 1.0
(
    defaultPrim = "DescentLander"
    upAxis = "Y"
    metersPerUnit = 1
)

# A powered-descent lander AIRFRAME — engine, tanks, legs, sensors, avionics. It flies
# what it is told and nothing else: possess it and the stick flies it; spawn it and it
# sits, because nothing is commanding it.
#
# It has no mission-specific autopilot. Guidance is a component a SCENE composes onto it:
#
#   def "Lander" (
#       prepend references = [
#           @lunco://vessels/landers/descent_lander.usda@</DescentLander>,
#           @lunco://components/gnc/position_pid_guidance.usda@</PositionPIDGuidance>,
#       ]
#   )
#   { double3 xformOp:translate = (0, 60.0, 0) }
#
# The airframe's flight-control system is AUTHORED here (`info:sourceAsset`), not bolted
# on, because it is not separable: its `inputs:` ARE the vessel's control surface — the
# ports the control profile writes when a session takes the stick. A lander without it
# is not a lander without an autopilot; it is a lander without an engine.
#
#   possession  ──(piloted)───► Lander.mo  authority gate
#   session stick ──────────────► pitch/roll/yaw/external_throttle
#   guidance program (if any) ──► guidance_throttle   ◄── UNWIRED = 0 = does not fly itself
#   Avian body ──(inertia, IMU, attitude reference)──► Lander.mo
#                                  │  local valve / body torque demands
#                                  ▼
#                         USD propulsion + actuator networks
#                                  │  authored mounts and directions
#                                  ▼
#                              Avian body
#
# Gravity is applied by lunco-environment; the model must NOT re-apply it. Thrust is
# body-frame, so the engine fires along the lander's own +Y and follows attitude.
#
# Controls (once possessed — see `../control_profiles.usda@</LanderControls>`):
#   Space       — full thrust
#   W/S/A/D     — pitch/roll torque
#   Q/E         — yaw torque
#   Backspace   — release possession

def Xform "DescentLander" (
    doc = "A powered-descent lander. Possess it to take the stick: Space thrusts, WASD tilts, Q/E turns. It has no guidance of its own — a scene composes that on."
    # An ASSEMBLY: a model built out of other models — its altimeter, its IMU, its
    # control profile all arrive by reference. USD's rule is that a `component` may not
    # contain component models, and the kind is what tells a browser (and the UI)
    # whether a prim is a thing you open up or a thing you place.
    kind = "assembly"
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI", "LunCoCatalogAPI", "LunCoProgramAPI", "LunCoUiSchemaAPI"]
    # The ON-BOARD COMPUTER, as a reference arc — the vessel's COMMAND SURFACE.
    # Its `inputs:` ports (`external_throttle`/`pitch`/`roll`/`yaw`/`release`) ARE
    # the set of commands this vessel accepts; there is no lander class in engine
    # code and no per-class list of commands. A LANDER-SPECIFIC OBC, because the
    # vocabulary is the vehicle's, not the engine's: a rover's computer
    # (`components/avionics/obc.usda`) publishes throttle/steer/brake instead, and
    # nothing but the ports differs between them.
    #
    # It ships WITH the airframe, unlike the guidance component above: guidance is
    # a mission choice a scene makes, but a lander with no computer is not an
    # un-guided lander, it is an inert one — no stick, no script, no API can reach
    # it. The flight-control PROGRAM (`Lander.mo`, below) is what turns these
    # commands into force and torque; the OBC only says what may be commanded.
    prepend references = @lunco://components/avionics/obc_lander.usda@</LanderOBC>
)
{
    # The feet are a sliding landing interface, not traction devices.  Their
    # prismatic joints constrain each leg to its authored rake; allowing the
    # pad/regolith pair to develop lateral friction would turn a normal
    # touchdown offset into a tangential impulse at the end of a 7.2 m lever.
    # Keep that interface explicit in USD physics material rather than hiding
    # a velocity clamp in the solver.  The normal reaction and suspension
    # stroke remain fully physical; only tangential traction is absent.
    def Scope "PhysicsMaterials"
    {
        def Material "LandingPadSlide" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.0
            float physics:staticFriction = 0.0
            float physics:restitution = 0.0
        }
    }

    # Typed Lunica presentation contract: this assembly and its four top-level
    # flight networks are the authored schema surface.  The connection canvas
    # uses this property when present, so internal Modelica implementation
    # prims do not collapse the complete system into an unreadable cloud.
    bool lunco:ui:schemaNode = false

    # The body model publishes demands; these scopes choose the physical
    # actuation topology. The generated Modelica wrapper is rebuilt from the
    # actuator prims and their authored transforms whenever this composition
    # changes.
    def Scope "MainPropulsion" (
        prepend apiSchemas = ["CollectionAPI:components", "LunCoDomainSynthesisAPI", "LunCoUiSchemaAPI"]
    )
    {
        bool lunco:ui:schemaNode = true
        string ui:displayName = "Main engine"
        int lunco:ui:schemaColumn = 2
        int lunco:ui:schemaRow = 1
        # The engine is a generated Modelica network. Every connection below
        # is USD topology; the reusable component files own only equations.
        float inputs:valve_opening.connect = </DescentLander.outputs:throttle>
        # RCS consumption crosses from the separately solved attitude network
        # through explicit network boundary ports. A component-to-component
        # edge across CollectionAPI scopes is not part of either generated DAE;
        # making the boundary explicit preserves the two solver islands while
        # keeping the causal flow authored and inspectable.
        float inputs:rcs_fuel_mass_flow_kgs.connect = </DescentLander/AttitudePropulsion.outputs:fuel_mass_flow_kgs>
        float inputs:rcs_oxidizer_mass_flow_kgs.connect = </DescentLander/AttitudePropulsion.outputs:oxidizer_mass_flow_kgs>
        float outputs:thrust_n.connect = </DescentLander/MainPropulsion/MainChamber.outputs:thrust_n>
        float outputs:engine_activity.connect = </DescentLander/MainPropulsion/MainChamber.outputs:activity>
        float outputs:propellant_flow.connect = </DescentLander/MainPropulsion/MainChamber.outputs:propellant_flow>
        float outputs:propellant_mass.connect = </DescentLander/MainPropulsion/PropellantStatus.outputs:propellant_mass_kg>
        float outputs:propellant_fraction.connect = </DescentLander/MainPropulsion/PropellantStatus.outputs:propellant_fraction>
        float outputs:propellant_used.connect = </DescentLander/MainPropulsion/PropellantStatus.outputs:propellant_used_kg>
        float outputs:low_fuel.connect = </DescentLander/MainPropulsion/PropellantStatus.outputs:low_fuel>
        float outputs:depleted.connect = </DescentLander/MainPropulsion/PropellantStatus.outputs:depleted>
        float outputs:vehicle_mass_kg.connect = </DescentLander/MainPropulsion/PropellantStatus.outputs:vehicle_mass_kg>
        float outputs:vehicle_inertia_xx_kg_m2.connect = </DescentLander/MainPropulsion/PropellantStatus.outputs:vehicle_inertia_xx_kg_m2>
        float outputs:vehicle_inertia_yy_kg_m2.connect = </DescentLander/MainPropulsion/PropellantStatus.outputs:vehicle_inertia_yy_kg_m2>
        float outputs:vehicle_inertia_zz_kg_m2.connect = </DescentLander/MainPropulsion/PropellantStatus.outputs:vehicle_inertia_zz_kg_m2>
        float outputs:vehicle_com_x_m.connect = </DescentLander/MainPropulsion/PropellantStatus.outputs:vehicle_com_x_m>
        float outputs:vehicle_com_y_m.connect = </DescentLander/MainPropulsion/PropellantStatus.outputs:vehicle_com_y_m>
        float outputs:vehicle_com_z_m.connect = </DescentLander/MainPropulsion/PropellantStatus.outputs:vehicle_com_z_m>
        uniform token collection:components:expansionRule = "explicitOnly"
        prepend rel collection:components:includes = [
            </DescentLander/MainPropulsion/FuelTank>,
            </DescentLander/MainPropulsion/OxidizerTank>,
            </DescentLander/MainPropulsion/FuelPump>,
            </DescentLander/MainPropulsion/OxidizerPump>,
            </DescentLander/MainPropulsion/MainChamber>,
            </DescentLander/MainPropulsion/PropellantStatus>,
        ]

        def Scope "FuelTank" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://models/LunCo/Propulsion/PropellantTank.mo@
            uniform bool lunco:program:realtimeSafe = true
            float inputs:initial_mass_kg = 1000.0
            float inputs:nominal_pressure_pa = 2500000.0
            float inputs:pressure_headroom_pa = 500000.0
            float inputs:low_fuel_mass_kg = 100.0
            float inputs:depleted_mass_kg = 0.5
            float inputs:minimum_mass_kg = 0.000001
            float inputs:event_transition_width_kg = 0.01
            float inputs:auxiliary_mass_flow_kgs.connect = </DescentLander/MainPropulsion.inputs:rcs_fuel_mass_flow_kgs>
            custom token connectors:outlet.connect = </DescentLander/MainPropulsion/FuelPump.connectors:inlet>
            float outputs:mass_kg
            float outputs:pressure_pa
            float outputs:mass_out_flow_kgs
            float outputs:low_fuel
            float outputs:depleted
        }
        def Scope "OxidizerTank" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://models/LunCo/Propulsion/PropellantTank.mo@
            uniform bool lunco:program:realtimeSafe = true
            float inputs:initial_mass_kg = 1000.0
            float inputs:nominal_pressure_pa = 2500000.0
            float inputs:pressure_headroom_pa = 500000.0
            float inputs:low_fuel_mass_kg = 100.0
            float inputs:depleted_mass_kg = 0.5
            float inputs:minimum_mass_kg = 0.000001
            float inputs:event_transition_width_kg = 0.01
            float inputs:auxiliary_mass_flow_kgs.connect = </DescentLander/MainPropulsion.inputs:rcs_oxidizer_mass_flow_kgs>
            custom token connectors:outlet.connect = </DescentLander/MainPropulsion/OxidizerPump.connectors:inlet>
            float outputs:mass_kg
            float outputs:pressure_pa
            float outputs:mass_out_flow_kgs
            float outputs:low_fuel
            float outputs:depleted
        }
        def Scope "FuelPump" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://models/LunCo/Propulsion/Turbopump.mo@
            uniform bool lunco:program:realtimeSafe = true
            float inputs:maximum_flow_kgs = 8.0
            float inputs:nominal_tank_pressure_pa = 2500000.0
            float inputs:discharge_pressure_pa = 8000000.0
            float inputs:spool_tau = 0.08
            float inputs:pump_efficiency = 0.72
            float inputs:speed_rpm_max = 30000.0
            float inputs:propellant_density_kg_m3 = 810.0
            float inputs:minimum_pressure_pa = 1.0
            float inputs:minimum_efficiency = 0.000001
            float inputs:minimum_time_constant_s = 0.000001
            float inputs:minimum_available_mass_kg = 0.000001
            float inputs:availability_transition_mass_kg = 0.01
            float inputs:available_mass_kg.connect = </DescentLander/MainPropulsion/FuelTank.outputs:mass_kg>
            float inputs:valve_opening.connect = </DescentLander/MainPropulsion.inputs:valve_opening>
            custom token connectors:inlet.connect = </DescentLander/MainPropulsion/FuelTank.connectors:outlet>
            custom token connectors:outlet.connect = </DescentLander/MainPropulsion/MainChamber.connectors:fuel_in>
            float outputs:mass_flow_kgs
            float outputs:outlet_pressure_pa
            float outputs:speed_fraction
            float outputs:speed_rpm
            float outputs:activity
            float outputs:shaft_power_w
        }
        def Scope "OxidizerPump" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://models/LunCo/Propulsion/Turbopump.mo@
            uniform bool lunco:program:realtimeSafe = true
            float inputs:maximum_flow_kgs = 21.0
            float inputs:nominal_tank_pressure_pa = 2500000.0
            float inputs:discharge_pressure_pa = 8000000.0
            float inputs:spool_tau = 0.08
            float inputs:pump_efficiency = 0.72
            float inputs:speed_rpm_max = 30000.0
            float inputs:propellant_density_kg_m3 = 1140.0
            float inputs:minimum_pressure_pa = 1.0
            float inputs:minimum_efficiency = 0.000001
            float inputs:minimum_time_constant_s = 0.000001
            float inputs:minimum_available_mass_kg = 0.000001
            float inputs:availability_transition_mass_kg = 0.01
            float inputs:available_mass_kg.connect = </DescentLander/MainPropulsion/OxidizerTank.outputs:mass_kg>
            float inputs:valve_opening.connect = </DescentLander/MainPropulsion.inputs:valve_opening>
            custom token connectors:inlet.connect = </DescentLander/MainPropulsion/OxidizerTank.connectors:outlet>
            custom token connectors:outlet.connect = </DescentLander/MainPropulsion/MainChamber.connectors:oxidizer_in>
            float outputs:mass_flow_kgs
            float outputs:outlet_pressure_pa
            float outputs:speed_fraction
            float outputs:speed_rpm
            float outputs:activity
            float outputs:shaft_power_w
        }
        def Scope "MainChamber" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://models/LunCo/Propulsion/CombustionChamber.mo@
            uniform bool lunco:program:realtimeSafe = true
            float inputs:oxidizer_to_fuel_ratio = 2.6
            float inputs:characteristic_velocity_mps = 1550.0
            float inputs:throat_area_m2 = 0.0045
            float inputs:effective_exhaust_velocity_mps = 2940.0
            float inputs:combustion_efficiency = 0.96
            float inputs:nominal_flow_kgs = 29.0
            float inputs:chamber_temperature_full_k = 3300.0
            float inputs:minimum_flow_kgs = 0.000001
            float inputs:minimum_throat_area_m2 = 0.000000001
            float inputs:minimum_mixture_ratio = 0.000001
            float inputs:fuel_energy_j_kg = 40000000.0
            custom token connectors:fuel_in
            custom token connectors:oxidizer_in
            float outputs:fuel_flow_kgs
            float outputs:oxidizer_flow_kgs
            float outputs:propellant_flow
            float outputs:mixture_ratio
            float outputs:mixture_ratio_error
            float outputs:mixture_efficiency
            float outputs:chamber_pressure_pa
            float outputs:ideal_chamber_pressure_pa
            float outputs:chamber_temperature_k
            float outputs:thrust_n
            float outputs:activity
            float outputs:heat_release_w
        }
        def Scope "PropellantStatus" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://models/LunCo/Propulsion/PropellantStatus.mo@
            uniform bool lunco:program:realtimeSafe = true
            float inputs:low_fuel_mass_kg = 200.0
            float inputs:depleted_mass_kg = 1.0
            float inputs:initial_propellant_mass_kg = 2000.0
            float inputs:minimum_mass_kg = 0.000001
            float inputs:event_transition_width_kg = 0.01
            float inputs:fuel_mass_kg.connect = </DescentLander/MainPropulsion/FuelTank.outputs:mass_kg>
            float inputs:oxidizer_mass_kg.connect = </DescentLander/MainPropulsion/OxidizerTank.outputs:mass_kg>
            float inputs:dry_mass_kg = 2000.0
            float inputs:dry_inertia_xx_kg_m2 = 4625.0
            float inputs:dry_inertia_yy_kg_m2 = 6250.0
            float inputs:dry_inertia_zz_kg_m2 = 4625.0
            float inputs:fuel_position_y_m = 0.8
            float inputs:oxidizer_position_y_m = -0.8
            float outputs:propellant_mass_kg
            float outputs:propellant_used_kg
            float outputs:propellant_fraction
            float outputs:low_fuel
            float outputs:depleted
            float outputs:vehicle_mass_kg
            float outputs:vehicle_inertia_xx_kg_m2
            float outputs:vehicle_inertia_yy_kg_m2
            float outputs:vehicle_inertia_zz_kg_m2
            float outputs:vehicle_com_x_m
            float outputs:vehicle_com_y_m
            float outputs:vehicle_com_z_m
        }
    }

    def Scope "AttitudeActuation" (
        prepend apiSchemas = ["CollectionAPI:components", "LunCoUiSchemaAPI"]
    )
    {
        bool lunco:ui:schemaNode = true
        string ui:displayName = "RCS allocator"
        int lunco:ui:schemaColumn = 2
        int lunco:ui:schemaRow = 0
        # The allocator is derived from the authored force-actuator geometry
        # below.  The selected synthesizer is explicit so a future projection
        # cannot silently reinterpret this scope as an acausal component graph.
        uniform token lunco:synthesizer = "actuator-wrench"
        float inputs:desired_torque_x.connect = </DescentLander.outputs:torque_x>
        float inputs:desired_torque_y.connect = </DescentLander.outputs:torque_y>
        float inputs:desired_torque_z.connect = </DescentLander.outputs:torque_z>

        # The generated allocator owns these boundary outputs. Their names must
        # match the commandOutput authored on each force actuator exactly.
        float outputs:pitch_pos_a_valve
        float outputs:pitch_pos_b_valve
        float outputs:pitch_neg_a_valve
        float outputs:pitch_neg_b_valve
        float outputs:roll_pos_a_valve
        float outputs:roll_pos_b_valve
        float outputs:roll_neg_a_valve
        float outputs:roll_neg_b_valve
        float outputs:yaw_pos_a_valve
        float outputs:yaw_pos_b_valve
        float outputs:yaw_neg_a_valve
        float outputs:yaw_neg_b_valve

        uniform token collection:components:expansionRule = "explicitOnly"
        prepend rel collection:components:includes = [
            </DescentLander/RcsPitchPos>,
            </DescentLander/RcsPitchNeg>,
            </DescentLander/RcsRollPos>,
            </DescentLander/RcsRollNeg>,
            </DescentLander/RcsYawPos>,
            </DescentLander/RcsYawNeg>,
            </DescentLander/RcsPitchPosB>,
            </DescentLander/RcsPitchNegB>,
            </DescentLander/RcsRollPosB>,
            </DescentLander/RcsRollNegB>,
            </DescentLander/RcsYawPosB>,
            </DescentLander/RcsYawNegB>,
        ]
    }

    # The allocator above emits valve openings. This separate generated
    # network owns reusable RCS thrust/flow equations, so a physical nozzle
    # receives the thrust produced by its own Modelica engine model and its
    # flame receives that model's activity output.
    def Scope "AttitudePropulsion" (
        prepend apiSchemas = ["CollectionAPI:components", "LunCoUiSchemaAPI"]
    )
    {
        bool lunco:ui:schemaNode = true
        string ui:displayName = "RCS jets"
        int lunco:ui:schemaColumn = 3
        int lunco:ui:schemaRow = 0
        float inputs:pitch_pos_a_valve.connect = </DescentLander/AttitudeActuation.outputs:pitch_pos_a_valve>
        float inputs:pitch_pos_b_valve.connect = </DescentLander/AttitudeActuation.outputs:pitch_pos_b_valve>
        float inputs:pitch_neg_a_valve.connect = </DescentLander/AttitudeActuation.outputs:pitch_neg_a_valve>
        float inputs:pitch_neg_b_valve.connect = </DescentLander/AttitudeActuation.outputs:pitch_neg_b_valve>
        float inputs:roll_pos_a_valve.connect = </DescentLander/AttitudeActuation.outputs:roll_pos_a_valve>
        float inputs:roll_pos_b_valve.connect = </DescentLander/AttitudeActuation.outputs:roll_pos_b_valve>
        float inputs:roll_neg_a_valve.connect = </DescentLander/AttitudeActuation.outputs:roll_neg_a_valve>
        float inputs:roll_neg_b_valve.connect = </DescentLander/AttitudeActuation.outputs:roll_neg_b_valve>
        float inputs:yaw_pos_a_valve.connect = </DescentLander/AttitudeActuation.outputs:yaw_pos_a_valve>
        float inputs:yaw_pos_b_valve.connect = </DescentLander/AttitudeActuation.outputs:yaw_pos_b_valve>
        float inputs:yaw_neg_a_valve.connect = </DescentLander/AttitudeActuation.outputs:yaw_neg_a_valve>
        float inputs:yaw_neg_b_valve.connect = </DescentLander/AttitudeActuation.outputs:yaw_neg_b_valve>

        float outputs:pitch_pos_a_thrust_n.connect = </DescentLander/AttitudePropulsion/RcsPitchPosModel.outputs:thrust_n>
        float outputs:pitch_pos_a_activity.connect = </DescentLander/AttitudePropulsion/RcsPitchPosModel.outputs:activity>
        float outputs:pitch_pos_b_thrust_n.connect = </DescentLander/AttitudePropulsion/RcsPitchPosBModel.outputs:thrust_n>
        float outputs:pitch_pos_b_activity.connect = </DescentLander/AttitudePropulsion/RcsPitchPosBModel.outputs:activity>
        float outputs:pitch_neg_a_thrust_n.connect = </DescentLander/AttitudePropulsion/RcsPitchNegModel.outputs:thrust_n>
        float outputs:pitch_neg_a_activity.connect = </DescentLander/AttitudePropulsion/RcsPitchNegModel.outputs:activity>
        float outputs:pitch_neg_b_thrust_n.connect = </DescentLander/AttitudePropulsion/RcsPitchNegBModel.outputs:thrust_n>
        float outputs:pitch_neg_b_activity.connect = </DescentLander/AttitudePropulsion/RcsPitchNegBModel.outputs:activity>
        float outputs:roll_pos_a_thrust_n.connect = </DescentLander/AttitudePropulsion/RcsRollPosModel.outputs:thrust_n>
        float outputs:roll_pos_a_activity.connect = </DescentLander/AttitudePropulsion/RcsRollPosModel.outputs:activity>
        float outputs:roll_pos_b_thrust_n.connect = </DescentLander/AttitudePropulsion/RcsRollPosBModel.outputs:thrust_n>
        float outputs:roll_pos_b_activity.connect = </DescentLander/AttitudePropulsion/RcsRollPosBModel.outputs:activity>
        float outputs:roll_neg_a_thrust_n.connect = </DescentLander/AttitudePropulsion/RcsRollNegModel.outputs:thrust_n>
        float outputs:roll_neg_a_activity.connect = </DescentLander/AttitudePropulsion/RcsRollNegModel.outputs:activity>
        float outputs:roll_neg_b_thrust_n.connect = </DescentLander/AttitudePropulsion/RcsRollNegBModel.outputs:thrust_n>
        float outputs:roll_neg_b_activity.connect = </DescentLander/AttitudePropulsion/RcsRollNegBModel.outputs:activity>
        float outputs:yaw_pos_a_thrust_n.connect = </DescentLander/AttitudePropulsion/RcsYawPosModel.outputs:thrust_n>
        float outputs:yaw_pos_a_activity.connect = </DescentLander/AttitudePropulsion/RcsYawPosModel.outputs:activity>
        float outputs:yaw_pos_b_thrust_n.connect = </DescentLander/AttitudePropulsion/RcsYawPosBModel.outputs:thrust_n>
        float outputs:yaw_pos_b_activity.connect = </DescentLander/AttitudePropulsion/RcsYawPosBModel.outputs:activity>
        float outputs:yaw_neg_a_thrust_n.connect = </DescentLander/AttitudePropulsion/RcsYawNegModel.outputs:thrust_n>
        float outputs:yaw_neg_a_activity.connect = </DescentLander/AttitudePropulsion/RcsYawNegModel.outputs:activity>
        float outputs:yaw_neg_b_thrust_n.connect = </DescentLander/AttitudePropulsion/RcsYawNegBModel.outputs:thrust_n>
        float outputs:yaw_neg_b_activity.connect = </DescentLander/AttitudePropulsion/RcsYawNegBModel.outputs:activity>
        float outputs:mass_flow_kgs.connect = </DescentLander/AttitudePropulsion/RcsFlowAggregator.outputs:total_flow_kgs>
        float outputs:fuel_mass_flow_kgs.connect = </DescentLander/AttitudePropulsion/RcsFlowAggregator.outputs:fuel_flow_kgs>
        float outputs:oxidizer_mass_flow_kgs.connect = </DescentLander/AttitudePropulsion/RcsFlowAggregator.outputs:oxidizer_flow_kgs>

        uniform token collection:components:expansionRule = "explicitOnly"
        prepend rel collection:components:includes = [
            </DescentLander/AttitudePropulsion/RcsPitchPosModel>,
            </DescentLander/AttitudePropulsion/RcsPitchPosBModel>,
            </DescentLander/AttitudePropulsion/RcsPitchNegModel>,
            </DescentLander/AttitudePropulsion/RcsPitchNegBModel>,
            </DescentLander/AttitudePropulsion/RcsRollPosModel>,
            </DescentLander/AttitudePropulsion/RcsRollPosBModel>,
            </DescentLander/AttitudePropulsion/RcsRollNegModel>,
            </DescentLander/AttitudePropulsion/RcsRollNegBModel>,
            </DescentLander/AttitudePropulsion/RcsYawPosModel>,
            </DescentLander/AttitudePropulsion/RcsYawPosBModel>,
            </DescentLander/AttitudePropulsion/RcsYawNegModel>,
            </DescentLander/AttitudePropulsion/RcsYawNegBModel>,
            </DescentLander/AttitudePropulsion/RcsFlowAggregator>,
        ]

        def Scope "RcsPitchPosModel" (
            prepend apiSchemas = ["LunCoProgramAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:sourceAsset = @lunco://models/LunCo/Propulsion/RCSJet.mo@
            uniform bool lunco:program:realtimeSafe = true
            float inputs:f_nom_n = 1250.0
            float inputs:isp_sec = 220.0
            float inputs:g0 = 9.80665
            float inputs:plume_width_m = 0.18
            float inputs:plume_length_m = 0.72
            float inputs:plume_luminance = 5.475
            float inputs:plume_exitance = 44200.0
