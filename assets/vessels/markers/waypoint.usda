#usda 1.0
(
    defaultPrim = "WaypointMarker"
    upAxis = "Y"
    metersPerUnit = 1
)

# Reusable mission waypoint marker — a softly translucent, non-occluding glowing
# DOME a vehicle is
# meant to drive to, plus a ground-anchored overlap volume. Neither is a solid
# body. The physics Sensor is consumed by the shared route projection, which
# emits the canonical `waypoint.reached` event with a typed {path,state,index} payload
# for Rhai; mission code does not poll a duplicate distance tolerance.
#
# Drop it anywhere with `prepend references` + `xformOp:translate`. The emissive
# material keeps the marker independent of scene lighting; the standard
# `primvars:doNotCastShadows` flag excludes this annotation from shadow maps.
def Xform "WaypointMarker" (
    doc = "Reusable mission waypoint marker with a non-solid arrival trigger for rover routes."
    prepend apiSchemas = ["LunCoCatalogAPI", "LunCoWaypointAPI", "LunCoBillboardAPI"]
    kind = "component"
)
{
    uniform bool lunco:spawnable = true
    bool lunco:waypoint = true
    # Every reusable waypoint opts into the shared label path. Runtime-created
    # markers attach the same data-only contract after spawning this asset.
    bool lunco:billboard = true
    string lunco:billboard:text = "Waypoint {index}\n{lat:.5}, {lon:.5}\n{height:.1} m"
    float lunco:billboard:offsetY = 4.0
    float lunco:billboard:fadeEnd = 1200.0
    custom string lunco:interaction:left = "pass_through"
    custom string lunco:interaction:right = "context"

    # Arrival is session state on the vessel's `ReachedWaypoints` component.
    # The marker remains authored geometry and is never rewritten or deleted
    # when a route leg completes. This keeps the scene reusable and replayable.
    # Rhai reads the authored inactive color below and applies it as a runtime
    # USD opinion when the waypoint.reached event arrives.
    float3 lunco:waypoint:inactiveColor = (0.38, 0.38, 0.38)

    # Emission REQUIRES a material. `displayColor` is a real UsdGeomGprim
    # primvar and stays on the geometry, but USD has no "display emissive" —
    # emission is a UsdPreviewSurface input, so it lives on a Shader reached
    # through `material:binding`.
    def Scope "Looks"
    {
        def Material "Dome_Mat"
        {
            token outputs:surface.connect = </WaypointMarker/Looks/Dome_Mat/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                # A restrained emissive cue keeps the translucent annotation
                # readable against the lunar sun without washing the vehicle
                # beneath it in green. This is an emissive annotation, not a
                # reflective surface.
                # Keep the UsdPreviewSurface contract explicit; the runtime
                # standard gprim cast flag below controls shadow-map participation
                # on the actual mesh entity.
                color3f inputs:diffuseColor = (0, 0, 0)
                color3f inputs:specularColor = (0, 0, 0)
                float inputs:useSpecularWorkflow = 1
                float inputs:roughness = 1.0
                color3f inputs:emissiveColor = (0.12, 1.3, 0.45)
                token outputs:surface
            }
        }
    }

    # Translucent additive dome. Additive blending keeps the annotation visible
    # without writing an occluding depth value over the rover or terrain behind it.
    # It is visual-only; the trigger volume below is
    # ground-anchored so a vehicle approaching a marker on a slope can enter the
    # waypoint without having to overlap the top of a dome floating one radius
    # above the terrain. The standard displayOpacity keeps the rover readable
    # through the annotation while the emissive-only material keeps its colour
    # independent of scene lighting.
    def Sphere "Dome" (
        prepend apiSchemas = ["MaterialBindingAPI", "LunCoSurfaceAPI"]
    )
    {
        custom string lunco:interaction:left = "pass_through"
        custom string lunco:interaction:right = "context"
        double radius = 1.5
        # The marker origin is the terrain contact point. Lift the visible sphere
        # centre by one radius so the complete dome is above the surface.
        double3 xformOp:translate = (0, 1.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </WaypointMarker/Looks/Dome_Mat>
        color3f[] primvars:displayColor = [(0.35, 1.0, 0.6)]
        float[] primvars:displayOpacity = [0.08]
        bool lunco:surface:additive = true
        # Waypoints are navigational annotations, not scenery. Keep their glow
        # visible without making a floating dome cast a terrain shadow. The
        # emissive-only UsdPreviewSurface above also makes its appearance
        # independent of scene lighting, shadows, and reflections.
        bool primvars:doNotCastShadows = true
    }

    # The trigger is deliberately a separate, invisible geometry prim. Its
    # centre is the marker's authored terrain anchor. The trigger radius is an
    # explicit standard geometry value because the runtime shape projection
    # reads geometry dimensions as authored defaults; USD attribute connections
    # describe dataflow and are not geometry-dimension values.
    def Sphere "Trigger" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double radius = 2.5
        token visibility = "invisible"
        bool physics:collisionEnabled = true
        custom string lunco:triggerZone = "waypoint"
    }
}
