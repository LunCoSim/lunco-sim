#usda 1.0
(
    defaultPrim = "WaypointMarker"
    upAxis = "Y"
    metersPerUnit = 1
)

# Reusable mission waypoint marker — a translucent glowing DOME a vehicle is
# meant to drive to. It NEVER collides as a solid body: the visible dome is also
# an overlap-only avian Sensor (non-solid). Arrival is an EVENT
# (`enter:waypoint`) reacted to in rhai, not a per-tick distance poll.
#
# Drop it anywhere with `prepend references` + `xformOp:translate`. Transparency
# uses the standard `primvars:displayOpacity` (folded into base-color alpha +
# AlphaMode::Blend by lunco-usd-bevy).
def Xform "WaypointMarker" (
    doc = "Reusable mission waypoint marker with a non-solid arrival trigger for rover routes."
    prepend apiSchemas = ["LunCoCatalogAPI"]
    kind = "component"
)
{
    uniform bool lunco:spawnable = true
    custom string lunco:waypoint = "true"
    custom string lunco:interaction:left = "pass_through"
    custom string lunco:interaction:right = "context"

    # Arrival is session state on the vessel's `ReachedWaypoints` component.
    # The marker remains authored geometry and is never rewritten or deleted
    # when a route leg completes. This keeps the scene reusable and replayable.

    # Emission REQUIRES a material. `displayColor` and `displayOpacity` are real
    # UsdGeomGprim primvars and stay on the geometry, but USD has no "display
    # emissive" — emission is a UsdPreviewSurface input, so it lives on a Shader
    # reached through `material:binding`.
    def Scope "Looks"
    {
        def Material "Dome_Mat"
        {
            token outputs:surface.connect = </WaypointMarker/Looks/Dome_Mat/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                # HDR (>1) so the dome READS AS A LIGHT SOURCE against 128 klx
                # lunar sun instead of a tinted bubble — the same trick the
                # headlight lens uses. Below 1.0 the tonemapper has nothing to
                # bloom and the marker sinks into the regolith at midday.
                color3f inputs:emissiveColor = (0.35, 3.2, 1.4)
                token outputs:surface
            }
        }
    }

    # Translucent emissive dome and overlap Sensor. This is deliberately one
    # Sphere: its standard USD radius is the single waypoint-size input used by
    # both the rendered marker and the Avian collider projection.
    def Sphere "Dome" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        custom string lunco:interaction:left = "pass_through"
        custom string lunco:interaction:right = "context"
        double radius = 2.5
        # The marker origin is the terrain contact point. Lift the sphere centre
        # by one radius so the complete visible dome is above the surface.
        double3 xformOp:translate = (0, 2.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </WaypointMarker/Looks/Dome_Mat>
        color3f[] primvars:displayColor = [(0.35, 1.0, 0.6)]
        # Was 0.28 — legible at a glance now, still transparent enough to see
        # the terrain (and any vehicle) through the dome.
        float[] primvars:displayOpacity = [0.45]
        # Waypoints are navigational annotations, not scenery. Keep their glow
        # visible without making a floating dome cast a terrain shadow.
        bool primvars:doNotCastShadows = true
        bool physics:collisionEnabled = true
        # The visible sphere itself is the non-solid arrival sensor. Its
        # authored radius above therefore defines both the visual footprint
        # and the arrival tolerance, with no second size variable to drift.
        custom string lunco:triggerZone = "waypoint"
    }
}
