#usda 1.0
(
    defaultPrim = "WaypointMarker"
    upAxis = "Y"
    metersPerUnit = 1
)

# Reusable mission waypoint marker — a translucent glowing DOME a vehicle is
# meant to drive to. It NEVER collides with physics: the dome has no collider,
# and the trigger volume is an overlap-only avian Sensor (non-solid). Arrival is
# an EVENT (`enter:waypoint`) reacted to in rhai, not a per-tick distance poll.
#
# Drop it anywhere with `prepend references` + `xformOp:translate`. Transparency
# uses the standard `primvars:displayOpacity` (folded into base-color alpha +
# AlphaMode::Blend by lunco-usd-bevy).
def Xform "WaypointMarker" (
    doc = "Reusable mission waypoint marker with a non-solid arrival trigger for rover routes."
    prepend apiSchemas = ["LunCoCatalogAPI"]
    kind = "component"
)
{
    uniform bool lunco:spawnable = true
    custom string lunco:waypoint = "true"

    # ── ARRIVAL STATE — authored, not deleted ────────────────────────────────
    # Reaching a waypoint does NOT remove it: the leg stays in the mission and
    # the marker stays on the map, so a route can be reviewed, replayed and
    # re-run. Arrival flips this flag in the RUNTIME layer (session state, not
    # the saved scene), driven by the `enter:` event this marker's own trigger
    # zone fires — never a per-tick distance poll.
    custom bool lunco:waypoint:reached = false

    # Both palettes live HERE, in the asset, because a waypoint's livery is
    # authored content — Rust selects between them, it does not define them.
    custom color3f lunco:waypoint:color:active = (0.35, 1.0, 0.6)
    custom color3f lunco:waypoint:color:reached = (0.45, 0.47, 0.5)

    # Emission REQUIRES a material. `displayColor` and `displayOpacity` are real
    # UsdGeomGprim primvars and stay on the geometry, but USD has no "display
    # emissive" — emission is a UsdPreviewSurface input, so it lives on a Shader
    # reached through `material:binding`.
    def Scope "Looks"
    {
        def Material "Dome_Mat"
        {
            token outputs:surface.connect = </WaypointMarker/Looks/Dome_Mat/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                # HDR (>1) so the dome READS AS A LIGHT SOURCE against 128 klx
                # lunar sun instead of a tinted bubble — the same trick the
                # headlight lens uses. Below 1.0 the tonemapper has nothing to
                # bloom and the marker sinks into the regolith at midday.
                color3f inputs:emissiveColor = (0.35, 3.2, 1.4)
                token outputs:surface
            }
        }
    }

    # Translucent emissive dome. A sphere centred at the marker origin (ground
    # level): the upper half reads as a half-sphere dome; the lower half sits
    # below the surface and is hidden. Purely visual — no collider.
    def Sphere "Dome"
    {
        double radius = 2.5
        # The marker origin is the terrain contact point. Lift the visual
        # centre by one radius so the complete dome is above the surface;
        # the trigger remains independently authored at ground level.
        double3 xformOp:translate = (0, 2.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </WaypointMarker/Looks/Dome_Mat>
        color3f[] primvars:displayColor = [(0.35, 1.0, 0.6)]
        # Was 0.28 — legible at a glance now, still transparent enough to see
        # the terrain (and any vehicle) through the dome.
        float[] primvars:displayOpacity = [0.45]
        # Waypoints are navigational annotations, not scenery. Keep their glow
        # visible without making a floating dome cast a terrain shadow.
        bool primvars:doNotCastShadows = true
        bool physics:collisionEnabled = false
    }

    # Geofence trigger volume — overlap-only Sensor (invisible, NON-SOLID, so it
    # never pushes the rover). `lunco:triggerZone` fires `enter:waypoint` /
    # `exit:waypoint` events when a vehicle crosses it. Radius = arrival
    # tolerance. Override `lunco:triggerZone` on the referencing prim if a scene
    # has several waypoints.
    def Sphere "Zone" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double radius = 4.0
        double3 xformOp:translate = (0, 1.0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool physics:collisionEnabled = true
        token visibility = "invisible"
        custom string lunco:triggerZone = "waypoint"
    }
}
