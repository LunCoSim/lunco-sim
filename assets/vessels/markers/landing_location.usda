#usda 1.0
(
    defaultPrim = "LandingLocationMarker"
    upAxis = "Y"
    metersPerUnit = 1
)

# Reusable landing location marker — a thin illuminated pad disc representing
# the target touchdown site. It NEVER collides with physics: the disc has no
# collider, and the trigger volume is an overlap-only Avian Sensor (non-solid).
#
# Drop it anywhere with `prepend references` + `xformOp:translate`.
def Xform "LandingLocationMarker" (
    doc = "Reusable landing-site marker with a non-solid trigger volume for touchdown guidance."
    prepend apiSchemas = ["LunCoCatalogAPI"]
    kind = "component"
)
{
    uniform bool lunco:spawnable = true
    custom string lunco:landingLocation = "true"
    custom string lunco:interaction:left = "pass_through"
    custom string lunco:interaction:right = "context"

    # Emission REQUIRES a material. `displayColor` / `displayOpacity` are real
    # UsdGeomGprim primvars and stay on the geometry; USD has no "display
    # emissive", so the glow is a UsdPreviewSurface input on a bound Shader.
    def Scope "Looks"
    {
        def Material "Dome_Mat"
        {
            token outputs:surface.connect = </LandingLocationMarker/Looks/Dome_Mat/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:emissiveColor = (0.85, 0.12, 0.12)
                token outputs:surface
            }
        }
    }

    # Thin emissive pad mark centred on the authored ground datum.  Keeping the
    # existing child name preserves ordinary USD overrides while changing the
    # reusable visual from a misleading flame-like hemisphere to a flat target.
    # Purely visual — no collider.
    def Cylinder "Dome" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        custom string lunco:interaction:left = "pass_through"
        custom string lunco:interaction:right = "context"
        uniform token axis = "Y"
        double radius = 2.5
        double height = 0.04
        rel material:binding = </LandingLocationMarker/Looks/Dome_Mat>
        color3f[] primvars:displayColor = [(0.95, 0.2, 0.2)]
        float[] primvars:displayOpacity = [0.5]
        bool physics:collisionEnabled = false
    }

    # Geofence trigger volume — overlap-only Sensor (invisible, NON-SOLID, so it
    # never pushes the lander). `lunco:triggerZone` fires `enter:landing_location` /
    # `exit:landing_location` events when a vehicle crosses it.
    def Sphere "Zone" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double radius = 4.0
        double3 xformOp:translate = (0, 1.0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool physics:collisionEnabled = true
        token visibility = "invisible"
        custom string lunco:triggerZone = "landing_location"
    }
}
