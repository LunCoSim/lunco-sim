#usda 1.0
(
    defaultPrim = "PythonBalloon"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "PythonBalloon" (
    documentation = "Rigid scientific balloon driven by a Python flight model and buoyancy force."
    kind = "component"
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "LunCoCatalogAPI", "LunCoProgramAPI"]
)
{
    uniform bool lunco:spawnable = true
    bool physics:rigidBodyEnabled = true
    float physics:mass = 4.5
    uniform token info:implementationSource = "sourceAsset"
    uniform asset info:sourceAsset = @lunco://models/GreenBalloon.py@
    uniform bool lunco:program:realtimeSafe = true
    float outputs:netForce = 0.0
    float inputs:force_y
    float inputs:force_y.connect = </PythonBalloon.outputs:netForce>
    float inputs:height
    float inputs:height.connect = </PythonBalloon.outputs:position_y>
    float inputs:velocity
    float inputs:velocity.connect = </PythonBalloon.outputs:velocity_y>
    float inputs:gravity
    float inputs:gravity.connect = </PythonBalloon/Environment.outputs:gravity_accel>
    def Xform "Environment" (
        prepend references = @lunco://components/environment/probe.usda@</EnvironmentProbe>
    )
    {
    }
    def Scope "Looks"
    {
        def Material "Envelope"
        {
            token outputs:surface
            token outputs:surface.connect = </PythonBalloon/Looks/Envelope/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                color3f inputs:cell_a = (0.20000000298023224, 0.800000011920929, 0.30000001192092896)
                color3f inputs:cell_b = (0.11999999731779099, 0.11999999731779099, 0.14000000059604645)
                color3f inputs:marker_color = (1.0, 1.0, 1.0)
                float inputs:wedge_count = 8.0
                float inputs:band_count = 6.0
                token outputs:surface
                uniform asset info:wesl:sourceAsset = @lunco://shaders/balloon.wesl@
            }
        }
    }
    def Sphere "Envelope" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        double radius = 1.0
        color3f[] primvars:displayColor = [(0.20000000298023224, 0.8999999761581421, 0.20000000298023224)]
        bool physics:collisionEnabled = true
        rel material:binding = </PythonBalloon/Looks/Envelope>
    }
}
