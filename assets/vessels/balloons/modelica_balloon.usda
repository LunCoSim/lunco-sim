#usda 1.0
(
    defaultPrim = "ModelicaBalloon"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "ModelicaBalloon" (
    documentation = "Rigid scientific balloon driven by a Modelica buoyancy and vertical-force model."
    kind = "component"
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "LunCoCatalogAPI"]
)
{
    uniform bool lunco:spawnable = true
    bool physics:rigidBodyEnabled = true
    float physics:mass = 4.5
    float outputs:position_y = 0.0
    float outputs:velocity_y = 0.0
    float inputs:force_y
    float inputs:force_y.connect = </ModelicaBalloon/Plant.outputs:netForce>
    def Xform "Environment" (
        prepend references = @lunco://components/environment/probe.usda@</EnvironmentProbe>
    )
    {
    }
    def Scope "Plant" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://models/Balloon.mo@
        float inputs:height
        float inputs:height.connect = </ModelicaBalloon.outputs:position_y>
        float inputs:velocity
        float inputs:velocity.connect = </ModelicaBalloon.outputs:velocity_y>
        float inputs:gravity
        float inputs:gravity.connect = </ModelicaBalloon/Environment.outputs:gravity_accel>
    }
    def Scope "Looks"
    {
        def Material "Envelope"
        {
            token outputs:surface
            token outputs:surface.connect = </ModelicaBalloon/Looks/Envelope/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                color3f inputs:cell_a = (0.8999999761581421, 0.20000000298023224, 0.20000000298023224)
                color3f inputs:cell_b = (0.11999999731779099, 0.11999999731779099, 0.14000000059604645)
                color3f inputs:marker_color = (1.0, 1.0, 1.0)
                float inputs:wedge_count = 8.0
                float inputs:band_count = 6.0
                token outputs:surface
                uniform asset info:wesl:sourceAsset = @lunco://shaders/balloon.wesl@
            }
        }
    }
    def Sphere "Envelope" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        double radius = 1.0
        color3f[] primvars:displayColor = [(0.8999999761581421, 0.20000000298023224, 0.20000000298023224)]
        bool physics:collisionEnabled = true
        rel material:binding = </ModelicaBalloon/Looks/Envelope>
    }
}
