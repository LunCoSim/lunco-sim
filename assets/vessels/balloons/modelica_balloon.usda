#usda 1.0
(
    defaultPrim = "ModelicaBalloon"
    upAxis = "Y"
    metersPerUnit = 1
)

# Reusable Modelica-driven balloon.
#
# The balloon IS its plant: the buoyancy model is not bolted onto the sphere, it is
# what makes the sphere a balloon — so the program is authored on the vessel prim
# itself and `info:sourceAsset` names the Modelica source. The model's
# `netForce` output is the body's `force_y` input; the body's height and velocity are
# the model's inputs. One prim, one self-loop.
#
# The root is an `Xform` — a vehicle, not a sphere — so the visible envelope is an
# ordinary child gprim that both renders and collides, and the rigid body is the root.
#
# Instantiate in scenes via reference + overrides:
#   def Xform "RedBalloon" (prepend references = @lunco://vessels/balloons/modelica_balloon.usda@</ModelicaBalloon>) {
#       double3 xformOp:translate = (10, 5, 0)
#       uniform token[] xformOpOrder = ["xformOp:translate"]
#   }

def Xform "ModelicaBalloon" (
    doc = "Rigid scientific balloon driven by a Modelica buoyancy and vertical-force model."
    kind = "component"
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "LunCoCatalogAPI"]
)
{
    uniform bool lunco:spawnable = true
    float lunco:spawnLift = 2.0

    bool physics:rigidBodyEnabled = true
    float physics:mass = 4.5

    # The body owns Avian physics ports. `force_y` is intentionally NOT a
    # Modelica input: it is the solver force sink on this rigid body.
    float inputs:force_y.connect = </ModelicaBalloon/Plant.outputs:netForce>

    # Local gravity, published onto every body that has one by
    # `lunco_environment::inject_local_gravity_into_cosim` (as the
    # `gravity_accel` connector). Declared here so the Plant's connection has a
    # real property to resolve to — the same reason a rover chassis declares its
    # `outputs:drive_left`. The runtime writes the value; this states the port.
    #
    # The balloon must not carry a gravity constant of its own: buoyancy is the
    # weight of displaced medium, so it has to use the SAME g Avian applies to
    # the body. Baking 9.81 into the model while the scene ran at 1.62 is what
    # made `RedBalloon` climb out of the world forever.
    float outputs:gravity_accel = 0.0

    # The Modelica program is a distinct child prim. This keeps the USD/Modelica
    # contract exact: Plant declares only its Modelica inputs, while the parent
    # exposes only Avian facts and force sinks.
    def Scope "Plant" (prepend apiSchemas = ["LunCoProgramAPI"])
    {
        uniform asset info:sourceAsset = @lunco://models/Balloon.mo@
        uniform bool lunco:program:realtimeSafe = true
        float inputs:height.connect = </ModelicaBalloon.outputs:height>
        float inputs:velocity.connect = </ModelicaBalloon.outputs:velocity_y>
        float inputs:gravity.connect = </ModelicaBalloon.outputs:gravity_accel>
        # `rho0` is left at the model's default of 0 — VACUUM. This asset is
        # lunar by default, so the envelope neither lifts nor drags. A scene with
        # an atmosphere states it, and gets the full profile back:
        #
        #     over "Plant" { float inputs:rho0 = 1.225 }   # Earth at sea level
        #
        # Authored on the SCENE, not here: which medium a body sits in is a fact
        # about where it is, and this file does not know that.
    }

    # ── Looks: the envelope's skin ───────────────────────────────────────────
    # Spin-revealing checker (see assets/shaders/balloon.wgsl), bound the way USD binds
    # every shader: a `Material` whose surface comes from a `Shader`.
    def Scope "Looks"
    {
        def Material "Envelope"
        {
            token outputs:surface.connect = </ModelicaBalloon/Looks/Envelope/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:wgsl:sourceAsset = @lunco://shaders/balloon.wgsl@
                color3f inputs:cell_a = (0.9, 0.2, 0.2)    # cell A (balloon identity)
                color3f inputs:cell_b = (0.12, 0.12, 0.14) # cell B (dark)
                color3f inputs:marker_color = (1.0, 1.0, 1.0) # marker wedge + poles
                float inputs:wedge_count = 8.0             # longitude cells
                float inputs:band_count = 6.0              # latitude cells
                token outputs:surface
            }
        }
    }

    # ── The envelope: renders and collides ───────────────────────────────────
    def Sphere "Envelope" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double radius = 1.0
        color3f[] primvars:displayColor = [(0.9, 0.2, 0.2)]
        bool physics:collisionEnabled = true
        rel material:binding = </ModelicaBalloon/Looks/Envelope>
    }
}
