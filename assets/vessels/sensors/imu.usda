#usda 1.0
(
    defaultPrim = "Imu"
    upAxis = "Y"
    metersPerUnit = 1
)

# Reusable IMU conversion model.  Avian remains the source of primitive rigid
# body state; this prim only turns those values into an instrument reading.
# The referencing vessel authors the raw connections because only the vessel
# knows which rigid body and environment probe own them.
def Xform "Imu" (
    kind = "component"
    prepend apiSchemas = ["LunCoProgramAPI"]
)
{
    token visibility = "invisible"
    uniform token info:implementationSource = "sourceAsset"
    uniform asset info:sourceAsset = @lunco://models/LunCo/Sensors/IMUSensor.mo@

    float inputs:raw_velocity_x = 0.0
    float inputs:raw_velocity_y = 0.0
    float inputs:raw_velocity_z = 0.0
    float inputs:raw_angvel_x = 0.0
    float inputs:raw_angvel_y = 0.0
    float inputs:raw_angvel_z = 0.0
    float inputs:raw_quat_w = 1.0
    float inputs:raw_quat_x = 0.0
    float inputs:raw_quat_y = 0.0
    float inputs:raw_quat_z = 0.0
    float inputs:gravity_x = 0.0
    float inputs:gravity_y = 0.0
    float inputs:gravity_z = 0.0

    # Measurement bandwidth is part of the sensor configuration, not a hidden
    # runtime constant. The Modelica sensor exposes these parameters so a
    # vehicle can tune them in USD without changing the sensor model.
    float inputs:accel_filter_time_constant_s = 0.02
    float inputs:angular_accel_filter_time_constant_s = 0.02

    float outputs:coordinate_accel_local_x
    float outputs:coordinate_accel_local_y
    float outputs:coordinate_accel_local_z
    float outputs:specific_force_x
    float outputs:specific_force_y
    float outputs:specific_force_z
    float outputs:gyro_x
    float outputs:gyro_y
    float outputs:gyro_z
    float outputs:sensor_health
    float outputs:attitude_quat_w
    float outputs:attitude_quat_x
    float outputs:attitude_quat_y
    float outputs:attitude_quat_z
    float outputs:attitude_quat_valid
}
