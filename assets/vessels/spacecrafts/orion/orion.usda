#usda 1.0
(
    defaultPrim = "Orion"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "Orion" (
    documentation = "Orion crew capsule."
    kind = "component"
    prepend apiSchemas = ["LunCoCatalogAPI", "LunCoSpacecraftAPI"]
    displayName = "Orion Capsule"
)
{
    uniform bool lunco:spawnable = true
    double lunco:spacecraft:hitRadiusKm = 1.0
    def Sphere "Capsule"
    {
        double radius = 1.0
        double3 xformOp:translate = (0.0, 2.5, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(1.0, 1.0, 1.0)]
    }
    def Cube "Body"
    {
        double size = 1.0
        double3 xformOp:translate = (0.0, 0.0, 0.0)
        double3 xformOp:scale = (3.0, 3.0, 3.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.20000000298023224, 0.800000011920929, 0.20000000298023224)]
    }
    def Cylinder "ServiceModule"
    {
        double radius = 1.25
        double height = 4.0
        double3 xformOp:translate = (0.0, -3.5, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
    }
}
