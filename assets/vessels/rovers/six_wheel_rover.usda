                double3 xformOp:scale = (0.42, 0.2, 0.42)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                custom token connectors:p
                token connectors:p.connect = </SixWheelRover/Battery.connectors:p>
                custom double inputs:irradiance
                double inputs:irradiance.connect = </SixWheelRover.inputs:irradiance>
                custom double inputs:sun_visibility
                double inputs:sun_visibility.connect = </SixWheelRover.inputs:sun_visibility>
                custom double inputs:target_mount_x
                double inputs:target_mount_x.connect = </SixWheelRover.inputs:target_mount_x>
                custom double inputs:target_mount_y
                double inputs:target_mount_y.connect = </SixWheelRover.inputs:target_mount_y>
