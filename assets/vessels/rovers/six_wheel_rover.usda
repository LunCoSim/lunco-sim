            }
            over "HeadlightController_R"
            {
                custom token connectors:p
                token connectors:p.connect = </SixWheelRover/Battery.connectors:p>
            }
            def LunCoEvent "BatteryDrained"
            {
                uniform token lunco:event:name = "battery_drained"
                uniform token lunco:event:severity = "warning"
                uniform bool lunco:event:latched = true
                double lunco:event:qualificationTime = 0.0
                float inputs:trigger
                float inputs:trigger.connect = </SixWheelRover.outputs:battery_drained>
            }
        }
    }
    variantSet "generation" = {
        "none" {
        }
        "solar" {
            rel collection:components:includes
            prepend rel collection:components:includes = </SixWheelRover/SolarPanel>
            custom double inputs:irradiance
            double inputs:irradiance.connect = </SixWheelRover/SolarPanel/Environment.outputs:sun_irradiance_w_m2>
            custom double inputs:sun_visibility
            double inputs:sun_visibility.connect = </SixWheelRover/SolarPanel/Environment.outputs:sun_visibility>
            custom double inputs:target_mount_x
            double inputs:target_mount_x.connect = </SixWheelRover/SolarPanel/Environment.outputs:sun_mount_x>
            custom double inputs:target_mount_y
            double inputs:target_mount_y.connect = </SixWheelRover/SolarPanel/Environment.outputs:sun_mount_y>
            custom double inputs:target_mount_z
            double inputs:target_mount_z.connect = </SixWheelRover/SolarPanel/Environment.outputs:sun_mount_z>
            custom double outputs:solar_power
            double outputs:solar_power.connect = </SixWheelRover/SolarPanel.outputs:power_out>
            custom double outputs:solar_incidence
            double outputs:solar_incidence.connect = </SixWheelRover/SolarPanel.outputs:cos_incidence>
            custom double outputs:solar_available_power
            double outputs:solar_available_power.connect = </SixWheelRover/SolarPanel.outputs:available_power_w>
