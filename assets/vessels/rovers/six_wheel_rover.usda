#usda 1.0
(
    defaultPrim = "SixWheelRover"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "SixWheelRover" (
    documentation = "Six-wheel skid-steer lunar rover with USD-authored actuator wiring and raycast suspension."
    kind = "assembly"
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI", "PhysxVehicleContextAPI", "LunCoCatalogAPI", "CollectionAPI:components"]
    prepend references = @lunco://components/mobility/drive_laws/modelica_skid.usda@</DriveLaw>
    prepend variantSets = ["power", "generation", "thermal"]
    variants = { string "generation" = "none"; string "power" = "infinite"; string "thermal" = "none" }
)
{
    uniform token lunco:steeringGeometry = "differential"
    uniform bool lunco:spawnable = true
    float physics:mass = 1400.0
    float outputs:drive_left = 0.0
    float outputs:drive_right = 0.0
    float outputs:brake = 0.0
    float outputs:headlight_left_intensity = 0.0
    float outputs:headlight_right_intensity = 0.0
    float outputs:headlight_left_power_w = 0.0
    float outputs:headlight_right_power_w = 0.0
    float inputs:headlights = 0.0
    float physxRigidBody:linearDamping = 0.5
    float physxRigidBody:angularDamping = 2.0
    float3 physics:diagonalInertia = (2400.0, 3000.0, 1200.0)
    float3 physics:centerOfMass = (0.0, -0.10000000149011612, 0.0)
    variantSet "power" = {
        "infinite" {
            uniform token collection:components:expansionRule = "explicitOnly"
            rel collection:components:includes
            prepend rel collection:components:includes = [</SixWheelRover/PowerSource>, </SixWheelRover/HeadlightController_L>, </SixWheelRover/HeadlightController_R>, </SixWheelRover/Motor_L0>, </SixWheelRover/TorqueSource_L0>, </SixWheelRover/Motor_L1>, </SixWheelRover/TorqueSource_L1>, </SixWheelRover/Motor_L2>, </SixWheelRover/TorqueSource_L2>, </SixWheelRover/Motor_R0>, </SixWheelRover/TorqueSource_R0>, </SixWheelRover/Motor_R1>, </SixWheelRover/TorqueSource_R1>, </SixWheelRover/Motor_R2>, </SixWheelRover/TorqueSource_R2>, </SixWheelRover/Gearbox_L0>, </SixWheelRover/Gearbox_L1>, </SixWheelRover/Gearbox_L2>, </SixWheelRover/Gearbox_R0>, </SixWheelRover/Gearbox_R1>, </SixWheelRover/Gearbox_R2>, </SixWheelRover/Shaft_L0>, </SixWheelRover/Shaft_L1>, </SixWheelRover/Shaft_L2>, </SixWheelRover/Shaft_R0>, </SixWheelRover/Shaft_R1>, </SixWheelRover/Shaft_R2>]
            float inputs:drive_left
            float inputs:drive_left.connect = </SixWheelRover.outputs:drive_left>
            float inputs:drive_right
            float inputs:drive_right.connect = </SixWheelRover.outputs:drive_right>
            float inputs:shaft_speed_L0
            float inputs:shaft_speed_L0.connect = </SixWheelRover/Wheel_L0.outputs:shaft_speed>
            float inputs:shaft_speed_L1
            float inputs:shaft_speed_L1.connect = </SixWheelRover/Wheel_L1.outputs:shaft_speed>
            float inputs:shaft_speed_L2
            float inputs:shaft_speed_L2.connect = </SixWheelRover/Wheel_L2.outputs:shaft_speed>
            float inputs:shaft_speed_R0
            float inputs:shaft_speed_R0.connect = </SixWheelRover/Wheel_R0.outputs:shaft_speed>
            float inputs:shaft_speed_R1
            float inputs:shaft_speed_R1.connect = </SixWheelRover/Wheel_R1.outputs:shaft_speed>
            float inputs:shaft_speed_R2
            float inputs:shaft_speed_R2.connect = </SixWheelRover/Wheel_R2.outputs:shaft_speed>
            float outputs:bus_voltage
            float outputs:bus_voltage.connect = </SixWheelRover/PowerSource.outputs:terminal_voltage_v>
            float outputs:bus_current
            float outputs:bus_current.connect = </SixWheelRover/PowerSource.outputs:terminal_current_a>
            float outputs:bus_power
            float outputs:bus_power.connect = </SixWheelRover/PowerSource.outputs:terminal_power_w>
            float outputs:headlight_left_intensity
            float outputs:headlight_left_intensity.connect = </SixWheelRover/HeadlightController_L.outputs:light_intensity>
            float outputs:headlight_right_intensity
            float outputs:headlight_right_intensity.connect = </SixWheelRover/HeadlightController_R.outputs:light_intensity>
            float outputs:headlight_left_power_w
            float outputs:headlight_left_power_w.connect = </SixWheelRover/HeadlightController_L.outputs:power_draw_w>
            float outputs:headlight_right_power_w
            float outputs:headlight_right_power_w.connect = </SixWheelRover/HeadlightController_R.outputs:power_draw_w>
            over "Battery"
            {
                bool active = false
            }
            def Xform "PowerSource" (
                prepend references = @lunco://components/power/ideal_voltage_source.usda@</IdealVoltageSource>
            )
            {
            }
            over "Motor_L0"
            {
                float inputs:demand
                float inputs:demand.connect = </SixWheelRover.inputs:drive_left>
                custom token connectors:p
                token connectors:p.connect = </SixWheelRover/PowerSource.connectors:p>
            }
            over "Motor_L1"
            {
                float inputs:demand
                float inputs:demand.connect = </SixWheelRover.inputs:drive_left>
                custom token connectors:p
                token connectors:p.connect = </SixWheelRover/PowerSource.connectors:p>
            }
            over "Motor_L2"
            {
                float inputs:demand
                float inputs:demand.connect = </SixWheelRover.inputs:drive_left>
                custom token connectors:p
                token connectors:p.connect = </SixWheelRover/PowerSource.connectors:p>
            }
            over "Motor_R0"
            {
                float inputs:demand
                float inputs:demand.connect = </SixWheelRover.inputs:drive_right>
                custom token connectors:p
                token connectors:p.connect = </SixWheelRover/PowerSource.connectors:p>
            }
            over "Motor_R1"
            {
                float inputs:demand
                float inputs:demand.connect = </SixWheelRover.inputs:drive_right>
                custom token connectors:p
                token connectors:p.connect = </SixWheelRover/PowerSource.connectors:p>
            }
            over "Motor_R2"
            {
                float inputs:demand
                float inputs:demand.connect = </SixWheelRover.inputs:drive_right>
                custom token connectors:p
                token connectors:p.connect = </SixWheelRover/PowerSource.connectors:p>
            }
            over "HeadlightController_L"
            {
                custom token connectors:p
                token connectors:p.connect = </SixWheelRover/PowerSource.connectors:p>
            }
            over "HeadlightController_R"
            {
                custom token connectors:p
                token connectors:p.connect = </SixWheelRover/PowerSource.connectors:p>
            }
        }
        "battery" {
            uniform token collection:components:expansionRule = "explicitOnly"
            rel collection:components:includes
            prepend rel collection:components:includes = [</SixWheelRover/Battery>, </SixWheelRover/HeadlightController_L>, </SixWheelRover/HeadlightController_R>, </SixWheelRover/Motor_L0>, </SixWheelRover/TorqueSource_L0>, </SixWheelRover/Motor_L1>, </SixWheelRover/TorqueSource_L1>, </SixWheelRover/Motor_L2>, </SixWheelRover/TorqueSource_L2>, </SixWheelRover/Motor_R0>, </SixWheelRover/TorqueSource_R0>, </SixWheelRover/Motor_R1>, </SixWheelRover/TorqueSource_R1>, </SixWheelRover/Motor_R2>, </SixWheelRover/TorqueSource_R2>, </SixWheelRover/Gearbox_L0>, </SixWheelRover/Gearbox_L1>, </SixWheelRover/Gearbox_L2>, </SixWheelRover/Gearbox_R0>, </SixWheelRover/Gearbox_R1>, </SixWheelRover/Gearbox_R2>, </SixWheelRover/Shaft_L0>, </SixWheelRover/Shaft_L1>, </SixWheelRover/Shaft_L2>, </SixWheelRover/Shaft_R0>, </SixWheelRover/Shaft_R1>, </SixWheelRover/Shaft_R2>]
            float inputs:drive_left
