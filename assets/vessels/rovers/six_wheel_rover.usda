    variantSet "thermal" = {
        "none" {
        }
        "basic" {
            def Scope "Thermal" (
                prepend apiSchemas = "CollectionAPI:components"
                documentation = "Rover thermal control network: motor dissipation → masses → radiators."
            )
            {
                uniform token collection:components:expansionRule = "explicitOnly"
                rel collection:components:includes
                prepend rel collection:components:includes = [</SixWheelRover/Thermal/MotorHeat_L0>, </SixWheelRover/Thermal/MotorHeat_L1>, </SixWheelRover/Thermal/MotorHeat_L2>, </SixWheelRover/Thermal/MotorHeat_R0>, </SixWheelRover/Thermal/MotorHeat_R1>, </SixWheelRover/Thermal/MotorHeat_R2>, </SixWheelRover/Thermal/MotorThermalLeft>, </SixWheelRover/Thermal/MotorThermalRight>, </SixWheelRover/Thermal/MotorRadiatorLeft>, </SixWheelRover/Thermal/MotorRadiatorRight>, </SixWheelRover/Thermal/ThermalBridge>]
                float inputs:motor_heat_L0
                float inputs:motor_heat_L0.connect = </SixWheelRover/Motor_L0.outputs:heat>
                float inputs:motor_heat_L1
                float inputs:motor_heat_L1.connect = </SixWheelRover/Motor_L1.outputs:heat>
                float inputs:motor_heat_L2
                float inputs:motor_heat_L2.connect = </SixWheelRover/Motor_L2.outputs:heat>
                float inputs:motor_heat_R0
                float inputs:motor_heat_R0.connect = </SixWheelRover/Motor_R0.outputs:heat>
                float inputs:motor_heat_R1
                float inputs:motor_heat_R1.connect = </SixWheelRover/Motor_R1.outputs:heat>
                float inputs:motor_heat_R2
                float inputs:motor_heat_R2.connect = </SixWheelRover/Motor_R2.outputs:heat>
                float outputs:motor_temp_left
                float outputs:motor_temp_left.connect = </SixWheelRover/Thermal/MotorThermalLeft.outputs:temp_k>
                float outputs:motor_temp_right
