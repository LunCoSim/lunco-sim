#usda 1.0
(
    defaultPrim = "Rucheyok"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "Rucheyok" (
    documentation = "Solar-powered four-wheel lunar rover assembled from referenced wheels, battery, panel, and flight computer."
    kind = "assembly"
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxVehicleContextAPI", "LunCoCatalogAPI", "CollectionAPI:components"]
    prepend references = @lunco://components/mobility/drive_laws/modelica_skid.usda@</DriveLaw>
)
{
    uniform token lunco:steeringGeometry = "differential"
    uniform bool lunco:spawnable = true
    float physics:mass = 800.0
    float outputs:drive_left = 0.0
    float outputs:drive_right = 0.0
    float outputs:brake = 0.0
    uniform token collection:components:expansionRule = "explicitOnly"
    rel collection:components:includes
    prepend rel collection:components:includes = [</Rucheyok/Battery>, </Rucheyok/SolarPanel>, </Rucheyok/Motor_FL>, </Rucheyok/TorqueSource_FL>, </Rucheyok/Motor_FR>, </Rucheyok/TorqueSource_FR>, </Rucheyok/Motor_RL>, </Rucheyok/TorqueSource_RL>, </Rucheyok/Motor_RR>, </Rucheyok/TorqueSource_RR>, </Rucheyok/Gearbox_FL>, </Rucheyok/Gearbox_FR>, </Rucheyok/Gearbox_RL>, </Rucheyok/Gearbox_RR>, </Rucheyok/Shaft_FL>, </Rucheyok/Shaft_FR>, </Rucheyok/Shaft_RL>, </Rucheyok/Shaft_RR>]
    float inputs:drive_left
    float inputs:drive_left.connect = </Rucheyok.outputs:drive_left>
    float inputs:drive_right
    float inputs:drive_right.connect = </Rucheyok.outputs:drive_right>
    float inputs:shaft_speed_FL
    float inputs:shaft_speed_FL.connect = </Rucheyok/Wheel_FL.outputs:shaft_speed>
    float inputs:shaft_speed_FR
    float inputs:shaft_speed_FR.connect = </Rucheyok/Wheel_FR.outputs:shaft_speed>
    float inputs:shaft_speed_RL
    float inputs:shaft_speed_RL.connect = </Rucheyok/Wheel_RL.outputs:shaft_speed>
    float inputs:shaft_speed_RR
    float inputs:shaft_speed_RR.connect = </Rucheyok/Wheel_RR.outputs:shaft_speed>
    float outputs:soc
    float outputs:soc.connect = </Rucheyok/Battery.outputs:soc_out>
    float outputs:battery_drained
    float outputs:battery_drained.connect = </Rucheyok/Battery.outputs:drained>
    float outputs:solar_power
    float outputs:solar_power.connect = </Rucheyok/SolarPanel.outputs:power_out>
    float outputs:solar_incidence
    float outputs:solar_incidence.connect = </Rucheyok/SolarPanel.outputs:cos_incidence>
    def Camera "FrontCamera" (
        prepend references = @lunco://components/cameras/rover_front_camera.usda@</FrontCamera>
    )
    {
        double3 lunco:cameraLookAt = (0.0, 5.0, -40.0)
        double3 xformOp:translate = (0.0, 5.5, -8.0)
    }
    def "Controls" (
        prepend references = @lunco://vessels/control_profiles.usda@</RoverControls>
    )
    {
    }
    def Cube "Chassis" (
        kind = "subcomponent"
        prepend apiSchemas = "PhysicsCollisionAPI"
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0.0, 2.0, 0.0)
        double3 xformOp:scale = (15.0, 4.0, 20.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.7200000286102295, 0.3799999952316284, 0.18000000715255737)]
    }
    def Xform "SolarPanel" (
        prepend references = @lunco://components/power/solar_panel.usda@</SolarPanel>
    )
    {
        double3 xformOp:translate = (0.0, 4.5, 0.0)
        double3 xformOp:scale = (12.0, 0.2, 6.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.05000000074505806, 0.05000000074505806, 0.5)]
        float physics:mass = 15.0
        custom token connectors:p
        token connectors:p.connect = </Rucheyok/Battery.connectors:p>
        custom double inputs:target_mount_x
        double inputs:target_mount_x.connect = </Rucheyok/SolarPanel/Environment.outputs:sun_mount_x>
        custom double inputs:target_mount_y
        double inputs:target_mount_y.connect = </Rucheyok/SolarPanel/Environment.outputs:sun_mount_y>
        custom double inputs:target_mount_z
        double inputs:target_mount_z.connect = </Rucheyok/SolarPanel/Environment.outputs:sun_mount_z>
        def Xform "Environment" (
            prepend references = @lunco://components/environment/probe.usda@</EnvironmentProbe>
        )
        {
        }
    }
    def Xform "Battery" (
        prepend references = @lunco://components/power/battery.usda@</Battery>
    )
    {
        double3 xformOp:translate = (0.0, 2.0, 0.0)
        double3 xformOp:scale = (4.0, 0.8, 6.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.800000011920929, 0.20000000298023224, 0.20000000298023224)]
        float physics:mass = 50.0
    }
    def LunCoEvent "BatteryDrained"
    {
        uniform token lunco:event:name = "battery_drained"
        uniform token lunco:event:severity = "warning"
        uniform bool lunco:event:latched = true
        double lunco:event:qualificationTime = 0.0
        float inputs:trigger
        float inputs:trigger.connect = </Rucheyok.outputs:battery_drained>
    }
    def Cylinder "Wheel_FL" (
        prepend apiSchemas = ["PhysxVehicleWheelAttachmentAPI", "PhysxVehicleWheelAPI"]
        prepend references = [@lunco://components/mobility/wheel.usda@</Wheel>, @lunco://components/mobility/suspensions/rigid.usda@</Suspension>]
    )
    {
        uniform token axis = "Z"
        double radius = 2.0
        double height = 1.5
        double3 xformOp:translate = (-8.5, 0.0, -10.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.20000000298023224, 0.800000011920929, 0.20000000298023224)]
        int physxVehicleWheelAttachment:index = 0
        float physxVehicleWheel:moi = 6.800000190734863
        float physxVehicleWheel:radius = 2.0
        float physxVehicleWheel:mass = 25.0
        float inputs:drive
        float inputs:drive.connect = </Rucheyok/Shaft_FL.outputs:torque>
    }
    def Cylinder "Wheel_FR" (
        prepend apiSchemas = ["PhysxVehicleWheelAttachmentAPI", "PhysxVehicleWheelAPI"]
        prepend references = [@lunco://components/mobility/wheel.usda@</Wheel>, @lunco://components/mobility/suspensions/rigid.usda@</Suspension>]
    )
    {
