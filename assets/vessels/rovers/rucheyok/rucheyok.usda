        double radius = 2.0
        double height = 1.5
        double3 xformOp:translate = (8.5, 0.0, -10.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.20000000298023224, 0.800000011920929, 0.20000000298023224)]
        int physxVehicleWheelAttachment:index = 1
        float physxVehicleWheel:moi = 6.800000190734863
        float physxVehicleWheel:radius = 2.0
        float physxVehicleWheel:mass = 25.0
        float inputs:drive
        float inputs:drive.connect = </Rucheyok/Shaft_FR.outputs:torque>
    }
    def Cylinder "Wheel_RL" (
        prepend apiSchemas = ["PhysxVehicleWheelAttachmentAPI", "PhysxVehicleWheelAPI"]
        prepend references = [@lunco://components/mobility/wheel.usda@</Wheel>, @lunco://components/mobility/suspensions/rigid.usda@</Suspension>]
    )
    {
        uniform token axis = "Z"
        double radius = 2.0
        double height = 1.5
        double3 xformOp:translate = (-8.5, 0.0, 10.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.800000011920929, 0.20000000298023224, 0.20000000298023224)]
        int physxVehicleWheelAttachment:index = 2
        float physxVehicleWheel:moi = 6.800000190734863
        float physxVehicleWheel:radius = 2.0
        float physxVehicleWheel:mass = 25.0
        float inputs:drive
        float inputs:drive.connect = </Rucheyok/Shaft_RL.outputs:torque>
    }
    def Cylinder "Wheel_RR" (
        prepend apiSchemas = ["PhysxVehicleWheelAttachmentAPI", "PhysxVehicleWheelAPI"]
        prepend references = [@lunco://components/mobility/wheel.usda@</Wheel>, @lunco://components/mobility/suspensions/rigid.usda@</Suspension>]
    )
    {
        uniform token axis = "Z"
        double radius = 2.0
        double height = 1.5
        double3 xformOp:translate = (8.5, 0.0, 10.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.800000011920929, 0.20000000298023224, 0.20000000298023224)]
        int physxVehicleWheelAttachment:index = 3
        float physxVehicleWheel:moi = 6.800000190734863
        float physxVehicleWheel:radius = 2.0
        float physxVehicleWheel:mass = 25.0
        float inputs:drive
        float inputs:drive.connect = </Rucheyok/Shaft_RR.outputs:torque>
    }
    def Xform "Motor_FL" (
        prepend references = @lunco://components/mobility/motor.usda@</Motor>
    )
    {
        double3 xformOp:translate = (-5.5, 0.0, -10.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:demand
        float inputs:demand.connect = </Rucheyok.outputs:drive_left>
        custom token connectors:p
        token connectors:p.connect = </Rucheyok/Battery.connectors:p>
        float inputs:speed
        float inputs:speed.connect = </Rucheyok/Gearbox_FL.outputs:speed_a>
    }
    def Xform "TorqueSource_FL" (
        prepend references = @lunco://components/mobility/torque.usda@</Torque>
    )
    {
        float inputs:tau_ref
        float inputs:tau_ref.connect = </Rucheyok/Motor_FL.outputs:shaft_torque>
        custom token connectors:flange
        token connectors:flange.connect = </Rucheyok/Gearbox_FL.connectors:flange_a>
    }
    def Xform "Gearbox_FL" (
        prepend references = @lunco://components/mobility/gearbox.usda@</Gearbox>
    )
    {
        double3 xformOp:translate = (-6.0, 0.0, -10.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:ratio = 200.0
        float inputs:eta = 0.8500000238418579
        float inputs:max_output_torque = 400.0
        custom token connectors:flange_a
        token connectors:flange_a.connect = </Rucheyok/TorqueSource_FL.connectors:flange>
        custom token connectors:flange_b
        token connectors:flange_b.connect = </Rucheyok/Shaft_FL.connectors:flange>
    }
    def Xform "Motor_FR" (
