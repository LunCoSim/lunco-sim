#usda 1.0
(
    defaultPrim = "RockerBogie"
    upAxis = "Y"
    metersPerUnit = 1
)

# G5 — rocker-bogie chassis with a differential coupling.
#
# A complete physical joint-based rocker-bogie suspension with 6 motorized wheels:
#   - Two side rockers (RockerL/R) hinge to the chassis on the X axis.
#   - Two bogies (BogieL/R) hinge to the rear of the rockers on the X axis.
#   - Six wheels (FL/FR/ML/MR/RL/RR) reference the reusable motorized wheel components.
#   - The differential coupling enforces: θ_left + θ_right → 0.
#   - Controllable via keyboard/UI through PhysxVehicleAckermannSteeringAPI.
#
# FOR PARAMETER EDITING GUIDE: See the accompanying README.md in this directory.

def Xform "RockerBogie" (
    doc = "Perseverance-class six-wheel rocker-bogie Mars rover with articulated suspension and differential body leveling."
    # An ASSEMBLY: a model built out of other models. Its wheels are component models
    # that arrive by reference, and USD forbids a `component` from containing them.
    kind = "assembly"
    prepend apiSchemas = [
        "PhysicsRigidBodyAPI", "PhysxRigidBodyAPI",
        "PhysicsMassAPI",
        "PhysicsArticulationRootAPI",
        "PhysxVehicleContextAPI",
        "PhysxVehicleAckermannSteeringAPI", "LunCoCatalogAPI",
        "CollectionAPI:components"
    ]
    # The ON-BOARD COMPUTER, as a second reference arc — the rover's COMMAND
    # SURFACE (`throttle`/`steer`/`brake`). Ships with the chassis; without one
    # this rover accepts no commands at all. See `skid_rover.usda`.
    prepend references = @lunco://components/avionics/obc.usda@</OBC>
    prepend references = @lunco://components/cameras/rover_front_camera.usda@</RoverFrontCamera>
    prepend variantSets = ["power", "generation", "thermal"]
    variants = {
        string power = "infinite"
        string generation = "none"
        string thermal = "none"
    }
)
{
    uniform bool lunco:spawnable = true
    # --- VEHICLE MASS & DAMPING ---
    #
    # Perseverance reference envelope: 3.0 m long, 2.7 m wide over the wheel
    # skins, 2.2 m tall to the camera head, and approximately 1,025 kg ready to
    # drive. The shared body is 1.90 m wide × 1.00 m high × 3.00 m long; the six
    # 0.525 m wheels set the overall footprint and obstacle scale.
    #
    # The authored mass is the warm-electronics-box/chassis mass. Adding the two
    # rockers, two bogies, six wheels, six motors, six reductions, OBC and camera
    # hardware gives the Perseverance-class vehicle mass. Difficulty tiers change
    # only their authored drive and tire properties.
    float physics:mass = 720.0
    # 0.5 rad steering lock; strength 0.0 deliberately keeps the simple parallel
    # steering used by the current wheel actuator while retaining the authored
    # Ackermann vehicle contract.
    float physxVehicleAckermannSteering:maxSteerAngle = 0.5
    float physxVehicleAckermannSteering:strength = 0.0
    # ── THERE IS NO AIR. DRAG LIVES IN THE PARTS. ───────────────────────────
    # Body damping is a fluid model: a force proportional to velocity, applied to
    # the hull. It is kept near zero so the Mars-rover behavior comes from wheel
    # contact, bearing drag, and gearbox losses rather than an invented headwind.
    #
    # Both are now ~0 and the losses are authored where the hardware loses them:
    #   · `physxVehicleWheel:dampingRate` = 0.45 N·m·s per wheel — the sealed
    #     dry-lubricated bearing plus regolith rolling resistance (`wheel.usda`).
    #   · gearbox `inputs:eta` = 0.85 — a cold multi-stage harmonic drive.
    #   · tyre μ — lateral friction is what actually resists a yaw, and it does:
    #     with angular damping gone the rover still turns flat (2.8° peak roll
    #     under full steer at 0.6 throttle, measured) rather than spinning out.
    #
    # 0.05 rather than a hard 0 on the angular term: a rigid body with literally no
    # rotational damping is a solver liability, and 0.05 is small enough to be lost
    # in the bearing drag. It is a numerical floor, not a physical claim.
    #
    # The body damping is not the speed limiter; the authored motor and gearbox
    # parameters below own the vehicle's playable speed envelope.
    float physxRigidBody:linearDamping = 0.0
    float physxRigidBody:angularDamping = 0.05

    # The two bank actuator ports, as attributes the motors CONNECT to. Declaring
    # them here gives each `inputs:demand.connect` a real property to resolve to, so
    # the binding is PCP-resolved and path-translated through the reference arcs
    # instead of matched by name. Without them every `Motor_*` on this chassis wires
    # to a property that does not exist and the cosim bridge drops the value with
    # "connection targets unknown input port 'drive_left'" — the same declaration
    # `six_wheel_rover.usda` has always carried.
    float outputs:drive_left = 0.0
    float outputs:drive_right = 0.0
    float outputs:steering = 0.0
    float outputs:brake = 0.0

    # --- Telemetry: the vehicle's own ground speed ---
    # `speed` is a PHYSICS port (the magnitude of this body's linear velocity, from
    # the avian backend), not a model variable — which is why it is authored on the
    # chassis and not on a component: the chassis IS the rigid body being measured.
    #
    # It is the one number "is this rover moving, and how fast" needs, and reading it
    # from a single port beats plotting `velocity_x/y/z` and doing the arithmetic by
    # eye — those are world-frame, so a rover that turns hands its speed from one
    # trace to another.
    # Intent->port control (stage 2): shared rover profile as a child `references`
    # arc so it composes through a spawn/reference like the wheels.
    def "Controls" (
        prepend references = @lunco://vessels/control_profiles.usda@</RoverControls>
    )
    {
    }

    # A spawned rover owns an empty mission program from the start. Adding its
    # first waypoint then updates `info:sourceCode` in place instead of adding
    # `LunCoProgramAPI` at runtime, which would require a whole-scene rebuild
    # and reboot every already-spawned rover.
    def Scope "Mission" (
        prepend apiSchemas = ["LunCoProgramAPI"]
    )
    {
        uniform token info:implementationSource = "sourceCode"
        uniform string info:sourceCode = """<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence/>
  </BehaviorTree>
</root>"""
    }

    # --- CHASSIS GEOMETRY & VISUALS ---
    # Main body — the shared box chassis component (collider + panelised hull
    # material), referenced INTO this prim so the name `Body` and every local
    # opinion below survive. Its own scale wins over the component default.
    def Cube "Body" (
        prepend references = @lunco://components/mobility/chassis/box_chassis.usda@</Chassis>
    )
    {
        double3 xformOp:scale = (0.95, 0.5, 1.5)
        # NASA-ish white-grey — the science-platform archetype. Colour is
        # `primvars:displayColor` and nothing else; the hull shader consumes it
        # as the base paint.
        color3f[] primvars:displayColor = [(0.25, 0.26, 0.28)]
        # Gold accent, keeping the solar-foil heritage of the original body.
        over "HullLook"
        {
            over "Shader"
            {
                color3f inputs:accent_color = (0.85, 0.7, 0.2)
            }
        }
    }

    # Slanted Solar panel deck on top of the chassis
    def Cube "SolarDeck"
    {
        double size = 1.0
        double3 xformOp:translate = (0.0, 0.21, 0.0)
        double3 xformOp:scale = (1.05, 0.02, 1.4)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.05, 0.05, 0.2)]
        bool physics:collisionEnabled = false
    }

    # ── Rocker bearing housings: the body-side half of each hinge ────────────
    #
    # The rocker pivots sit at the lower outside corners of the 1.90 m-wide
    # equipment box. These housings are deliberately larger than the axle shafts
    # so the body-to-rocker attachment remains visible at rover scale. The
    # articulated rocker bodies and their authored hinges remain the sole physical
    # linkage.
    #
    # Structure, not a second mechanism: these are children of the CHASSIS and turn
    # with it, while the arm rotates about them. Collision is off — the rocker's own
    # `Collider` already occupies this volume, and a second body here would fight it.
    def Cylinder "RockerBearingL"
    {
        uniform token axis = "X"
        double radius = 0.16
        double height = 0.12
        double3 xformOp:translate = (-0.96, -0.2, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.55, 0.42, 0.16)]
        bool physics:collisionEnabled = false
    }

    def Cylinder "RockerBearingR"
    {
        uniform token axis = "X"
        double radius = 0.16
        double height = 0.12
        double3 xformOp:translate = (0.96, -0.2, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.55, 0.42, 0.16)]
        bool physics:collisionEnabled = false
    }

    # Shared Earth-tracking antenna. The component owns BOTH its hinges and its
    # mount: being a child of this chassis is the attachment, so there is no
    # antenna joint to author here.
    #
    # ⚠ THIS IS THE ROVER'S ONLY ANTENNA. A scene that wants a link node on a
    # rocker-bogie authors an `over "Antenna"` here — it does NOT add a second
    # antenna child.
    #
    # MOUNTED ON THE REAR DECK, on the centreline-left, clear of the forward
    # science mast at z = -0.6 (forward is -Z: that is where the headlights point).
    # s = 0.45 ⇒ a 0.52 m dish on a 0.5 m stalk — big enough to read as a high-gain
    # at rover scale, short enough to stay inside the roll envelope.
    def "Antenna" (
        prepend references = @lunco://components/comms/antenna.usda@</CommsAntenna>
    )
    {
        double3 xformOp:translate = (-0.35, 0.22, 0.6)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        over "Mast"
        {
            double radius = 0.02
            double height = 0.5
            double3 xformOp:translate = (0.0, 0.25, 0.0)
            color3f[] primvars:displayColor = [(0.30, 0.30, 0.32)]
        }
        over "YawHead"
        {
            double3 xformOp:translate = (0.0, 0.5, 0.0)
            over "DishGimbal"
            {
                over "DishHead"
                {
                    double3 xformOp:scale = (0.45, 0.45, 0.45)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                    over "LinkAperture"
                    {
                        string lunco:link:class = "rover"
                        bool lunco:wifiNode = true
                        double lunco:wifi:maxRangeM = 5000.0
                        over "LinkBeam"
                        {
                            over "Up"
                            {
                                over "Driver"
                                {
                                    custom float lunco:param:earthOnly = 1
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    # Instrument platform / science mast
    def Cylinder "Mast"
    {
        uniform token axis = "Y"
        double radius = 0.04
        double height = 1.0
        double3 xformOp:translate = (0.0, 0.6, -0.6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.30, 0.30, 0.32)]
        bool physics:collisionEnabled = false
    }

    def Cube "CameraHead"
    {
        double size = 1.0
        double3 xformOp:scale = (0.2, 0.15, 0.15)
        double3 xformOp:translate = (0.0, 1.18, -0.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.15, 0.15, 0.15)]
        bool physics:collisionEnabled = false
    }

    # Headlights
    def Xform "Headlight_L" (
        prepend references = @lunco://components/lights/headlight.usda@</Headlight>
    )
    {
        double3 xformOp:translate = (-0.5, 0.1, -0.9)
        double3 xformOp:rotateXYZ = (-15, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Xform "Headlight_R" (
        prepend references = @lunco://components/lights/headlight.usda@</Headlight>
    )
    {
        double3 xformOp:translate = (0.5, 0.1, -0.9)
        double3 xformOp:rotateXYZ = (-15, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    # ── Left rocker ─────────────────────────────────────────────────────────
    def Xform "RockerL" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        # Structural mass and diagonal inertia for the articulated rocker. These
        # authored values are part of the vehicle's physical envelope; the
        # differential constrains its hinge motion independently.
        float physics:mass = 50.0
        float3 physics:diagonalInertia = (30.0, 30.0, 3.0)
        # Hinge/bearing loss for the articulated arm. Without an authored
        # rotational loss the loaded rocker mode rings after each tire-contact
        # correction and makes the chassis bob at speed.
        float physxRigidBody:angularDamping = 0.1
        double3 xformOp:translate = (-0.99, -0.2, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        # Rocker main forward-down link (pivots down/forward to front wheel)
        # Length: 1.265m, Midpoint: (0.0, -0.2, -0.6), Rotated: +18.43 deg about X
        # Endpoints are the rocker hinge at (0, 0, 0) and the front axle at
        # (0, -0.4, -1.2) in this rocker frame.
        def Cylinder "FrontLink"
        {
            uniform token axis = "Z"
            double radius = 0.06
            double height = 1.265
            double3 xformOp:translate = (0.0, -0.2, -0.6)
            double3 xformOp:rotateXYZ = (18.43, 0.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
            color3f[] primvars:displayColor = [(0.35, 0.35, 0.38)]
            bool physics:collisionEnabled = false
        }

        # Rocker rear-down link (pivots down/backward to bogie hinge)
        # Length: 0.632m, Midpoint: (0.0, -0.1, 0.3), Rotated: 18.43 deg about X
        def Cylinder "RearLink"
        {
            uniform token axis = "Z"
            double radius = 0.06
            double height = 0.632
            double3 xformOp:translate = (0.0, -0.1, 0.3)
            double3 xformOp:rotateXYZ = (18.43, 0.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
            color3f[] primvars:displayColor = [(0.35, 0.35, 0.38)]
            bool physics:collisionEnabled = false
        }

        # Outward X-axis axle to front wheel
        def Cylinder "Axle"
        {
            uniform token axis = "X"
            double radius = 0.04
            double height = 0.25
            double3 xformOp:translate = (-0.125, -0.4, -1.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(0.30, 0.30, 0.32)]
            bool physics:collisionEnabled = false
        }

        # Rocker-side pivot hub. It overlaps the body-side bearing housing at the
        # authored hinge frame, making the leg-to-body attachment readable while
        # remaining a visual-only child of this rigid body.
        def Cylinder "RockerPivotHub"
        {
            uniform token axis = "X"
            double radius = 0.12
            double height = 0.2
            double3 xformOp:translate = (0.0, 0.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(0.85, 0.7, 0.2)]
            bool physics:collisionEnabled = false
        }

        # Simplified box collider for the rocker arm (clears the bogie space).
        # `visibility = "invisible"` — collision-only: the loader would otherwise
        # render this as a white bar (no displayColor → Color::WHITE fallback).
        def Cube "Collider" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1.0
            double3 xformOp:scale = (0.12, 0.12, 1.2)
            double3 xformOp:translate = (0.0, -0.2, -0.6)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            token visibility = "invisible"
            bool physics:collisionEnabled = true
        }

        # Front Left Wheel
        def Cylinder "Wheel_FL" (
            prepend apiSchemas = ["PhysxVehicleWheelAttachmentAPI", "PhysxVehicleWheelAPI"]
            prepend references = [
                @lunco://components/mobility/wheel.usda@</Wheel>,
                @lunco://components/mobility/suspensions/rocker.usda@</Suspension>,
            ]
        )
        {
            uniform token axis = "X"
            # Perseverance wheel: 0.525 m diameter × 0.18 m wide. Both the
            # UsdGeom radius and PhysX vehicle radius are authored because the
            # simulation reads the latter for contact and wheel inertia.
            double radius = 0.2625
            double height = 0.18
            float physxVehicleWheel:radius = 0.2625
            # A 1,500 N·m catalogue lock is an emergency brake for a much heavier
            # wheel and makes this articulated rover pitch over on a normal stop.
            # 100 N·m gives the wheel a finite, controllable stop authority.
            float physxVehicleWheel:maxBrakeTorque = 100.0
            # An aluminium spun wheel with a flexure sidewall, not the 25 kg
            # placeholder `wheel.usda` ships as its catalogue default.
            float physxVehicleWheel:mass = 12.0
            double3 xformOp:translate = (-0.3, -0.4, -1.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(0.15, 0.15, 0.15)]

            # --- WHEEL DYNAMICS CONFIGURATION ---
            int physxVehicleWheelAttachment:index = 0
            # Complete axle inertia for the authored motor, reduction, and tire assembly.
            # The 6.8 kg.m2 value is the composed USD mechanical contract.
            float physxVehicleWheel:moi = 6.8
            float inputs:drive.connect = </RockerBogie/RockerL/Shaft_FL.outputs:torque>
            float inputs:steer.connect = </RockerBogie.outputs:steering>
        }

        # Motor + reduction for the front-left wheel. A CHILD OF THE ROCKER, not of
        # the chassis: the rocker is its own rigid body, and a motor bolted to the
        # arm must swing with the arm. Placed inboard of the wheel so its housing
        # never overlaps the wheel collider.
        #
        #   τ_axle = stallTorque · (1 − ω_shaft/noLoadSpeed) · ratio · efficiency · demand
        # clamped at the gearbox's `maxOutputTorque`; axle no-load speed =
        # 2400/200 = 12 rad/s. The wheel's authored `inputs:drive` connection
        # selects the `drive_left` channel explicitly.
        def Xform "Motor_FL" (
            prepend references = @lunco://components/mobility/motor.usda@</Motor>
        )
        {
            # ── A DRIVE ACTUATOR LIVES ON THE AXLE IT TURNS ─────────────────────
            # Both housings are ON THE WHEEL'S AXIS — same y, same z as Wheel_FL —
            # with the rocker's own structure between them: motor bolted to the
            # arm's INBOARD face, harmonic drive on the OUTBOARD face driving the
            # hub. That is the MER/MSL arrangement and it is what the wiring
            # already claims (`drivenWheel` → this wheel, `Motor.outputs:torque` →
            # this gearbox).
            #
            # They used to sit at x = ±0.3/±0.15 — 0.9 m inboard of the wheel,
            # floating in the middle of the vehicle, driving a hub they did not
            # touch.
            #
            # ⚠ AND THEY MUST BE TURNED. `motor.usda`/`gearbox.usda` draw `Body` as
            # a bare `Cylinder` with no `axis`, so it defaults to Z — fore-and-aft,
            # broadside to the axle. The component cannot fix this: a wheel's axis
            # is the VESSEL's decision (Rucheyok's wheels are Z-forward), so the
            # rotation belongs on the instance, here, where `axis = "X"` is known.
            double3 xformOp:translate = (0.1, -0.4, -1.2)
            double3 xformOp:rotateXYZ = (0.0, 90.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
            float inputs:speed.connect = </RockerBogie/RockerL/Gearbox_FL.outputs:speed_a>
            float inputs:demand.connect = </RockerBogie.outputs:drive_left>

            # ── SPEED KNOB ────────────────────────────────────────────────────
            # The axle's free-spin cap is `noLoadSpeed / ratio`: 2400 / 200 =
            # 12 rad/s, or 3.15 m/s at the authored 0.2625 m wheel radius. This
            # remains the tutorial's playable envelope; torque, tire grip, and
            # contact losses determine the loaded speed below that ceiling.
            #
            # SPEED ONLY. `stallTorque` is untouched here — the axle torque
            # (stallTorque · 200 · 0.85) is set per tier in `variants/rover_*.usda`,
            # and it is the torque ladder (153 › 85 › 68 N·m) that now carries the
            # difficulty, sized against each tier's traction cone.
            float inputs:no_load_speed = 2400.0
        }

        def Xform "TorqueSource_FL" (
            prepend references = @lunco://components/mobility/torque.usda@</Torque>
        )
        {
            float inputs:tau_ref.connect = </RockerBogie/RockerL/Motor_FL.outputs:shaft_torque>
            custom token connectors:flange.connect = </RockerBogie/RockerL/Gearbox_FL.connectors:flange_a>
        }

        def Xform "Gearbox_FL" (
            prepend references = @lunco://components/mobility/gearbox.usda@</Gearbox>
        )
        {
            # Outboard face of the arm, on the axle, feeding the hub. See Motor_FL.
            double3 xformOp:translate = (-0.055, -0.4, -1.2)
            double3 xformOp:rotateXYZ = (0.0, 90.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
            float inputs:ratio = 200.0
            float inputs:eta = 0.85
            float inputs:max_output_torque = 400.0
            custom token connectors:flange_a.connect = </RockerBogie/RockerL/TorqueSource_FL.connectors:flange>
            custom token connectors:flange_b.connect = </RockerBogie/RockerL/Shaft_FL.connectors:flange>
        }

        def Xform "Shaft_FL" (prepend references = @lunco://components/mobility/avian_shaft.usda@</AvianShaft>)
        {
            float inputs:speed.connect = </RockerBogie.inputs:shaft_speed_FL>
        }
    }

    # ── Right rocker ────────────────────────────────────────────────────────
    def Xform "RockerR" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        # Structural mass and diagonal inertia for the articulated rocker. These
        # authored values are part of the vehicle's physical envelope; the
        # differential constrains its hinge motion independently.
        float physics:mass = 50.0
        float3 physics:diagonalInertia = (30.0, 30.0, 3.0)
        float physxRigidBody:angularDamping = 0.1
        double3 xformOp:translate = (0.99, -0.2, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cylinder "FrontLink"
        {
            uniform token axis = "Z"
            double radius = 0.06
            double height = 1.265
            double3 xformOp:translate = (0.0, -0.2, -0.6)
            double3 xformOp:rotateXYZ = (18.43, 0.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
            color3f[] primvars:displayColor = [(0.35, 0.35, 0.38)]
            bool physics:collisionEnabled = false
        }

        def Cylinder "RearLink"
        {
            uniform token axis = "Z"
            double radius = 0.06
            double height = 0.632
            double3 xformOp:translate = (0.0, -0.1, 0.3)
            double3 xformOp:rotateXYZ = (18.43, 0.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
            color3f[] primvars:displayColor = [(0.35, 0.35, 0.38)]
            bool physics:collisionEnabled = false
        }

        def Cylinder "Axle"
        {
            uniform token axis = "X"
            double radius = 0.04
            double height = 0.25
            double3 xformOp:translate = (0.125, -0.4, -1.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(0.30, 0.30, 0.32)]
            bool physics:collisionEnabled = false
        }

        def Cylinder "RockerPivotHub"
        {
            uniform token axis = "X"
            double radius = 0.12
            double height = 0.2
            double3 xformOp:translate = (0.0, 0.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(0.85, 0.7, 0.2)]
            bool physics:collisionEnabled = false
        }

        # Simplified box collider for the rocker arm (clears the bogie space).
        # `visibility = "invisible"` — collision-only: the loader would otherwise
        # render this as a white bar (no displayColor → Color::WHITE fallback).
        def Cube "Collider" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1.0
            double3 xformOp:scale = (0.12, 0.12, 1.2)
            double3 xformOp:translate = (0.0, -0.2, -0.6)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            token visibility = "invisible"
            bool physics:collisionEnabled = true
        }

        # Front Right Wheel
        def Cylinder "Wheel_FR" (
            prepend apiSchemas = ["PhysxVehicleWheelAttachmentAPI", "PhysxVehicleWheelAPI"]
            prepend references = [
                @lunco://components/mobility/wheel.usda@</Wheel>,
                @lunco://components/mobility/suspensions/rocker.usda@</Suspension>,
            ]
        )
        {
            uniform token axis = "X"
            double radius = 0.2625
            double height = 0.18
            float physxVehicleWheel:radius = 0.2625
            float physxVehicleWheel:maxBrakeTorque = 100.0
            float physxVehicleWheel:mass = 12.0
            double3 xformOp:translate = (0.3, -0.4, -1.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(0.15, 0.15, 0.15)]

            int physxVehicleWheelAttachment:index = 1
            # Complete axle inertia for the authored motor, reduction, and tire assembly.
            # The 6.8 kg.m2 value is the composed USD mechanical contract.
            float physxVehicleWheel:moi = 6.8
            float inputs:drive.connect = </RockerBogie/RockerR/Shaft_FR.outputs:torque>
            float inputs:steer.connect = </RockerBogie.outputs:steering>
        }

        # Wheel index 1 is odd ⇒ `drive_right`. Mirror of the left rocker.
        def Xform "Motor_FR" (
            prepend references = @lunco://components/mobility/motor.usda@</Motor>
        )
        {
            # Mirror of the left arm — on the axle, arm between motor and gearbox,
            # both turned onto X. See Motor_FL.
            double3 xformOp:translate = (-0.1, -0.4, -1.2)
            double3 xformOp:rotateXYZ = (0.0, 90.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
            float inputs:speed.connect = </RockerBogie/RockerR/Gearbox_FR.outputs:speed_a>
            float inputs:demand.connect = </RockerBogie.outputs:drive_right>
            # 12.9 km/h measured — see Motor_FL. All six must
            # agree, or the fast wheels drag the slow ones and every wheel scrubs.
            float inputs:no_load_speed = 2400.0
        }

        def Xform "TorqueSource_FR" (
            prepend references = @lunco://components/mobility/torque.usda@</Torque>
        )
        {
            float inputs:tau_ref.connect = </RockerBogie/RockerR/Motor_FR.outputs:shaft_torque>
            custom token connectors:flange.connect = </RockerBogie/RockerR/Gearbox_FR.connectors:flange_a>
        }

        def Xform "Gearbox_FR" (
            prepend references = @lunco://components/mobility/gearbox.usda@</Gearbox>
        )
        {
            double3 xformOp:translate = (0.055, -0.4, -1.2)
            double3 xformOp:rotateXYZ = (0.0, 90.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
            float inputs:ratio = 200.0
            float inputs:eta = 0.85
            float inputs:max_output_torque = 400.0
            custom token connectors:flange_a.connect = </RockerBogie/RockerR/TorqueSource_FR.connectors:flange>
            custom token connectors:flange_b.connect = </RockerBogie/RockerR/Shaft_FR.connectors:flange>
        }

        def Xform "Shaft_FR" (prepend references = @lunco://components/mobility/avian_shaft.usda@</AvianShaft>)
        {
            float inputs:speed.connect = </RockerBogie.inputs:shaft_speed_FR>
        }
    }

