#usda 1.0
(
    defaultPrim = "RockerBogie"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "RockerBogie" (
    documentation = "Perseverance-class six-wheel rocker-bogie Mars rover with articulated suspension and differential body leveling."
    kind = "assembly"
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI", "PhysxVehicleContextAPI", "LunCoCatalogAPI", "CollectionAPI:components"]
    prepend references = @lunco://components/mobility/drive_laws/modelica_ackermann.usda@</DriveLaw>
    prepend variantSets = ["power", "generation", "thermal"]
    variants = { string "generation" = "none"; string "power" = "infinite"; string "thermal" = "none" }
)
{
    uniform token lunco:steeringGeometry = "ackermann"
    uniform bool lunco:spawnable = true
    float physics:mass = 720.0
    float physxRigidBody:linearDamping = 0.0
    float physxRigidBody:angularDamping = 0.05000000074505806
    float outputs:drive_left = 0.0
    float outputs:drive_right = 0.0
    float outputs:heading_fl = 0.0
    float outputs:heading_fr = 0.0
    float outputs:brake = 0.0
    variantSet "power" = {
        "infinite" {
            uniform token collection:components:expansionRule = "explicitOnly"
            rel collection:components:includes
            prepend rel collection:components:includes = [</RockerBogie/PowerSource>, </RockerBogie/RockerL/Motor_FL>, </RockerBogie/RockerL/TorqueSource_FL>, </RockerBogie/BogieL/Motor_ML>, </RockerBogie/BogieL/TorqueSource_ML>, </RockerBogie/BogieL/Motor_RL>, </RockerBogie/BogieL/TorqueSource_RL>, </RockerBogie/RockerR/Motor_FR>, </RockerBogie/RockerR/TorqueSource_FR>, </RockerBogie/BogieR/Motor_MR>, </RockerBogie/BogieR/TorqueSource_MR>, </RockerBogie/BogieR/Motor_RR>, </RockerBogie/BogieR/TorqueSource_RR>, </RockerBogie/RockerL/Gearbox_FL>, </RockerBogie/RockerR/Gearbox_FR>, </RockerBogie/BogieL/Gearbox_ML>, </RockerBogie/BogieL/Gearbox_RL>, </RockerBogie/BogieR/Gearbox_MR>, </RockerBogie/BogieR/Gearbox_RR>, </RockerBogie/RockerL/Shaft_FL>, </RockerBogie/RockerR/Shaft_FR>, </RockerBogie/BogieL/Shaft_ML>, </RockerBogie/BogieL/Shaft_RL>, </RockerBogie/BogieR/Shaft_MR>, </RockerBogie/BogieR/Shaft_RR>]
            float inputs:drive_left
            float inputs:drive_left.connect = </RockerBogie.outputs:drive_left>
            float inputs:drive_right
            float inputs:drive_right.connect = </RockerBogie.outputs:drive_right>
            float inputs:shaft_speed_FL
            float inputs:shaft_speed_FL.connect = </RockerBogie/RockerL/Wheel_FL.outputs:shaft_speed>
            float inputs:shaft_speed_FR
            float inputs:shaft_speed_FR.connect = </RockerBogie/RockerR/Wheel_FR.outputs:shaft_speed>
            float inputs:shaft_speed_ML
            float inputs:shaft_speed_ML.connect = </RockerBogie/BogieL/Wheel_ML.outputs:shaft_speed>
            float inputs:shaft_speed_RL
            float inputs:shaft_speed_RL.connect = </RockerBogie/BogieL/Wheel_RL.outputs:shaft_speed>
            float inputs:shaft_speed_MR
            float inputs:shaft_speed_MR.connect = </RockerBogie/BogieR/Wheel_MR.outputs:shaft_speed>
            float inputs:shaft_speed_RR
            float inputs:shaft_speed_RR.connect = </RockerBogie/BogieR/Wheel_RR.outputs:shaft_speed>
            float outputs:bus_voltage
            float outputs:bus_voltage.connect = </RockerBogie/PowerSource.outputs:terminal_voltage_v>
            float outputs:bus_current
            float outputs:bus_current.connect = </RockerBogie/PowerSource.outputs:terminal_current_a>
            float outputs:bus_power
            float outputs:bus_power.connect = </RockerBogie/PowerSource.outputs:terminal_power_w>
            over "Battery"
            {
                bool active = false
            }
            def Xform "PowerSource" (
                prepend references = @lunco://components/power/ideal_voltage_source.usda@</IdealVoltageSource>
            )
            {
            }
            over "RockerL"
            {
                over "Motor_FL"
                {
                    float inputs:demand
                    float inputs:demand.connect = </RockerBogie.inputs:drive_left>
                    custom token connectors:p
                    token connectors:p.connect = </RockerBogie/PowerSource.connectors:p>
                }
            }
            over "BogieL"
            {
                over "Motor_ML"
                {
                    float inputs:demand
                    float inputs:demand.connect = </RockerBogie.inputs:drive_left>
                    custom token connectors:p
                    token connectors:p.connect = </RockerBogie/PowerSource.connectors:p>
                }
                over "Motor_RL"
                {
                    float inputs:demand
                    float inputs:demand.connect = </RockerBogie.inputs:drive_left>
                    custom token connectors:p
                    token connectors:p.connect = </RockerBogie/PowerSource.connectors:p>
                }
            }
            over "RockerR"
            {
                over "Motor_FR"
                {
                    float inputs:demand
                    float inputs:demand.connect = </RockerBogie.inputs:drive_right>
                    custom token connectors:p
                    token connectors:p.connect = </RockerBogie/PowerSource.connectors:p>
                }
            }
            over "BogieR"
            {
                over "Motor_MR"
                {
                    float inputs:demand
                    float inputs:demand.connect = </RockerBogie.inputs:drive_right>
                    custom token connectors:p
                    token connectors:p.connect = </RockerBogie/PowerSource.connectors:p>
                }
                over "Motor_RR"
                {
                    float inputs:demand
                    float inputs:demand.connect = </RockerBogie.inputs:drive_right>
                    custom token connectors:p
                    token connectors:p.connect = </RockerBogie/PowerSource.connectors:p>
                }
            }
        }
        "battery" {
            uniform token collection:components:expansionRule = "explicitOnly"
            rel collection:components:includes
            prepend rel collection:components:includes = [</RockerBogie/Battery>, </RockerBogie/RockerL/Motor_FL>, </RockerBogie/RockerL/TorqueSource_FL>, </RockerBogie/BogieL/Motor_ML>, </RockerBogie/BogieL/TorqueSource_ML>, </RockerBogie/BogieL/Motor_RL>, </RockerBogie/BogieL/TorqueSource_RL>, </RockerBogie/RockerR/Motor_FR>, </RockerBogie/RockerR/TorqueSource_FR>, </RockerBogie/BogieR/Motor_MR>, </RockerBogie/BogieR/TorqueSource_MR>, </RockerBogie/BogieR/Motor_RR>, </RockerBogie/BogieR/TorqueSource_RR>, </RockerBogie/RockerL/Gearbox_FL>, </RockerBogie/RockerR/Gearbox_FR>, </RockerBogie/BogieL/Gearbox_ML>, </RockerBogie/BogieL/Gearbox_RL>, </RockerBogie/BogieR/Gearbox_MR>, </RockerBogie/BogieR/Gearbox_RR>, </RockerBogie/RockerL/Shaft_FL>, </RockerBogie/RockerR/Shaft_FR>, </RockerBogie/BogieL/Shaft_ML>, </RockerBogie/BogieL/Shaft_RL>, </RockerBogie/BogieR/Shaft_MR>, </RockerBogie/BogieR/Shaft_RR>]
            float inputs:drive_left
            float inputs:drive_left.connect = </RockerBogie.outputs:drive_left>
            float inputs:drive_right
            float inputs:drive_right.connect = </RockerBogie.outputs:drive_right>
            float inputs:shaft_speed_FL
            float inputs:shaft_speed_FL.connect = </RockerBogie/RockerL/Wheel_FL.outputs:shaft_speed>
            float inputs:shaft_speed_FR
            float inputs:shaft_speed_FR.connect = </RockerBogie/RockerR/Wheel_FR.outputs:shaft_speed>
            float inputs:shaft_speed_ML
            float inputs:shaft_speed_ML.connect = </RockerBogie/BogieL/Wheel_ML.outputs:shaft_speed>
            float inputs:shaft_speed_RL
            float inputs:shaft_speed_RL.connect = </RockerBogie/BogieL/Wheel_RL.outputs:shaft_speed>
            float inputs:shaft_speed_MR
            float inputs:shaft_speed_MR.connect = </RockerBogie/BogieR/Wheel_MR.outputs:shaft_speed>
            float inputs:shaft_speed_RR
            float inputs:shaft_speed_RR.connect = </RockerBogie/BogieR/Wheel_RR.outputs:shaft_speed>
            float outputs:soc
            float outputs:soc.connect = </RockerBogie/Battery.outputs:soc_out>
            float outputs:battery_drained
            float outputs:battery_drained.connect = </RockerBogie/Battery.outputs:drained>
            float outputs:bus_voltage
            float outputs:bus_voltage.connect = </RockerBogie/Battery.outputs:terminal_voltage_v>
            float outputs:bus_current
            float outputs:bus_current.connect = </RockerBogie/Battery.outputs:terminal_current_a>
            float outputs:bus_power
            float outputs:bus_power.connect = </RockerBogie/Battery.outputs:net_power_w>
            float outputs:battery_net_power
            float outputs:battery_net_power.connect = </RockerBogie/Battery.outputs:net_power_w>
            float outputs:battery_charge_power
            float outputs:battery_charge_power.connect = </RockerBogie/Battery.outputs:charge_power_w>
            float outputs:battery_discharge_power
            float outputs:battery_discharge_power.connect = </RockerBogie/Battery.outputs:discharge_power_w>
            float outputs:motor_electrical_power
            float outputs:motor_electrical_power.connect = </RockerBogie/RockerL/Motor_FL.outputs:electrical_power>
            float outputs:motor_mechanical_power
            float outputs:motor_mechanical_power.connect = </RockerBogie/RockerL/Motor_FL.outputs:mechanical_power_w>
            float outputs:motor_terminal_current
            float outputs:motor_terminal_current.connect = </RockerBogie/RockerL/Motor_FL.outputs:terminal_current_a>
            over "RockerL"
            {
                over "Motor_FL"
                {
                    float inputs:demand
                    float inputs:demand.connect = </RockerBogie.inputs:drive_left>
                    custom token connectors:p
                    token connectors:p.connect = </RockerBogie/Battery.connectors:p>
                }
            }
            over "BogieL"
            {
                over "Motor_ML"
                {
                    float inputs:demand
                    float inputs:demand.connect = </RockerBogie.inputs:drive_left>
                    custom token connectors:p
                    token connectors:p.connect = </RockerBogie/Battery.connectors:p>
                }
                over "Motor_RL"
                {
                    float inputs:demand
                    float inputs:demand.connect = </RockerBogie.inputs:drive_left>
                    custom token connectors:p
                    token connectors:p.connect = </RockerBogie/Battery.connectors:p>
                }
            }
            over "RockerR"
            {
                over "Motor_FR"
                {
                    float inputs:demand
                    float inputs:demand.connect = </RockerBogie.inputs:drive_right>
                    custom token connectors:p
                    token connectors:p.connect = </RockerBogie/Battery.connectors:p>
                }
            }
            over "BogieR"
            {
                over "Motor_MR"
                {
                    float inputs:demand
                    float inputs:demand.connect = </RockerBogie.inputs:drive_right>
                    custom token connectors:p
                    token connectors:p.connect = </RockerBogie/Battery.connectors:p>
                }
                over "Motor_RR"
                {
                    float inputs:demand
                    float inputs:demand.connect = </RockerBogie.inputs:drive_right>
                    custom token connectors:p
                    token connectors:p.connect = </RockerBogie/Battery.connectors:p>
                }
            }
            def LunCoEvent "BatteryDrained"
            {
                uniform token lunco:event:name = "battery_drained"
                uniform token lunco:event:severity = "warning"
                uniform bool lunco:event:latched = true
                double lunco:event:qualificationTime = 0.0
                float inputs:trigger
                float inputs:trigger.connect = </RockerBogie.outputs:battery_drained>
            }
        }
    }
    variantSet "generation" = {
        "none" {
        }
        "solar" {
            rel collection:components:includes
            prepend rel collection:components:includes = </RockerBogie/SolarPanel>
            float outputs:solar_power
            float outputs:solar_power.connect = </RockerBogie/SolarPanel.outputs:power_out>
            float outputs:solar_available_power
            float outputs:solar_available_power.connect = </RockerBogie/SolarPanel.outputs:available_power_w>
            float outputs:solar_incidence
            float outputs:solar_incidence.connect = </RockerBogie/SolarPanel.outputs:cos_incidence>
            def Xform "SolarPanel" (
                prepend references = @lunco://components/power/solar_panel.usda@</SolarPanel>
            )
            {
                double3 xformOp:translate = (0.0, 0.55, 0.0)
                double3 xformOp:scale = (0.42, 0.2, 0.42)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                custom token connectors:p
                token connectors:p.connect = </RockerBogie/Battery.connectors:p>
                custom double inputs:target_mount_x
                double inputs:target_mount_x.connect = </RockerBogie/SolarPanel/Environment.outputs:sun_mount_x>
                custom double inputs:target_mount_y
                double inputs:target_mount_y.connect = </RockerBogie/SolarPanel/Environment.outputs:sun_mount_y>
                custom double inputs:target_mount_z
                double inputs:target_mount_z.connect = </RockerBogie/SolarPanel/Environment.outputs:sun_mount_z>
                def Xform "Environment" (
                    prepend references = @lunco://components/environment/probe.usda@</EnvironmentProbe>
                )
                {
                }
            }
        }
    }
    variantSet "thermal" = {
        "none" {
        }
        "basic" {
            def Scope "Thermal" (
                prepend apiSchemas = "CollectionAPI:components"
                documentation = "Rover thermal control network: motor dissipation → masses → radiators."
            )
            {
                uniform token collection:components:expansionRule = "explicitOnly"
                rel collection:components:includes
                prepend rel collection:components:includes = [</RockerBogie/Thermal/MotorHeat_FL>, </RockerBogie/Thermal/MotorHeat_ML>, </RockerBogie/Thermal/MotorHeat_RL>, </RockerBogie/Thermal/MotorHeat_FR>, </RockerBogie/Thermal/MotorHeat_MR>, </RockerBogie/Thermal/MotorHeat_RR>, </RockerBogie/Thermal/MotorThermalLeft>, </RockerBogie/Thermal/MotorThermalRight>, </RockerBogie/Thermal/MotorRadiatorLeft>, </RockerBogie/Thermal/MotorRadiatorRight>, </RockerBogie/Thermal/ThermalBridge>]
                float inputs:motor_heat_FL
                float inputs:motor_heat_FL.connect = </RockerBogie/RockerL/Motor_FL.outputs:heat>
                float inputs:motor_heat_ML
                float inputs:motor_heat_ML.connect = </RockerBogie/BogieL/Motor_ML.outputs:heat>
                float inputs:motor_heat_RL
                float inputs:motor_heat_RL.connect = </RockerBogie/BogieL/Motor_RL.outputs:heat>
                float inputs:motor_heat_FR
                float inputs:motor_heat_FR.connect = </RockerBogie/RockerR/Motor_FR.outputs:heat>
                float inputs:motor_heat_MR
                float inputs:motor_heat_MR.connect = </RockerBogie/BogieR/Motor_MR.outputs:heat>
                float inputs:motor_heat_RR
                float inputs:motor_heat_RR.connect = </RockerBogie/BogieR/Motor_RR.outputs:heat>
                float outputs:motor_temp_left
                float outputs:motor_temp_left.connect = </RockerBogie/Thermal/MotorThermalLeft.outputs:temp_k>
                float outputs:motor_temp_right
                float outputs:motor_temp_right.connect = </RockerBogie/Thermal/MotorThermalRight.outputs:temp_k>
                def Xform "ThermalBridge" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</ThermalConductor>
                )
                {
                    custom token connectors:port_a
                    token connectors:port_a.connect = </RockerBogie/Thermal/MotorThermalLeft.connectors:port>
                    custom token connectors:port_b
                    token connectors:port_b.connect = </RockerBogie/Thermal/MotorThermalRight.connectors:port>
                }
                def Xform "MotorHeat_FL" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorHeatLoad>
                )
                {
                    float inputs:heat_w
                    float inputs:heat_w.connect = </RockerBogie/Thermal.inputs:motor_heat_FL>
                    custom token connectors:port
                    token connectors:port.connect = </RockerBogie/Thermal/MotorThermalLeft.connectors:port>
                }
                def Xform "MotorHeat_ML" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorHeatLoad>
                )
                {
                    float inputs:heat_w
                    float inputs:heat_w.connect = </RockerBogie/Thermal.inputs:motor_heat_ML>
                    custom token connectors:port
                    token connectors:port.connect = </RockerBogie/Thermal/MotorThermalLeft.connectors:port>
                }
                def Xform "MotorHeat_RL" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorHeatLoad>
                )
                {
                    float inputs:heat_w
                    float inputs:heat_w.connect = </RockerBogie/Thermal.inputs:motor_heat_RL>
                    custom token connectors:port
                    token connectors:port.connect = </RockerBogie/Thermal/MotorThermalLeft.connectors:port>
                }
                def Xform "MotorThermalLeft" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorThermalMass>
                )
                {
                }
                def Xform "MotorRadiatorLeft" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorRadiator>
                )
                {
                    custom token connectors:port
                    token connectors:port.connect = </RockerBogie/Thermal/MotorThermalLeft.connectors:port>
                }
                def Xform "MotorHeat_FR" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorHeatLoad>
                )
                {
                    float inputs:heat_w
                    float inputs:heat_w.connect = </RockerBogie/Thermal.inputs:motor_heat_FR>
                    custom token connectors:port
                    token connectors:port.connect = </RockerBogie/Thermal/MotorThermalRight.connectors:port>
                }
                def Xform "MotorHeat_MR" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorHeatLoad>
                )
                {
                    float inputs:heat_w
                    float inputs:heat_w.connect = </RockerBogie/Thermal.inputs:motor_heat_MR>
                    custom token connectors:port
                    token connectors:port.connect = </RockerBogie/Thermal/MotorThermalRight.connectors:port>
                }
                def Xform "MotorHeat_RR" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorHeatLoad>
                )
                {
                    float inputs:heat_w
                    float inputs:heat_w.connect = </RockerBogie/Thermal.inputs:motor_heat_RR>
                    custom token connectors:port
                    token connectors:port.connect = </RockerBogie/Thermal/MotorThermalRight.connectors:port>
                }
                def Xform "MotorThermalRight" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorThermalMass>
                )
                {
                }
                def Xform "MotorRadiatorRight" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorRadiator>
                )
                {
                    custom token connectors:port
                    token connectors:port.connect = </RockerBogie/Thermal/MotorThermalRight.connectors:port>
                }
            }
        }
    }
    def Camera "FrontCamera" (
        prepend references = @lunco://components/cameras/rover_front_camera.usda@</FrontCamera>
    )
    {
    }
    def "Controls" (
        prepend references = @lunco://vessels/control_profiles.usda@</RoverControls>
    )
    {
    }
    def Cube "Body" (
        prepend references = @lunco://components/mobility/chassis/box_chassis.usda@</Chassis>
    )
    {
        double3 xformOp:scale = (1.9, 0.5, 1.5)
        color3f[] primvars:displayColor = [(0.25, 0.25999999046325684, 0.2800000011920929)]
        over "HullLook"
        {
            over "Shader"
            {
                color3f inputs:accent_color = (0.8500000238418579, 0.699999988079071, 0.20000000298023224)
            }
        }
    }
    def Cube "SolarDeck"
    {
        double size = 1.0
        double3 xformOp:translate = (0.0, 0.21, 0.0)
        double3 xformOp:scale = (1.05, 0.02, 1.4)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.05000000074505806, 0.05000000074505806, 0.20000000298023224)]
        bool physics:collisionEnabled = false
    }
    def Cylinder "RockerBearingL"
    {
        uniform token axis = "X"
        double radius = 0.16
        double height = 0.12
        double3 xformOp:translate = (-0.96, -0.2, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.550000011920929, 0.41999998688697815, 0.1599999964237213)]
        bool physics:collisionEnabled = false
    }
    def Cylinder "RockerBearingR"
    {
        uniform token axis = "X"
        double radius = 0.16
        double height = 0.12
        double3 xformOp:translate = (0.96, -0.2, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.550000011920929, 0.41999998688697815, 0.1599999964237213)]
        bool physics:collisionEnabled = false
    }
    def "Antenna" (
        prepend references = @lunco://components/comms/antenna.usda@</CommsAntenna>
    )
    {
        double3 xformOp:translate = (-0.35, 0.22, 0.6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "Mast"
        {
            double radius = 0.02
            double height = 0.5
            double3 xformOp:translate = (0.0, 0.25, 0.0)
            color3f[] primvars:displayColor = [(0.30000001192092896, 0.30000001192092896, 0.3199999928474426)]
        }
        over "YawHead"
        {
            double3 xformOp:translate = (0.0, 0.5, 0.0)
            over "DishGimbal"
            {
                over "DishHead"
                {
                    double3 xformOp:scale = (0.45, 0.45, 0.45)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                    over "LinkAperture"
                    {
                        string lunco:link:class = "rover"
                        over "LinkBeam"
                        {
                            over "Up"
                            {
                                over "Driver"
                                {
                                    custom float lunco:param:earthOnly = 1.0
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    def Xform "WifiRadio" (
        prepend references = @lunco://components/comms/wifi_radio.usda@</WifiRadio>
    )
    {
        double3 xformOp:translate = (0.0, 0.22, 0.35)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cylinder "Mast"
    {
        uniform token axis = "Y"
        double radius = 0.04
        double height = 1.0
        double3 xformOp:translate = (0.0, 0.6, -0.6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.30000001192092896, 0.30000001192092896, 0.3199999928474426)]
        bool physics:collisionEnabled = false
    }
    def Cube "CameraHead"
    {
        double size = 1.0
        double3 xformOp:scale = (0.2, 0.15, 0.15)
        double3 xformOp:translate = (0.0, 1.18, -0.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.15000000596046448, 0.15000000596046448, 0.15000000596046448)]
        bool physics:collisionEnabled = false
    }
    def Xform "Headlight_L" (
        prepend references = @lunco://components/lights/headlight.usda@</Headlight>
    )
    {
        double3 xformOp:translate = (-0.5, 0.1, -0.9)
        double3 xformOp:rotateXYZ = (-15.0, 0.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
