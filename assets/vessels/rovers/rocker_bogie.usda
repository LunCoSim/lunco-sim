    # All joints below DELIBERATELY omit `physics:localPos0`/`localPos1`: each body's
    # placement is already its `xformOp:translate`, and the avian joint reader DERIVES
    # the anchor from the composed world poses (body1's origin in body0's rotation
    # frame; anchor on body1 = origin). This works for the sibling rocker↔bogie hinges
    # and the scaled hierarchy, so no anchor is typed — or left to drift — twice.
    # Author a `localPos0` on a joint to override the derivation.
    #
    # ── Lateral-axis revolute hinges (chassis ↔ rocker) ─────────────────────
    # HingeL/R: chassis <-> rocker joints.
    # NASA MER/MSL use mechanical stops limiting rocker travel to +/-30 to +/-45 degrees.
    # We use +/-30 degrees to keep the chassis level and prevent differential lockup.
    def PhysicsRevoluteJoint "HingeL" (
        doc = "Chassis-to-rocker hinge. Limited to +/-30 deg to match NASA mechanical stops, preventing excessive chassis roll and differential lockup."
    )
    {
        rel physics:body0 = </RockerBogie>
        rel physics:body1 = </RockerBogie/RockerL>
        uniform token physics:axis = "X"
        float physics:lowerLimit = -30
        float physics:upperLimit = 30
    }
    def PhysicsRevoluteJoint "HingeR" (
        doc = "Chassis-to-rocker hinge. Limited to +/-30 deg to match NASA mechanical stops, preventing excessive chassis roll and differential lockup."
    )
    {
        rel physics:body0 = </RockerBogie>
        rel physics:body1 = </RockerBogie/RockerR>
        uniform token physics:axis = "X"
        float physics:lowerLimit = -30
        float physics:upperLimit = 30
    }

    # ── Differential coupling (rocker-bogie holonomic constraint) ───────────
    # The standard PhysX gear joint over the two chassis↔rocker hinges: it couples
    # θ_left + θ_right → restSum (the drive's targetPosition), so the chassis pitch
    # tracks the rocker average instead of flopping on a free pitch DOF.
    #
    # `solve_differential_gear` projects this relation with an implicit
    # spring-damper solve in Avian's substep solver. The positive stiffness value
    # is the authored engagement state; zero disables the gear in the control
    # scene.
    def PhysxPhysicsGearJoint "Differential" (
        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
    )
    {
        rel physxGearJoint:hinge0 = </RockerBogie/HingeL>
        rel physxGearJoint:hinge1 = </RockerBogie/HingeR>
        float physxGearJoint:gearRatio = -1.0
        float drive:angular:physics:targetPosition = 0.0
        float drive:angular:physics:stiffness = 100000.0
    }

    # ── Lateral-axis revolute hinges (rocker ↔ bogie) ───────────────────────
    # BogieHingeL/R: rocker <-> bogie joints.
    # NASA rovers limit bogie rotation to +/-20 to +/-30 degrees to prevent the
    # middle/rear wheels from colliding with the rocker frame or chassis belly.
    # We use +/-20 degrees as a safe operating envelope.
    def PhysicsRevoluteJoint "BogieHingeL" (
        doc = "Rocker-to-bogie hinge. Limited to +/-20 deg to match NASA stops, preventing middle/rear wheels from colliding with the rocker frame."
    )
    {
        rel physics:body0 = </RockerBogie/RockerL>
        rel physics:body1 = </RockerBogie/BogieL>
        uniform token physics:axis = "X"
        float physics:lowerLimit = -20
        float physics:upperLimit = 20
    }
    def PhysicsRevoluteJoint "BogieHingeR" (
        doc = "Rocker-to-bogie hinge. Limited to +/-20 deg to match NASA stops, preventing middle/rear wheels from colliding with the rocker frame."
    )
    {
        rel physics:body0 = </RockerBogie/RockerR>
        rel physics:body1 = </RockerBogie/BogieR>
        uniform token physics:axis = "X"
        float physics:lowerLimit = -20
        float physics:upperLimit = 20
    }

    # The six wheels intentionally have NO revolute joints. They are raycast
    # wheels, so their authored rocker suspension supplies the compliant normal
    # load while the rocker/bogie bodies and the four structural hinges above
    # remain real Avian rigid bodies. A wheel revolute would promote each tire to
    # a second rigid body and bypass the suspension component entirely.

    # --- Drive law -----------------------------------------------------------
    # HOW throttle/steer become actuator values is COMPOSITION, not an
    # enumeration. The plain authored state is the built-in linear Ackermann
    # kernel: both drive banks receive throttle and the steering port drives the
    # front wheel actuators. For a solver-clocked per-side motor lag, compose an
    # authored drive law on this same vehicle:
    #
    #   def "Rover" (
    #       prepend references = [
    #           @lunco://vessels/rovers/rocker_bogie.usda@</RockerBogie>,
    #           @lunco://components/mobility/drive_laws/modelica_skid.usda@</DriveLaw>,
    #       ]
    #   ) {}
    #
    # Each wheel authors its `inputs:drive` connection to one of the two drive-bank
    # ports. The channel assignment is USD topology, not an index heuristic.

    # --- Power: does driving cost anything ----------------------------------
    # ORTHOGONAL to the drive law: `infinite` deactivates the finite-storage
    # component, while `battery` keeps it active and composes the reusable
    # six-motor electrical network into one Modelica DAE. The reference stays
    # in the stable chassis namespace so USD remaps its authored relationships
    # through every power realization.
    #
    # Same two sets `six_wheel_rover.usda` carries, because the difficulty tiers
    # (`variants/rover_*.usda`) sit on THIS chassis now and a tier must not lose a
    # capability by changing suspension.
    def Xform "Battery" (
        prepend references = @lunco://components/power/battery.usda@</Battery>
    )
    {
        double3 xformOp:translate = (0, 0.35, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    variantSet "power" = {
        "infinite" {
            over "Battery" {
                bool active = false
            }
            def Xform "PowerSource" (
                prepend references = @lunco://components/power/ideal_voltage_source.usda@</IdealVoltageSource>
            )
            {
            }
            float inputs:drive_left.connect = </RockerBogie.outputs:drive_left>
            float inputs:drive_right.connect = </RockerBogie.outputs:drive_right>
            float inputs:shaft_speed_FL.connect = </RockerBogie/RockerL/Wheel_FL.outputs:shaft_speed>
            float inputs:shaft_speed_FR.connect = </RockerBogie/RockerR/Wheel_FR.outputs:shaft_speed>
            float inputs:shaft_speed_ML.connect = </RockerBogie/BogieL/Wheel_ML.outputs:shaft_speed>
            float inputs:shaft_speed_RL.connect = </RockerBogie/BogieL/Wheel_RL.outputs:shaft_speed>
            float inputs:shaft_speed_MR.connect = </RockerBogie/BogieR/Wheel_MR.outputs:shaft_speed>
            float inputs:shaft_speed_RR.connect = </RockerBogie/BogieR/Wheel_RR.outputs:shaft_speed>
            float outputs:bus_voltage.connect = </RockerBogie/PowerSource.outputs:terminal_voltage_v>
            float outputs:bus_current.connect = </RockerBogie/PowerSource.outputs:terminal_current_a>
            float outputs:bus_power.connect = </RockerBogie/PowerSource.outputs:terminal_power_w>
            uniform token collection:components:expansionRule = "explicitOnly"
            prepend rel collection:components:includes = [
                </RockerBogie/PowerSource>,
                </RockerBogie/RockerL/Motor_FL>,
                </RockerBogie/RockerL/TorqueSource_FL>,
                </RockerBogie/BogieL/Motor_ML>,
                </RockerBogie/BogieL/TorqueSource_ML>,
                </RockerBogie/BogieL/Motor_RL>,
                </RockerBogie/BogieL/TorqueSource_RL>,
                </RockerBogie/RockerR/Motor_FR>,
                </RockerBogie/RockerR/TorqueSource_FR>,
                </RockerBogie/BogieR/Motor_MR>,
                </RockerBogie/BogieR/TorqueSource_MR>,
                </RockerBogie/BogieR/Motor_RR>,
                </RockerBogie/BogieR/TorqueSource_RR>,
                </RockerBogie/RockerL/Gearbox_FL>,
                </RockerBogie/RockerR/Gearbox_FR>,
                </RockerBogie/BogieL/Gearbox_ML>,
                </RockerBogie/BogieL/Gearbox_RL>,
                </RockerBogie/BogieR/Gearbox_MR>,
                </RockerBogie/BogieR/Gearbox_RR>,
                </RockerBogie/RockerL/Shaft_FL>,
                </RockerBogie/RockerR/Shaft_FR>,
                </RockerBogie/BogieL/Shaft_ML>,
                </RockerBogie/BogieL/Shaft_RL>,
                </RockerBogie/BogieR/Shaft_MR>,
                </RockerBogie/BogieR/Shaft_RR>,
            ]
            over "RockerL" {
                over "Motor_FL" {
                    float inputs:demand.connect = </RockerBogie.inputs:drive_left>
                    custom token connectors:p.connect = </RockerBogie/PowerSource.connectors:p>
                }
            }
            over "BogieL" {
                over "Motor_ML" {
                    float inputs:demand.connect = </RockerBogie.inputs:drive_left>
                    custom token connectors:p.connect = </RockerBogie/PowerSource.connectors:p>
                }
                over "Motor_RL" {
                    float inputs:demand.connect = </RockerBogie.inputs:drive_left>
                    custom token connectors:p.connect = </RockerBogie/PowerSource.connectors:p>
                }
            }
            over "RockerR" {
                over "Motor_FR" {
                    float inputs:demand.connect = </RockerBogie.inputs:drive_right>
                    custom token connectors:p.connect = </RockerBogie/PowerSource.connectors:p>
                }
            }
            over "BogieR" {
                over "Motor_MR" {
                    float inputs:demand.connect = </RockerBogie.inputs:drive_right>
                    custom token connectors:p.connect = </RockerBogie/PowerSource.connectors:p>
                }
                over "Motor_RR" {
                    float inputs:demand.connect = </RockerBogie.inputs:drive_right>
                    custom token connectors:p.connect = </RockerBogie/PowerSource.connectors:p>
                }
            }
        }

        "battery" {
            float inputs:drive_left.connect = </RockerBogie.outputs:drive_left>
            float inputs:drive_right.connect = </RockerBogie.outputs:drive_right>
            float inputs:shaft_speed_FL.connect = </RockerBogie/RockerL/Wheel_FL.outputs:shaft_speed>
            float inputs:shaft_speed_FR.connect = </RockerBogie/RockerR/Wheel_FR.outputs:shaft_speed>
            float inputs:shaft_speed_ML.connect = </RockerBogie/BogieL/Wheel_ML.outputs:shaft_speed>
            float inputs:shaft_speed_RL.connect = </RockerBogie/BogieL/Wheel_RL.outputs:shaft_speed>
            float inputs:shaft_speed_MR.connect = </RockerBogie/BogieR/Wheel_MR.outputs:shaft_speed>
            float inputs:shaft_speed_RR.connect = </RockerBogie/BogieR/Wheel_RR.outputs:shaft_speed>
            float outputs:soc.connect = </RockerBogie/Battery.outputs:soc_out>
            float outputs:battery_drained.connect = </RockerBogie/Battery.outputs:drained>
            float outputs:bus_voltage.connect = </RockerBogie/Battery.outputs:terminal_voltage_v>
            float outputs:bus_current.connect = </RockerBogie/Battery.outputs:terminal_current_a>
            float outputs:bus_power.connect = </RockerBogie/Battery.outputs:net_power_w>
            float outputs:battery_net_power.connect = </RockerBogie/Battery.outputs:net_power_w>
            float outputs:battery_charge_power.connect = </RockerBogie/Battery.outputs:charge_power_w>
            float outputs:battery_discharge_power.connect = </RockerBogie/Battery.outputs:discharge_power_w>
            # These are authored network-boundary observables for the
            # front-left actuator. Consumers read the typed Electrical
            # surface; they never depend on generated Modelica member
            # identifiers, which are implementation details of the
            # synthesized wrapper.
            float outputs:motor_electrical_power.connect = </RockerBogie/RockerL/Motor_FL.outputs:electrical_power>
            float outputs:motor_mechanical_power.connect = </RockerBogie/RockerL/Motor_FL.outputs:mechanical_power_w>
            float outputs:motor_terminal_current.connect = </RockerBogie/RockerL/Motor_FL.outputs:terminal_current_a>
            uniform token collection:components:expansionRule = "explicitOnly"
            prepend rel collection:components:includes = [
                </RockerBogie/Battery>,
                </RockerBogie/RockerL/Motor_FL>,
                </RockerBogie/RockerL/TorqueSource_FL>,
                </RockerBogie/BogieL/Motor_ML>,
                </RockerBogie/BogieL/TorqueSource_ML>,
                </RockerBogie/BogieL/Motor_RL>,
                </RockerBogie/BogieL/TorqueSource_RL>,
                </RockerBogie/RockerR/Motor_FR>,
                </RockerBogie/RockerR/TorqueSource_FR>,
                </RockerBogie/BogieR/Motor_MR>,
                </RockerBogie/BogieR/TorqueSource_MR>,
                </RockerBogie/BogieR/Motor_RR>,
                </RockerBogie/BogieR/TorqueSource_RR>,
                </RockerBogie/RockerL/Gearbox_FL>,
                </RockerBogie/RockerR/Gearbox_FR>,
                </RockerBogie/BogieL/Gearbox_ML>,
                </RockerBogie/BogieL/Gearbox_RL>,
                </RockerBogie/BogieR/Gearbox_MR>,
                </RockerBogie/BogieR/Gearbox_RR>,
                </RockerBogie/RockerL/Shaft_FL>,
                </RockerBogie/RockerR/Shaft_FR>,
                </RockerBogie/BogieL/Shaft_ML>,
                </RockerBogie/BogieL/Shaft_RL>,
                </RockerBogie/BogieR/Shaft_MR>,
                </RockerBogie/BogieR/Shaft_RR>,
            ]
            over "RockerL" {
                over "Motor_FL" {
                    float inputs:demand.connect = </RockerBogie.inputs:drive_left>
                    custom token connectors:p.connect = </RockerBogie/Battery.connectors:p>
                }
            }
            over "BogieL" {
                over "Motor_ML" {
                    float inputs:demand.connect = </RockerBogie.inputs:drive_left>
                    custom token connectors:p.connect = </RockerBogie/Battery.connectors:p>
                }
                over "Motor_RL" {
                    float inputs:demand.connect = </RockerBogie.inputs:drive_left>
                    custom token connectors:p.connect = </RockerBogie/Battery.connectors:p>
                }
            }
            over "RockerR" {
                over "Motor_FR" {
                    float inputs:demand.connect = </RockerBogie.inputs:drive_right>
                    custom token connectors:p.connect = </RockerBogie/Battery.connectors:p>
                }
            }
            over "BogieR" {
                over "Motor_MR" {
                    float inputs:demand.connect = </RockerBogie.inputs:drive_right>
                    custom token connectors:p.connect = </RockerBogie/Battery.connectors:p>
                }
                over "Motor_RR" {
                    float inputs:demand.connect = </RockerBogie.inputs:drive_right>
                    custom token connectors:p.connect = </RockerBogie/Battery.connectors:p>
                }
            }

            def LunCoEvent "BatteryDrained" {
                float inputs:trigger.connect = </RockerBogie.outputs:battery_drained>
                uniform token lunco:event:name = "battery_drained"
                uniform token lunco:event:severity = "warning"
                uniform bool lunco:event:latched = true
                double lunco:event:qualificationTime = 0.0
            }

        }
    }

    variantSet "generation" = {
        "none" {
        }

        "solar" {
            # ONE spec per prim, per layer. The bus connection below used to be a
            # sibling `over "SolarPanel"` next to this `def`, and the `over` won:
            # the composed panel kept `connectors:p` and lost EVERYTHING the `def`
            # brought — the reference, the children, `LunCoProgramAPI`,
            # `info:sourceAsset`. `read_network` then skips a member with no
            # program API, and the runtime blames the collection instead:
            # `SolarPanel is outside the rover-root collection`. See
            # `sibling_over_does_not_erase_a_def_in_the_same_layer`.
            def Xform "SolarPanel" (
                prepend references = @lunco://components/power/solar_panel.usda@</SolarPanel>
            )
            {
                double3 xformOp:translate = (0, 0.55, 0)
                double3 xformOp:scale = (0.42, 0.2, 0.42)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]

                # The acausal tie to the battery belongs HERE, in the `def` that
                # introduces the panel — not in a sibling `over "SolarPanel"` in the
                # same variant block. Two specs for one prim inside one variant is
                # authoring the same opinion twice and relying on the merge; state it
                # once, where the prim is declared.
                custom token connectors:p.connect = </RockerBogie/Battery.connectors:p>
                float inputs:sun_mount_x.connect = </RockerBogie.inputs:sun_mount_x>
                float inputs:sun_mount_y.connect = </RockerBogie.inputs:sun_mount_y>
                float inputs:sun_mount_z.connect = </RockerBogie.inputs:sun_mount_z>

                def Xform "Environment" (
                    prepend references = @lunco://components/environment/probe.usda@</EnvironmentProbe>
                )
                {
                }
            }
                # Environment probes are runtime providers, not generated
                # Modelica members. Cross the island boundary through typed
                # inputs, then let the panel consume those boundary values.
                float inputs:sun_mount_x.connect = </RockerBogie/SolarPanel/Environment.outputs:sun_mount_x>
                float inputs:sun_mount_y.connect = </RockerBogie/SolarPanel/Environment.outputs:sun_mount_y>
                float inputs:sun_mount_z.connect = </RockerBogie/SolarPanel/Environment.outputs:sun_mount_z>
                float outputs:solar_power.connect = </RockerBogie/SolarPanel.outputs:power_out>
                float outputs:solar_available_power.connect = </RockerBogie/SolarPanel.outputs:available_power_w>
                float outputs:solar_incidence.connect = </RockerBogie/SolarPanel.outputs:cos_incidence>
                prepend rel collection:components:includes = [</RockerBogie/SolarPanel>]
        }
    }

    # --- Thermal: a SEPARATE domain layer, not a graft onto Electrical ------
    # `none` is EMPTY. `basic` composes a self-contained `Scope "Thermal"` — its
    # OWN `CollectionAPI:components`, compiled to its OWN generated DAE — and
    # couples to the electrical island by CAUSAL cross-domain wires only:
    # each motor's `outputs:heat` (solved by the electrical DAE) feeds a
    # `MotorHeatLoad.inputs:heat_w` here as a runtime SimConnection. The acausal
    # `connectors:port` edges stay INSIDE this thermal collection. An explicit
    # chassis ThermalConductor joins the two banks, which lets thermal compile
    # as one physically connected DAE independently of electrical — including
    # when `power != "battery"` (no electrical island at all). All six motors
    # get a heat-load bridge; `ML`/`MR` are no longer silently dropped.
    variantSet "thermal" = {
        "none" {
        }

        "basic" {
            def Scope "Thermal" (
                prepend apiSchemas = ["CollectionAPI:components"]
                doc = "Rover thermal control network: motor dissipation → masses → radiators."
            )
            {
                # ── Causal boundary IN: one heat wire per driven wheel ──
                # Solved by the electrical island and routed here at runtime.
                # With `power="infinite"` these resolve to the motors' authored
                # `outputs:heat` directly (still 0 for an uncommanded motor); the
                # thermal island compiles and runs regardless.
                # Thermal consumes the solved motor outputs directly. The
                # generated electrical wrapper resolves these member addresses;
                # no rover-root heat aliases are needed.
                float inputs:motor_heat_FL.connect = </RockerBogie/RockerL/Motor_FL.outputs:heat>
                float inputs:motor_heat_ML.connect = </RockerBogie/BogieL/Motor_ML.outputs:heat>
                float inputs:motor_heat_RL.connect = </RockerBogie/BogieL/Motor_RL.outputs:heat>
                float inputs:motor_heat_FR.connect = </RockerBogie/RockerR/Motor_FR.outputs:heat>
                float inputs:motor_heat_MR.connect = </RockerBogie/BogieR/Motor_MR.outputs:heat>
                float inputs:motor_heat_RR.connect = </RockerBogie/BogieR/Motor_RR.outputs:heat>

                # ── Causal boundary OUT: bank temperatures published HERE ──
                float outputs:motor_temp_left.connect  = </RockerBogie/Thermal/MotorThermalLeft.outputs:temp_k>
                float outputs:motor_temp_right.connect = </RockerBogie/Thermal/MotorThermalRight.outputs:temp_k>

                uniform token collection:components:expansionRule = "explicitOnly"
                prepend rel collection:components:includes = [
                    </RockerBogie/Thermal/MotorHeat_FL>,
                    </RockerBogie/Thermal/MotorHeat_ML>,
                    </RockerBogie/Thermal/MotorHeat_RL>,
                    </RockerBogie/Thermal/MotorHeat_FR>,
                    </RockerBogie/Thermal/MotorHeat_MR>,
                    </RockerBogie/Thermal/MotorHeat_RR>,
                    </RockerBogie/Thermal/MotorThermalLeft>,
                    </RockerBogie/Thermal/MotorThermalRight>,
                    </RockerBogie/Thermal/MotorRadiatorLeft>,
                    </RockerBogie/Thermal/MotorRadiatorRight>,
                    </RockerBogie/Thermal/ThermalBridge>,
                ]

                def Xform "ThermalBridge" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</ThermalConductor>
                )
                {
                    custom token connectors:port_a.connect = </RockerBogie/Thermal/MotorThermalLeft.connectors:port>
                    custom token connectors:port_b.connect = </RockerBogie/Thermal/MotorThermalRight.connectors:port>
                }

                # ── Left bank: three heat loads into one mass/radiator node ──
                def Xform "MotorHeat_FL" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorHeatLoad>
                )
                {
                    float inputs:heat_w.connect = </RockerBogie/Thermal.inputs:motor_heat_FL>
                    custom token connectors:port.connect = </RockerBogie/Thermal/MotorThermalLeft.connectors:port>
                }
                def Xform "MotorHeat_ML" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorHeatLoad>
                )
                {
                    float inputs:heat_w.connect = </RockerBogie/Thermal.inputs:motor_heat_ML>
                    custom token connectors:port.connect = </RockerBogie/Thermal/MotorThermalLeft.connectors:port>
                }
                def Xform "MotorHeat_RL" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorHeatLoad>
                )
                {
                    float inputs:heat_w.connect = </RockerBogie/Thermal.inputs:motor_heat_RL>
                    custom token connectors:port.connect = </RockerBogie/Thermal/MotorThermalLeft.connectors:port>
                }
                def Xform "MotorThermalLeft" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorThermalMass>
                )
                {
                }
                def Xform "MotorRadiatorLeft" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorRadiator>
                )
                {
                    custom token connectors:port.connect = </RockerBogie/Thermal/MotorThermalLeft.connectors:port>
                }

                # ── Right bank: three heat loads into one mass/radiator node ──
                def Xform "MotorHeat_FR" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorHeatLoad>
                )
                {
                    float inputs:heat_w.connect = </RockerBogie/Thermal.inputs:motor_heat_FR>
                    custom token connectors:port.connect = </RockerBogie/Thermal/MotorThermalRight.connectors:port>
                }
                def Xform "MotorHeat_MR" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorHeatLoad>
                )
                {
                    float inputs:heat_w.connect = </RockerBogie/Thermal.inputs:motor_heat_MR>
                    custom token connectors:port.connect = </RockerBogie/Thermal/MotorThermalRight.connectors:port>
                }
                def Xform "MotorHeat_RR" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorHeatLoad>
                )
                {
                    float inputs:heat_w.connect = </RockerBogie/Thermal.inputs:motor_heat_RR>
                    custom token connectors:port.connect = </RockerBogie/Thermal/MotorThermalRight.connectors:port>
                }
                def Xform "MotorThermalRight" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorThermalMass>
                )
                {
                }
                def Xform "MotorRadiatorRight" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorRadiator>
                )
                {
                    custom token connectors:port.connect = </RockerBogie/Thermal/MotorThermalRight.connectors:port>
                }
            }
        }
    }
}
