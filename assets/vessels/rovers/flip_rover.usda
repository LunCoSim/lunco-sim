#usda 1.0
(
    defaultPrim = "FLIP"
    upAxis = "Y"
    metersPerUnit = 1
)

# Astrolab FLIP four-wheel study proxy.
#
# This is a thin maintained composition layer, not a copied rover. The shared
# skid-rover asset owns the wheel, drivetrain, battery, solar, camera, and
# Modelica component contracts. FLIP owns its public identity, envelope,
# payload deck, sensor mast, and study values here. Replace proxy values only
# at this asset/component owner when as-built data becomes available.
def Xform "FLIP" (
    doc = "Astrolab FLIP four-wheel lunar rover study proxy with an explicit payload deck and sensor mast."
    kind = "assembly"
    prepend apiSchemas = ["LunCoCatalogAPI"]
    prepend references = @lunco://vessels/rovers/skid_rover.usda@</SkidRover>
    variants = {
        string drivetrain = "raycast"
        string power = "battery"
        string generation = "solar"
        string thermal = "none"
    }
)
{
    uniform bool lunco:spawnable = true
    custom string lunco:mission:payload = "Astrolab FLIP"
    custom string lunco:mission:vehicle_family = "FLEX Lunar Innovation Platform"
    custom string lunco:configuration = "four-wheel skid-steer study proxy"
    custom string lunco:parameter_status = "public envelope plus explicit simulator assumptions"
    custom string lunco:provenance:source = "https://www.astrolab.space/flip-rover/"
    custom string lunco:provenance:engineering_boundary = "replace proxy values with FLIP as-built CAD and test data"

    # FLIP study envelope and mass properties. The shared base remains the
    # physical owner; these explicit opinions replace its compact-rover values.
    float physics:mass = 450.0
    float3 physics:centerOfMass = (0.0, -0.05, 0.0)
    float3 physics:diagonalInertia = (240.0, 337.5, 145.5)
    float physxRigidBody:linearDamping = 0.5
    float physxRigidBody:angularDamping = 2.0

    over "Chassis"
    {
        double3 xformOp:scale = (2.4, 0.42, 3.15)
        color3f[] primvars:displayColor = [(0.20, 0.24, 0.28)]
    }

    over "Suspension_FL"
    {
        double3 xformOp:translate = (-0.95, -0.55, -1.05)
    }
    over "Suspension_FR"
    {
        double3 xformOp:translate = (0.95, -0.55, -1.05)
    }
    over "Suspension_RL"
    {
        double3 xformOp:translate = (-0.95, -0.55, 1.05)
    }
    over "Suspension_RR"
    {
        double3 xformOp:translate = (0.95, -0.55, 1.05)
    }

    # The wheel component owns the standard wheel facts; FLIP owns this
    # vehicle's wheel-size and axle-moment opinions.
    over "Suspension_FL/Wheel_FL"
    {
        float physxVehicleWheel:radius = 0.45
        float physxVehicleWheel:width = 0.28
        float physxVehicleWheel:moi = 3.4
    }
    over "Suspension_FR/Wheel_FR"
    {
        float physxVehicleWheel:radius = 0.45
        float physxVehicleWheel:width = 0.28
        float physxVehicleWheel:moi = 3.4
    }
    over "Suspension_RL/Wheel_RL"
    {
        float physxVehicleWheel:radius = 0.45
        float physxVehicleWheel:width = 0.28
        float physxVehicleWheel:moi = 3.4
    }
    over "Suspension_RR/Wheel_RR"
    {
        float physxVehicleWheel:radius = 0.45
        float physxVehicleWheel:width = 0.28
        float physxVehicleWheel:moi = 3.4
    }

    # FLIP-specific payload interface. These shapes are deliberately simple
    # authored study geometry; the generic collision owner projects them under
    # the single FLIP body inherited from the shared rover.
    def Cube "PayloadDeck" (
        prepend apiSchemas = "PhysicsCollisionAPI"
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0.0, 0.38, 0.0)
        double3 xformOp:scale = (1.45, 0.08, 0.95)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.48, 0.50, 0.52)]
        bool physics:collisionEnabled = true
    }

    def Xform "SensorMast"
    {
        def Cylinder "Post"
        {
            double radius = 0.06
            double height = 0.55
            double3 xformOp:translate = (0.0, 0.78, -0.25)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(0.35, 0.37, 0.40)]
            bool physics:collisionEnabled = false
        }
        def Cube "SensorBar"
        {
            double size = 1.0
            double3 xformOp:translate = (0.0, 1.08, -0.25)
            double3 xformOp:scale = (0.42, 0.06, 0.08)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.12, 0.14, 0.16)]
            bool physics:collisionEnabled = false
        }
    }

    # The current base solar variant is a fixed, body-mounted power proxy.
    # Articulated panel body/joint promotion remains the separate Editor task.
    over "SolarPanel"
    {
        custom string lunco:installation = "body-mounted photovoltaic study proxy; articulated deployment is not asserted here"
        float inputs:area = 4.8
        float inputs:efficiency = 0.30
        double3 xformOp:translate = (0.0, 0.45, 1.05)
        double3 xformOp:scale = (0.39, 0.03, 0.39)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
