#usda 1.0
(
    defaultPrim = "SixWheelIndependent"
    upAxis = "Y"
    metersPerUnit = 1
)

# Six-wheel rover with INDEPENDENT per-wheel drive — the full G4 + G4b stack:
#   * G4 extensible port set: six `outputs:drive_w0..outputs:drive_w5` attributes
#     on the root declare custom actuator ports (beyond the canonical
#     drive_left/right/...); the reader discovers them by scanning `outputs:`.
#   * G4 per-wheel binding: each wheel connects `inputs:drive` to its own port —
#     a real USD connection, so it is path-translated through reference arcs and
#     binds to its own instance's port rather than to a like-named prim.
#   * G4b authored controller: the Modelica/Rhai command policy maps
#     (throttle, steer) onto all six channels — left bank `+steer`, right bank
#     `−steer` (skid motion realised through six independent motors). The
#     per-wheel output connections are explicit, so every channel is editable.
#
# The drivetrain is the authored controller, so adding a 7th wheel or re-routing
# a channel is a one-line USD edit. `PhysxVehicleContextAPI` still provides the
# generic produced-port surface.

def Xform "SixWheelIndependent" (
    doc = "Six-wheel lunar rover whose individual motor channels and drive mix are authored as USD connections."
    # An ASSEMBLY: a model built out of other models. Its wheels are component models
    # that arrive by reference, and USD forbids a `component` from containing them.
    kind = "assembly"
    prepend apiSchemas = [
        "PhysicsRigidBodyAPI", "PhysxRigidBodyAPI",
        "PhysicsMassAPI",
        "PhysxVehicleContextAPI", "LunCoCatalogAPI", "CollectionAPI:components"
    ]
    # The ON-BOARD COMPUTER, as a second reference arc — the rover's COMMAND
    # SURFACE (`throttle`/`steer`/`brake`). Ships with the chassis; without one
    # this rover accepts no commands at all. See `skid_rover.usda`.
    prepend references = @lunco://components/avionics/obc.usda@</OBC>
    prepend references = @lunco://components/mobility/drive_laws/modelica_six_independent.usda@</DriveLaw>
)
{
    def Camera "FrontCamera" (
        prepend references = @lunco://components/cameras/rover_front_camera.usda@</FrontCamera>
    )
    {
        # The rover drives along -Z. Keep the operator eye at solar-panel
        # height behind the chassis so the forward view includes the body and
        # the path ahead, rather than looking outward from the front bumper.
        double3 xformOp:translate = (0.0, 0.55, 4.0)
        custom double3 lunco:cameraLookAt = (0.0, 0.75, -12.0)
    }

    uniform bool lunco:spawnable = true
    float physics:mass = 1400.0
    float physxRigidBody:linearDamping = 0.5
    float physxRigidBody:angularDamping = 2.0
    float3 physics:diagonalInertia = (2400.0, 3000.0, 1200.0)
    float3 physics:centerOfMass = (0.0, -0.1, 0.0)

    # Intent->port control (stage 2): shared rover profile as a child `references`
    # arc so it composes through a spawn/reference like the wheels.
    def "Controls" (
        prepend references = @lunco://vessels/control_profiles.usda@</RoverControls>
    )
    {
    }

    # G4 — six custom actuator ports (one per wheel). A port IS an attribute: each
    # wheel binds to one with a USD connection (`inputs:drive.connect`), so the set
    # is declared once here and the bindings are PCP-resolved rather than matched by
    # name.
    float outputs:drive_w0 = 0.0
    float outputs:drive_w1 = 0.0
    float outputs:drive_w2 = 0.0
    float outputs:drive_w3 = 0.0
    float outputs:drive_w4 = 0.0
    float outputs:drive_w5 = 0.0
    float outputs:brake = 0.0

    # --- Power: the independent channels share one authored electrical rail ---
    # The source and all six motor/mechanical islands are in one collection, so
    # the solver sees the actual load topology rather than a Rust-side motor
    # shortcut. A finite source may replace this branch without changing any
    # actuator or wheel code.
    def Xform "PowerSource" (
        prepend references = @lunco://components/power/ideal_voltage_source.usda@</IdealVoltageSource>
    )
    {
    }
    # The rover root owns the explicit component collection and its causal
    # boundary. There is no extra domain-name prim in the USD hierarchy.
        float inputs:drive_w0.connect = </SixWheelIndependent.outputs:drive_w0>
        float inputs:drive_w1.connect = </SixWheelIndependent.outputs:drive_w1>
        float inputs:drive_w2.connect = </SixWheelIndependent.outputs:drive_w2>
        float inputs:drive_w3.connect = </SixWheelIndependent.outputs:drive_w3>
        float inputs:drive_w4.connect = </SixWheelIndependent.outputs:drive_w4>
        float inputs:drive_w5.connect = </SixWheelIndependent.outputs:drive_w5>
        float inputs:shaft_speed_L0.connect = </SixWheelIndependent/Wheel_L0.outputs:shaft_speed>
        float inputs:shaft_speed_L1.connect = </SixWheelIndependent/Wheel_L1.outputs:shaft_speed>
        float inputs:shaft_speed_L2.connect = </SixWheelIndependent/Wheel_L2.outputs:shaft_speed>
        float inputs:shaft_speed_R0.connect = </SixWheelIndependent/Wheel_R0.outputs:shaft_speed>
        float inputs:shaft_speed_R1.connect = </SixWheelIndependent/Wheel_R1.outputs:shaft_speed>
        float inputs:shaft_speed_R2.connect = </SixWheelIndependent/Wheel_R2.outputs:shaft_speed>
        float outputs:bus_voltage.connect = </SixWheelIndependent/PowerSource.outputs:terminal_voltage_v>
        float outputs:bus_current.connect = </SixWheelIndependent/PowerSource.outputs:terminal_current_a>
        float outputs:bus_power.connect = </SixWheelIndependent/PowerSource.outputs:terminal_power_w>
        uniform token collection:components:expansionRule = "explicitOnly"
        prepend rel collection:components:includes = [
            </SixWheelIndependent/PowerSource>,
            </SixWheelIndependent/Motor_L0>,
                </SixWheelIndependent/TorqueSource_L0>,
            </SixWheelIndependent/Motor_L1>,
                </SixWheelIndependent/TorqueSource_L1>,
            </SixWheelIndependent/Motor_L2>,
                </SixWheelIndependent/TorqueSource_L2>,
            </SixWheelIndependent/Motor_R0>,
                </SixWheelIndependent/TorqueSource_R0>,
            </SixWheelIndependent/Motor_R1>,
                </SixWheelIndependent/TorqueSource_R1>,
            </SixWheelIndependent/Motor_R2>,
                </SixWheelIndependent/TorqueSource_R2>,
            </SixWheelIndependent/Gearbox_L0>,
            </SixWheelIndependent/Gearbox_L1>,
            </SixWheelIndependent/Gearbox_L2>,
            </SixWheelIndependent/Gearbox_R0>,
            </SixWheelIndependent/Gearbox_R1>,
            </SixWheelIndependent/Gearbox_R2>,
            </SixWheelIndependent/Shaft_L0>,
            </SixWheelIndependent/Shaft_L1>,
            </SixWheelIndependent/Shaft_L2>,
            </SixWheelIndependent/Shaft_R0>,
            </SixWheelIndependent/Shaft_R1>,
            </SixWheelIndependent/Shaft_R2>,
        ]
    over "Motor_L0" {
        float inputs:demand.connect = </SixWheelIndependent.inputs:drive_w0>
        custom token connectors:p.connect = </SixWheelIndependent/PowerSource.connectors:p>
    }
    over "Motor_L1" {
        float inputs:demand.connect = </SixWheelIndependent.inputs:drive_w1>
        custom token connectors:p.connect = </SixWheelIndependent/PowerSource.connectors:p>
    }
    over "Motor_L2" {
        float inputs:demand.connect = </SixWheelIndependent.inputs:drive_w2>
        custom token connectors:p.connect = </SixWheelIndependent/PowerSource.connectors:p>
    }
    over "Motor_R0" {
        float inputs:demand.connect = </SixWheelIndependent.inputs:drive_w3>
        custom token connectors:p.connect = </SixWheelIndependent/PowerSource.connectors:p>
    }
    over "Motor_R1" {
        float inputs:demand.connect = </SixWheelIndependent.inputs:drive_w4>
        custom token connectors:p.connect = </SixWheelIndependent/PowerSource.connectors:p>
    }
    over "Motor_R2" {
        float inputs:demand.connect = </SixWheelIndependent.inputs:drive_w5>
        custom token connectors:p.connect = </SixWheelIndependent/PowerSource.connectors:p>
    }

    # G4b — the mix. Left bank (w0,w1,w2) = throttle+steer; right bank (w3,w4,w5)
    # = throttle−steer. Pure throttle drives all six equally; pure steer pivots.
    #
    # ONE PRIM PER SINK PORT, named for the actuator port it writes, carrying a
    # `lunco:factor:<source>` per command source it responds to — the sources are
    # the OBC's command ports (`inputs:throttle`/`steer`/`brake`). Each term prim
    # IS a connection, so the linear transform on it is PER CONNECTION, which is
    # what SSP's `<Connection><LinearTransformation/></Connection>` says and what
    # a factor keyed only by sink port cannot express: `drive_w0` takes throttle
    # at +1 AND steer at +1, two sources into one sink at different factors.
    #
    # An absent factor is 0, so a term states only what it responds to. Retuning
    # one wheel is an `over` on one prim — no other term is touched, and the
    # steer sign per bank is still stated in exactly one place per wheel.
    def Cube "Chassis" (
        prepend references = @lunco://components/mobility/chassis/box_chassis.usda@</Chassis>
    )
    {
        # Longer flatbed than the component default. Teal identity — colour is
        # `primvars:displayColor` and nothing else; the hull shader consumes it
        # as the base paint.
        double3 xformOp:scale = (2.0, 0.3, 5.0)
        color3f[] primvars:displayColor = [(0.3, 0.62, 0.72)]
    }

    # --- Left bank → drive_w0/w1/w2 -----------------------------------------
    def Cylinder "Wheel_L0" (
        prepend apiSchemas = ["PhysxVehicleWheelAttachmentAPI", "PhysxVehicleWheelAPI"]
        prepend references = [
            @lunco://components/mobility/wheel.usda@</Wheel>,
            @lunco://components/mobility/suspensions/standard.usda@</Suspension>,
        ]
    )
    {
        double3 xformOp:translate = (-1.0, -0.65, -2.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        int physxVehicleWheelAttachment:index = 0
        # Complete axle inertia for the authored motor, reduction, and tire assembly.
        # The 6.8 kg.m2 value is the composed USD mechanical contract.
        float physxVehicleWheel:moi = 6.8
        float inputs:drive.connect = </SixWheelIndependent/Shaft_L0.outputs:torque>
    }

    def Cylinder "Wheel_L1" (
        prepend apiSchemas = ["PhysxVehicleWheelAttachmentAPI", "PhysxVehicleWheelAPI"]
        prepend references = [
            @lunco://components/mobility/wheel.usda@</Wheel>,
            @lunco://components/mobility/suspensions/standard.usda@</Suspension>,
        ]
    )
    {
        double3 xformOp:translate = (-1.0, -0.65, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        int physxVehicleWheelAttachment:index = 2
        # Complete axle inertia for the authored motor, reduction, and tire assembly.
        # The 6.8 kg.m2 value is the composed USD mechanical contract.
        float physxVehicleWheel:moi = 6.8
        float inputs:drive.connect = </SixWheelIndependent/Shaft_L1.outputs:torque>
    }

    def Cylinder "Wheel_L2" (
        prepend apiSchemas = ["PhysxVehicleWheelAttachmentAPI", "PhysxVehicleWheelAPI"]
        prepend references = [
            @lunco://components/mobility/wheel.usda@</Wheel>,
            @lunco://components/mobility/suspensions/standard.usda@</Suspension>,
        ]
    )
    {
        double3 xformOp:translate = (-1.0, -0.65, 2.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        int physxVehicleWheelAttachment:index = 4
        # Complete axle inertia for the authored motor, reduction, and tire assembly.
        # The 6.8 kg.m2 value is the composed USD mechanical contract.
        float physxVehicleWheel:moi = 6.8
        float inputs:drive.connect = </SixWheelIndependent/Shaft_L2.outputs:torque>
    }

    # --- Right bank → drive_w3/w4/w5 ----------------------------------------
    def Cylinder "Wheel_R0" (
        prepend apiSchemas = ["PhysxVehicleWheelAttachmentAPI", "PhysxVehicleWheelAPI"]
        prepend references = [
            @lunco://components/mobility/wheel.usda@</Wheel>,
            @lunco://components/mobility/suspensions/standard.usda@</Suspension>,
        ]
    )
    {
        double3 xformOp:translate = (1.0, -0.65, -2.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        int physxVehicleWheelAttachment:index = 1
        # Complete axle inertia for the authored motor, reduction, and tire assembly.
        # The 6.8 kg.m2 value is the composed USD mechanical contract.
        float physxVehicleWheel:moi = 6.8
        float inputs:drive.connect = </SixWheelIndependent/Shaft_R0.outputs:torque>
    }

    def Cylinder "Wheel_R1" (
        prepend apiSchemas = ["PhysxVehicleWheelAttachmentAPI", "PhysxVehicleWheelAPI"]
        prepend references = [
            @lunco://components/mobility/wheel.usda@</Wheel>,
            @lunco://components/mobility/suspensions/standard.usda@</Suspension>,
        ]
    )
    {
        double3 xformOp:translate = (1.0, -0.65, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        int physxVehicleWheelAttachment:index = 3
        # Complete axle inertia for the authored motor, reduction, and tire assembly.
        # The 6.8 kg.m2 value is the composed USD mechanical contract.
        float physxVehicleWheel:moi = 6.8
        float inputs:drive.connect = </SixWheelIndependent/Shaft_R1.outputs:torque>
    }

    def Cylinder "Wheel_R2" (
        prepend apiSchemas = ["PhysxVehicleWheelAttachmentAPI", "PhysxVehicleWheelAPI"]
        prepend references = [
            @lunco://components/mobility/wheel.usda@</Wheel>,
            @lunco://components/mobility/suspensions/standard.usda@</Suspension>,
        ]
    )
    {
        double3 xformOp:translate = (1.0, -0.65, 2.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        int physxVehicleWheelAttachment:index = 5
        # Complete axle inertia for the authored motor, reduction, and tire assembly.
        # The 6.8 kg.m2 value is the composed USD mechanical contract.
        float physxVehicleWheel:moi = 6.8
        float inputs:drive.connect = </SixWheelIndependent/Shaft_R2.outputs:torque>
    }

    # --- Motors + reductions -------------------------------------------------
    # SIX motors, SIX channels: this is the rover the independent-drive story is
    # about, and each motor's `inputs:demand` wires to exactly the port its wheel
    # connects `inputs:drive` to — `drive_w0..drive_w5`, in that order. Nothing is
    # renumbered; the drive-law output connections above are the only place the
    # bank routing is stated.
    #
    # The Modelica motor, gearbox, and shaft solve the electrical and rotational
    # state once. A weak or hot wheel is an authored Modelica input opinion on
    # that motor instance, never a Rust code path or a name-based relationship.
    def Xform "Motor_L0" (
        prepend references = @lunco://components/mobility/motor.usda@</Motor>
    )
    {
        double3 xformOp:translate = (-0.45, -0.1, -2.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:demand.connect = </SixWheelIndependent.outputs:drive_w0>
        float inputs:speed.connect = </SixWheelIndependent/Gearbox_L0.outputs:speed_a>
    }

    def Xform "TorqueSource_L0" (
        prepend references = @lunco://components/mobility/torque.usda@</Torque>
    )
    {
        float inputs:tau_ref.connect = </SixWheelIndependent/Motor_L0.outputs:shaft_torque>
        custom token connectors:flange.connect = </SixWheelIndependent/Gearbox_L0.connectors:flange_a>
    }

    def Xform "Gearbox_L0" (
        prepend references = @lunco://components/mobility/gearbox.usda@</Gearbox>
    )
    {
        double3 xformOp:translate = (-0.6, -0.1, -2.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:ratio = 200.0
        float inputs:eta = 0.85
        float inputs:max_output_torque = 400.0
        custom token connectors:flange_a.connect = </SixWheelIndependent/TorqueSource_L0.connectors:flange>
        custom token connectors:flange_b.connect = </SixWheelIndependent/Shaft_L0.connectors:flange>
    }

    def Xform "Motor_L1" (
        prepend references = @lunco://components/mobility/motor.usda@</Motor>
    )
    {
        double3 xformOp:translate = (-0.45, -0.1, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:demand.connect = </SixWheelIndependent.outputs:drive_w1>
        float inputs:speed.connect = </SixWheelIndependent/Gearbox_L1.outputs:speed_a>
    }


    def Xform "TorqueSource_L1" (
        prepend references = @lunco://components/mobility/torque.usda@</Torque>
    )
    {
        float inputs:tau_ref.connect = </SixWheelIndependent/Motor_L1.outputs:shaft_torque>
        custom token connectors:flange.connect = </SixWheelIndependent/Gearbox_L1.connectors:flange_a>
    }

    def Xform "Gearbox_L1" (
        prepend references = @lunco://components/mobility/gearbox.usda@</Gearbox>
    )
    {
        double3 xformOp:translate = (-0.6, -0.1, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:ratio = 200.0
        float inputs:eta = 0.85
        float inputs:max_output_torque = 400.0
        custom token connectors:flange_a.connect = </SixWheelIndependent/TorqueSource_L1.connectors:flange>
        custom token connectors:flange_b.connect = </SixWheelIndependent/Shaft_L1.connectors:flange>
    }

    def Xform "Motor_L2" (
        prepend references = @lunco://components/mobility/motor.usda@</Motor>
    )
    {
        double3 xformOp:translate = (-0.45, -0.1, 2.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:demand.connect = </SixWheelIndependent.outputs:drive_w2>
        float inputs:speed.connect = </SixWheelIndependent/Gearbox_L2.outputs:speed_a>
    }


    def Xform "TorqueSource_L2" (
        prepend references = @lunco://components/mobility/torque.usda@</Torque>
    )
    {
        float inputs:tau_ref.connect = </SixWheelIndependent/Motor_L2.outputs:shaft_torque>
        custom token connectors:flange.connect = </SixWheelIndependent/Gearbox_L2.connectors:flange_a>
    }

    def Xform "Gearbox_L2" (
        prepend references = @lunco://components/mobility/gearbox.usda@</Gearbox>
    )
    {
        double3 xformOp:translate = (-0.6, -0.1, 2.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:ratio = 200.0
        float inputs:eta = 0.85
        float inputs:max_output_torque = 400.0
        custom token connectors:flange_a.connect = </SixWheelIndependent/TorqueSource_L2.connectors:flange>
        custom token connectors:flange_b.connect = </SixWheelIndependent/Shaft_L2.connectors:flange>
    }

    def Xform "Motor_R0" (
        prepend references = @lunco://components/mobility/motor.usda@</Motor>
    )
    {
        double3 xformOp:translate = (0.45, -0.1, -2.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:demand.connect = </SixWheelIndependent.outputs:drive_w3>
        float inputs:speed.connect = </SixWheelIndependent/Gearbox_R0.outputs:speed_a>
    }


    def Xform "TorqueSource_R0" (
        prepend references = @lunco://components/mobility/torque.usda@</Torque>
    )
    {
        float inputs:tau_ref.connect = </SixWheelIndependent/Motor_R0.outputs:shaft_torque>
        custom token connectors:flange.connect = </SixWheelIndependent/Gearbox_R0.connectors:flange_a>
    }

    def Xform "Gearbox_R0" (
        prepend references = @lunco://components/mobility/gearbox.usda@</Gearbox>
    )
    {
        double3 xformOp:translate = (0.6, -0.1, -2.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:ratio = 200.0
        float inputs:eta = 0.85
        float inputs:max_output_torque = 400.0
        custom token connectors:flange_a.connect = </SixWheelIndependent/TorqueSource_R0.connectors:flange>
        custom token connectors:flange_b.connect = </SixWheelIndependent/Shaft_R0.connectors:flange>
    }

    def Xform "Motor_R1" (
        prepend references = @lunco://components/mobility/motor.usda@</Motor>
    )
    {
        double3 xformOp:translate = (0.45, -0.1, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:demand.connect = </SixWheelIndependent.outputs:drive_w4>
        float inputs:speed.connect = </SixWheelIndependent/Gearbox_R1.outputs:speed_a>
    }


    def Xform "TorqueSource_R1" (
        prepend references = @lunco://components/mobility/torque.usda@</Torque>
    )
    {
        float inputs:tau_ref.connect = </SixWheelIndependent/Motor_R1.outputs:shaft_torque>
        custom token connectors:flange.connect = </SixWheelIndependent/Gearbox_R1.connectors:flange_a>
    }

    def Xform "Gearbox_R1" (
        prepend references = @lunco://components/mobility/gearbox.usda@</Gearbox>
    )
    {
        double3 xformOp:translate = (0.6, -0.1, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:ratio = 200.0
        float inputs:eta = 0.85
        float inputs:max_output_torque = 400.0
        custom token connectors:flange_a.connect = </SixWheelIndependent/TorqueSource_R1.connectors:flange>
        custom token connectors:flange_b.connect = </SixWheelIndependent/Shaft_R1.connectors:flange>
    }

    def Xform "Motor_R2" (
        prepend references = @lunco://components/mobility/motor.usda@</Motor>
    )
    {
        double3 xformOp:translate = (0.45, -0.1, 2.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:demand.connect = </SixWheelIndependent.outputs:drive_w5>
        float inputs:speed.connect = </SixWheelIndependent/Gearbox_R2.outputs:speed_a>
    }


    def Xform "TorqueSource_R2" (
        prepend references = @lunco://components/mobility/torque.usda@</Torque>
    )
    {
        float inputs:tau_ref.connect = </SixWheelIndependent/Motor_R2.outputs:shaft_torque>
        custom token connectors:flange.connect = </SixWheelIndependent/Gearbox_R2.connectors:flange_a>
    }

    def Xform "Gearbox_R2" (
        prepend references = @lunco://components/mobility/gearbox.usda@</Gearbox>
    )
    {
        double3 xformOp:translate = (0.6, -0.1, 2.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:ratio = 200.0
        float inputs:eta = 0.85
        float inputs:max_output_torque = 400.0
        custom token connectors:flange_a.connect = </SixWheelIndependent/TorqueSource_R2.connectors:flange>
        custom token connectors:flange_b.connect = </SixWheelIndependent/Shaft_R2.connectors:flange>
    }

    def Xform "Shaft_L0" (prepend references = @lunco://components/mobility/avian_shaft.usda@</AvianShaft>)
    {
        float inputs:speed.connect = </SixWheelIndependent.inputs:shaft_speed_L0>
    }
    def Xform "Shaft_L1" (prepend references = @lunco://components/mobility/avian_shaft.usda@</AvianShaft>)
    {
        float inputs:speed.connect = </SixWheelIndependent.inputs:shaft_speed_L1>
    }
    def Xform "Shaft_L2" (prepend references = @lunco://components/mobility/avian_shaft.usda@</AvianShaft>)
    {
        float inputs:speed.connect = </SixWheelIndependent.inputs:shaft_speed_L2>
    }
    def Xform "Shaft_R0" (prepend references = @lunco://components/mobility/avian_shaft.usda@</AvianShaft>)
    {
        float inputs:speed.connect = </SixWheelIndependent.inputs:shaft_speed_R0>
    }
    def Xform "Shaft_R1" (prepend references = @lunco://components/mobility/avian_shaft.usda@</AvianShaft>)
    {
        float inputs:speed.connect = </SixWheelIndependent.inputs:shaft_speed_R1>
    }
    def Xform "Shaft_R2" (prepend references = @lunco://components/mobility/avian_shaft.usda@</AvianShaft>)
    {
        float inputs:speed.connect = </SixWheelIndependent.inputs:shaft_speed_R2>
    }

    # --- Drive law -----------------------------------------------------------
    # HOW throttle/steer become the six wheel channels is COMPOSITION, not an
    # enumeration. The plain authored state is the per-wheel command surface
    # above. For a solver-clocked per-side motor lag,
    # compose the law on as a reference arc alongside the airframe:
    #
    #   def "Rover" (
    #       prepend references = [
    #           @lunco://vessels/rovers/six_wheel_independent.usda@</SixWheelIndependent>,
    #           @lunco://components/mobility/drive_laws/modelica_six_independent.usda@</DriveLaw>,
    #       ]
    #   ) {}
    #
    # That component reuses `RoverDrivetrain.mo` (the law is per-SIDE; native
    # USD connections fan each side out to its three wheel ports).
}
