#usda 1.0
(
    defaultPrim = "SkidRover"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "SkidRover" (
    documentation = "Four-wheel skid-steer lunar rover with selectable raycast or joint-based drivetrain."
    kind = "assembly"
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI", "PhysxVehicleContextAPI", "LunCoCatalogAPI", "CollectionAPI:components"]
    prepend references = @lunco://components/mobility/drive_laws/modelica_skid.usda@</DriveLaw>
    prepend variantSets = ["drivetrain", "power", "generation", "thermal"]
    variants = { string "drivetrain" = "raycast"; string "generation" = "none"; string "power" = "infinite"; string "thermal" = "none" }
)
{
    uniform token lunco:steeringGeometry = "differential"
    uniform bool lunco:spawnable = true
    float physics:mass = 1000.0
    float3 physics:diagonalInertia = (1028.0, 1354.0, 341.0)
    float3 physics:centerOfMass = (0.0, 0.0, 0.0)
    float outputs:drive_left = 0.0
    float outputs:drive_right = 0.0
    float outputs:brake = 0.0
    float physxRigidBody:linearDamping = 0.5
    float physxRigidBody:angularDamping = 2.0
    variantSet "drivetrain" = {
        "raycast" {
        }
        "physical" (
            prepend references = @lunco://components/mobility/physical_drivetrain.usda@</Drivetrain>
        ) {
            over "Suspension_FL" (
                prepend apiSchemas = "PhysicsRigidBodyAPI"
            )
            {
            }
            over "Suspension_FR" (
                prepend apiSchemas = "PhysicsRigidBodyAPI"
            )
            {
            }
            over "Suspension_RL" (
                prepend apiSchemas = "PhysicsRigidBodyAPI"
            )
            {
            }
            over "Suspension_RR" (
                prepend apiSchemas = "PhysicsRigidBodyAPI"
            )
            {
            }
            over "Suspension_FL/Wheel_FL" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsFilteredPairsAPI"]
            )
            {
                bool physics:rigidBodyEnabled = true
                bool physics:collisionEnabled = true
                rel physics:filteredPairs = </SkidRover/Chassis>
            }
            over "Suspension_FR/Wheel_FR" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsFilteredPairsAPI"]
            )
            {
                bool physics:rigidBodyEnabled = true
                bool physics:collisionEnabled = true
                rel physics:filteredPairs = </SkidRover/Chassis>
            }
            over "Suspension_RL/Wheel_RL" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsFilteredPairsAPI"]
            )
            {
                bool physics:rigidBodyEnabled = true
                bool physics:collisionEnabled = true
                rel physics:filteredPairs = </SkidRover/Chassis>
            }
            over "Suspension_RR/Wheel_RR" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsFilteredPairsAPI"]
            )
            {
                bool physics:rigidBodyEnabled = true
                bool physics:collisionEnabled = true
                rel physics:filteredPairs = </SkidRover/Chassis>
            }
        }
    }
    variantSet "power" = {
        "infinite" {
            uniform token collection:components:expansionRule = "explicitOnly"
            rel collection:components:includes
            prepend rel collection:components:includes = [</SkidRover/PowerSource>, </SkidRover/Motor_FL>, </SkidRover/TorqueSource_FL>, </SkidRover/Motor_FR>, </SkidRover/TorqueSource_FR>, </SkidRover/Motor_RL>, </SkidRover/TorqueSource_RL>, </SkidRover/Motor_RR>, </SkidRover/TorqueSource_RR>, </SkidRover/Gearbox_FL>, </SkidRover/Gearbox_FR>, </SkidRover/Gearbox_RL>, </SkidRover/Gearbox_RR>, </SkidRover/Shaft_FL>, </SkidRover/Shaft_FR>, </SkidRover/Shaft_RL>, </SkidRover/Shaft_RR>]
            float inputs:drive_left
            float inputs:drive_left.connect = </SkidRover.outputs:drive_left>
            float inputs:drive_right
            float inputs:drive_right.connect = </SkidRover.outputs:drive_right>
            float inputs:shaft_speed_FL
            float inputs:shaft_speed_FL.connect = </SkidRover/Suspension_FL/Wheel_FL.outputs:shaft_speed>
            float inputs:shaft_speed_FR
            float inputs:shaft_speed_FR.connect = </SkidRover/Suspension_FR/Wheel_FR.outputs:shaft_speed>
            float inputs:shaft_speed_RL
            float inputs:shaft_speed_RL.connect = </SkidRover/Suspension_RL/Wheel_RL.outputs:shaft_speed>
            float inputs:shaft_speed_RR
            float inputs:shaft_speed_RR.connect = </SkidRover/Suspension_RR/Wheel_RR.outputs:shaft_speed>
            float outputs:bus_voltage
            float outputs:bus_voltage.connect = </SkidRover/PowerSource.outputs:terminal_voltage_v>
            float outputs:bus_current
            float outputs:bus_current.connect = </SkidRover/PowerSource.outputs:terminal_current_a>
            float outputs:bus_power
            float outputs:bus_power.connect = </SkidRover/PowerSource.outputs:terminal_power_w>
            over "Battery"
            {
                bool active = false
            }
            def Xform "PowerSource" (
                prepend references = @lunco://components/power/ideal_voltage_source.usda@</IdealVoltageSource>
            )
            {
            }
            over "Motor_FL"
            {
                float inputs:demand
                float inputs:demand.connect = </SkidRover.inputs:drive_left>
                custom token connectors:p
                token connectors:p.connect = </SkidRover/PowerSource.connectors:p>
            }
            over "Motor_FR"
            {
                float inputs:demand
                float inputs:demand.connect = </SkidRover.inputs:drive_right>
                custom token connectors:p
                token connectors:p.connect = </SkidRover/PowerSource.connectors:p>
            }
            over "Motor_RL"
            {
                float inputs:demand
                float inputs:demand.connect = </SkidRover.inputs:drive_left>
                custom token connectors:p
                token connectors:p.connect = </SkidRover/PowerSource.connectors:p>
            }
            over "Motor_RR"
            {
                float inputs:demand
                float inputs:demand.connect = </SkidRover.inputs:drive_right>
                custom token connectors:p
                token connectors:p.connect = </SkidRover/PowerSource.connectors:p>
            }
        }
        "battery" {
            uniform token collection:components:expansionRule = "explicitOnly"
            rel collection:components:includes
            prepend rel collection:components:includes = [</SkidRover/Battery>, </SkidRover/Motor_FL>, </SkidRover/TorqueSource_FL>, </SkidRover/Motor_FR>, </SkidRover/TorqueSource_FR>, </SkidRover/Motor_RL>, </SkidRover/TorqueSource_RL>, </SkidRover/Motor_RR>, </SkidRover/TorqueSource_RR>, </SkidRover/Gearbox_FL>, </SkidRover/Gearbox_FR>, </SkidRover/Gearbox_RL>, </SkidRover/Gearbox_RR>, </SkidRover/Shaft_FL>, </SkidRover/Shaft_FR>, </SkidRover/Shaft_RL>, </SkidRover/Shaft_RR>]
            float inputs:drive_left
            float inputs:drive_left.connect = </SkidRover.outputs:drive_left>
            float inputs:drive_right
            float inputs:drive_right.connect = </SkidRover.outputs:drive_right>
            float inputs:shaft_speed_FL
            float inputs:shaft_speed_FL.connect = </SkidRover/Suspension_FL/Wheel_FL.outputs:shaft_speed>
            float inputs:shaft_speed_FR
            float inputs:shaft_speed_FR.connect = </SkidRover/Suspension_FR/Wheel_FR.outputs:shaft_speed>
            float inputs:shaft_speed_RL
            float inputs:shaft_speed_RL.connect = </SkidRover/Suspension_RL/Wheel_RL.outputs:shaft_speed>
            float inputs:shaft_speed_RR
            float inputs:shaft_speed_RR.connect = </SkidRover/Suspension_RR/Wheel_RR.outputs:shaft_speed>
            float outputs:soc
            float outputs:soc.connect = </SkidRover/Battery.outputs:soc_out>
            float outputs:battery_drained
            float outputs:battery_drained.connect = </SkidRover/Battery.outputs:drained>
            float outputs:battery_net_power
            float outputs:battery_net_power.connect = </SkidRover/Battery.outputs:net_power_w>
            float outputs:battery_charge_power
            float outputs:battery_charge_power.connect = </SkidRover/Battery.outputs:charge_power_w>
            float outputs:battery_discharge_power
            float outputs:battery_discharge_power.connect = </SkidRover/Battery.outputs:discharge_power_w>
            float outputs:motor_electrical_power
            float outputs:motor_electrical_power.connect = </SkidRover/Motor_FL.outputs:electrical_power>
            float outputs:motor_terminal_current
            float outputs:motor_terminal_current.connect = </SkidRover/Motor_FL.outputs:terminal_current_a>
            over "Motor_FL"
            {
                float inputs:demand
                float inputs:demand.connect = </SkidRover.inputs:drive_left>
                custom token connectors:p
                token connectors:p.connect = </SkidRover/Battery.connectors:p>
            }
            over "Motor_FR"
            {
                float inputs:demand
                float inputs:demand.connect = </SkidRover.inputs:drive_right>
                custom token connectors:p
                token connectors:p.connect = </SkidRover/Battery.connectors:p>
            }
            over "Motor_RL"
            {
                float inputs:demand
                float inputs:demand.connect = </SkidRover.inputs:drive_left>
                custom token connectors:p
                token connectors:p.connect = </SkidRover/Battery.connectors:p>
            }
            over "Motor_RR"
            {
                float inputs:demand
                float inputs:demand.connect = </SkidRover.inputs:drive_right>
                custom token connectors:p
                token connectors:p.connect = </SkidRover/Battery.connectors:p>
            }
            def LunCoEvent "BatteryDrained"
            {
                uniform token lunco:event:name = "battery_drained"
                uniform token lunco:event:severity = "warning"
                uniform bool lunco:event:latched = true
                double lunco:event:qualificationTime = 0.0
                float inputs:trigger
                float inputs:trigger.connect = </SkidRover.outputs:battery_drained>
            }
        }
    }
    variantSet "generation" = {
        "none" {
        }
        "solar" {
            rel collection:components:includes
            prepend rel collection:components:includes = </SkidRover/SolarPanel>
            custom double inputs:irradiance
            double inputs:irradiance.connect = </SkidRover/SolarPanel/Environment.outputs:sun_irradiance_w_m2>
            custom double inputs:sun_visibility
            double inputs:sun_visibility.connect = </SkidRover/SolarPanel/Environment.outputs:sun_visibility>
            custom double inputs:target_mount_x
            double inputs:target_mount_x.connect = </SkidRover/SolarPanel/Environment.outputs:sun_mount_x>
            custom double inputs:target_mount_y
            double inputs:target_mount_y.connect = </SkidRover/SolarPanel/Environment.outputs:sun_mount_y>
            custom double inputs:target_mount_z
            double inputs:target_mount_z.connect = </SkidRover/SolarPanel/Environment.outputs:sun_mount_z>
            custom double outputs:solar_power
            double outputs:solar_power.connect = </SkidRover/SolarPanel.outputs:power_out>
            custom double outputs:solar_incidence
            double outputs:solar_incidence.connect = </SkidRover/SolarPanel.outputs:cos_incidence>
            custom double outputs:solar_available_power
            double outputs:solar_available_power.connect = </SkidRover/SolarPanel.outputs:available_power_w>
            def Xform "SolarPanel" (
                prepend references = @lunco://components/power/solar_panel.usda@</SolarPanel>
            )
            {
                double3 xformOp:translate = (0.0, 0.45, 0.0)
                double3 xformOp:scale = (0.42, 0.2, 0.42)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                custom token connectors:p
                token connectors:p.connect = </SkidRover/Battery.connectors:p>
                custom double inputs:irradiance
                double inputs:irradiance.connect = </SkidRover.inputs:irradiance>
                custom double inputs:sun_visibility
                double inputs:sun_visibility.connect = </SkidRover.inputs:sun_visibility>
                custom double inputs:target_mount_x
                double inputs:target_mount_x.connect = </SkidRover.inputs:target_mount_x>
                custom double inputs:target_mount_y
                double inputs:target_mount_y.connect = </SkidRover.inputs:target_mount_y>
                custom double inputs:target_mount_z
                double inputs:target_mount_z.connect = </SkidRover.inputs:target_mount_z>
            }
        }
    }
    variantSet "thermal" = {
        "none" {
        }
        "basic" {
            def Scope "Thermal" (
                prepend apiSchemas = "CollectionAPI:components"
                documentation = "Rover thermal control network: motor dissipation → masses → radiators."
            )
            {
                uniform token collection:components:expansionRule = "explicitOnly"
                rel collection:components:includes
                prepend rel collection:components:includes = [</SkidRover/Thermal/MotorHeat_FL>, </SkidRover/Thermal/MotorHeat_RL>, </SkidRover/Thermal/MotorHeat_FR>, </SkidRover/Thermal/MotorHeat_RR>, </SkidRover/Thermal/MotorThermalLeft>, </SkidRover/Thermal/MotorThermalRight>, </SkidRover/Thermal/MotorRadiatorLeft>, </SkidRover/Thermal/MotorRadiatorRight>, </SkidRover/Thermal/ThermalBridge>]
                float inputs:motor_heat_FL
                float inputs:motor_heat_FL.connect = </SkidRover/Motor_FL.outputs:heat>
                float inputs:motor_heat_FR
                float inputs:motor_heat_FR.connect = </SkidRover/Motor_FR.outputs:heat>
                float inputs:motor_heat_RL
                float inputs:motor_heat_RL.connect = </SkidRover/Motor_RL.outputs:heat>
                float inputs:motor_heat_RR
                float inputs:motor_heat_RR.connect = </SkidRover/Motor_RR.outputs:heat>
                float outputs:motor_temp_left
                float outputs:motor_temp_left.connect = </SkidRover/Thermal/MotorThermalLeft.outputs:temp_k>
                float outputs:motor_temp_right
                float outputs:motor_temp_right.connect = </SkidRover/Thermal/MotorThermalRight.outputs:temp_k>
                def Xform "ThermalBridge" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</ThermalConductor>
                )
                {
                    custom token connectors:port_a
                    token connectors:port_a.connect = </SkidRover/Thermal/MotorThermalLeft.connectors:port>
                    custom token connectors:port_b
                    token connectors:port_b.connect = </SkidRover/Thermal/MotorThermalRight.connectors:port>
                }
                def Xform "MotorHeat_FL" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorHeatLoad>
                )
                {
                    float inputs:heat_w
                    float inputs:heat_w.connect = </SkidRover/Thermal.inputs:motor_heat_FL>
                    custom token connectors:port
                    token connectors:port.connect = </SkidRover/Thermal/MotorThermalLeft.connectors:port>
                }
                def Xform "MotorHeat_RL" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorHeatLoad>
                )
                {
                    float inputs:heat_w
                    float inputs:heat_w.connect = </SkidRover/Thermal.inputs:motor_heat_RL>
                    custom token connectors:port
                    token connectors:port.connect = </SkidRover/Thermal/MotorThermalLeft.connectors:port>
                }
                def Xform "MotorThermalLeft" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorThermalMass>
                )
                {
                }
                def Xform "MotorRadiatorLeft" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorRadiator>
                )
                {
                    custom token connectors:port
                    token connectors:port.connect = </SkidRover/Thermal/MotorThermalLeft.connectors:port>
                }
                def Xform "MotorHeat_FR" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorHeatLoad>
                )
                {
                    float inputs:heat_w
                    float inputs:heat_w.connect = </SkidRover/Thermal.inputs:motor_heat_FR>
                    custom token connectors:port
                    token connectors:port.connect = </SkidRover/Thermal/MotorThermalRight.connectors:port>
                }
                def Xform "MotorHeat_RR" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorHeatLoad>
                )
                {
                    float inputs:heat_w
                    float inputs:heat_w.connect = </SkidRover/Thermal.inputs:motor_heat_RR>
                    custom token connectors:port
                    token connectors:port.connect = </SkidRover/Thermal/MotorThermalRight.connectors:port>
                }
                def Xform "MotorThermalRight" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorThermalMass>
                )
                {
                }
                def Xform "MotorRadiatorRight" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorRadiator>
                )
                {
                    custom token connectors:port
                    token connectors:port.connect = </SkidRover/Thermal/MotorThermalRight.connectors:port>
                }
            }
        }
    }
    def Camera "FrontCamera" (
        prepend references = @lunco://components/cameras/rover_front_camera.usda@</FrontCamera>
    )
    {
    }
    def "Controls" (
        prepend references = @lunco://vessels/control_profiles.usda@</RoverControls>
    )
    {
    }
    def Xform "Battery" (
        prepend references = @lunco://components/power/battery.usda@</Battery>
    )
    {
        double3 xformOp:translate = (0.0, 0.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cube "Chassis" (
        prepend references = @lunco://components/mobility/chassis/box_chassis.usda@</Chassis>
    )
    {
        color3f[] primvars:displayColor = [(0.8799999952316284, 0.8899999856948853, 0.8999999761581421)]
        over "HullLook"
        {
            over "Shader"
            {
                color3f inputs:accent_color = (0.7200000286102295, 0.1599999964237213, 0.11999999731779099)
            }
        }
    }
    def Xform "Headlight_L" (
        prepend references = @lunco://components/lights/headlight.usda@</Headlight>
    )
    {
        double3 xformOp:translate = (-0.8, 0.2, -1.75)
        double3 xformOp:rotateXYZ = (-15.0, 0.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
    def Xform "Headlight_R" (
        prepend references = @lunco://components/lights/headlight.usda@</Headlight>
    )
    {
        double3 xformOp:translate = (0.8, 0.2, -1.75)
        double3 xformOp:rotateXYZ = (-15.0, 0.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
    def Xform "Suspension_FL" (
        prepend references = @lunco://components/mobility/suspensions/physical_carrier.usda@</SuspensionCarrier>
    )
    {
        double3 xformOp:translate = (-1.0, -0.65, -1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Cylinder "Wheel_FL" (
            prepend apiSchemas = ["PhysxVehicleWheelAttachmentAPI", "PhysxVehicleWheelAPI"]
            prepend references = [@lunco://components/mobility/wheel.usda@</Wheel>, @lunco://components/mobility/suspensions/standard.usda@</Suspension>]
        )
        {
            double3 xformOp:translate = (0.0, 0.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            int physxVehicleWheelAttachment:index = 0
            float physxVehicleWheel:moi = 6.800000190734863
            float inputs:drive
            float inputs:drive.connect = </SkidRover/Shaft_FL.outputs:torque>
        }
    }
    def Xform "Suspension_FR" (
        prepend references = @lunco://components/mobility/suspensions/physical_carrier.usda@</SuspensionCarrier>
    )
    {
        double3 xformOp:translate = (1.0, -0.65, -1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Cylinder "Wheel_FR" (
            prepend apiSchemas = ["PhysxVehicleWheelAttachmentAPI", "PhysxVehicleWheelAPI"]
            prepend references = [@lunco://components/mobility/wheel.usda@</Wheel>, @lunco://components/mobility/suspensions/standard.usda@</Suspension>]
        )
        {
            double3 xformOp:translate = (0.0, 0.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            int physxVehicleWheelAttachment:index = 1
            float physxVehicleWheel:moi = 6.800000190734863
            float inputs:drive
            float inputs:drive.connect = </SkidRover/Shaft_FR.outputs:torque>
        }
    }
    def Xform "Suspension_RL" (
        prepend references = @lunco://components/mobility/suspensions/physical_carrier.usda@</SuspensionCarrier>
    )
    {
        double3 xformOp:translate = (-1.0, -0.65, 1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Cylinder "Wheel_RL" (
            prepend apiSchemas = ["PhysxVehicleWheelAttachmentAPI", "PhysxVehicleWheelAPI"]
            prepend references = [@lunco://components/mobility/wheel.usda@</Wheel>, @lunco://components/mobility/suspensions/standard.usda@</Suspension>]
        )
        {
            double3 xformOp:translate = (0.0, 0.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            int physxVehicleWheelAttachment:index = 2
            float physxVehicleWheel:moi = 6.800000190734863
            float inputs:drive
            float inputs:drive.connect = </SkidRover/Shaft_RL.outputs:torque>
        }
    }
    def Xform "Suspension_RR" (
        prepend references = @lunco://components/mobility/suspensions/physical_carrier.usda@</SuspensionCarrier>
    )
    {
        double3 xformOp:translate = (1.0, -0.65, 1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Cylinder "Wheel_RR" (
            prepend apiSchemas = ["PhysxVehicleWheelAttachmentAPI", "PhysxVehicleWheelAPI"]
            prepend references = [@lunco://components/mobility/wheel.usda@</Wheel>, @lunco://components/mobility/suspensions/standard.usda@</Suspension>]
        )
        {
            double3 xformOp:translate = (0.0, 0.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            int physxVehicleWheelAttachment:index = 3
            float physxVehicleWheel:moi = 6.800000190734863
            float inputs:drive
            float inputs:drive.connect = </SkidRover/Shaft_RR.outputs:torque>
        }
    }
    def Xform "Motor_FL" (
        prepend references = @lunco://components/mobility/motor.usda@</Motor>
    )
    {
        double3 xformOp:translate = (-0.3, -0.35, -1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:demand
        float inputs:demand.connect = </SkidRover.outputs:drive_left>
        float inputs:speed
        float inputs:speed.connect = </SkidRover/Gearbox_FL.outputs:speed_a>
    }
    def Xform "TorqueSource_FL" (
        prepend references = @lunco://components/mobility/torque.usda@</Torque>
    )
    {
        float inputs:tau_ref
        float inputs:tau_ref.connect = </SkidRover/Motor_FL.outputs:shaft_torque>
        custom token connectors:flange
        token connectors:flange.connect = </SkidRover/Gearbox_FL.connectors:flange_a>
    }
    def Xform "Gearbox_FL" (
        prepend references = @lunco://components/mobility/gearbox.usda@</Gearbox>
    )
    {
        double3 xformOp:translate = (-0.52, -0.35, -1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:ratio = 200.0
        float inputs:eta = 0.8500000238418579
        float inputs:max_output_torque = 400.0
        custom token connectors:flange_a
        token connectors:flange_a.connect = </SkidRover/TorqueSource_FL.connectors:flange>
        custom token connectors:flange_b
        token connectors:flange_b.connect = </SkidRover/Shaft_FL.connectors:flange>
    }
    def Xform "Motor_FR" (
        prepend references = @lunco://components/mobility/motor.usda@</Motor>
    )
    {
        double3 xformOp:translate = (0.3, -0.35, -1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:demand
