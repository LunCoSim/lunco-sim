#usda 1.0
(
    defaultPrim = "SkidRover"
    upAxis = "Y"
    metersPerUnit = 1
)

# Base Skid-Steer Rover — reusable component definition.
#
# **Pixar/Omniverse-correct structure**: an `Xform` root holds the
# vehicle/physics schemas (`PhysicsRigidBodyAPI`, `PhysicsMassAPI`,
# `PhysxVehicleContextAPI`, `PhysxVehicleTankDifferentialAPI`); a child
# `Cube "Chassis"` carries `PhysicsCollisionAPI` + the visual mesh +
# its own `xformOp:scale` for chassis dimensions; sibling
# `Cylinder` wheels carry `PhysxVehicleWheelAPI`.
#
# Why this shape: `xformOp:scale` on the Xform root would propagate
# to wheel children (Bevy's Transform inheritance), distorting
# raycaster directions and panicking Avian's `Dir3` normalization.
# Putting the chassis scale on the **child** `Chassis` keeps the
# wheels at unit scale relative to the Xform root.
#
# **`drivetrain` variantSet (raycast | physical)** — the standard
# OpenUSD way to ship two locomotion models in one asset:
#   * `raycast` (fallback)  — wheels are visual-only at ride height;
#     the PhysX-style raycaster drives the body. No joints.
#   * `physical`            — wheels drop fully BELOW the chassis and
#     each is bound to the body by a `PhysicsRevoluteJoint` with a
#     `PhysicsDriveAPI:angular` motor; the root gains
#     `PhysicsArticulationRootAPI`. Joint rel-targets are **asset-local**
#     (`</SkidRover/Wheel_FL>`) and translate through the reference arc
#     when instanced in a scene.
#
# Instantiate in scenes via reference + variant selection + overrides:
#   - variants = { string drivetrain = "physical" } → joint drivetrain
#   - double3 xformOp:translate                     → set position
#   - over "Chassis" { color3f[] primvars:displayColor = [(...)] } → livery
#     (the hull shader consumes displayColor — one authored colour, one place)

def Xform "SkidRover" (
    doc = "Four-wheel skid-steer lunar rover with selectable raycast or joint-based drivetrain."
    # An ASSEMBLY: a model built out of other models. Its wheels are component models
    # that arrive by reference, and USD's rule is that a `component` may not contain
    # them — the kind is what tells a browser (and the UI) whether a prim is a thing you
    # open up or a thing you place.
    kind = "assembly"
    prepend apiSchemas = [
        "PhysicsRigidBodyAPI", "PhysxRigidBodyAPI",
        "PhysicsMassAPI",
        "PhysxVehicleContextAPI",
        "PhysxVehicleTankDifferentialAPI", "LunCoCatalogAPI"
    ]
    # The ON-BOARD COMPUTER, as a second reference arc — the rover's COMMAND
    # SURFACE. Its `inputs:` ports (`throttle`/`steer`/`brake`) ARE the set of
    # commands this vessel accepts; the engine has no per-class list. It ships
    # WITH the chassis because a complete vehicle comes with its computer: a scene
    # author placing a rover should not have to know to bolt a brain on, and a
    # rover without one has wheels, motors and power and sits there, unable to be
    # driven by human, autopilot, script or API.
    prepend references = @lunco://components/avionics/obc.usda@</OBC>
    prepend references = @lunco://components/cameras/rover_front_camera.usda@</RoverFrontCamera>
    prepend variantSets = ["drivetrain", "power", "generation", "thermal"]
    variants = {
        string drivetrain = "raycast"
        string power = "infinite"
        string generation = "none"
        string thermal = "none"
    }
)
{
    uniform bool lunco:spawnable = true
    # Mass & damping live on the rigid body root.
    float physics:mass = 1000.0
    # Principal inertia for that mass. Authoring `physics:mass` alone overrides
    # ONLY the mass — Avian keeps the collider-derived tensor for a default-density
    # body, so the chassis ends up with a rover's mass and a crate's resistance to
    # spin. That matters most when this rover is WELDED under the descent lander:
    # the weld's constraint impulses then act on a body far too easy to rotate and
    # throw the whole stack. Sibling rovers (`six_wheel_rover`, `differential_rig`)
    # already author this; the skid rover was simply missing it.
    # Solid box of the `Chassis` collider (2.0 x 0.3 x 3.5):
    #   I_x = m*(y^2 + z^2)/12 = 1000*(0.09 + 12.25)/12 = 1028
    #   I_y = m*(x^2 + z^2)/12 = 1000*(4.00 + 12.25)/12 = 1354
    #   I_z = m*(x^2 + y^2)/12 = 1000*(4.00 +  0.09)/12 =  341
    float3 physics:diagonalInertia = (1028.0, 1354.0, 341.0)
    # Lift the spawn point 1 m so the rover settles onto terrain (read by the
    # spawn catalog — keeps spawn height as USD data, not Rust category logic).
    float lunco:spawnLift = 1.0
    float outputs:drive_left = 0.0
    float outputs:drive_right = 0.0
    float outputs:steering = 0.0
    float outputs:brake = 0.0

    # Ground speed as a retained channel — the avian `speed` port on this body
    # (magnitude of its linear velocity). See `rocker_bogie.usda` for why speed is
    # authored on the chassis rather than on a component.
    float physxRigidBody:linearDamping = 0.5
    float physxRigidBody:angularDamping = 2.0

    # Intent->port control (stage 2): the shared rover profile's `Controls` scope
    # (forward/back->throttle, left/right->steer, brake->brake). Delivered as a
    # child `references` arc so it composes through a spawn/reference like a wheel.
    # Override a single intent by redefining `Controls/<intent>` locally; the
    # key->intent half is the shared leafwing UserIntent map.
    def "Controls" (
        prepend references = @lunco://vessels/control_profiles.usda@</RoverControls>
    )
    {
    }

    # The reusable battery is an assembly child, not a variant-local arc. The
    # power variant selects whether its reference contributes to the composed
    # vehicle, while keeping the component's internal authored relationships in
    # one stable namespace for every realization.
    def Xform "Battery" (
        prepend references = @lunco://components/power/battery.usda@</Battery>
    )
    {
        double3 xformOp:translate = (0, 0.55, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # Chassis collider + visual — 2.0 m × 0.3 m × 3.5 m.
    def Cube "Chassis" (
        prepend references = @lunco://components/mobility/chassis/box_chassis.usda@</Chassis>
    )
    {
        # Silver-white — the baseline workhorse, and the brightest hull in the
        # fleet so it reads first against regolith. Colour is
        # `primvars:displayColor` and nothing else; the hull shader consumes it
        # as the base paint.
        color3f[] primvars:displayColor = [(0.88, 0.89, 0.9)]
        # …with a deep-red accent stripe so it can't be mistaken for the
        # white-grey rocker-bogie at a glance.
        over "HullLook"
        {
            over "Shader"
            {
                color3f inputs:accent_color = (0.72, 0.16, 0.12)
            }
        }
    }

    # Headlights (Spotlights pointing forward and tilted down by 15 deg, with visual geometry and light source)
    def Xform "Headlight_L" (
        prepend references = @lunco://components/lights/headlight.usda@</Headlight>
    )
    {
        double3 xformOp:translate = (-0.8, 0.2, -1.75)
        double3 xformOp:rotateXYZ = (-15, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Xform "Headlight_R" (
        prepend references = @lunco://components/lights/headlight.usda@</Headlight>
    )
    {
        double3 xformOp:translate = (0.8, 0.2, -1.75)
        double3 xformOp:rotateXYZ = (-15, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    # --- Wheels (reference the reusable mobility component) ---
    # WHERE A WHEEL SITS IS A PROPERTY OF THE VEHICLE, so it is authored HERE,
    # once, and NOT in the `drivetrain` variant. It used to be authored twice —
    # `raycast_drivetrain.usda` put the wheel prim at y=-0.15 and
    # `physical_drivetrain.usda` at y=-0.65 — because the prim meant two
    # different points: the strut top in one realization, the axle in the other.
    # One rover then had two ride heights and two centre-of-mass heights, which
    # no tire parameter can compensate for.
    #
    # The wheel prim IS THE AXLE, in both realizations. y=-0.65 is the physical
    # rover's authored drop (chassis half-height 0.15 ⇒ bottom at y=-0.15; a
    # Ø0.8 wheel centred at -0.65 tops out at -0.25 and clears it by 0.10 m).
    # The raycast realization derives its cast origin — the strut top, at
    # `restLength − radius` above the axle — from the authored suspension
    # geometry instead of from a baked-in translate.
    def Cylinder "Wheel_FL" (
        # No local `kind`: a wheel IS a component model, and the kind composes in from
        # the reference along with everything else it brings.
        prepend references = [
            @lunco://components/mobility/wheel.usda@</Wheel>,
            @lunco://components/mobility/suspensions/standard.usda@</Suspension>,
        ]
    )
    {
        double3 xformOp:translate = (-1.0, -0.65, -1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        int physxVehicleWheelAttachment:index = 0
        float inputs:drive.connect = </SkidRover.outputs:drive_left>
    }

    def Cylinder "Wheel_FR" (
        # No local `kind`: a wheel IS a component model, and the kind composes in from
        # the reference along with everything else it brings.
        prepend references = [
            @lunco://components/mobility/wheel.usda@</Wheel>,
            @lunco://components/mobility/suspensions/standard.usda@</Suspension>,
        ]
    )
    {
        double3 xformOp:translate = (1.0, -0.65, -1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        int physxVehicleWheelAttachment:index = 1
        float inputs:drive.connect = </SkidRover.outputs:drive_right>
    }

    def Cylinder "Wheel_RL" (
        # No local `kind`: a wheel IS a component model, and the kind composes in from
        # the reference along with everything else it brings.
        prepend references = [
            @lunco://components/mobility/wheel.usda@</Wheel>,
            @lunco://components/mobility/suspensions/standard.usda@</Suspension>,
        ]
    )
    {
        double3 xformOp:translate = (-1.0, -0.65, 1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        int physxVehicleWheelAttachment:index = 2
        float inputs:drive.connect = </SkidRover.outputs:drive_left>
    }

    def Cylinder "Wheel_RR" (
        # No local `kind`: a wheel IS a component model, and the kind composes in from
        # the reference along with everything else it brings.
        prepend references = [
            @lunco://components/mobility/wheel.usda@</Wheel>,
            @lunco://components/mobility/suspensions/standard.usda@</Suspension>,
        ]
    )
    {
        double3 xformOp:translate = (1.0, -0.65, 1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        int physxVehicleWheelAttachment:index = 3
        float inputs:drive.connect = </SkidRover.outputs:drive_right>
    }

    # --- Motors + reductions -------------------------------------------
    # One motor and one reduction PER DRIVEN WHEEL, each its own part with its own
    # mass, torque curve, efficiency and waste heat. Torque and top speed used to be
    # authored on the wheel; they are the MOTOR's, and what reaches the axle is
    #   τ_axle = stallTorque · (1 − ω_shaft/noLoadSpeed) · ratio · efficiency · demand
    # clamped at the gearbox's `maxOutputTorque`, with the axle's no-load speed
    # noLoadSpeed/ratio = 2400/200 = 12 rad/s — the ONE top-speed number both the
    # raycast and the physical wheel realization obey.
    #
    # `inputs:demand` wires to the SAME drive channel the wheel binds to: the
    # Each wheel's authored connection selects `drive_left` or `drive_right`; those
    # ports live on this rover ROOT.
    #
    # `lunco:motor:drivenWheel` names the WHEEL, not a joint, so it is authored here
    # UNCONDITIONALLY — outside every variant. A wheel exists in both realizations;
    # a joint exists only in `physical`. Where the wheel has a joint the loader
    # follows wheel → joint and writes that joint's drive target; where it does not,
    # the raycast wheel consumes the same axle torque and no-load speed directly.
    #
    # Placed INBOARD of the wheels, under the chassis: they are children of the
    # chassis rigid body, so their housings join its compound collider and must not
    # overlap the wheel colliders (which are their own bodies once jointed).
    def Xform "Motor_FL" (
        prepend references = @lunco://components/mobility/motor.usda@</Motor>
    )
    {
        double3 xformOp:translate = (-0.3, -0.35, -1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:demand.connect = </SkidRover.outputs:drive_left>
        prepend rel lunco:motor:drivenWheel = </SkidRover/Wheel_FL>
    }

    def Xform "Gearbox_FL" (
        prepend references = @lunco://components/mobility/gearbox.usda@</Gearbox>
    )
    {
        double3 xformOp:translate = (-0.52, -0.35, -1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:torque.connect = </SkidRover/Motor_FL.outputs:torque>
    }

    def Xform "Motor_FR" (
        prepend references = @lunco://components/mobility/motor.usda@</Motor>
    )
    {
        double3 xformOp:translate = (0.3, -0.35, -1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:demand.connect = </SkidRover.outputs:drive_right>
        prepend rel lunco:motor:drivenWheel = </SkidRover/Wheel_FR>
    }

    def Xform "Gearbox_FR" (
        prepend references = @lunco://components/mobility/gearbox.usda@</Gearbox>
    )
    {
        double3 xformOp:translate = (0.52, -0.35, -1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:torque.connect = </SkidRover/Motor_FR.outputs:torque>
    }

    def Xform "Motor_RL" (
        prepend references = @lunco://components/mobility/motor.usda@</Motor>
    )
    {
        double3 xformOp:translate = (-0.3, -0.35, 1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:demand.connect = </SkidRover.outputs:drive_left>
        prepend rel lunco:motor:drivenWheel = </SkidRover/Wheel_RL>
    }

    def Xform "Gearbox_RL" (
        prepend references = @lunco://components/mobility/gearbox.usda@</Gearbox>
    )
    {
        double3 xformOp:translate = (-0.52, -0.35, 1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:torque.connect = </SkidRover/Motor_RL.outputs:torque>
    }

    def Xform "Motor_RR" (
        prepend references = @lunco://components/mobility/motor.usda@</Motor>
    )
    {
        double3 xformOp:translate = (0.3, -0.35, 1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:demand.connect = </SkidRover.outputs:drive_right>
        prepend rel lunco:motor:drivenWheel = </SkidRover/Wheel_RR>
    }

    def Xform "Gearbox_RR" (
        prepend references = @lunco://components/mobility/gearbox.usda@</Gearbox>
    )
    {
        double3 xformOp:translate = (0.52, -0.35, 1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:torque.connect = </SkidRover/Motor_RR.outputs:torque>
    }

    # --- Comms ---------------------------------------------------------
    # Shared Earth-tracking antenna. The component owns both its hinges; being a
    # child of this rover body is the mount, so nothing is authored here but the
    # position.
    def Xform "Comms" (
        prepend references = @lunco://components/comms/antenna.usda@</CommsAntenna>
    )
    {
        double3 xformOp:translate = (0, 0.15, -0.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "YawHead" {
            over "DishGimbal" {
                over "DishHead" {
                    over "LinkAperture" {
                        string lunco:link:class = "rover"
                        bool lunco:wifiNode = true
                        double lunco:wifi:maxRangeM = 5000.0
                        over "LinkBeam" {
                            over "Up" {
                                over "Driver" {
                                    custom float lunco:param:earthOnly = 1
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    # --- Drivetrain variant set ---------------------------------------
    # HOW a wheel is simulated, and NOTHING ELSE. Where the wheels sit, what they
    # mass, how much grip they have and what torque reaches them are properties of
    # the ROVER and are authored above, outside this variantSet.
    #
    # `raycast` (the fallback, declared on the root) is therefore EMPTY: a raycast
    # wheel is the absence of a joint. It used to reference a
    # `raycast_drivetrain.usda` whose entire content was a second, different set of
    # wheel translates — one rover with two ride heights. That file is gone; the
    # strut geometry the raycast wheel needs is derived from the authored
    # suspension (`restLength`) instead of being baked into a mount.
    #
    # `physical` brings what genuinely only exists in that realization: the
    # articulation root and the per-wheel revolute joints.
    variantSet "drivetrain" = {
        "raycast" {
        }

        "physical" (
            prepend references = @lunco://components/mobility/physical_drivetrain.usda@</Drivetrain>
        ) {
            # Physical wheels are rigid axles. Replace the compliant raycast
            # suspension arc with the explicit rigid-mount component; leaving the
            # standard arc composed would make the physical projection claim a
            # spring it does not integrate.
            over "Wheel_FL" (
                delete references = @lunco://components/mobility/suspensions/standard.usda@</Suspension>
                prepend references = @lunco://components/mobility/suspensions/rigid.usda@</Suspension>
            ) {}
            over "Wheel_FR" (
                delete references = @lunco://components/mobility/suspensions/standard.usda@</Suspension>
                prepend references = @lunco://components/mobility/suspensions/rigid.usda@</Suspension>
            ) {}
            over "Wheel_RL" (
                delete references = @lunco://components/mobility/suspensions/standard.usda@</Suspension>
                prepend references = @lunco://components/mobility/suspensions/rigid.usda@</Suspension>
            ) {}
            over "Wheel_RR" (
                delete references = @lunco://components/mobility/suspensions/standard.usda@</Suspension>
                prepend references = @lunco://components/mobility/suspensions/rigid.usda@</Suspension>
            ) {}
        }
    }

    # --- Drive law -----------------------------------------------------------
    # HOW throttle/steer become per-side drive is COMPOSITION, not an enumeration.
    # The plain authored state below is the instant built-in skid kernel. To fly a
    # solver-clocked first-order motor lag instead, compose the drive law on as a
    # reference arc, exactly like the OBC above:
    #
    #   def "Rover" (
    #       prepend references = [
    #           @lunco://vessels/rovers/skid_rover.usda@</SkidRover>,
    #           @lunco://components/mobility/drive_laws/modelica_skid.usda@</DriveLaw>,
    #       ]
    #   ) {}
    #
    # A drive law is just a `LunCoProgramAPI` on the vessel and the file extension
    # picks the engine, so there is nothing for a closed variant list to add — it
    # could only ever name the laws that existed when this file was written.
    # The wheel drive connections below select the port pair the skid law writes.

    # --- Power: does driving cost anything ----------------------------------
    # ORTHOGONAL to the drive law (which decides how commands become drive) and
    # `drivetrain` (how wheels are realized): `infinite` composes an ideal
    # voltage source with the motors. It is still a real generated Modelica
    # network, but it has no finite storage limit. `battery` replaces that
    # source with the battery state model; its one generated DAE solves the
    # battery and motor loads together.
    variantSet "power" = {
        "infinite" {
            over "Battery" (
                delete references = @lunco://components/power/battery.usda@</Battery>
            ) {}
            def Xform "PowerSource" (
                prepend references = @lunco://components/power/ideal_voltage_source.usda@</IdealVoltageSource>
            )
            {
            }
            def Scope "Electrical" (
                prepend apiSchemas = ["CollectionAPI:components"]
            )
            {
                float inputs:drive_left.connect = </SkidRover.outputs:drive_left>
                float inputs:drive_right.connect = </SkidRover.outputs:drive_right>
                float outputs:bus_voltage.connect = </SkidRover/PowerSource.outputs:terminal_voltage_v>
                float outputs:bus_current.connect = </SkidRover/PowerSource.outputs:terminal_current_a>
                float outputs:bus_power.connect = </SkidRover/PowerSource.outputs:terminal_power_w>
                float outputs:motor_heat_FL.connect = </SkidRover/Motor_FL.outputs:heat>
                float outputs:motor_heat_FR.connect = </SkidRover/Motor_FR.outputs:heat>
                float outputs:motor_heat_RL.connect = </SkidRover/Motor_RL.outputs:heat>
                float outputs:motor_heat_RR.connect = </SkidRover/Motor_RR.outputs:heat>
                uniform token collection:components:expansionRule = "explicitOnly"
                prepend rel collection:components:includes = [
                    </SkidRover/PowerSource>,
                    </SkidRover/Motor_FL>,
                    </SkidRover/Motor_FR>,
                    </SkidRover/Motor_RL>,
                    </SkidRover/Motor_RR>,
                ]
            }
            over "Motor_FL" {
                float inputs:demand.connect = </SkidRover/Electrical.inputs:drive_left>
                custom token connectors:p.connect = </SkidRover/PowerSource.connectors:p>
            }
            over "Motor_FR" {
                float inputs:demand.connect = </SkidRover/Electrical.inputs:drive_right>
                custom token connectors:p.connect = </SkidRover/PowerSource.connectors:p>
            }
            over "Motor_RL" {
                float inputs:demand.connect = </SkidRover/Electrical.inputs:drive_left>
                custom token connectors:p.connect = </SkidRover/PowerSource.connectors:p>
            }
            over "Motor_RR" {
                float inputs:demand.connect = </SkidRover/Electrical.inputs:drive_right>
                custom token connectors:p.connect = </SkidRover/PowerSource.connectors:p>
            }
        }

        "battery" {
            def Scope "Electrical" (
                prepend apiSchemas = ["CollectionAPI:components"]
            )
            {
                float inputs:drive_left.connect = </SkidRover.outputs:drive_left>
                float inputs:drive_right.connect = </SkidRover.outputs:drive_right>
                float outputs:soc.connect = </SkidRover/Battery.outputs:soc_out>
                float outputs:battery_drained.connect = </SkidRover/Battery.outputs:drained>
                float outputs:battery_net_power.connect = </SkidRover/Battery.outputs:net_power_w>
                float outputs:battery_charge_power.connect = </SkidRover/Battery.outputs:charge_power_w>
                float outputs:battery_discharge_power.connect = </SkidRover/Battery.outputs:discharge_power_w>
                # Forward each motor's solved `heat` to the electrical boundary so
                # the thermal island can source it as a cross-domain SimConnection.
                float outputs:motor_heat_FL.connect = </SkidRover/Motor_FL.outputs:heat>
                float outputs:motor_heat_FR.connect = </SkidRover/Motor_FR.outputs:heat>
                float outputs:motor_heat_RL.connect = </SkidRover/Motor_RL.outputs:heat>
                float outputs:motor_heat_RR.connect = </SkidRover/Motor_RR.outputs:heat>
                uniform token collection:components:expansionRule = "explicitOnly"
                prepend rel collection:components:includes = [
                    </SkidRover/Battery>,
                    </SkidRover/Motor_FL>,
                    </SkidRover/Motor_FR>,
                    </SkidRover/Motor_RL>,
                    </SkidRover/Motor_RR>,
                ]
            }
            over "Motor_FL" {
                float inputs:demand.connect = </SkidRover/Electrical.inputs:drive_left>
                custom token connectors:p.connect = </SkidRover/Battery.connectors:p>
            }
            over "Motor_FR" {
                float inputs:demand.connect = </SkidRover/Electrical.inputs:drive_right>
                custom token connectors:p.connect = </SkidRover/Battery.connectors:p>
            }
            over "Motor_RL" {
                float inputs:demand.connect = </SkidRover/Electrical.inputs:drive_left>
                custom token connectors:p.connect = </SkidRover/Battery.connectors:p>
            }
            over "Motor_RR" {
                float inputs:demand.connect = </SkidRover/Electrical.inputs:drive_right>
                custom token connectors:p.connect = </SkidRover/Battery.connectors:p>
            }

            # The wheel receives the motor's solved available command. Its
            # voltage authority comes from the same electrical model that
            # reports battery power; no battery-specific runtime branch exists.
            over "Wheel_FL" {
                float inputs:drive.connect = </SkidRover/Motor_FL.outputs:available_demand>
            }
            over "Wheel_FR" {
                float inputs:drive.connect = </SkidRover/Motor_FR.outputs:available_demand>
            }
            over "Wheel_RL" {
                float inputs:drive.connect = </SkidRover/Motor_RL.outputs:available_demand>
            }
            over "Wheel_RR" {
                float inputs:drive.connect = </SkidRover/Motor_RR.outputs:available_demand>
            }

            def LunCoEvent "BatteryDrained" {
                float inputs:trigger.connect = </SkidRover/Electrical.outputs:battery_drained>
                uniform token lunco:event:name = "battery_drained"
                uniform token lunco:event:severity = "warning"
                uniform bool lunco:event:latched = true
                double lunco:event:qualificationTime = 0.0
            }

        }
    }

    # Generation is independent of storage: a panel owns one electrical source
    # pin, while this assembly supplies the optional battery-bus connection.
    # Selecting solar without `power=battery` leaves a physical panel with no
    # generated DAE; selecting both composes one connected electrical island.
    variantSet "generation" = {
        "none" {
        }

        "solar" {
            def Xform "SolarPanel" (
                prepend references = @lunco://components/power/solar_panel.usda@</SolarPanel>
            )
            {
                double3 xformOp:translate = (0, 0.45, 0)
                double3 xformOp:scale = (0.42, 0.2, 0.42)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                # ONE spec per prim, per layer. This was a sibling
                # `over "SolarPanel"` below, and the `over` won: the composed
                # panel kept `connectors:p` and lost the reference, the children,
                # `LunCoProgramAPI` and `info:sourceAsset`. The runtime then
                # blamed the collection — `SolarPanel is outside collection
                # Electrical` — and every solar rover's island was rejected. See
                # `sibling_over_does_not_erase_a_def_in_the_same_layer`.
                custom token connectors:p.connect = </SkidRover/Battery.connectors:p>
                # Environment is runtime-provided, not a generated Modelica
                # component. It crosses the electrical island once through its
                # typed boundary, then the panel consumes that boundary input.
                float inputs:sun_mount_x.connect = </SkidRover/Electrical.inputs:sun_mount_x>
                float inputs:sun_mount_y.connect = </SkidRover/Electrical.inputs:sun_mount_y>
                float inputs:sun_mount_z.connect = </SkidRover/Electrical.inputs:sun_mount_z>

                def Xform "Environment" (
                    prepend references = @lunco://components/environment/probe.usda@</EnvironmentProbe>
                )
                {
                }
            }
            # `Electrical` is contributed only by the battery power variant, a
            # SIBLING variantSet — a different composition arc, which does merge.
            # This over therefore expresses a connection when both assembly
            # layers are present, never a panel-side dependency.
            over "Electrical"
            {
                float inputs:sun_mount_x.connect = </SkidRover/SolarPanel/Environment.outputs:sun_mount_x>
                float inputs:sun_mount_y.connect = </SkidRover/SolarPanel/Environment.outputs:sun_mount_y>
                float inputs:sun_mount_z.connect = </SkidRover/SolarPanel/Environment.outputs:sun_mount_z>
                float outputs:solar_power.connect = </SkidRover/SolarPanel.outputs:power_out>
                float outputs:solar_available_power.connect = </SkidRover/SolarPanel.outputs:available_power_w>
                float outputs:solar_incidence.connect = </SkidRover/SolarPanel.outputs:cos_incidence>
                prepend rel collection:components:includes = [</SkidRover/SolarPanel>]
            }
        }
    }

    # --- Thermal: a SEPARATE domain layer, not a graft onto Electrical ------
    # `basic` composes a self-contained `Scope "Thermal"` — its OWN
    # `CollectionAPI:components`, compiled to its OWN generated DAE — coupled to
    # the electrical island by CAUSAL cross-domain wires only: each motor's
    # `outputs:heat` feeds a `MotorHeatLoad.inputs:heat_w` here as a runtime
    # SimConnection. The acausal `connectors:port` edges stay INSIDE this
    # collection, so thermal compiles independently of electrical. All four
    # motors get a heat-load bridge; left and right banks are joined by an
    # explicit chassis ThermalConductor.
    variantSet "thermal" = {
        "none" {
        }

        "basic" {
            def Scope "Thermal" (
                prepend apiSchemas = ["CollectionAPI:components"]
                doc = "Rover thermal control network: motor dissipation → masses → radiators."
            )
            {
                float inputs:motor_heat_FL.connect = </SkidRover/Electrical.outputs:motor_heat_FL>
                float inputs:motor_heat_FR.connect = </SkidRover/Electrical.outputs:motor_heat_FR>
                float inputs:motor_heat_RL.connect = </SkidRover/Electrical.outputs:motor_heat_RL>
                float inputs:motor_heat_RR.connect = </SkidRover/Electrical.outputs:motor_heat_RR>

                float outputs:motor_temp_left.connect  = </SkidRover/Thermal/MotorThermalLeft.outputs:temp_k>
                float outputs:motor_temp_right.connect = </SkidRover/Thermal/MotorThermalRight.outputs:temp_k>

                uniform token collection:components:expansionRule = "explicitOnly"
                prepend rel collection:components:includes = [
                    </SkidRover/Thermal/MotorHeat_FL>,
                    </SkidRover/Thermal/MotorHeat_RL>,
                    </SkidRover/Thermal/MotorHeat_FR>,
                    </SkidRover/Thermal/MotorHeat_RR>,
                    </SkidRover/Thermal/MotorThermalLeft>,
                    </SkidRover/Thermal/MotorThermalRight>,
                    </SkidRover/Thermal/MotorRadiatorLeft>,
                    </SkidRover/Thermal/MotorRadiatorRight>,
                    </SkidRover/Thermal/ThermalBridge>,
                ]

                def Xform "ThermalBridge" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</ThermalConductor>
                )
                {
                    custom token connectors:port_a.connect = </SkidRover/Thermal/MotorThermalLeft.connectors:port>
                    custom token connectors:port_b.connect = </SkidRover/Thermal/MotorThermalRight.connectors:port>
                }

                # ── Left bank: FL + RL into one mass/radiator node ──
                def Xform "MotorHeat_FL" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorHeatLoad>
                )
                {
                    float inputs:heat_w.connect = </SkidRover/Thermal.inputs:motor_heat_FL>
                    custom token connectors:port.connect = </SkidRover/Thermal/MotorThermalLeft.connectors:port>
                }
                def Xform "MotorHeat_RL" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorHeatLoad>
                )
                {
                    float inputs:heat_w.connect = </SkidRover/Thermal.inputs:motor_heat_RL>
                    custom token connectors:port.connect = </SkidRover/Thermal/MotorThermalLeft.connectors:port>
                }
                def Xform "MotorThermalLeft" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorThermalMass>
                )
                {
                }
                def Xform "MotorRadiatorLeft" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorRadiator>
                )
                {
                    custom token connectors:port.connect = </SkidRover/Thermal/MotorThermalLeft.connectors:port>
                }

                # ── Right bank: FR + RR into one mass/radiator node ──
                def Xform "MotorHeat_FR" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorHeatLoad>
                )
                {
                    float inputs:heat_w.connect = </SkidRover/Thermal.inputs:motor_heat_FR>
                    custom token connectors:port.connect = </SkidRover/Thermal/MotorThermalRight.connectors:port>
                }
                def Xform "MotorHeat_RR" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorHeatLoad>
                )
                {
                    float inputs:heat_w.connect = </SkidRover/Thermal.inputs:motor_heat_RR>
                    custom token connectors:port.connect = </SkidRover/Thermal/MotorThermalRight.connectors:port>
                }
                def Xform "MotorThermalRight" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorThermalMass>
                )
                {
                }
                def Xform "MotorRadiatorRight" (
                    prepend references = @lunco://components/thermal/motor_thermal.usda@</MotorRadiator>
                )
                {
                    custom token connectors:port.connect = </SkidRover/Thermal/MotorThermalRight.connectors:port>
                }
            }
        }
    }
}
