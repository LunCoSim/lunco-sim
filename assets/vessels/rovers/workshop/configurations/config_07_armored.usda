#usda 1.0
(
    defaultPrim = "Config07Armored"
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "Config07Armored" (
    kind = "assembly"
    doc = "Armored, 45 points: armor 15 + redundant computer 10 + high-torque drive 20. Basic rover systems are free."
