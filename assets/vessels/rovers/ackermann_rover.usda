#usda 1.0
(
    defaultPrim = "AckermannRover"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "AckermannRover" (
    doc = "Four-wheel Ackermann-steer lunar rover with selectable raycast or physical drivetrain."
    kind = "assembly"
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI", "PhysxVehicleContextAPI", "LunCoCatalogAPI", "CollectionAPI:components", "PhysxVehicleAPI"]
    prepend references = @lunco://components/mobility/drive_laws/modelica_ackermann.usda@</DriveLaw>
    prepend variantSets = ["drivetrain", "power"]
    variants = { string "drivetrain" = "raycast"; string "power" = "infinite" }
)
{
    uniform bool lunco:spawnable = true
    uniform token lunco:steeringGeometry = "ackermann"
    float physics:mass = 1000.0
    float3 physics:diagonalInertia = (1028.0, 1354.0, 341.0)
    float3 physics:centerOfMass = (0.0, 0.0, 0.0)
    float outputs:drive_left = 0.0
    float outputs:drive_right = 0.0
    float outputs:heading_fl = 0.0
    float outputs:heading_fr = 0.0
    float outputs:brake = 0.0
    float physxRigidBody:linearDamping = 0.5
    float physxRigidBody:angularDamping = 2.0
    variantSet "drivetrain" = {
        "raycast" {
        }
        "physical" (
            prepend references = @lunco://components/mobility/physical_drivetrain.usda@</Drivetrain>
        ) {
            def Xform "SteeringKnuckle_FL" (
                prepend references = @lunco://components/mobility/steering_knuckle.usda@</SteeringKnuckle>
            )
            {
                double3 xformOp:translate = (-1.0, -0.65, -1.225)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
            def Xform "SteeringKnuckle_FR" (
                prepend references = @lunco://components/mobility/steering_knuckle.usda@</SteeringKnuckle>
            )
            {
                double3 xformOp:translate = (1.0, -0.65, -1.225)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
            def PhysicsRevoluteJoint "Steering_FL_Hinge"
            {
                rel physics:body0 = </AckermannRover>
                rel physics:body1 = </AckermannRover/SteeringKnuckle_FL>
                uniform token physics:axis = "Y"
                float physics:lowerLimit = -30.0
                float physics:upperLimit = 30.0
                float inputs:angle
                float inputs:angle.connect = </AckermannRover.outputs:heading_fl>
                point3f physics:localPos0 = (-1.0, -0.6499999761581421, -1.225000023841858)
            }
            def PhysicsRevoluteJoint "Steering_FR_Hinge"
            {
                rel physics:body0 = </AckermannRover>
                rel physics:body1 = </AckermannRover/SteeringKnuckle_FR>
                uniform token physics:axis = "Y"
                float physics:lowerLimit = -30.0
                float physics:upperLimit = 30.0
                float inputs:angle
                float inputs:angle.connect = </AckermannRover.outputs:heading_fr>
                point3f physics:localPos0 = (1.0, -0.6499999761581421, -1.225000023841858)
            }
            over "Suspension_FL_Slider"
            {
                rel physics:body0 = </AckermannRover/SteeringKnuckle_FL>
                point3f physics:localPos0 = (0.0, 0.0, 0.0)
            }
            over "Suspension_FR_Slider"
            {
                rel physics:body0 = </AckermannRover/SteeringKnuckle_FR>
                point3f physics:localPos0 = (0.0, 0.0, 0.0)
            }
            over "Suspension_FL" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI"]
            )
            {
                over "Wheel_FL" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsFilteredPairsAPI"]
                )
                {
                    bool physics:rigidBodyEnabled = true
                    bool physics:collisionEnabled = true
                    rel physics:filteredPairs = [</AckermannRover/Chassis>, </AckermannRover/SteeringKnuckle_FL>]
                }
            }
            over "Suspension_FR" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI"]
            )
            {
                over "Wheel_FR" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsFilteredPairsAPI"]
                )
                {
                    bool physics:rigidBodyEnabled = true
                    bool physics:collisionEnabled = true
                    rel physics:filteredPairs = [</AckermannRover/Chassis>, </AckermannRover/SteeringKnuckle_FR>]
                }
            }
            over "Suspension_RL" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI"]
            )
            {
                over "Wheel_RL" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsFilteredPairsAPI"]
                )
                {
                    bool physics:rigidBodyEnabled = true
                    bool physics:collisionEnabled = true
                    rel physics:filteredPairs = </AckermannRover/Chassis>
                }
            }
            over "Suspension_RR" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI"]
            )
            {
                over "Wheel_RR" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsFilteredPairsAPI"]
                )
                {
                    bool physics:rigidBodyEnabled = true
                    bool physics:collisionEnabled = true
                    rel physics:filteredPairs = </AckermannRover/Chassis>
                }
            }
            over "Suspension_RL_Slider"
            {
                point3f physics:localPos0 = (-1.0, -0.6499999761581421, 1.225000023841858)
            }
            over "Suspension_RR_Slider"
            {
                point3f physics:localPos0 = (1.0, -0.6499999761581421, 1.225000023841858)
            }
        }
    }
    variantSet "power" = {
        "infinite" {
            uniform token collection:components:expansionRule = "explicitOnly"
            rel collection:components:includes
            prepend rel collection:components:includes = [</AckermannRover/PowerSource>, </AckermannRover/Motor_FL>, </AckermannRover/TorqueSource_FL>, </AckermannRover/Motor_FR>, </AckermannRover/TorqueSource_FR>, </AckermannRover/Motor_RL>, </AckermannRover/TorqueSource_RL>, </AckermannRover/Motor_RR>, </AckermannRover/TorqueSource_RR>, </AckermannRover/Gearbox_FL>, </AckermannRover/Gearbox_FR>, </AckermannRover/Gearbox_RL>, </AckermannRover/Gearbox_RR>, </AckermannRover/Shaft_FL>, </AckermannRover/Shaft_FR>, </AckermannRover/Shaft_RL>, </AckermannRover/Shaft_RR>]
            float inputs:drive_left
            float inputs:drive_left.connect = </AckermannRover.outputs:drive_left>
            float inputs:drive_right
            float inputs:drive_right.connect = </AckermannRover.outputs:drive_right>
            float inputs:shaft_speed_FL
            float inputs:shaft_speed_FL.connect = </AckermannRover/Suspension_FL/Wheel_FL.outputs:shaft_speed>
            float inputs:shaft_speed_FR
            float inputs:shaft_speed_FR.connect = </AckermannRover/Suspension_FR/Wheel_FR.outputs:shaft_speed>
            float inputs:shaft_speed_RL
            float inputs:shaft_speed_RL.connect = </AckermannRover/Suspension_RL/Wheel_RL.outputs:shaft_speed>
            float inputs:shaft_speed_RR
            float inputs:shaft_speed_RR.connect = </AckermannRover/Suspension_RR/Wheel_RR.outputs:shaft_speed>
            float outputs:bus_voltage
            float outputs:bus_voltage.connect = </AckermannRover/PowerSource.outputs:terminal_voltage_v>
            float outputs:bus_current
            float outputs:bus_current.connect = </AckermannRover/PowerSource.outputs:terminal_current_a>
            float outputs:bus_power
            float outputs:bus_power.connect = </AckermannRover/PowerSource.outputs:terminal_power_w>
            def Xform "PowerSource" (
                prepend references = @lunco://components/power/ideal_voltage_source.usda@</IdealVoltageSource>
            )
            {
            }
            over "Motor_FL"
            {
                float inputs:demand
                float inputs:demand.connect = </AckermannRover.inputs:drive_left>
                custom token connectors:p
                token connectors:p.connect = </AckermannRover/PowerSource.connectors:p>
            }
            over "Motor_FR"
            {
                float inputs:demand
                float inputs:demand.connect = </AckermannRover.inputs:drive_right>
                custom token connectors:p
                token connectors:p.connect = </AckermannRover/PowerSource.connectors:p>
            }
            over "Motor_RL"
            {
                float inputs:demand
                float inputs:demand.connect = </AckermannRover.inputs:drive_left>
                custom token connectors:p
                token connectors:p.connect = </AckermannRover/PowerSource.connectors:p>
            }
            over "Motor_RR"
            {
                float inputs:demand
                float inputs:demand.connect = </AckermannRover.inputs:drive_right>
                custom token connectors:p
                token connectors:p.connect = </AckermannRover/PowerSource.connectors:p>
            }
        }
    }
    def Camera "FrontCamera" (
        prepend references = @lunco://components/cameras/rover_front_camera.usda@</FrontCamera>
    )
    {
    }
    def "Controls" (
        prepend references = @lunco://vessels/control_profiles.usda@</RoverControls>
    )
    {
    }
    def Cube "Chassis" (
        prepend references = @lunco://components/mobility/chassis/box_chassis.usda@</Chassis>
    )
    {
        color3f[] primvars:displayColor = [(0.18000000715255737, 0.3199999928474426, 0.6200000047683716)]
    }
    def Xform "Headlight_L" (
        prepend references = @lunco://components/lights/headlight.usda@</Headlight>
    )
    {
        double3 xformOp:translate = (-0.8, 0.2, -1.75)
        double3 xformOp:rotateXYZ = (-15.0, 0.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
    def Xform "Headlight_R" (
        prepend references = @lunco://components/lights/headlight.usda@</Headlight>
    )
    {
        double3 xformOp:translate = (0.8, 0.2, -1.75)
        double3 xformOp:rotateXYZ = (-15.0, 0.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
    def Xform "Suspension_FL" (
        prepend references = @lunco://components/mobility/suspensions/physical_carrier.usda@</SuspensionCarrier>
    )
    {
        double3 xformOp:translate = (-1.0, -0.65, -1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Cylinder "Wheel_FL" (
            prepend apiSchemas = ["PhysxVehicleWheelAttachmentAPI", "PhysxVehicleWheelAPI"]
            prepend references = [@lunco://components/mobility/wheel.usda@</Wheel>, @lunco://components/mobility/suspensions/standard.usda@</Suspension>]
        )
        {
            double3 xformOp:translate = (0.0, 0.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            int physxVehicleWheelAttachment:index = 0
            float physxVehicleWheel:moi = 6.800000190734863
            float inputs:drive
            float inputs:drive.connect = </AckermannRover/Shaft_FL.outputs:torque>
            float inputs:heading
            float inputs:heading.connect = </AckermannRover.outputs:heading_fl>
        }
    }
    def Xform "Suspension_FR" (
        prepend references = @lunco://components/mobility/suspensions/physical_carrier.usda@</SuspensionCarrier>
    )
    {
        double3 xformOp:translate = (1.0, -0.65, -1.225)
