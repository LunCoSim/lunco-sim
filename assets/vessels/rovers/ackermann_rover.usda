#usda 1.0
(
    defaultPrim = "AckermannRover"
    upAxis = "Y"
    metersPerUnit = 1
)

# Base Ackermann-Steer Rover — same Xform-root + child-Chassis form
# as `skid_rover.usda` (see that file's header comment for the
# rationale + the `drivetrain` variantSet contract). Chassis:
# 2.0 m × 0.3 m × 3.5 m. Mass: 1000 kg.
#
# Carries the `drivetrain` variantSet (raycast | physical):
#   * `raycast`             — visual-only contact-probe wheels.
#   * `physical`            — each wheel is mounted on an authored prismatic
#     suspension carrier and bound to it by a per-wheel
#     `PhysicsRevoluteJoint`. Joint rel-targets are asset-local and translate
#     through the reference arc.

def Xform "AckermannRover" (
    doc = "Four-wheel Ackermann-steer lunar rover with selectable raycast or physical drivetrain."
    # An ASSEMBLY: a model built out of other models. Its wheels are component models
    # that arrive by reference, and USD forbids a `component` from containing them.
    kind = "assembly"
    prepend apiSchemas = [
        "PhysicsRigidBodyAPI", "PhysxRigidBodyAPI",
        "PhysicsMassAPI",
        "PhysxVehicleContextAPI",
        "PhysxVehicleAckermannSteeringAPI", "LunCoCatalogAPI"
    ]
    # The ON-BOARD COMPUTER, as a second reference arc — the rover's COMMAND
    # SURFACE (`throttle`/`steer`/`brake`). Ships with the chassis: a complete
    # vehicle comes with its computer, and without one this rover accepts no
    # commands at all. See `skid_rover.usda` for the full rationale.
    prepend references = @lunco://components/avionics/obc.usda@</OBC>
    prepend references = @lunco://components/cameras/rover_front_camera.usda@</RoverFrontCamera>
    prepend variantSets = ["drivetrain", "power"]
    variants = {
        string drivetrain = "raycast"
        string power = "infinite"
    }
)
{
    uniform bool lunco:spawnable = true

    # --- Steering (PhysxVehicleAckermannSteeringAPI, applied above) ---
    # The steer lock belongs to the VEHICLE, not to a wheel: it is one property of one
    # steering system, and a rover's wheels do not each get an opinion about it. PhysX
    # agrees — `physxVehicleWheel:maxSteerAngle` is deprecated in favour of this.
    # RADIANS, as everywhere in PhysX (only the authoring wizard's UI is in degrees).
    # 0.5 rad = 28.6°, the lock this rover has always driven with.
    float physxVehicleAckermannSteering:maxSteerAngle = 0.5
    # 0.0 = parallel steering. The wheels are steered by a shared angle today; full
    # Ackermann geometry (inner wheel turns tighter) is not modelled yet.
    float physxVehicleAckermannSteering:strength = 0.0

    float physics:mass = 1000.0
    # Symmetric box chassis: the body frame origin is the authored COM for both
    # raycast and joint realizations.
    float3 physics:centerOfMass = (0.0, 0.0, 0.0)
    float lunco:spawnLift = 1.0
    float outputs:drive_left = 0.0
    float outputs:drive_right = 0.0
    float outputs:steering = 0.0
    float outputs:brake = 0.0

    # Ground speed as a retained channel — the avian `speed` port on this body
    # (magnitude of its linear velocity). See `rocker_bogie.usda` for why speed is
    # authored on the chassis rather than on a component.
    float physxRigidBody:linearDamping = 0.5
    float physxRigidBody:angularDamping = 2.0

    # Control profile (intent -> port). Child `references` arc so it composes
    # through a spawn/reference exactly like the wheels below.
    def "Controls" (
        prepend references = @lunco://vessels/control_profiles.usda@</RoverControls>
    )
    {
    }

    def Cube "Chassis" (
        prepend references = @lunco://components/mobility/chassis/box_chassis.usda@</Chassis>
    )
    {
        # Deep blue — the steered-axle archetype. Colour is
        # `primvars:displayColor` and nothing else; the hull shader consumes it
        # as the base paint.
        color3f[] primvars:displayColor = [(0.18, 0.32, 0.62)]
    }

    # Headlights (Spotlights pointing forward and tilted down by 15 deg, with visual geometry and light source)
    def Xform "Headlight_L" (
        prepend references = @lunco://components/lights/headlight.usda@</Headlight>
    )
    {
        double3 xformOp:translate = (-0.8, 0.2, -1.75)
        double3 xformOp:rotateXYZ = (-15, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Xform "Headlight_R" (
        prepend references = @lunco://components/lights/headlight.usda@</Headlight>
    )
    {
        double3 xformOp:translate = (0.8, 0.2, -1.75)
        double3 xformOp:rotateXYZ = (-15, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    # --- Wheels ---------------------------------------------------------
    # The mount is a property of the VEHICLE and is authored here, once, for both
    # realizations — see `skid_rover.usda` for the full rationale. The wheel prim
    # IS THE AXLE either way; the raycast realization derives its strut top
    # (`restLength − radius` above the axle) from the authored suspension.
    def Xform "Suspension_FL" (
        prepend references = @lunco://components/mobility/suspensions/physical_carrier.usda@</SuspensionCarrier>
    )
    {
        double3 xformOp:translate = (-1.0, -0.65, -1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]

    def Cylinder "Wheel_FL" (
        prepend apiSchemas = ["PhysxVehicleWheelAttachmentAPI", "PhysxVehicleWheelAPI"]
        prepend references = [
            @lunco://components/mobility/wheel.usda@</Wheel>,
            @lunco://components/mobility/suspensions/standard.usda@</Suspension>,
        ]
    )
    {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        int physxVehicleWheelAttachment:index = 0
        # Complete axle inertia for the authored motor, reduction, and tire assembly.
        # The 6.8 kg.m2 value is the composed USD mechanical contract.
        float physxVehicleWheel:moi = 6.8
        float inputs:drive.connect = </AckermannRover/Shaft_FL.outputs:torque>
        float inputs:steer.connect = </AckermannRover.outputs:steering>
    }
    }

    def Xform "Suspension_FR" (
        prepend references = @lunco://components/mobility/suspensions/physical_carrier.usda@</SuspensionCarrier>
    )
    {
        double3 xformOp:translate = (1.0, -0.65, -1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]

    def Cylinder "Wheel_FR" (
        prepend apiSchemas = ["PhysxVehicleWheelAttachmentAPI", "PhysxVehicleWheelAPI"]
        prepend references = [
            @lunco://components/mobility/wheel.usda@</Wheel>,
            @lunco://components/mobility/suspensions/standard.usda@</Suspension>,
        ]
    )
    {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        int physxVehicleWheelAttachment:index = 1
        # Complete axle inertia for the authored motor, reduction, and tire assembly.
        # The 6.8 kg.m2 value is the composed USD mechanical contract.
        float physxVehicleWheel:moi = 6.8
        float inputs:drive.connect = </AckermannRover/Shaft_FR.outputs:torque>
        float inputs:steer.connect = </AckermannRover.outputs:steering>
    }
    }

    def Xform "Suspension_RL" (
        prepend references = @lunco://components/mobility/suspensions/physical_carrier.usda@</SuspensionCarrier>
    )
    {
        double3 xformOp:translate = (-1.0, -0.65, 1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]

    def Cylinder "Wheel_RL" (
        prepend apiSchemas = ["PhysxVehicleWheelAttachmentAPI", "PhysxVehicleWheelAPI"]
        prepend references = [
            @lunco://components/mobility/wheel.usda@</Wheel>,
            @lunco://components/mobility/suspensions/standard.usda@</Suspension>,
        ]
    )
    {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        int physxVehicleWheelAttachment:index = 2
        # Complete axle inertia for the authored motor, reduction, and tire assembly.
        # The 6.8 kg.m2 value is the composed USD mechanical contract.
        float physxVehicleWheel:moi = 6.8
        float inputs:drive.connect = </AckermannRover/Shaft_RL.outputs:torque>
    }
    }

    def Xform "Suspension_RR" (
        prepend references = @lunco://components/mobility/suspensions/physical_carrier.usda@</SuspensionCarrier>
    )
    {
        double3 xformOp:translate = (1.0, -0.65, 1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]

    def Cylinder "Wheel_RR" (
        prepend apiSchemas = ["PhysxVehicleWheelAttachmentAPI", "PhysxVehicleWheelAPI"]
        prepend references = [
            @lunco://components/mobility/wheel.usda@</Wheel>,
            @lunco://components/mobility/suspensions/standard.usda@</Suspension>,
        ]
    )
    {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        int physxVehicleWheelAttachment:index = 3
        # Complete axle inertia for the authored motor, reduction, and tire assembly.
        # The 6.8 kg.m2 value is the composed USD mechanical contract.
        float physxVehicleWheel:moi = 6.8
        float inputs:drive.connect = </AckermannRover/Shaft_RR.outputs:torque>
    }
    }

    # --- Motors + reductions -------------------------------------------
    # One motor and one reduction per driven wheel — see `skid_rover.usda` for the
    # full rationale. Ackermann steers with the KNUCKLES, so all four wheels are
    # driven from the same two per-side channels the built-in kernel writes; the
    # steering command is a separate port and no motor listens to it.
    #
    #   τ_axle = stallTorque · (1 − ω_shaft/noLoadSpeed) · ratio · efficiency · demand
    #   axle no-load speed = 2400 / 200 = 12 rad/s
    def Xform "Motor_FL" (
        prepend references = @lunco://components/mobility/motor.usda@</Motor>
    )
    {
        double3 xformOp:translate = (-0.3, -0.35, -1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:demand.connect = </AckermannRover.outputs:drive_left>
        float inputs:speed.connect = </AckermannRover/Gearbox_FL.outputs:speed_a>
    }

    def Xform "TorqueSource_FL" (
        prepend references = @lunco://components/mobility/torque.usda@</Torque>
    )
    {
        float inputs:tau_ref.connect = </AckermannRover/Motor_FL.outputs:shaft_torque>
        custom token connectors:flange.connect = </AckermannRover/Gearbox_FL.connectors:flange_a>
    }

    def Xform "Gearbox_FL" (
        prepend references = @lunco://components/mobility/gearbox.usda@</Gearbox>
    )
    {
        double3 xformOp:translate = (-0.52, -0.35, -1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:ratio = 200.0
        float inputs:eta = 0.85
        float inputs:max_output_torque = 400.0
        custom token connectors:flange_a.connect = </AckermannRover/TorqueSource_FL.connectors:flange>
        custom token connectors:flange_b.connect = </AckermannRover/Shaft_FL.connectors:flange>
    }

    def Xform "Motor_FR" (
        prepend references = @lunco://components/mobility/motor.usda@</Motor>
    )
    {
        double3 xformOp:translate = (0.3, -0.35, -1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:demand.connect = </AckermannRover.outputs:drive_right>
        float inputs:speed.connect = </AckermannRover/Gearbox_FR.outputs:speed_a>
    }


    def Xform "TorqueSource_FR" (
        prepend references = @lunco://components/mobility/torque.usda@</Torque>
    )
    {
        float inputs:tau_ref.connect = </AckermannRover/Motor_FR.outputs:shaft_torque>
        custom token connectors:flange.connect = </AckermannRover/Gearbox_FR.connectors:flange_a>
    }

    def Xform "Gearbox_FR" (
        prepend references = @lunco://components/mobility/gearbox.usda@</Gearbox>
    )
    {
        double3 xformOp:translate = (0.52, -0.35, -1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:ratio = 200.0
        float inputs:eta = 0.85
        float inputs:max_output_torque = 400.0
        custom token connectors:flange_a.connect = </AckermannRover/TorqueSource_FR.connectors:flange>
        custom token connectors:flange_b.connect = </AckermannRover/Shaft_FR.connectors:flange>
    }

    def Xform "Motor_RL" (
        prepend references = @lunco://components/mobility/motor.usda@</Motor>
    )
    {
        double3 xformOp:translate = (-0.3, -0.35, 1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:demand.connect = </AckermannRover.outputs:drive_left>
        float inputs:speed.connect = </AckermannRover/Gearbox_RL.outputs:speed_a>
    }


    def Xform "TorqueSource_RL" (
        prepend references = @lunco://components/mobility/torque.usda@</Torque>
    )
    {
        float inputs:tau_ref.connect = </AckermannRover/Motor_RL.outputs:shaft_torque>
        custom token connectors:flange.connect = </AckermannRover/Gearbox_RL.connectors:flange_a>
    }

    def Xform "Gearbox_RL" (
        prepend references = @lunco://components/mobility/gearbox.usda@</Gearbox>
    )
    {
        double3 xformOp:translate = (-0.52, -0.35, 1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:ratio = 200.0
        float inputs:eta = 0.85
        float inputs:max_output_torque = 400.0
        custom token connectors:flange_a.connect = </AckermannRover/TorqueSource_RL.connectors:flange>
        custom token connectors:flange_b.connect = </AckermannRover/Shaft_RL.connectors:flange>
    }

    def Xform "Motor_RR" (
        prepend references = @lunco://components/mobility/motor.usda@</Motor>
    )
    {
        double3 xformOp:translate = (0.3, -0.35, 1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:demand.connect = </AckermannRover.outputs:drive_right>
        float inputs:speed.connect = </AckermannRover/Gearbox_RR.outputs:speed_a>
    }


    def Xform "TorqueSource_RR" (
        prepend references = @lunco://components/mobility/torque.usda@</Torque>
    )
    {
        float inputs:tau_ref.connect = </AckermannRover/Motor_RR.outputs:shaft_torque>
        custom token connectors:flange.connect = </AckermannRover/Gearbox_RR.connectors:flange_a>
    }

    def Xform "Gearbox_RR" (
        prepend references = @lunco://components/mobility/gearbox.usda@</Gearbox>
    )
    {
        double3 xformOp:translate = (0.52, -0.35, 1.225)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:ratio = 200.0
        float inputs:eta = 0.85
        float inputs:max_output_torque = 400.0
        custom token connectors:flange_a.connect = </AckermannRover/TorqueSource_RR.connectors:flange>
        custom token connectors:flange_b.connect = </AckermannRover/Shaft_RR.connectors:flange>
    }

    def Xform "Shaft_FL" (prepend references = @lunco://components/mobility/avian_shaft.usda@</AvianShaft>)
    {
        float inputs:speed.connect = </AckermannRover/Electrical.inputs:shaft_speed_FL>
    }
    def Xform "Shaft_FR" (prepend references = @lunco://components/mobility/avian_shaft.usda@</AvianShaft>)
    {
        float inputs:speed.connect = </AckermannRover/Electrical.inputs:shaft_speed_FR>
    }
    def Xform "Shaft_RL" (prepend references = @lunco://components/mobility/avian_shaft.usda@</AvianShaft>)
    {
        float inputs:speed.connect = </AckermannRover/Electrical.inputs:shaft_speed_RL>
    }
    def Xform "Shaft_RR" (prepend references = @lunco://components/mobility/avian_shaft.usda@</AvianShaft>)
    {
        float inputs:speed.connect = </AckermannRover/Electrical.inputs:shaft_speed_RR>
    }

    # --- Comms ---------------------------------------------------------
    # Shared Earth-tracking antenna.
    def Xform "Comms" (
        prepend references = @lunco://components/comms/antenna.usda@</CommsAntenna>
    )
    {
        double3 xformOp:translate = (0, 0.15, -0.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "YawHead" {
            over "DishGimbal" {
                over "DishHead" {
                    over "LinkAperture" {
                        string lunco:link:class = "rover"
                        bool lunco:wifiNode = true
                        double lunco:wifi:maxRangeM = 5000.0
                        over "LinkBeam" {
                            over "Up" {
                                over "Driver" {
                                    custom float lunco:param:earthOnly = 1
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    # --- Drivetrain variant set (see skid_rover.usda for the contract) ---
    # HOW a wheel is simulated, and nothing else — the mounts are authored on this
    # rover, above, for both realizations. `raycast` is EMPTY: a raycast wheel is
    # the absence of a joint. `physical` adds the articulation root and the joints.
    variantSet "drivetrain" = {
        "raycast" {
        }

        "physical" (
            prepend references = @lunco://components/mobility/physical_drivetrain.usda@</Drivetrain>
        ) {
            over "Suspension_FL" (prepend apiSchemas = ["PhysicsRigidBodyAPI"]) {}
            over "Suspension_FR" (prepend apiSchemas = ["PhysicsRigidBodyAPI"]) {}
            over "Suspension_RL" (prepend apiSchemas = ["PhysicsRigidBodyAPI"]) {}
            over "Suspension_RR" (prepend apiSchemas = ["PhysicsRigidBodyAPI"]) {}
            # The wheel is a separate rigid body and its full suspension travel can
            # enter the chassis envelope.  Use the standard authored filtered-pair
            # contract for this deliberate clearance; the revolute joint already
            # filters wheel↔carrier, while this relation covers wheel↔chassis.
            over "Suspension_FL/Wheel_FL" (
                prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
            ) {
                rel physics:filteredPairs = </AckermannRover/Chassis>
            }
            over "Suspension_FR/Wheel_FR" (
                prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
            ) {
                rel physics:filteredPairs = </AckermannRover/Chassis>
            }
            over "Suspension_RL/Wheel_RL" (
                prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
            ) {
                rel physics:filteredPairs = </AckermannRover/Chassis>
            }
            over "Suspension_RR/Wheel_RR" (
                prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
            ) {
                rel physics:filteredPairs = </AckermannRover/Chassis>
            }
        }
    }

    # --- Power: the drivetrain is a real electrical network -----------------
    # The ideal source is the authored infinite-power configuration. A finite
    # source can replace this branch by composing the same public `p` network;
    # no runtime motor path changes when the source changes.
    variantSet "power" = {
        "infinite" {
            def Xform "PowerSource" (
                prepend references = @lunco://components/power/ideal_voltage_source.usda@</IdealVoltageSource>
            )
            {
            }
            def Scope "Electrical" (
                prepend apiSchemas = ["CollectionAPI:components"]
            )
            {
                float inputs:drive_left.connect = </AckermannRover.outputs:drive_left>
                float inputs:drive_right.connect = </AckermannRover.outputs:drive_right>
                float inputs:shaft_speed_FL.connect = </AckermannRover/Suspension_FL/Wheel_FL.outputs:shaft_speed>
                float inputs:shaft_speed_FR.connect = </AckermannRover/Suspension_FR/Wheel_FR.outputs:shaft_speed>
                float inputs:shaft_speed_RL.connect = </AckermannRover/Suspension_RL/Wheel_RL.outputs:shaft_speed>
                float inputs:shaft_speed_RR.connect = </AckermannRover/Suspension_RR/Wheel_RR.outputs:shaft_speed>
                float outputs:bus_voltage.connect = </AckermannRover/PowerSource.outputs:terminal_voltage_v>
                float outputs:bus_current.connect = </AckermannRover/PowerSource.outputs:terminal_current_a>
                float outputs:bus_power.connect = </AckermannRover/PowerSource.outputs:terminal_power_w>
                uniform token collection:components:expansionRule = "explicitOnly"
                prepend rel collection:components:includes = [
                    </AckermannRover/PowerSource>,
                    </AckermannRover/Motor_FL>,
                        </AckermannRover/TorqueSource_FL>,
                    </AckermannRover/Motor_FR>,
                        </AckermannRover/TorqueSource_FR>,
                    </AckermannRover/Motor_RL>,
                        </AckermannRover/TorqueSource_RL>,
                    </AckermannRover/Motor_RR>,
                        </AckermannRover/TorqueSource_RR>,
                    </AckermannRover/Gearbox_FL>,
                    </AckermannRover/Gearbox_FR>,
                    </AckermannRover/Gearbox_RL>,
                    </AckermannRover/Gearbox_RR>,
                    </AckermannRover/Shaft_FL>,
                    </AckermannRover/Shaft_FR>,
                    </AckermannRover/Shaft_RL>,
                    </AckermannRover/Shaft_RR>,
                ]
            }
            over "Motor_FL" {
                float inputs:demand.connect = </AckermannRover/Electrical.inputs:drive_left>
                custom token connectors:p.connect = </AckermannRover/PowerSource.connectors:p>
            }
            over "Motor_FR" {
                float inputs:demand.connect = </AckermannRover/Electrical.inputs:drive_right>
                custom token connectors:p.connect = </AckermannRover/PowerSource.connectors:p>
            }
            over "Motor_RL" {
                float inputs:demand.connect = </AckermannRover/Electrical.inputs:drive_left>
                custom token connectors:p.connect = </AckermannRover/PowerSource.connectors:p>
            }
            over "Motor_RR" {
                float inputs:demand.connect = </AckermannRover/Electrical.inputs:drive_right>
                custom token connectors:p.connect = </AckermannRover/PowerSource.connectors:p>
            }
        }
    }

    # --- Drive law -----------------------------------------------------------
    # HOW throttle/steer become drive + steering is COMPOSITION, not an
    # enumeration. The plain authored state is the instant built-in Ackermann
    # linear kernel. For a solver-clocked shared-axle motor lag, compose the law
    # on as a reference arc alongside the airframe:
    #
    #   def "Rover" (
    #       prepend references = [
    #           @lunco://vessels/rovers/ackermann_rover.usda@</AckermannRover>,
    #           @lunco://components/mobility/drive_laws/modelica_ackermann.usda@</DriveLaw>,
    #       ]
    #   ) {}
    #
    # NOTE the built-in kernel here writes THREE ports (drive_left/drive_right/
    # steering), so an Ackermann law must cover all three — steering as a model
    # passthrough, since Ackermann steers with the knuckles, not a torque
    # differential.
}
