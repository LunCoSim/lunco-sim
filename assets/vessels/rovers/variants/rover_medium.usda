#usda 1.0
(
    defaultPrim = "RoverMedium"
    upAxis = "Y"
    metersPerUnit = 1
)

# ── Rover variant: MEDIUM ("Standard") ───────────────────────────────────────
# The baseline rover for tier 2. It shares the exact same physical chassis as
# the other tiers, so differences on the course are attributable to drive and
# grip rather than hidden body tuning. Its worn tires retain more grip than the
# Awful tier; the motor is capped at the same stable 68 N.m axle rating so the
# articulated suspension cannot be driven into a rollover at the course berm.
#
# See `rover_easy.usda` for the tier ladder, and for why grip and torque are
# authored per wheel rather than on this prim.
def Xform "RoverMedium" (
    doc = "Standard rover profile. Worn tires (μ=1.0), 0.4 N·m motor stall torque, and the shared rocker-bogie chassis. Compare with Hauler to isolate tire friction."
    prepend apiSchemas = ["LunCoCatalogAPI"]
    prepend references = @lunco://vessels/rovers/rocker_bogie.usda@</RockerBogie>
)
{
    uniform bool lunco:spawnable = true

    # Handling, per wheel. `worn` tires: μ=1.0 ⇒ idealized slip limit atan(1.0)=45.0°.
    # The built-in profiles share this chassis and compare authored tire friction
    # and motor stall torque.
    #
    # Motor torque is sized against the tire: τ_cone = μ·N·r per wheel
    # (N = 532 kg·g_moon/6 ≈ 143.6 N, r = 0.4 m ⇒ medium cone 57 N·m). The
    # stable course rating is 68 N·m at the axle (0.4 N·m shaft stall), enough
    # to climb while keeping the free bogie below its rollover impulse.
    # ⚠ The wheels, motors and gearboxes are CHILDREN OF THE SUSPENSION, not of the
    # chassis: a rocker-bogie's front wheel hangs off the rocker arm and its middle
    # and rear wheels off the bogie, so each tier's opinions are nested one level
    # deeper than they were on the flat six-wheel chassis. Same six wheels, same
    # ladder — the arm they hang from is what changed.
    #
    # TORQUE COMES FROM THE MOTOR. The axle torque is derived as
    # stallTorque · ratio · efficiency = stallTorque · 200 · 0.85, so 0.4 N·m of
    # shaft stall torque lands 68 N·m at the axle. The ladder is easy 153 ›
    # medium 68 = awful 68, expressed on the part that actually makes the torque;
    # tire grip and suspension still provide the comparison separation.
    #
    # The gearbox ships rated at 400 N·m, which would clamp this tier down onto
    # `awful` and flatten the ladder. Rated above the motor so the motor stays the
    # only knob.
    over "RockerL"
    {
        over "Wheel_FL" (variants = { string tire = "worn" }) { }
        over "Motor_FL" { float inputs:stall_torque = 0.4 }
        over "Gearbox_FL" { float inputs:max_output_torque = 1000.0 }
    }
    over "RockerR"
    {
        over "Wheel_FR" (variants = { string tire = "worn" }) { }
        over "Motor_FR" { float inputs:stall_torque = 0.4 }
        over "Gearbox_FR" { float inputs:max_output_torque = 1000.0 }
    }
    over "BogieL"
    {
        over "Wheel_ML" (variants = { string tire = "worn" }) { }
        over "Wheel_RL" (variants = { string tire = "worn" }) { }
        over "Motor_ML" { float inputs:stall_torque = 0.4 }
        over "Motor_RL" { float inputs:stall_torque = 0.4 }
        over "Gearbox_ML" { float inputs:max_output_torque = 1000.0 }
        over "Gearbox_RL" { float inputs:max_output_torque = 1000.0 }
    }
    over "BogieR"
    {
        over "Wheel_MR" (variants = { string tire = "worn" }) { }
        over "Wheel_RR" (variants = { string tire = "worn" }) { }
        over "Motor_MR" { float inputs:stall_torque = 0.4 }
        over "Motor_RR" { float inputs:stall_torque = 0.4 }
        over "Gearbox_MR" { float inputs:max_output_torque = 1000.0 }
        over "Gearbox_RR" { float inputs:max_output_torque = 1000.0 }
    }

    # Livery — amber hull (medium). Tiers restyle the ONE authored colour,
    # `primvars:displayColor`, which the hull shader consumes as its base paint.
    # The rocker-bogie chassis calls its hull `Body`, not `Chassis`.
    over "Body"
    {
        color3f[] primvars:displayColor = [(0.85, 0.65, 0.15)]
    }
}
