#usda 1.0
(
    defaultPrim = "RoverStress"
    upAxis = "Y"
    metersPerUnit = 1
)

# Stress-matrix wrapper over the maintained easy rover. Communications hardware
# uses the antenna component's passive default during the mobility/count experiment.
def Xform "RoverStress" (
    doc = "Stress-matrix rover: maintained easy mobility assembly with the shared antenna in its passive default state."
    prepend apiSchemas = ["LunCoCatalogAPI"]
    prepend references = @lunco://vessels/rovers/variants/rover_easy.usda@</RoverEasy>
)
{
    uniform bool lunco:spawnable = true
}
