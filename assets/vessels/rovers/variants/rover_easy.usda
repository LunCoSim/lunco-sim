#usda 1.0
(
    defaultPrim = "RoverEasy"
    upAxis = "Y"
    metersPerUnit = 1
)

# ── Rover variant: EASY ("Explorer LT") ──────────────────────────────────────
# The forgiving rover for the first tier of the scored run. It references the
# shared six-wheel base (via the asset-root `lunco://` scheme, so it resolves
# wherever this twin is mounted) and OVERRIDES only the handling knobs.
#
# Design intent: every tier composes the same rocker-bogie body. Capability
# differences are therefore only tire grip and motor torque, not hidden chassis
# mass, centre-of-mass, inertia, or damping changes.
#
# The three tiers are a LADDER OVER THE SURVEYED SITE, not vibes. Slip limit is
# atan(frictionCoefficient). Per the twin's SURVEY.md (4 m baseline, re-measured
# 2026-07-17) the site's ways in measure 19.8° (ДЗЗ route, worst leg — the descent
# on the 199°/SSW radial) / 25.5° (naive straight line) / 31.1° (N, the steepest
# SECTOR) / 39.9° (336°/NNW, the steepest individual line):
#   easy   μ=1.8 → 61.0°  drives every line, including the NNW wall  (this file)
#   medium μ=1.0 → 45.0°  clears the steepest SECTOR (31.1° N) with margin
#   awful  μ=0.8 → 38.7°  still clears the steepest line (39.9° is close — watch it)
# Re-survey the site ⇒ re-check these three numbers, or the ladder is decorative.
#
# The steep side is N/NNW, NOT WSW. WSW (237°) is 22.2° — one of the EASIER ways
# out. Earlier revisions of these files recorded "34.4° WSW" as the steepest wall;
# that figure is wrong and SURVEY.md calls it out by name.
# Grip is the TIRE's and torque is the MOTOR's, so each tier authors those only
# through the real nested parts below. USD attributes do not inherit down
# namespace, and the shared chassis keeps its own physical properties.
#
# There is no steering knob. The base is a skid rover with authored generic ports:
# it steers by driving its sides at different speeds, and its wheels do not turn.
def Xform "RoverEasy" (
    doc = "Easy rover (Explorer LT) — low centre of mass, planted and forgiving. The trainer tier: it climbs the borderline slope and resists tipping. Start here."
    prepend apiSchemas = ["LunCoCatalogAPI"]
    prepend references = @lunco://vessels/rovers/rocker_bogie.usda@</RockerBogie>
)
{
    uniform bool lunco:spawnable = true

    # Grip comes from the TIRE — μ is a property of rubber, so the tier fits
    # `cleated` tires (μ=1.8 ⇒ slip limit atan(1.8)=61.0°, well past the SURVEYED
    # site's steepest line at 39.9° NNW, so this tier drives ANY line into the
    # crater and back — the terrain never punishes you, so you learn the route
    # before the route matters).
    # ⚠ Motor torque is sized AGAINST the tire: the wheelie_check gate (bogie
    # < 10° on flat ground under full throttle) bounds stall torque to ~1.5× the
    # traction cone — τ_cone = μ·N·r per wheel (N = 532 kg·g_moon/6 ≈ 143.6 N,
    # r = 0.4 m ⇒ easy cone 103 N·m). Above ~2× the motor reaction on the free
    # bogie hinge slams it into its ±20° stop and lifts the middle wheels. This
    # tier: 119 N·m at the axle ⇒ 0.7 N·m shaft stall.
    # ⚠ The wheels, motors and gearboxes are CHILDREN OF THE SUSPENSION, not of the
    # chassis: a rocker-bogie's front wheel hangs off the rocker arm and its middle
    # and rear wheels off the bogie, so each tier's opinions are nested one level
    # deeper than they were on the flat six-wheel chassis. Same six wheels, same
    # ladder — the arm they hang from is what changed.
    over "RockerL"
    {
        over "Wheel_FL" (variants = { string tire = "cleated" }) { }
        over "Motor_FL" { float inputs:stall_torque = 0.9 }
        over "Gearbox_FL" { float inputs:max_output_torque = 1000.0 }
    }
    over "RockerR"
    {
        over "Wheel_FR" (variants = { string tire = "cleated" }) { }
        over "Motor_FR" { float inputs:stall_torque = 0.9 }
        over "Gearbox_FR" { float inputs:max_output_torque = 1000.0 }
    }
    over "BogieL"
    {
        over "Wheel_ML" (variants = { string tire = "cleated" }) { }
        over "Wheel_RL" (variants = { string tire = "cleated" }) { }
        over "Motor_ML" { float inputs:stall_torque = 0.9 }
        over "Motor_RL" { float inputs:stall_torque = 0.9 }
        over "Gearbox_ML" { float inputs:max_output_torque = 1000.0 }
        over "Gearbox_RL" { float inputs:max_output_torque = 1000.0 }
    }
    over "BogieR"
    {
        over "Wheel_MR" (variants = { string tire = "cleated" }) { }
        over "Wheel_RR" (variants = { string tire = "cleated" }) { }
        over "Motor_MR" { float inputs:stall_torque = 0.9 }
        over "Motor_RR" { float inputs:stall_torque = 0.9 }
        over "Gearbox_MR" { float inputs:max_output_torque = 1000.0 }
        over "Gearbox_RR" { float inputs:max_output_torque = 1000.0 }
    }

    # TORQUE COMES FROM THE MOTOR. The axle torque is derived:
    #   τ_axle = stallTorque · ratio · efficiency = stallTorque · 200 · 0.85
    # This tier is sized at ~1.2× its traction cone (see the note above): 0.7 N·m
    # of shaft stall torque lands 119 N·m at the axle — plenty to climb, not
    # enough to slam the bogie. The tier is a per-instance attribute override on a
    # real part, which is also how a single weak or overheating wheel would be
    # expressed.

    # The shipped reduction rates its output shaft at 400 N·m, which would CLAMP
    # this tier (and medium) and flatten the ladder into "everything hits 400". A
    # rover built for 900 N·m at the axle has the drive to carry it, so the tiers
    # rate their gearboxes above their motors and the motor stays the only knob.

    # Livery — calm green hull (easy=green); accent stays default. Tiers
    # restyle the ONE authored colour, `primvars:displayColor`, which the hull
    # shader consumes as its base paint.
    over "Body"
    {
        color3f[] primvars:displayColor = [(0.3, 0.72, 0.35)]
    }
}
