#usda 1.0
(
    """
    Retained Object Builder authoring fixture for the USD socket/plug workflow.
    It is not composed by any shipped app curriculum; app availability is
    determined only by the app root layers that sublayer a track.
    """
    defaultPrim = "ObjectBuilder"
    metersPerUnit = 1
)

def Scope "ObjectBuilder" (
    prepend apiSchemas = ["LunCoTutorialTrackAPI"]
)
{
    string lunco:track:label = "Object Builder"
    string lunco:track:perspective = "object_builder"

    def Scope "MountComponents" (
        prepend apiSchemas = ["LunCoProgramAPI", "LunCoTutorialAPI"]
        prepend payload = @lunco://scenes/luncosim/sandbox_scene.usda@
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://tutorials/object_builder/mount_components.rhai@
        string lunco:tutorial:title = "Build from Parts"
        string lunco:tutorial:blurb = "Select a host, inspect its USD mount sockets, and snap a component by its authored plug frame."
        uniform token lunco:tutorial:difficulty = "intermediate"
        uniform token lunco:tutorial:format = "tour"
        rel lunco:tutorial:next = </Sandbox/BuildBase>
    }
}
