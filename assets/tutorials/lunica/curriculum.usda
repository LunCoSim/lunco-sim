#usda 1.0
(
    """
    Modelica workbench curriculum. See `../sandbox/curriculum.usda` for what a
    track and a lesson are made of.

    NO LESSON HERE CARRIES A PAYLOAD, and every one of them is correct. These are
    workbench tours — they teach panels, compilation, plots and the API, none of
    which is a 3D world — so they run in whatever the user already has open. That
    a whole track legitimately declares no environment is why "every lesson opens
    a scene" was never a rule that could be enforced, and why the environment had
    to become something a lesson DECLARES (present, or deliberately absent)
    rather than something it calls.
    """
    defaultPrim = "Lunica"
    metersPerUnit = 1
)

def Scope "Lunica" (
    prepend apiSchemas = ["LunCoTutorialTrackAPI"]
)
{
    string lunco:track:label = "3️⃣ Modelica Workbench"
    string lunco:track:perspective = "modelica_analyze"

    def Scope "Overview" (
        prepend apiSchemas = ["LunCoProgramAPI", "LunCoTutorialAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://tutorials/lunica/overview.rhai@
        string lunco:tutorial:title = "Lunica Overview"
        string lunco:tutorial:blurb = "Learn the Lunica workbench in a short guided tour."
        uniform token lunco:tutorial:difficulty = "beginner"
        uniform token lunco:tutorial:format = "tour"
        uniform bool lunco:tutorial:firstStart = true
        rel lunco:tutorial:next = </Lunica/Workspace>
    }

    def Scope "Workspace" (
        prepend apiSchemas = ["LunCoProgramAPI", "LunCoTutorialAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://tutorials/lunica/workspace.rhai@
        string lunco:tutorial:title = "Your Workspace"
        string lunco:tutorial:blurb = "Find Twins, models, read-only libraries, and learning paths."
        uniform token lunco:tutorial:difficulty = "beginner"
        uniform token lunco:tutorial:format = "tour"
        rel lunco:tutorial:next = </Lunica/Model>
    }

    def Scope "Model" (
        prepend apiSchemas = ["LunCoProgramAPI", "LunCoTutorialAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://tutorials/lunica/model.rhai@
        string lunco:tutorial:title = "Open & View a Model"
        string lunco:tutorial:blurb = "Open a model, switch views, and add a connected component."
        uniform token lunco:tutorial:difficulty = "beginner"
        uniform token lunco:tutorial:format = "tour"
        rel lunco:tutorial:next = </Lunica/Run>
    }

    def Scope "Run" (
        prepend apiSchemas = ["LunCoProgramAPI", "LunCoTutorialAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://tutorials/lunica/run.rhai@
        string lunco:tutorial:title = "Compile & Run"
        string lunco:tutorial:blurb = "Compile a model, choose a run mode, and change a live input."
        uniform token lunco:tutorial:difficulty = "beginner"
        uniform token lunco:tutorial:format = "tour"
        rel lunco:tutorial:next = </Lunica/Experiments>
    }

    def Scope "Experiments" (
        prepend apiSchemas = ["LunCoProgramAPI", "LunCoTutorialAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://tutorials/lunica/experiments.rhai@
        string lunco:tutorial:title = "Experiments & Sweeps"
        string lunco:tutorial:blurb = "Override parameters and compare several runs without editing source."
        uniform token lunco:tutorial:difficulty = "intermediate"
        uniform token lunco:tutorial:format = "tour"
        rel lunco:tutorial:next = </Lunica/Plots>
    }

    def Scope "Plots" (
        prepend apiSchemas = ["LunCoProgramAPI", "LunCoTutorialAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://tutorials/lunica/plots.rhai@
        string lunco:tutorial:title = "Plots & Results"
        string lunco:tutorial:blurb = "Read graphs, diagnostics, and solver messages."
        uniform token lunco:tutorial:difficulty = "beginner"
        uniform token lunco:tutorial:format = "tour"
        rel lunco:tutorial:next = </Lunica/Scripting>
    }

    def Scope "Scripting" (
        prepend apiSchemas = ["LunCoProgramAPI", "LunCoTutorialAPI"]
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://tutorials/lunica/scripting.rhai@
        string lunco:tutorial:title = "Automate with API + MCP"
        string lunco:tutorial:blurb = "Drive the workbench from scripts, the HTTP API, or MCP."
        uniform token lunco:tutorial:difficulty = "intermediate"
        uniform token lunco:tutorial:format = "tour"
    }
}
