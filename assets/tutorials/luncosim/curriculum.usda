#usda 1.0
(
    """
    LunCoSim foundations curriculum. See `../sandbox/curriculum.usda` for what a
    track and a lesson are made of.

    The first-run path reviews the UI and then hands the learner into the
    authored driving and terrain mechanics tracks.
    """
    defaultPrim = "LunCoSim"
    metersPerUnit = 1
)

def Scope "LunCoSim" (
    prepend apiSchemas = ["LunCoTutorialTrackAPI"]
)
{
    string lunco:track:label = "LunCoSim Foundations"
    string lunco:track:perspective = "rover_build"

    def Scope "Welcome" (
        prepend apiSchemas = ["LunCoProgramAPI", "LunCoTutorialAPI"]
        prepend payload = @lunco://tutorials/sandbox/first_drive.usda@
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://tutorials/luncosim/welcome.rhai@
        string lunco:tutorial:title = "Read the Sim UI"
        string lunco:tutorial:blurb = "Find the scene, live state, controls, and simulation time."
        uniform token lunco:tutorial:difficulty = "beginner"
        uniform token lunco:tutorial:format = "tour"
        uniform bool lunco:tutorial:firstStart = true
        rel lunco:tutorial:next = </Perspectives/Overview>
    }

    def Scope "Controls" (
        prepend apiSchemas = ["LunCoProgramAPI", "LunCoTutorialAPI"]
        prepend payload = @lunco://tutorials/sandbox/first_drive.usda@
    )
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:sourceAsset = @lunco://tutorials/luncosim/controls.rhai@
        string lunco:tutorial:title = "Authority Handoff"
        string lunco:tutorial:blurb = "Take control of a rover, confirm the status, and release it."
        uniform token lunco:tutorial:difficulty = "beginner"
        uniform token lunco:tutorial:format = "exercise"
        rel lunco:tutorial:next = </Basic/MoonDrivingBasics>
    }
}
