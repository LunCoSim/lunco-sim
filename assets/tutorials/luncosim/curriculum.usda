#usda 1.0
(
    """
    Flagship curriculum. See `../sandbox/curriculum.usda` for what a track and a
    lesson are made of.

    Both lessons declare the default LunCoSim world. This is intentionally
    explicit: first-run boot hands scene ownership to the selected tutorial and
    therefore skips the ordinary startup load. A world-less onboarding lesson
    would otherwise open over an empty viewport.
    """
    defaultPrim = "LunCoSim"
    metersPerUnit = 1
)

def Scope "LunCoSim" (
    prepend apiSchemas = ["LunCoTutorialTrackAPI"]
)
{
    string lunco:track:label = "🌍 LunCoSim Flagship"

    def Scope "Welcome" (
        prepend apiSchemas = ["LunCoProgramAPI", "LunCoTutorialAPI"]
        prepend payload = @lunco://scenes/luncosim/sandbox_scene.usda@
    )
    {
        uniform asset info:sourceAsset = @lunco://tutorials/luncosim/welcome.rhai@
        string lunco:tutorial:title = "Welcome to LunCoSim"
        string lunco:tutorial:blurb = "A guided tour of the flagship — the live solar system, the camera, and time-warp."
        uniform token lunco:tutorial:difficulty = "beginner"
        uniform bool lunco:tutorial:firstStart = true
        rel lunco:tutorial:next = </LunCoSim/Controls>
    }

    def Scope "Controls" (
        prepend apiSchemas = ["LunCoProgramAPI", "LunCoTutorialAPI"]
        prepend payload = @lunco://scenes/luncosim/sandbox_scene.usda@
    )
    {
        uniform asset info:sourceAsset = @lunco://tutorials/luncosim/controls.rhai@
        string lunco:tutorial:title = "Controls & Command"
        string lunco:tutorial:blurb = "Focus a body, fly the camera, and possess a vessel — then hand back to the autopilot."
        uniform token lunco:tutorial:difficulty = "beginner"
    }
}
