#usda 1.0
(
    defaultPrim = "SlopeTest"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "SlopeTest" (
    kind = "assembly"
    documentation = "A borderline ~18° grade with the top-heavy Hauler at its base — the tip-over teaching stage."
    prepend apiSchemas = ["LunCoCatalogAPI"]
)
{
    uniform bool lunco:spawnable = false
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0.0, -1.0, 0.0)
        float physics:gravityMagnitude = 1.6200000047683716
    }
    def Scope "PhysicsMaterials"
    {
        def Material "Friction_0_95" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.949999988079071
            float physics:staticFriction = 0.949999988079071
        }
        def Material "Friction_1_0" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 1.0
            float physics:staticFriction = 1.0
        }
    }
    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0.0, -0.5, 0.0)
        double3 xformOp:scale = (120.0, 1.0, 120.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.3400000035762787, 0.3199999928474426, 0.3100000023841858)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </SlopeTest/PhysicsMaterials/Friction_1_0>
    }
    def Cube "Ramp" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (8.0, 3.6, 0.0)
        double3 xformOp:rotateXYZ = (0.0, 0.0, 18.0)
        double3 xformOp:scale = (34.0, 0.6, 40.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.4000000059604645, 0.36000001430511475, 0.33000001311302185)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </SlopeTest/PhysicsMaterials/Friction_0_95>
    }
    def Xform "Rover" (
        prepend references = @lunco://vessels/rovers/variants/rover_awful.usda@</RoverAwful>
    )
    {
        double3 xformOp:translate = (-18.0, 1.0, 0.0)
        double3 xformOp:rotateXYZ = (0.0, -90.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
    def Xform "Marker" (
        prepend references = @lunco://markers/route_point.usda@</RoutePoint>
    )
    {
        double3 xformOp:translate = (23.0, 8.65, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "Trigger"
        {
            token lunco:triggerZone = "waypoint"
        }
    }
    def DistantLight "Sun" (
        prepend references = @lunco://lighting/sun.usda@</Sun>
    )
    {
        double3 xformOp:rotateXYZ = (-16.0, 60.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        float inputs:shadow:distance = 600.0
        float lunco:shadow:firstCascadeFarBound = 20.0
    }
    def Camera "Avatar" (
        prepend apiSchemas = ["LunCoCameraAPI", "LunCoAvatarAPI"]
        prepend references = @lunco://components/cameras/lunar_surface_camera.usda@</LunarSurfaceCamera>
    )
    {
        uniform bool lunco:avatar = true
        double3 lunco:cameraLookAt = (5.0, 4.0, 0.0)
        double3 xformOp:translate = (-30.0, 16.0, -34.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def "Controls" (
            prepend references = @lunco://vessels/control_profiles.usda@</AvatarControls>
        )
        {
        }
    }
}
