#usda 1.0
(
    defaultPrim = "RoverVariants"
    upAxis = "Y"
    metersPerUnit = 1
)

# B4's complete teaching world. The practice yard, ramp, gravity, camera and
# medium baseline come from the same authored DrivingBasics stage used by B1;
# this payload adds the other two profile assets as ordinary USD references.
#
# The three vehicles are therefore composed before the tutorial script starts.
# The script only presents the lesson and never races the asynchronous spawn
# catalogue with runtime SpawnEntity requests.
def Xform "RoverVariants" (
    kind = "assembly"
    doc = "B4 practice yard with the easy, medium and awful rocker-bogie profiles composed as three authored vehicles."
    prepend references = @lunco://tutorials/basic/driving_basics.usda@</DrivingBasics>
)
{
    def Xform "ExplorerLT" (
        prepend references = @lunco://vessels/rovers/variants/rover_easy.usda@</RoverEasy>
    )
    {
        double3 xformOp:translate = (-35.0, 1.0, -9.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "Hauler" (
        prepend references = @lunco://vessels/rovers/variants/rover_awful.usda@</RoverAwful>
    )
    {
        double3 xformOp:translate = (-35.0, 1.0, 9.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
