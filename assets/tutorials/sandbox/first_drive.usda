#usda 1.0
(
    defaultPrim = "FirstDrive"
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "FirstDrive" (
    kind = "assembly"
    doc = "Take control of the training rover, reach the visible green marker, and stop."
    prepend apiSchemas = ["LunCoCatalogAPI"]
)
{
    uniform bool lunco:spawnable = false
    def Scope "PhysicsMaterials"
    {
        def Material "Friction_1_0" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 1.0
            float physics:staticFriction = 1.0
        }
    }
    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "LunCoTerrainAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:translate = (0.0, -0.5, 0.0)
        double3 xformOp:scale = (200.0, 1.0, 200.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.3499999940395355, 0.33000001311302185, 0.3799999952316284)]
        bool physics:collisionEnabled = true
        rel material:binding:physics = </FirstDrive/PhysicsMaterials/Friction_1_0>
    }
    def Camera "Avatar" (
        prepend apiSchemas = ["LunCoCameraAPI", "LunCoAvatarAPI"]
        prepend references = @lunco://components/cameras/lunar_surface_camera.usda@</LunarSurfaceCamera>
    )
    {
        uniform bool lunco:avatar = true
        double3 lunco:cameraLookAt = (0.0, 0.0, -8.0)
        double3 xformOp:translate = (14.0, 10.0, 10.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def "Controls" (
            prepend references = @lunco://vessels/control_profiles.usda@</AvatarControls>
        )
        {
        }
    }
    def DistantLight "Sun" (
        prepend references = @lunco://lighting/sun.usda@</Sun>
    )
    {
        double3 xformOp:rotateXYZ = (-35.0, 40.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
    def Xform "Rover" (
        prepend references = @lunco://vessels/rovers/skid_rover.usda@</SkidRover>
    )
    {
        double3 xformOp:translate = (0.0, 1.02, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "Flag" (
        prepend references = @lunco://markers/route_point.usda@</RoutePoint>
    )
    {
        double3 xformOp:translate = (0.0, 0.0, -18.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
