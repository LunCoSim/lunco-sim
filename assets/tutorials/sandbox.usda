#usda 1.0
(
    """
    The curriculum the SANDBOX app offers.

    This layer is the answer to "which tracks does this app show", and its
    sublayer order is the order they appear in. A track is offered by whichever
    app composes it; its name does not determine its owner.

    STRONGEST FIRST, as everywhere else in USD. A twin adds its own curriculum on
    the SESSION layer at runtime, so it composes over these without editing them
    and leaves when the twin closes.
    """
    metersPerUnit = 1
    subLayers = [
        @lunco://tutorials/sandbox/curriculum.usda@,
        @lunco://tutorials/basic/curriculum.usda@
    ]
)
