class "LunCoTerrainEditAPI"
{
    uniform token lunco:edit:kind = "" (
        allowedTokens = ["", "brush", "flatten", "crater"]
    )
    double2 lunco:edit:center = (0.0, 0.0)
    double lunco:edit:radius = 0.0
    double lunco:edit:amount = 0.0
}

class "LunCoProgramAPI"
{
    uniform token info:implementationSource (
        allowedTokens = ["id", "sourceAsset", "sourceCode"]
    )
    uniform token info:id = ""
    uniform asset info:sourceAsset = @@
    uniform string info:sourceCode = ""
    uniform token info:sourceAsset:subIdentifier = ""
    uniform bool lunco:program:realtimeSafe = false
    uniform double lunco:program:communicationPeriod = 0.016666666666666666
}

class "LunCoModelicaTopologyAPI"
{
    uniform token lunco:modelica:topologyRole = "neutral" (
        allowedTokens = ["source", "storage", "load", "neutral"]
    )
}

