class LunCoEvent "LunCoEvent"
{
    float inputs:trigger = 0.0
    uniform token lunco:event:name = ""
    uniform token lunco:event:severity = "info" (
        allowedTokens = ["debug", "info", "warning", "error", "critical"]
    )
    uniform bool lunco:event:latched = false
    uniform double lunco:event:qualificationTime = 0.0
}

